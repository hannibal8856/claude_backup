/* In-process replacement for /sbin/ies_uri_handle_client --type read.
 * The implementation lives in libies_uri_handle_hook.so (built by
 * app_moxa_iss_10_1_0/code/uri_ctrl_hook). We dlopen() at runtime
 * instead of link-time to avoid a circular buildroot dependency
 * (3rdparty_net_snmp <- iss <- dhcpsnp <- lib_moxa_snmp_plugin <- 3rdparty_net_snmp). */
typedef ies_handle_t (*pfn_ies_uri_handle_read_t)(const unsigned char *uri,
                                                    const unsigned char *fname);
typedef ies_handle_t (*pfn_IssSnmpURI_readRemapper_t)(unsigned char *uriString,
                                                       unsigned char *iputFile,
                                                       unsigned char *oputFile);

static pfn_ies_uri_handle_read_t     g_ies_uri_handle_read     = NULL;
static pfn_IssSnmpURI_readRemapper_t g_IssSnmpURI_readRemapper = NULL;
static int                            g_uri_hook_load_state    = 0; /* 0=untried 1=ok -1=failed */

static int
mox_snmp_uri_hook_load(void)
{
    void *h;

    if ( g_uri_hook_load_state != 0 )
    {
        return g_uri_hook_load_state;
    }

    h = dlopen("libies_uri_handle_hook.so", RTLD_LAZY | RTLD_GLOBAL);
    if ( NULL == h )
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP,
            "dlopen(libies_uri_handle_hook.so) failed: %s\n", dlerror());
        g_uri_hook_load_state = -1;
        return -1;
    }

    g_ies_uri_handle_read =
        (pfn_ies_uri_handle_read_t) dlsym(h, "ies_uri_handle_read");
    g_IssSnmpURI_readRemapper =
        (pfn_IssSnmpURI_readRemapper_t) dlsym(h, "IssSnmpURI_readRemapper");

    if ( NULL == g_ies_uri_handle_read || NULL == g_IssSnmpURI_readRemapper )
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP,
            "dlsym failed: ies_uri_handle_read=%p IssSnmpURI_readRemapper=%p\n",
            (void *)g_ies_uri_handle_read, (void *)g_IssSnmpURI_readRemapper);
        g_uri_hook_load_state = -1;
        return -1;
    }

    g_uri_hook_load_state = 1;
    return 1;
}


