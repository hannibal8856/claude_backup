/*-------------------------------------------------------------------+
 * Function           : utilSNMP_get_oid_from_oidstr
 *
 * Description        :
        

+-------------------------------------------------------------------*/
int 
utilSNMP_get_oid_from_oidstr
(
    char *oid_str, 
    int   oid_str_len, 
    oid   tmp_oid[MAX_OID_LEN]
)
{
    char *oid_str_buf;
    int   oid_str_index;
    int   oid_num_index;

    oid_str_index = 0;
    for ( oid_num_index = 0; 
          oid_num_index < MAX_OID_LEN; 
          oid_num_index++) 
    {

        oid_str_buf = &oid_str[oid_str_index];
        while (1) 
        {
            if (',' == oid_str[oid_str_index]) 
            {
                break;
            }
            if ('.' == oid_str[oid_str_index]) 
            {
                break;
            }            
            oid_str_index++;
            if (oid_str_index >= oid_str_len) 
            {
                break;
            }
        }
        oid_str[oid_str_index] = ' ';
        tmp_oid[oid_num_index] = atoi(oid_str_buf);

        oid_str_index++;
        if (oid_str_index >= oid_str_len) 
        {
            break;
        }
    }
    oid_num_index++;
    return oid_num_index;
}


/*-------------------------------------------------------------------+
   Function Name   : ies_uri_snmp_sprintf
   Description     : 

   Note            : 
+-------------------------------------------------------------------*/
int ies_uri_snmp_sprintf
(
    char   *buf, 
    int     buf_len, 
    int    *buf_pos, 
    char   *fmt, 
    ...
)
{

    char   *buf_index;
    int     total_len;
    int     len;
    va_list ap;

    total_len = buf_len - *buf_pos;
    buf_index = &buf[*buf_pos];

    va_start(ap, fmt);
    len = vsnprintf(buf_index, total_len, fmt, ap);
    va_end(ap);

    total_len -= len;
    if (total_len > 0 ) 
    {
        *buf_pos += len;
        return IES_NOERR;
    }
    return IES_ERR;
}

/*-------------------------------------------------------------------+
   Function Name   : ies_uri_snmp_dump_oid2
   Description     : 

