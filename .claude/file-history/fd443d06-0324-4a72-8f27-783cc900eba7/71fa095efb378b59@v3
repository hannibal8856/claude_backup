    else 
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
        goto out;
    }
    index                       = index - 1;
    uri_interface_entry->index  = index;
    uri_interface_entry->iftype = iftype;
    ret = IES_NOERR;
out:

    return ret;
}



