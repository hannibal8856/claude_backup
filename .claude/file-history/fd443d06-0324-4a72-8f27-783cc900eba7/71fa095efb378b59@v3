/* Forward a GET to an AgentX subagent (per D4).
 *
 * in-master keeps its registration so it still owns SET; on MODE_IS_GET the
 * request is handed to whichever subagent covers the same OID range.
 *
 * net-snmp's registration table is two-dimensional. ->next/->prev slice the
 * OID space into non-overlapping regions in OID order; ->children holds every
 * overlapping registration for one region, sorted by (namelen descending,
 * priority ascending) in netsnmp_subtree_load() (agent_registry.c). The losers
 * are kept, not discarded. netsnmp_subtree_split() splits via deepcopy and
 * preserves name_a / namelen / reginfo, so when a local registration carves up
 * a subagent's broad registration, the resulting fragment still carries the
 * subagent's reginfo and hangs off the children chain.
 *
 * This is the same traversal unregister_mib_context() uses to locate a
 * specific registration (agent_registry.c:1714) - not an invented technique.
 *
 * The subtree is located via reginfo->rootoid rather than the request's OID:
 * on GETNEXT, requestvb->name is the *preceding* OID and may fall in a
 * different region. Using our own registration root is correct for both GET
 * and GETNEXT.
 *
 * Returns 0 when the request was handed to a subagent, -1 when no subagent
 * covers this OID, in which case the caller falls back to the local slow path.
 */
static int
mox_snmp_forward_get_to_subagent
(
    netsnmp_handler_registration *reginfo,
    netsnmp_agent_request_info   *reqinfo,
    netsnmp_request_info         *request
)
{
    netsnmp_subtree      *sub  = NULL;
    netsnmp_subtree      *c    = NULL;
    netsnmp_request_info *saved_next;
    const char           *ctx  = NULL;

    if ( NULL == reginfo || NULL == reginfo->rootoid )
    {
        return -1;
    }

    if ( NULL != reqinfo && NULL != reqinfo->asp && NULL != reqinfo->asp->pdu )
    {
        ctx = reqinfo->asp->pdu->contextName;
    }

    sub = netsnmp_subtree_find(reginfo->rootoid, reginfo->rootoid_len, NULL, ctx);
    if ( NULL == sub )
    {
        return -1;
    }

    for ( c = sub->children; NULL != c; c = c->children )
    {
        if ( NULL != c->reginfo && NULL != c->reginfo->handler &&
             c->reginfo->handler->access_method == agentx_master_handler )
        {
            break;
        }
    }

    if ( NULL == c )
    {
        return -1;                  /* no subagent covers this OID */
    }

    /* Forward this request only; leaving ->next intact would make
     * netsnmp_call_handlers pull the whole chain along. */
    saved_next    = request->next;
    request->next = NULL;
    (void) netsnmp_call_handlers(c->reginfo, reqinfo, request);
    request->next = saved_next;

    return 0;
}

/*-------------------------------------------------------------------+
 * Function           : mox_snmp_handle_entry
 *
 * Description        :
        all the get function from ISS, use file operation.
        all function from framework use flask
        all the set function , use flask
+-------------------------------------------------------------------*/
int
mox_snmp_handle_entry
(
    netsnmp_mib_handler                   *handler,
    netsnmp_handler_registration          *reginfo,
    netsnmp_agent_request_info            *reqinfo,
    netsnmp_request_info                  *request 
)
{
    struct ies_auto_mibs_entry             entry_buf;
    struct ies_auto_mibs_entry            *entry = NULL;
    FILE                                  *fp    = NULL;
    int                                    ret;
    struct timespec                        timeBefore;
    struct timespec                        timeAfter;
    char                                   snmp_username[RWUSER_NAME_SIZE] = {0};
    int                                    token_cnt = 0;
    
    if ( request->processed )
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "%s line %d\n", __func__, __LINE__);
        return SNMP_ERR_NOERROR;
    }
    if ( 0 != clock_gettime(CLOCK_MONOTONIC, &timeBefore) ) 
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
    }

    memset(&entry_buf, 0                   , sizeof(entry_buf));
    memcpy(&entry_buf, reginfo->my_reg_void, sizeof(entry_buf));

    entry = &entry_buf;

    if ( IES_AUTO_MIBS_MAGIC_ENTRY != entry->magic ) 
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "%s: Bad Magic \n", __func__);
        return SNMP_ERR_NOSUCHNAME; 
    }

    // Default token for snmp v1, v2c and v3(read-only user)
    snprintf(security_token, sizeof(security_token), "%s", security_tokens[0]);
    // Identify SNMPv3 read-write username and use different token to access
    if (reqinfo->asp->pdu->securityName)
    {
        snprintf(snmp_username, RWUSER_NAME_SIZE, reqinfo->asp->pdu->securityName);
        // Search token array
        for (token_cnt = 0; token_cnt < MAX_TOKEN_NUM - 1; token_cnt++) {
            if (strncmp(snmp_username, rwuser_list[token_cnt], RWUSER_NAME_SIZE) == 0) {
                memset(security_token, 0, sizeof(security_token));
                snprintf(security_token, sizeof(security_token), "%s", security_tokens[token_cnt+1]);
                break;
            }
        }
    }

    if ( MODE_IS_GET(reqinfo->mode) ) 
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "%s@%d: entry %s \n",
            __func__, __LINE__, entry->uri );

        /* per D2 every GET goes to a subagent, but the forward does not live
         * here: it sits inside the two value-file generators below, at the
         * point where each would leave the process. Anything answered before
         * that point is never forwarded, by construction rather than by a list
         * of flags.
         *
         * A registered get-value function short-circuits the generators
         * entirely, so these entries never reach a forward. Note that most of
         * them are not in-process: only the five generalInfo callbacks read
         * local state, the other 18 go out to the framework over HTTP via
         * getEntryValue_uriScalarEntry(). They stay local because nothing has
         * moved them yet, not because they are cheap. */
        if ( moxaSnmpHandle_ChkEntryGetValue(entry) == 0 )
        {
            if ( moxaSnmpHandle_ExeEntryGetValue(reqinfo, request, entry) == 0 )
            {
                return SNMP_ERR_NOERROR;
            }
            return SNMP_ERR_BADVALUE;
        }

        if ( moxaSnmpHandle_UtilMibEntryCheckFromUri(entry) )
        {
            ret = entry_handle_generate_uri_value_file(entry, &fp, reginfo, reqinfo, request);

            if ( IES_GET_FORWARDED == ret )
            {
                return SNMP_ERR_NOERROR;
            }

            if ( IES_NOERR != ret )
            {

                LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d \n", __func__, __LINE__);

                if ( 0 != clock_gettime(CLOCK_MONOTONIC, &timeAfter) ) 
                {
                    LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
                }
                util_timeDiff("mib get bad 2", &timeBefore, &timeAfter);
                return SNMP_ERR_BADVALUE;
            }
        } 
        else 
        {
            ret = entry_handle_generate_iss_value_file(entry, &fp, reginfo, reqinfo, request);

            if ( IES_GET_FORWARDED == ret )
            {
                return SNMP_ERR_NOERROR;
            }

            if ( IES_NOERR != ret )
            {

                LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d \n", __func__, __LINE__);

                if ( 0 != clock_gettime(CLOCK_MONOTONIC, &timeAfter) ) 
                {
                    LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
                }
                util_timeDiff("mib get bad 3", &timeBefore, &timeAfter);
                return SNMP_ERR_BADVALUE;
            }
        }

        ret = entry_handle_get_value_from_file(
            reginfo, reqinfo, request, entry, 
            fp, ( MODE_GET == reqinfo->mode ) ? IES_AUTO_MIBS_TBL_GET : IES_AUTO_MIBS_TBL_GET_NEXT);

        if ( IES_NOERR == IS_SCALAR_ENTRY(entry) ) 
        {
            entry_handle_remove_file(entry);
        }

        if ( 0 != clock_gettime(CLOCK_MONOTONIC, &timeAfter) ) 
        {
            LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
        }

        if ( IES_NOERR == ret ) 
        {
            util_timeDiff("mib_get_success", &timeBefore, &timeAfter);
        } 
        else 
        {
            util_timeDiff("mib get bad 4", &timeBefore, &timeAfter);
        }
        return ( IES_NOERR == ret ) ? SNMP_ERR_NOERROR : SNMP_ERR_BADVALUE;

    } 
    else 
    if ( MODE_IS_SET(reqinfo->mode) ) 
    {
        if ( MODE_SET_COMMIT == reqinfo->mode ) 
        {
            LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "%s@%d: entry %s \n",
                __func__, __LINE__, entry->uri );
            if ( moxaSnmpHandle_ChkEntrySetValue(entry) == 0 )
            {
                if ( moxaSnmpHandle_ExeEntrySetValue(reqinfo, request, entry) == 0 )
                {
                    return SNMP_ERR_NOERROR;
                }
                return SNMP_ERR_BADVALUE;
            }
            return mox_snmp_flask_handle_entry_set(reqinfo, request, entry);
        }
        else
        if ( reqinfo->mode == MODE_SET_RESERVE1 )
        {
            LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "%s@%d: entry %s \n",
                __func__, __LINE__, entry->uri );
            if ( moxaSnmpHandle_ChkEntryDep(entry) == 0 )
            {
                if ( moxaSnmpHandle_ExeEntryDep(reqinfo, request, entry) == 0 )
                {
                    return SNMP_ERR_NOERROR;
                }
                return SNMP_ERR_BADVALUE;
            }
        }
        return SNMP_ERR_NOERROR;
    }
    // TBD: only support GET/SET for now !!
    LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d \n", __func__, __LINE__);
    return SNMP_ERR_BADVALUE;
}

/*-------------------------------------------------------------------+
 * Function           : mox_snmp_init_entry
 *
 * Description        :
        register MIB entry into NetSNMP

+-------------------------------------------------------------------*/
ies_handle_t
mox_snmp_init_entry
(
    struct ies_auto_mibs_entry *entry_array,
    int                         entry_array_len
)
{
    int i, j;
    netsnmp_handler_registration *reginfo = NULL;
    struct ies_auto_mibs_entry   *entry   = NULL;
    
    
    for( i = 0; i < entry_array_len; i++ ) 
    {
        entry = NULL;
        entry = (struct ies_auto_mibs_entry *) malloc ( sizeof(*entry) );

        if ( entry == NULL )
        {
            LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", 
                __func__, __LINE__);

            return IES_ERR;
        }

        memset(entry, 0, sizeof(*entry));
        memcpy(entry, &entry_array[i], sizeof(*entry));

        entry->magic = IES_AUTO_MIBS_MAGIC_ENTRY;

        if ( IES_NOERR != ies_auto_mibs_setup_entry_flags(entry) )
        {
            LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n",
                __func__, __LINE__);

            return IES_ERR;
        }

        if ( moxaSnmpHandle_UtilMibEntryGenerateTableIndexEntry(entry) != 0 )
        {
            LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n",
                __func__, __LINE__);

            return IES_ERR;
        }

        if ( moxaSnmpHandle_UtilMibEntryRegisterToNetSNMP(entry) != 0 )
        {
            LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d, name=%s\r\n",
                __func__, __LINE__, entry->name);

            return IES_ERR;
        }
    }
    return IES_NOERR;
}

