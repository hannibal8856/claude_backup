void utilSNMP_dump_oid
(
    char *msg, 
    oid  *oid_buf,
    int oid_len
)
{

    int i = 0;
    char oid_str[IES_MAX_OID] = {0x0};
    int  oid_str_len          = 0;

    if ( NULL == msg ) 
    {
        msg = "utilSNMP_dump_oid";
    }
    LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "%s: oid len = \'%d\'\n", msg, oid_len);
    oid_str_len = 0;
    while ( i < oid_len ) 
    {
        ies_uri_snmp_sprintf((char *)oid_str, IES_MAX_OID, &oid_str_len, "%2.2d-", (unsigned int)oid_buf[i]);
        i++;
    }
    LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "%s\n", oid_str);
}


/*-------------------------------------------------------------------+
   Function Name   : utilSNMP_fgets
   Description     : 

   cos fgets will stop when there is '\n' in read string.
   but oid value like sysDesc will contain '\n' in oid value.
   so, we need to improve fgets to make it overcome the '\n' issue.

+-------------------------------------------------------------------*/
char * 
utilSNMP_fgets
(
    char                         *file_buf,
    int                           file_buf_size,
    FILE                         *fp,
    struct ies_auto_mibs_entry   *entry
)
{
#define MAX_READ_COUNT  (8)
    char tmp[IES_MAX_FILE_BUF] = {0x0};
    int  i = 0, len = 0;
    int  file_buf_idx = 0;

    if ( IES_NOERR == IES_SNMP_COMPARE_URI("stdsnmdb/sysDescr", entry->uri) )
    {
        for ( i = 0; i < MAX_READ_COUNT; i++ )
        {
            memset(tmp, 0, sizeof(tmp));
            if ( NULL == fgets(tmp, sizeof(tmp), fp) ) 
            {
                return NULL;
            }
            if ( '#' == tmp[0] )
            {
                continue;
            }
            len = strlen(tmp);
            len -= 2;
            if ( IES_NOERR != ies_uri_snmp_sprintf(file_buf, file_buf_size, &file_buf_idx, "%s", tmp ) )
            {
                return NULL;
            }
            if ( '\'' == tmp[len] )
            {
                return file_buf;
            }
        }
        return NULL;
    }

    return fgets(file_buf, file_buf_size, fp);

#undef MAX_READ_COUNT
}




/*-------------------------------------------------------------------+
 * Function           : utilSNMP_setOCT_to_bEntry
 *
 * Description        :
        

+-------------------------------------------------------------------*/
ies_handle_t 
utilSNMP_setOCT_to_bEntry
(
    netsnmp_request_info           *request,
    struct bits_entry              *bEntry,
    int                             maxBitEntry
)
{
#define CHECK_SNMP_BITS_ENABLE(index, indexBuff)   ( ((indexBuff)[(index)/8]) & ( 0x01 << ( 8 - (( index % 8 ) + 1)) ) )
    char *buf;
    int  i;

    if ( maxBitEntry > ( request->requestvb->val_len * 8 ) )
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
        return IES_ERR;
    }

    buf = request->requestvb->val.string;
    for ( i = 0; i < maxBitEntry; i++ ) 
    {
        if ( CHECK_SNMP_BITS_ENABLE(i, buf) ) 
        {
            bEntry[i].enable = IES_SNMP_BITS_ENABLE;
        } 
        else 
        {
            bEntry[i].enable = IES_SNMP_BITS_DISABLE;
        }
    }
    return IES_NOERR;
#undef CHECK_SNMP_BITS_ENABLE
}



