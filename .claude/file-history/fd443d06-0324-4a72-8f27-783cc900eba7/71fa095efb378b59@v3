/*-------------------------------------------------------------------+
 * Function           : utilSNMP_setOCT_to_hexValue
 *
 * Description        :
        

+-------------------------------------------------------------------*/
ies_handle_t 
utilSNMP_setOCT_to_hexValue
(
    netsnmp_request_info *request,
    char                 *oct_char_ret
)
{
    char                  oct_char, oct_char_tmp;

    memcpy(&oct_char, request->requestvb->val.string, 1);
    oct_char_tmp = 0;
    LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "%s line %d oct_char = %2x\n", __func__, __LINE__, oct_char);
    if ( 0x80 & oct_char ) 
    {
        oct_char_tmp |= 0x01;
    }
    if ( 0x40 & oct_char ) 
    {
        oct_char_tmp |= 0x02;
    }
    if ( 0x20 & oct_char ) 
    {
        oct_char_tmp |= 0x04;
    }
    if ( 0x10 & oct_char ) 
    {
        oct_char_tmp |= 0x08;
    }
    if ( 0x08 & oct_char ) 
    {
        oct_char_tmp |= 0x10;
    }
    if ( 0x04 & oct_char ) 
    {
        oct_char_tmp |= 0x20;
    }
    if ( 0x02 & oct_char ) 
    {
        oct_char_tmp |= 0x40;
    }
    if ( 0x01 & oct_char ) 
    {
        oct_char_tmp |= 0x80;
    }
    *oct_char_ret = oct_char_tmp;
    return IES_NOERR;
}

