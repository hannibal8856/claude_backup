/*-------------------------------------------------------------------+
   Function Name   : util_timeDiff
   Description     : 

   Note            : 
+-------------------------------------------------------------------*/
void util_timeDiff
(
    char            *msg,
    struct timespec *timeBefore, 
    struct timespec *timeAfter
) 
{
  struct timespec    timeTemp;
  if ((timeAfter->tv_nsec - timeBefore->tv_nsec) < 0 ) 
  {
    timeTemp.tv_sec  = timeAfter->tv_sec  - timeBefore->tv_sec  - 1 ;
    timeTemp.tv_nsec = timeAfter->tv_nsec - timeBefore->tv_nsec + 1000000000;
  } 
  else 
  {
    timeTemp.tv_sec  = timeAfter->tv_sec  - timeBefore->tv_sec;
    timeTemp.tv_nsec = timeAfter->tv_nsec - timeBefore->tv_nsec;
  }

  LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "%-20s:\'%02ld\'  \'%09ld\' \n", msg, 
    timeTemp.tv_sec , timeTemp.tv_nsec);

  return;
}


