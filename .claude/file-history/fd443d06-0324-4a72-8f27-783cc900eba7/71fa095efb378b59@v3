{

    ies_handle_t                 ret    = IES_ERR;
    ies_snmp_uri_port_interface  iftype = IES_SNMP_URI_PORT_PHYSICAL;
    int                          index;
    int                          minPortInDevice;
    int                          maxPortInDevice;
    int                          maxPortNumber;


    minPortInDevice = 1;
    maxPortInDevice = gMaxPortInDevice;
    maxPortNumber   = gMaxPortInDevice + gMaxPortChannel;
    index           = port;

    LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "%s line %d index = %d\n", __func__, __LINE__, index);
    if ( index >= minPortInDevice && index <= maxPortInDevice )
    {
        iftype = IES_SNMP_URI_PORT_PHYSICAL;
    }
    else 
    if ( index > maxPortInDevice && index <= maxPortNumber )
    {
        index  -= gMaxPortInDevice;
        iftype  = IES_SNMP_URI_PORT_PORTCHANNEL;
