typedef int             s32;
typedef unsigned int    u32;
typedef short           s16;
typedef unsigned short  u16;
typedef char            s8;
typedef unsigned char   u8;

typedef enum {
    IES_NOERR              =    0,
    IES_ERR                =  (-1),
    IES_ERR_NO_ENTRY       =   (2),
    IES_ERR_NOT_FOUND      =   (3),
    IES_ERR_NULL_ENTRY     =   (4),
    /* The GET was handed to an AgentX subagent; no local value file was
     * produced. Deliberately outside the SNMP_ERR_* range: the two value-file
     * generators in ies_auto_mibs.c return SNMP_ERR_BADVALUE through this same
     * type, so a value colliding with an SNMP error code would eventually be
     * read as "forwarded" and answer NOERROR with the varbind unfilled.
     * SNMP_ERR_* currently runs to 18 (SNMP_ERR_INCONSISTENTNAME). */
    IES_GET_FORWARDED      = (100),
} ies_handle_t;


#endif //_IES_COMMON_H_
