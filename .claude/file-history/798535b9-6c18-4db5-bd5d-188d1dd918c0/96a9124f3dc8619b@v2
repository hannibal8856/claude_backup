/**
 * @brief Reset specific port's data
 *
 * @param[in]   aPortNo               Specified logical port index (0-based).
 * @returns                           0 means success, other means fail
 */
static int _ResetFiberDdmStatus(const uint8_t aPortNo)
{
    struct FiberCheckPortStatus tmpStatus;
    struct FiberCheckStatus*  fiber_check_status_shm_ptr = NULL;
    int ret = FIBER_CHECK_ERR_DEFAULT;

    memset(&tmpStatus, 0, sizeof(struct FiberCheckPortStatus));

     // Wait semaphore
    LibUtil_SemWait(kSemCritSecSrvTypeFiberCheckStatusSrv);

    // Open share memory
    ret = LibUtil_ShmOpen(kShmSrvBlkTypeFiberCheckStatusSrv, (char**) &fiber_check_status_shm_ptr);
    if (ret != 0) {
        FIBER_CHECK_APP_ERR_MSG("Error: shm open failed, returned %d.\n", ret);
        // Release semaphore
        LibUtil_SemPost(kSemCritSecSrvTypeFiberCheckStatusSrv);
        return ret;
    }

    pthread_mutex_lock(&sFiberCheckStatusMntrMutex);
    memcpy(&gFiberCheckStatus.mPortStatus[aPortNo], &tmpStatus, sizeof(struct FiberCheckPortStatus));
    memcpy(fiber_check_status_shm_ptr, &gFiberCheckStatus, sizeof(struct FiberCheckStatus));
    pthread_mutex_unlock(&sFiberCheckStatusMntrMutex);

    // Detach shm segment
    ret = LibUtil_ShmClose((char*) fiber_check_status_shm_ptr);
    if (ret != 0) {
        FIBER_CHECK_APP_ERR_MSG("Error: shm close failed, returned %d.\n", ret);
        // Release semaphore
        LibUtil_SemPost(kSemCritSecSrvTypeFiberCheckStatusSrv);
        return ret;
    }

    // Release semaphore
    LibUtil_SemPost(kSemCritSecSrvTypeFiberCheckStatusSrv);

    return FIBER_CHECK_OK;
}

/**
 * @brief Access io to update real time ddm status
 *
 * @param[in]   aPortNo               Specified logical port index (0-based).
 * @param[in]   aFiberCheckPortStatus Target status structure to keep status
 * @returns                           0 means success, other means fail
 */
static int32_t _GetFiberDdmStatus(const uint8_t aPortNo, struct FiberCheckPortStatus * aFiberCheckPortStatus)
{
    int32_t ret = FIBER_CHECK_ERR_DEFAULT;
    struct FiberCheckStatus*  fiber_check_status_shm_ptr = NULL;
    struct FiberCheckPortStatus tmpStatus;
    struct FiberBaseInfo tmpBaseInfo;
    char port_str[20] = {0};
    uint32_t slot = 0;
    uint32_t module_port = 0;

    LibSystem_GetEthModulePortIdxByPortIdx(aPortNo, &module_port);
    LibSystem_GetEthModuleIdxByPortIdx(aPortNo, &slot);
    snprintf(port_str, 20, "%d/%d", slot + 1, module_port + 1);

    memset(&tmpBaseInfo, 0, sizeof(struct FiberBaseInfo));
    memset(&tmpStatus, 0, sizeof(struct FiberCheckPortStatus));

    ret = FiberCheckDdm_GetFiberBaseInfo(aPortNo, &tmpBaseInfo, false);
    if (FIBER_CHECK_OK != ret) {
        FIBER_CHECK_APP_ERR_MSG("port %d cannot get fiber base info, ret = %d\n",
                                      aPortNo, ret);
        goto SET_SHM;
    }

    //So far have valid A0h info
    tmpStatus.mValid = true;

    memcpy(tmpStatus.mModelName, tmpBaseInfo.mModelName, sizeof(tmpStatus.mModelName));
    memcpy(tmpStatus.mSerialNumber, tmpBaseInfo.mSerialNumber, sizeof(tmpStatus.mSerialNumber));
    tmpStatus.mWaveLength = tmpBaseInfo.mWaveLength;
    tmpStatus.mSupportDdm = tmpBaseInfo.mSupportDdm;

    if (!tmpStatus.mSupportDdm) {
        // FIBER_CHECK_APP_DEBUG_MSG("port %d, not support ddm\n",
        //                               aPortNo);
        goto SET_SHM;
    }

    ret = FiberCheckDdm_GetDdmTemperature(aPortNo, &tmpStatus.mTemperatureC);
    if (FIBER_CHECK_OK != ret) {
        FIBER_CHECK_APP_ERR_MSG("port %d get ddm temp error, ret = %d\n",
                                      aPortNo, ret);
        tmpStatus.mSupportDdm = false;
        goto SET_SHM;
    }

    ret = FiberCheckDdm_GetDdmVoltage(aPortNo, &tmpStatus.mVoltage);
    if (FIBER_CHECK_OK != ret) {
        FIBER_CHECK_APP_ERR_MSG("port %d get ddm volt error, ret = %d\n",
                                      aPortNo, ret);
        tmpStatus.mSupportDdm = false;
        goto SET_SHM;
    }

    //follow eCos logic
    if ((tmpStatus.mVoltage > (DDM_VOLTAGE_DEFAULT + DDM_VLOTAGE_TOLERANCE)) ||
        (tmpStatus.mVoltage < (DDM_VOLTAGE_DEFAULT - DDM_VLOTAGE_TOLERANCE))) {
        FIBER_CHECK_APP_ERR_MSG("port %d, voltage read error\n",
                                      aPortNo);
        tmpStatus.mVoltage = DDM_VOLTAGE_DEFAULT;
    }

    ret = FiberCheckDdm_GetDdmTxBiasCurrent_ma(aPortNo, &tmpStatus.mTxBiasCurrent);
    if (FIBER_CHECK_OK != ret) {
        FIBER_CHECK_APP_ERR_MSG("port %d, tx bias current read error ret = %d\n",
                                      aPortNo, ret);
        //Current fiber check does not present this info to user, do nothing
    }

    ret = FiberCheckDdm_GetDdmTxPower_dbm(aPortNo, &tmpStatus.mTxPower);
    if (FIBER_CHECK_OK != ret) {
        FIBER_CHECK_APP_ERR_MSG("port %d, tx power read error ret = %d\n",
                                      aPortNo, ret);
        tmpStatus.mSupportDdm = false;
        goto SET_SHM;
    }

    ret = FiberCheckDdm_GetDdmRxPower_dbm(aPortNo, &tmpStatus.mRxPower);
    if (FIBER_CHECK_OK != ret) {
        FIBER_CHECK_APP_ERR_MSG("port %d, rx power read error ret = %d\n",
                                      aPortNo, ret);
        tmpStatus.mSupportDdm = false;
        goto SET_SHM;
    }

    // FIBER_CHECK_APP_DEBUG_MSG("port %d %s Wavelen: %d SN: %s ddm:%d TxPwr: %f RxPwr: %f Volt: %f Current: %f Temperature: %f\n", aPortNo,
    //             tmpStatus.mModelName,
    //             tmpStatus.mWaveLength,
    //             tmpStatus.mSerialNumber,
    //             tmpStatus.mSupportDdm,
    //             tmpStatus.mTxPower,
    //             tmpStatus.mRxPower,
    //             tmpStatus.mVoltage,
    //             tmpStatus.mTxBiasCurrent,
    //             tmpStatus.mTemperatureC);
    LIBMOXADEBUGLOGNG_SYSLOG(port_str, FIBER_CHECK_STR_ID_FIBER_MONITOR_DUMP_CURRENT_FIBER_MODULE_INFO,
                             port_str, tmpStatus.mModelName, tmpStatus.mWaveLength, tmpStatus.mSerialNumber, tmpStatus.mTxPower,
                             tmpStatus.mRxPower, tmpStatus.mVoltage, tmpStatus.mTxBiasCurrent, tmpStatus.mTemperatureC);
SET_SHM:

    // Wait semaphore
    LibUtil_SemWait(kSemCritSecSrvTypeFiberCheckStatusSrv);

    // Open share memory
    ret = LibUtil_ShmOpen(kShmSrvBlkTypeFiberCheckStatusSrv, (char**) &fiber_check_status_shm_ptr);
    if (ret != 0) {
        FIBER_CHECK_APP_ERR_MSG("Error: shm open failed, returned %d.\n", ret);
        // Release semaphore
        LibUtil_SemPost(kSemCritSecSrvTypeFiberCheckStatusSrv);
        return ret;
    }

    pthread_mutex_lock(&sFiberCheckStatusMntrMutex);
    memcpy(&gFiberCheckStatus.mPortStatus[aPortNo], &tmpStatus, sizeof(struct FiberCheckPortStatus));
    memcpy(fiber_check_status_shm_ptr, &gFiberCheckStatus, sizeof(struct FiberCheckStatus));
    pthread_mutex_unlock(&sFiberCheckStatusMntrMutex);

    // Detach shm segment
    ret = LibUtil_ShmClose((char*) fiber_check_status_shm_ptr);
    if (ret != 0) {
        FIBER_CHECK_APP_ERR_MSG("Error: shm close failed, returned %d.\n", ret);
        // Release semaphore
        LibUtil_SemPost(kSemCritSecSrvTypeFiberCheckStatusSrv);
        return ret;
    }

    // Release semaphore
    LibUtil_SemPost(kSemCritSecSrvTypeFiberCheckStatusSrv);

    memcpy(aFiberCheckPortStatus, &tmpStatus, sizeof(struct FiberCheckPortStatus));

    return FIBER_CHECK_OK;
}

/**
 * @brief Init parameters of Fiber Check subtask status monitor"
 *
 * @param[in]  aSysPara         Parameters come from parent process
 * @returns                     void
 */
static void _InitSystemParameter(const struct FiberCheckModelParameter* aSysPara)
{
    int32_t ret = -1;


    //set static global parameters for easier local use
    if(aSysPara != NULL){
        MAX_PORT_NUM = aSysPara->mMaxPortNum;
        MAX_MODULE_NUM = aSysPara->mMaxModuleNum;
        MAX_POWER_MODULE_NUM = aSysPara->mMaxPowerModuleNum;
    }else{
        FIBER_CHECK_APP_ERR_MSG("system parameters init fail\n");
    }

    //Init global status. Only the DDM part is cleared here: the main task fills
    //in mIsPortLinkUp in parallel with this thread starting up.
    pthread_mutex_lock(&sFiberCheckStatusMntrMutex);
    memset(&gFiberCheckStatus.mPortStatus, 0 , sizeof(gFiberCheckStatus.mPortStatus));
    pthread_mutex_unlock(&sFiberCheckStatusMntrMutex);

    return;
}

