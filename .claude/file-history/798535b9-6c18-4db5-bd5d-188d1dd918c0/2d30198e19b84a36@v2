/**
 * @brief Get Uri
 *
 * @param[in]  aPortNo          0 based virtual port
 * @returns                     0 means success, other means fail
 */
static int _GetUri(const char *aUri, char *aData, uint32_t aDataLen)
{
    JSON_Value *return_data = NULL;
    char *json_str = NULL;
    int32_t result = FIBER_CHECK_ERR_DEFAULT;
    struct LibFrameworkUri_Handle *handle = NULL;
    uint32_t str_len = 0;

    handle = LibFrameworkUri_CreateHandle("127.0.0.1", 80);
    if (handle == NULL) {
        FIBER_CHECK_APP_ERR_MSG("Create handle error\n");
        return FIBER_CHECK_ERR_DEFAULT;
    }
    result = LibFrameworkUri_GetUri(handle, aUri, sUriToken, &return_data);

    if (result != 0 || !return_data) {
        FIBER_CHECK_APP_ERR_MSG("Get %s error\n", aUri);
        json_value_free(return_data);
        return_data = NULL;
        LibFrameworkUri_ReleaseHandle(handle);
        return FIBER_CHECK_ERR_DEFAULT;
    }

    json_str = json_serialize_to_string(return_data);

    str_len = strlen(json_str);

    strncpy(aData, json_str, str_len > aDataLen ? aDataLen : str_len);

    json_free_serialized_string(json_str);

    json_value_free(return_data);
    return_data = NULL;

    LibFrameworkUri_ReleaseHandle(handle);

    return FIBER_CHECK_OK;
}

/**
 * @brief Check if port is linkup
 *
 * @param[in]  aPortNo          0 based virtual port
 * @returns                     void
 */
static bool _IsPortLinkUp(const uint8_t aPortNo)
{
    char uri[128] = {0};
    char uri_result[20] = {0};

    snprintf(uri, 128, "/api/v1/status/portStatus/portTable/%d/linkStatus", aPortNo);
    _GetUri(uri, uri_result, 20);
    //linkstatus: up(1), down(2), testing(3), unknown(4), dormant(5), notPresent(6), lowerLayerDown(7)
    if (strncmp (uri_result, "1", strlen("1")) != 0 ) {
        return false;
    }

    return true;
}

