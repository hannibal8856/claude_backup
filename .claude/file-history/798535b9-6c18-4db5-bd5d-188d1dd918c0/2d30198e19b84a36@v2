/**
 * @brief Register system signals and signal handlers
 *
 * @returns void
 */
static void _InitSystemSignal(void)
{
    struct sigaction action;

    action.sa_handler = _SignalHandler;
    sigemptyset (&action.sa_mask);
    action.sa_flags = 0;

    sigaction(SIGTERM, &action, NULL); /* catch SIGTERM signal */
}

