/**
 * @brief Convert virutal port to user port
 * @param[in]  vport            virtual port (0 based)
 * @param[in]  interface_str    user port string
 * @returns                     void
 */
static int32_t _ConvertVport2Interface(const int32_t vport, unsigned char* interface_str)
{
    uint32_t module_index = 0;
    uint32_t module_port_index = 0;
    int32_t ret = -1;

    if (interface_str == NULL) {
        return ret;
    }

    ret = LibSystem_GetCliModuleIdxByPortIdx(vport, &module_index);
    if (ret != LIB_SYSTEM_RET_SUCCESS) {
        return ret;
    }
    ret = LibSystem_GetCliModulePortIdxByPortIdx(vport, &module_port_index);
    if (ret != LIB_SYSTEM_RET_SUCCESS) {
        return ret;
    }

	uint32_t moduleId = 0;
			
    LibSystem_GetEthModuleId(module_index, &moduleId);
			
    if (moduleId == kLm7000HPhr) {
        sprintf(interface_str, "%u/%c", module_index+1, module_port_index+'A');
    }
    else {
        sprintf(interface_str, "%u/%u", module_index+1, module_port_index+1);
    }

    return ret;
}

/**
 * @brief Init token for uri
 *
 * @returns                     void
 */
static void _InitToken(void)
{
    char security_token_file[FIBER_CHECK_TOKEN_PATH_LEN]  = {0};

    snprintf(security_token_file, sizeof(security_token_file),
             "%s", FIBER_CHECKL_TOKEN_FILE);

    unlink(FIBER_CHECKL_TOKEN_FILE);

    if (LibUtil_CreateToken("system", "fiber_check", security_token_file) != 0) {
        FIBER_CHECK_APP_ERR_MSG("Token init fail\n");
        return;
    }

    return;
}

/**
 * @brief Get token for uri
 *
 * @returns                     void
 */
static void _GetToken(void)
{
    FILE *fp  = NULL;
    char security_token_file[FIBER_CHECK_TOKEN_PATH_LEN]  = {0};

    snprintf(security_token_file, sizeof(security_token_file),
             "%s", FIBER_CHECKL_TOKEN_FILE);

    fp = fopen(security_token_file, "r");
    if (fp == NULL) {
        FIBER_CHECK_APP_ERR_MSG("Cannot open token fail\n");
        return;
    }

    if (fgets(sUriToken, sizeof(sUriToken), fp) == NULL) {
        fclose(fp);
        FIBER_CHECK_APP_ERR_MSG("Cannot get token content\n");
        return;
    }

    fclose(fp);
    return;
}


