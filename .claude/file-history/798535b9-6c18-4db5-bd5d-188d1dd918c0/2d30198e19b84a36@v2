static void _CreateFiberCheckDirectories(void)
{
    int ret = 0;

    ret = mkdir("/moxa/storage/fiber_check", 0755);
    ret = mkdir("/moxa/run/fiber_check", 0755);
    if (ret == 0) {
        //first time run fiber check service
        FIBER_CHECK_APP_DEBUG_MSG("fiber check directories first create\n");
