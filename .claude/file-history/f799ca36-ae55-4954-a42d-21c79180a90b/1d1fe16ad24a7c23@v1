clean:


test:

${BUILD_PATH}:
	mkdir -p $@

# app
${BUILD_PATH}/config_moxa_snmp_control: ${BUILD_PATH} \
		${BUILD_PATH}/config_moxa_snmp_control.o
	${CC} -lparson -lmoxa_util -lmoxa_system -lmoxa_encrypt -o $@ $(filter %.o,$^)

${BUILD_PATH}/config_moxa_snmp_control.o: ${BUILD_PATH}\
		${APP_PATH}/config_moxa_snmp_control.c
	${CC} ${CFLAGS} ${MOXA_CMTFLAGS} -c -fPIC -o $@ $(filter %.c,$^)

rust_clippy_scan:
ifeq ("${RUST_CLIPPY_SCAN_CONFIG}", "true")
	${SILENCE}rm -rf rust_clippy_scan_result
	${SILENCE}mkdir -p rust_clippy_scan_result
	${SILENCE}cd framework && cargo clippy --release --target=${TARGET} --target-dir=${RUST_TARGET_DIR} --features ${CARGO_FEATURES}
	${SILENCE}cd framework && cargo clippy --release --target=${TARGET} --target-dir=${RUST_TARGET_DIR} --features ${CARGO_FEATURES} --message-format=json > ${PWD}/rust_clippy_scan_result/${APP_NAME}.json
endif
