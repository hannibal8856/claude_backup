	${SILENCE}mkdir -m 740 -p ${DESTDIR}/${MOXA_CONFIG_CHANGE_TARGET_WANTS_PATH}
	${SILENCE}ln -fs /usr/lib/systemd/system/config_moxa_snmp.service ${DESTDIR}/${MOXA_CONFIG_CHANGE_TARGET_WANTS_PATH}

	# app - script
	${SILENCE}mkdir -p ${DESTDIR}/${PROJECT_PATH}
	${SILENCE}install -m 755 ${APP_SCRIPT_PATH}/init_snmpd.sh ${DESTDIR}/${PROJECT_PATH}

