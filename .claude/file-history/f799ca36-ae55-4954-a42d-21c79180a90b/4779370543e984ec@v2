/* Plan C: with AgentX, SNMP ifAdminStatus SET lands here (not the framework
 * ies-auto-mibs path), so mirror it into the Moxa config layer via the
 * existing mxcfg helper (same one TurboRing/loop-protection already use). */
extern INT4 PortSetAdminStatus2MxCfgAsync (UINT4 u4IfIndex, UINT4 u4AdminStatus);

VOID
RegisterIFMIB ()
{
    SNMPRegisterMibWithLock (&ifmibOID, &ifmibEntry, CfaLock, CfaUnlock,
                             SNMP_MSR_TGR_TRUE);
    SNMPAddSysorEntry (&ifmibOID, (const UINT1 *) "ifMIB");
}

