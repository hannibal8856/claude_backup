INT4
IfAdminStatusSet (tSnmpIndex * pMultiIndex, tRetVal * pMultiData)
{
    INT4 i4RetVal;

    i4RetVal = nmhSetIfAdminStatus (pMultiIndex->pIndex[0].i4_SLongValue,
                                    pMultiData->i4_SLongValue);

    /* Plan C: push the SNMP-originated admin-status change into the Moxa
     * config layer. Async (own detached thread) so the AgentX SET handler is
     * not blocked on the HTTP PATCH round-trip. ifAdminStatus up(1)/down(2)
     * map directly to CFA_IF_UP/CFA_IF_DOWN; PortSetAdminStatus2MxCfg builds
     * the portTable URI as (ifIndex-1) and handles physical ports. */
    if (i4RetVal == SNMP_SUCCESS)
    {
        PortSetAdminStatus2MxCfgAsync (pMultiIndex->pIndex[0].i4_SLongValue,
                                       pMultiData->i4_SLongValue);
    }

    return i4RetVal;
}

