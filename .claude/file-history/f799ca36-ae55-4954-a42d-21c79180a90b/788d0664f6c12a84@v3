/* Process flow

    [main process]
          .
          .
          .
        fork()     [new process]
          A
         / \
        |   \
        |    \___  exec()
    waitpid()        .
       z             .
       z             . (running)
       z             .
       z           Done!
       z             |
       +----<----<---+
       |
       V
   (continue)

*/

/**
 * @brief Execute shell command by fork() and exec().
 *
 * @param[out]    aRet          Return code of shell command.
 * @param[out]    aOutput       STDOUT message buffer.
 * @param[in]     aOutputLen    Max STDOUT message size to be read.
 * @param[in]     aFormat       Commands. (printf format string)
 * @returns       0 means success, others fail.
 */
int32_t LibUtil_ExecShCmd(int32_t *aRet,
                          char *aOutput,
                          const int32_t aOutputLen,
                          const char *aFormat, ...)
{
    pid_t pid;
    int32_t ret = -1;
    struct timespec ts_start, ts_end;

    clock_gettime(CLOCK_MONOTONIC, &ts_start);

    /* Parse shell command from printf format string */
    va_list ap;
    char sh_cmd[LIB_UTIL_MAX_CMD_LEN];
    int32_t len = 0;

    va_start(ap, aFormat);
    len = vsnprintf(sh_cmd, LIB_UTIL_MAX_CMD_LEN, aFormat, ap);
    va_end(ap);

    if (sh_cmd == NULL) {
        LibUtil_DbgTrace(kDbgFlgCtrlBlk,
                        "Error in %s:%d.\n", __func__, __LINE__);
        return -1;
    }

    /* Using pipe to do IPC,
       pipe_fd[0] is READ, pipe_fd[1] is WRITE */
    int32_t pipe_fd[2];

    if (pipe(pipe_fd) < 0) {
        LibUtil_DbgTrace(kDbgFlgCtrlBlk,
                        "pipe() error in %s:%d.\n", __func__, __LINE__);
        return -1;
    }

    /* Fork another process to execute input commands */
    pid = fork();

    if (pid < 0) {
        LibUtil_DbgTrace(kDbgFlgCtrlBlk,
                        "fork() error in %s:%d.\n", __func__, __LINE__);
        /* Close READ interface */
        close(pipe_fd[0]);

        /* Close WRITE interface */
        close(pipe_fd[1]);

        return -1;
    } else if (pid == 0) {
        /* Close READ interface */
        close(pipe_fd[0]);

        /* Direct pipe_fd[1] to STDOUT */
        if (pipe_fd[1] != STDOUT_FILENO) {
            if (dup2(pipe_fd[1], STDOUT_FILENO) != STDOUT_FILENO) {
                LibUtil_DbgTrace(kDbgFlgCtrlBlk,
                                "dup2() error in %s:%d.\n",
                                 __func__, __LINE__);
                return -1;
            }

            /* Close WRITE interface */
            close(pipe_fd[1]);
        }

        /* Execute command */
        execl("/bin/sh", "sh", "-c", sh_cmd, NULL);

        /* Let child process return "command not found" */
        _exit(127);
    } else {
        /* Close WRITE interface */
        close(pipe_fd[1]);

        /* Read STDOUT message from READ interface */
        if (aOutput != NULL) {
            int32_t read_count = 0;
            read_count = read(pipe_fd[0], aOutput, aOutputLen);

            /* Add string terminator '\0' to the end */
            aOutput[read_count] = '\0';
        }

        /* Wait child process */
        int32_t rc = -1;
        while (waitpid(pid, &rc, 0) < 0) {
            /* check if waitpid was interrupted by a signal */
            if (errno != EINTR) {
                close(pipe_fd[0]);

                /* Update return code to output */
                if (aRet != NULL) {
                    *aRet = WEXITSTATUS(rc);
                }
                LibUtil_DbgTrace(kDbgFlgCtrlBlk,
                                "waitpid() error in %s:%d.\n",
                                __func__, __LINE__);
                return -1;
            }
            /* waitpid() was interrupred by a signal */
            LibUtil_DbgTrace(kDbgFlgCtrlBlk,
                            "Error in %s:%d.\n", __func__, __LINE__);
        }

        close(pipe_fd[0]);

        /* Update return code to output */
        if (aRet != NULL) {
            *aRet = WEXITSTATUS(rc);
        }
    }

    clock_gettime(CLOCK_MONOTONIC, &ts_end);
    {
        static FILE *gExecShCmdLogFp = NULL;
        if (gExecShCmdLogFp == NULL) {
            gExecShCmdLogFp = fopen("/run/util_debug/exec_sh_cmd_time", "a");
            if (gExecShCmdLogFp != NULL) {
                setvbuf(gExecShCmdLogFp, NULL, _IOLBF, 0);
            }
        }
        if (gExecShCmdLogFp != NULL) {
            long long elapsed_ns =
                ((long long)ts_end.tv_sec  - (long long)ts_start.tv_sec)  * 1000000000LL
              + ((long long)ts_end.tv_nsec - (long long)ts_start.tv_nsec);
            fprintf(gExecShCmdLogFp,
                "pid=%d ts_start=%lld.%09ld s ts_end=%lld.%09ld s "
                "elapsed=%lld.%06lld ms cmd=%s\n",
                (int)getpid(),
                (long long)ts_start.tv_sec, ts_start.tv_nsec,
                (long long)ts_end.tv_sec,   ts_end.tv_nsec,
                elapsed_ns / 1000000LL,
                (elapsed_ns / 1000LL) % 1000LL,
                sh_cmd);
        }
    }

    return 0;
}

int32_t LibUtil_CreateToken(const char *username,
                            const char *service,
                            const char *security_token_file)
{
    return (LibUtil_ExecShCmd(NULL, NULL, 0,
        "/usr/sbin/app_moxa_token_module"
        " -c -u %s@moxa^service -r admin -s %s -i 127.0.0.1 > %s",
        username, service, security_token_file));
}
