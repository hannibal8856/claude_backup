add_h2('4.2 組件 2:ies_auto_mibs.c::mox_snmp_init_entry 內的 reader + skip')
add_para('位置:3rdparty_net_snmp/ies-auto-mibs/ies_auto_mibs.c,新增 ~85 行')
add_code('''#define AGENTX_OWNED_LIST_FILE   "/etc/moxa/netsnmp/agentx_owned.list"
#define AGENTX_OWNED_MAX         (32)
#define AGENTX_OWNED_PREFIX_LEN  (64)

static char gAgentXOwnedPrefix[AGENTX_OWNED_MAX][AGENTX_OWNED_PREFIX_LEN];
static int  gAgentXOwnedCount  = 0;
static int  gAgentXOwnedLoaded = 0;

static void mox_snmp_load_agentx_owned_list(void) {
    /* 啟動時讀一次,parse '#' 註解、trim whitespace、塞 array */
    /* 找不到檔 → 靜默回 empty(legacy 行為,全部 register)*/
}

static int mox_snmp_entry_is_agentx_owned(struct ies_auto_mibs_entry *entry) {
    /* 兩個 filter,缺一不可: */
    if (entry->mode != HANDLER_CAN_RONLY)
        return 0;                /* RW 永遠留本地 → SET 走 framework */

    for (i = 0; i < gAgentXOwnedCount; i++) {
        if (strncmp(entry->uri, gAgentXOwnedPrefix[i],
                    strlen(gAgentXOwnedPrefix[i])) == 0)
            return 1;
    }
    return 0;
}

/* 插進 mox_snmp_init_entry 的 register loop */
if (!gAgentXOwnedLoaded)
    mox_snmp_load_agentx_owned_list();

if (mox_snmp_entry_is_agentx_owned(entry)) {
    LibUtil_DbgTrace(...);
    free(entry); entry = NULL;
    continue;       /* 不呼 netsnmp_register_*,讓 master 路由 */
}''')

