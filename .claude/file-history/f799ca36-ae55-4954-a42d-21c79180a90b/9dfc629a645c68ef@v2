add_h1('6. Runtime 資料流')

add_h2('6.1 GET ifInOctets.1(RO,走 AgentX)')
add_code('''NMS → snmpd master (port 161)
   ↓ longest-prefix-match in registration tree
   ↓
   ifInOctets (.1.3.6.1.2.1.2.2.1.10) ──
       ies-auto-mibs 沒 register (mox_snmp_init_entry skip 過)
   ifTable subtree (.1.3.6.1.2.1.2.2) ──
       ISS subagent register 過
   ↓ master 選 ISS (longest-prefix match,no closer local handler)
   ↓ AgentX GetNext-PDU 透過 TCP:705 送 ISS
ISS subagent (snxmain.c)
   ↓ SnmpMain thread 處理
   ↓ gpMibReg[oid].GetHandler → ifInOctets internal getter
   ↓ AgentX Response-PDU 回 master
   ↓ snmpd 包成 SNMP Response 回 NMS

→ 完全繞過 mox_snmp_handle_entry + URI hook + framework REST
→ 延遲從 ~7 ms 降到 ~3 ms''')

add_h2('6.2 SET ifAdminStatus.1(RW,不動)')
add_code('''NMS → snmpd master
   ↓ longest-prefix-match → 命中本地 ies-auto-mibs registration
     (深度 11,本地 entry RW 沒被 skip)
   ↓ 比 ISS 註冊的 prefix (深度 6) 深 → 本地贏
   ↓ mox_snmp_handle_entry → mox_snmp_flask_handle_entry_set
   ↓ UtilCfgPatchURIConfig → LibFrameworkUri_PatchUri
   ↓ HTTP 80 → nginx → actix-web 9759 → framework
   ↓ JSON 寫 /moxa/run/flask-moxa-config-layer/RunningConfig/
   ↓ 回 SNMP Response

→ 維持 framework SET source-of-truth
→ SET 路徑完全沒被動到''')

