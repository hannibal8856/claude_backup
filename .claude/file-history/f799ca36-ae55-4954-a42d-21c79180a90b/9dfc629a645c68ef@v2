def add_h1(text): return doc.add_heading(text, level=1)
def add_h2(text): return doc.add_heading(text, level=2)
def add_h3(text): return doc.add_heading(text, level=3)


def add_para(text, bold=False, italic=False):
    p = doc.add_paragraph()
    run = p.add_run(text)
