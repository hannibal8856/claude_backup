/*
 * lib_moxa_ies_auto_mibs — reuse the canonical ies-auto-mibs entry arrays.
 *
 * Single source of truth: instead of hand-copying OID<->URI rows, #include the
 * same net_*.h that 3rdparty_net_snmp/ies-auto-mibs compiles, and convert each
 * `struct ies_auto_mibs_entry` to our `struct ies_map_entry` at first use. The
 * framework subagent then serves whatever groups are listed in g_reuse_srcs[]
 * (and whose MOX_SNMP_INIT_ENTRY is commented out on the snmpd side).
 *
 * This file is the ONLY one that pulls in the ies-auto-mibs headers + net-snmp;
 * lookup.c / mapping_data.c stay dependency-free. Build must pass the same
 * product -D flags as 3rdparty_net_snmp so the #if entry set matches.
 *
 * PoC scope: scalars only (uri_index == "0"); tables (uri_index != "0") are
 * skipped until table handling lands.
 *
 * mod_uri: a group whose MIB URI (net_*.h `.uri`) differs from the framework
 * config-layer path carries a per-group `ies_auto_mibs_setup_entry_flags_*` that
 * populates entry->mod_uri exactly as the in-master path does. When a group has
 * one (the `setup` field below), we call it and use `mod_uri[0] ? mod_uri : uri`,
 * so the config path matches ies-auto-mibs byte-for-byte. Groups whose URI == the
 * config path pass NULL.
 */
#include <net-snmp/net-snmp-config.h>
#include <net-snmp/net-snmp-includes.h>
#include <net-snmp/agent/net-snmp-agent-includes.h>   /* HANDLER_CAN_* */

#include "ies_auto_mibs_handle.h"   /* struct ies_auto_mibs_entry, SNMP_DATA_TYPE_* */
#include "net_mx_event_port.h"      /* mx_event_port_MibEntry[] */
#include "net_mx_event_general.h"   /* mx_event_general_MibEntry[] */
#include "net_mx_event_switching.h" /* mx_event_switching_MibEntry[] */
#include "net_mx_event_poe.h"       /* mx_event_poe_MibEntry[] */
#include "net_mx_email.h"           /* mx_email_MibEntry[] */
#include "net_mxGeneralInfo.h"      /* mx_generalInfomation_MibEntry[] */
#include "net_mxLoginPolicy.h"      /* mx_LoginPolicy_MibEntry[] */
#include "net_mxPasswordPolicy.h"   /* mx_PasswordPolicy_MibEntry[] */
#include "net_mx_RMON.h"            /* mx_RMON_MibEntry[] */
#if defined(INCLUDE_MOXA_L3)
#include "net_mx_event_routing.h"   /* mx_event_routing_MibEntry[] */
#endif
#if defined(MOXA_TRACKING)
#include "net_mx_event_tracking.h"  /* mx_event_tracking_MibEntry[] */
#endif
#include "net_mx_turboring_v2.h"    /* mxTurboRingV2_MibEntry[] */

/* Per-group setup fn that populates mod_uri/flags (same source the in-master
 * ies_auto_mibs_setup.c calls). Included as source, like ies_auto_mibs_setup.c. */
#include "ies_auto_mibs_setup_net_mx_turboring_v2.c"

#include "lib_moxa_ies_auto_mibs.h"

#include "lib_moxa_system_product_info_api.h"   /* LibSystem_GetMaxPortNumInSystem */

#include <stdint.h>
#include <stdlib.h>
#include <string.h>

/* Per-entry setup that fills mod_uri/flags, matching the in-master path. */
typedef ies_handle_t (*reuse_setup_fn)(struct ies_auto_mibs_entry *entry);

/* Groups migrated to the framework subagent. Add { <array>, ARRAY_LEN, <setup> }
 * here as each group's MOX_SNMP_INIT_ENTRY is commented out in
 * ies_auto_mibs_setup.c. `setup` is NULL when the group's URI == config path. */
struct reuse_src {
    struct ies_auto_mibs_entry *arr;
    size_t                      count;
    reuse_setup_fn              setup;
};

#define REUSE_SRC(arr, setup) { (arr), sizeof(arr) / sizeof((arr)[0]), (setup) }

static struct reuse_src g_reuse_srcs[] = {
    REUSE_SRC(mx_event_port_MibEntry,       NULL),
    REUSE_SRC(mx_event_general_MibEntry,    NULL),
    REUSE_SRC(mx_event_switching_MibEntry,  NULL),
    REUSE_SRC(mx_event_poe_MibEntry,        NULL),
    REUSE_SRC(mx_email_MibEntry,            NULL),
    REUSE_SRC(mx_generalInfomation_MibEntry, NULL),
    REUSE_SRC(mx_LoginPolicy_MibEntry,      NULL),
    REUSE_SRC(mx_PasswordPolicy_MibEntry,   NULL),
    REUSE_SRC(mx_RMON_MibEntry,             NULL),
#if defined(INCLUDE_MOXA_L3)
    REUSE_SRC(mx_event_routing_MibEntry,    NULL),
#endif
#if defined(MOXA_TRACKING)
    REUSE_SRC(mx_event_tracking_MibEntry,   NULL),
#endif
    REUSE_SRC(mxTurboRingV2_MibEntry,
              ies_auto_mibs_setup_entry_flags_mx_turboring_v2),
};

static struct ies_map_entry *s_table = NULL;
static size_t                s_len   = 0;

/* A portsPbmp table column: uri_index != "0" and the config path is a per-port
 * boolean array. Two columns: "portIndex" (value = port) and the value column
 * (value = array[port-1] as TruthValue). Other tables stay skipped. */
static int
is_ports_pbmp(const struct ies_auto_mibs_entry *e)
{
    return (strcmp(e->uri_index, "0") != 0) &&
           (strstr(e->uri, "portsPbmp") != NULL);
}

/* 1 = index column (value = port), 2 = value column (config bool array). */
static int
ports_pbmp_col(const struct ies_auto_mibs_entry *e)
{
    return (strcmp(e->uri_index, "portIndex") == 0) ? 1 : 2;
}

/* Physical port count = length of the portsPbmp config array. 0 disables table
 * expansion (falls back to skipping, as before). */
static uint32_t
system_port_num(void)
{
    uint32_t n = 0;
    if (LibSystem_GetMaxPortNumInSystem(&n) != 0 || n == 0 || n > 256)
    {
        return 0;
    }
    return n;
}

/* Fill one row: instance OID = e->oid_list + `suffix` (.0 for a scalar, or the
 * port number for a table column). Returns 0 on success. */
static int
emit_row(struct ies_map_entry *row, const struct ies_auto_mibs_entry *e,
         moxa_oid suffix, const char *uri, int table_col)
{
    moxa_oid *o;
    int j;

    o = (moxa_oid *) malloc((e->oid_len + 1) * sizeof(moxa_oid));
    if (o == NULL)
    {
        return -1;
    }
    for (j = 0; j < e->oid_len; j++)
    {
        o[j] = (moxa_oid) e->oid_list[j];
    }
    o[e->oid_len] = suffix;

    row->oid       = o;
    row->oid_len   = (size_t) (e->oid_len + 1);
    row->uri       = uri;   /* static storage; lives for program */
    row->uri_index = "";
    row->val_type  = e->val_type;   /* SNMP_DATA_TYPE_* == ASN tag */
    row->mode      = e->mode;
    row->table_col = table_col;
    return 0;
}

static void
build_reuse_table(void)
{
    size_t   nsrc = sizeof(g_reuse_srcs) / sizeof(g_reuse_srcs[0]);
    size_t   s, i, n, k;
    uint32_t port_num = system_port_num();

    if (s_table != NULL)
    {
        return;
    }

    /* Count: scalars (1 each) + portsPbmp columns (port_num each). */
    n = 0;
    for (s = 0; s < nsrc; s++)
    {
        for (i = 0; i < g_reuse_srcs[s].count; i++)
        {
            struct ies_auto_mibs_entry *e = &g_reuse_srcs[s].arr[i];

            if (e->iss_build != 0)
            {
                continue;   /* iss_build==1 stays with ISS; serve iss0 only */
            }
            if (strcmp(e->uri_index, "0") == 0)
            {
                n++;
            }
            else if (port_num > 0 && is_ports_pbmp(e))
            {
                n += port_num;
            }
        }
    }

    s_table = (struct ies_map_entry *) calloc(n, sizeof(*s_table));
    if (s_table == NULL)
    {
        return;
    }

    k = 0;
    for (s = 0; s < nsrc; s++)
    {
        for (i = 0; i < g_reuse_srcs[s].count; i++)
        {
            struct ies_auto_mibs_entry *e = &g_reuse_srcs[s].arr[i];
            const char *uri;
            int         is_scalar;

            if (e->iss_build != 0)
            {
                continue;   /* iss_build==1 stays with ISS; serve iss0 only */
            }
            is_scalar = (strcmp(e->uri_index, "0") == 0);

            if (!is_scalar && !(port_num > 0 && is_ports_pbmp(e)))
            {
                continue;   /* other tables still skipped */
            }

            /* Populate mod_uri/flags in-place (our own array copy) so the URI we
             * store below matches the config-layer path the in-master path uses.
             * No-op for groups without a setup fn (URI == config path). */
            if (g_reuse_srcs[s].setup != NULL)
            {
                g_reuse_srcs[s].setup(e);
            }
            uri = e->mod_uri[0] ? e->mod_uri : e->uri;

            if (is_scalar)
            {
                if (emit_row(&s_table[k], e, 0, uri, 0) == 0)
                {
                    k++;
                }
            }
            else
            {
                int      col = ports_pbmp_col(e);
                uint32_t p;

                for (p = 1; p <= port_num; p++)
                {
                    if (emit_row(&s_table[k], e, (moxa_oid) p, uri, col) == 0)
                    {
                        k++;
                    }
                }
            }
        }
    }
    s_len = k;
}

const struct ies_map_entry *
ies_map_reuse_table(size_t *len)
{
    build_reuse_table();
    if (len != NULL)
    {
        *len = s_len;
    }
    return s_table;
}
