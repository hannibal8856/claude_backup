(
    u8           *iputURI,
    u8           *oputURI,
    u8           *iputFile,
    u8           *oputFile
)
{
    
    char          uri_col_buf[IES_MAX_URI_COL][IES_MAX_URI_COL_LEN] = {0x0};
    int           uri_col_idx                                       =  0;
    FILE         *iput_fp                                           = NULL;
    FILE         *oput_fp                                           = NULL;
    char          iput_buf[IES_MAX_FILE]                            = {0x0};
