/*
 * lib_moxa_snmp_agentx — FRR-style AgentX subagent wrapper on net-snmp.
 *
 * Encapsulates the net-snmp boilerplate (AGENT_ROLE / AGENT_X_SOCKET / init_agent
 * / init_snmp / select-process loop) so any process can act as an AgentX subagent
 * connecting to the snmpd master at tcp:127.0.0.1:705.
 *
 * GET/SET only — no trap API. Traps are out-of-band (app events -> MQTT ->
 * trap_notification -> /bin/snmptrap).
 *
 * Clean-room; design reference only was FRR lib/agentx.c (not copied).
 */
#ifndef LIB_MOXA_SNMP_AGENTX_H
#define LIB_MOXA_SNMP_AGENTX_H

#include <net-snmp/net-snmp-config.h>
#include <net-snmp/net-snmp-includes.h>
#include <net-snmp/agent/net-snmp-agent-includes.h>

#ifdef __cplusplus
extern "C" {
#endif

/* Exported even though the library builds with -fvisibility=hidden. */
#define MOXA_AGENTX_API __attribute__((visibility("default")))

/* Initialize the calling process as an AgentX subagent (connects to the snmpd
 * master at tcp:127.0.0.1:705). Call once before any MoxaAgentX_Register*.
 * Returns 0 on success. */
MOXA_AGENTX_API int  MoxaAgentX_Init(const char *daemon_name);

/* Register one scalar OID with a net-snmp node handler.
 * mode = HANDLER_CAN_RONLY / HANDLER_CAN_RWRITE. Returns MIB_REGISTERED_OK (0)
 * on success. */
MOXA_AGENTX_API int  MoxaAgentX_RegisterScalar(const char *descr,
                                               const oid *o, size_t olen,
                                               int mode,
                                               Netsnmp_Node_Handler *handler);

/* Register a read-only integer scalar instance backed by an internal value.
 * B0 connectivity test only; the real config GET handlers come in a later task.
 * `o`/`olen` is the full instance OID (e.g. ...99.1.0). Returns 0 on success. */
MOXA_AGENTX_API int  MoxaAgentX_RegisterTestInt(const char *descr,
                                                const oid *o, size_t olen,
                                                long value);

/* Register an exact-instance OID (full OID incl. the trailing .0) served by
 * `handler` (mirrors the dlmod's netsnmp_register_instance). mode =
 * HANDLER_CAN_RONLY / HANDLER_CAN_RWRITE. Returns MIB_REGISTERED_OK (0). */
MOXA_AGENTX_API int  MoxaAgentX_RegisterInstance(const char *descr,
                                                 const oid *o, size_t olen,
                                                 int mode,
                                                 Netsnmp_Node_Handler *handler);

/* Handler-side helpers (call from within a Netsnmp_Node_Handler; `requests` is
 * the netsnmp_request_info* the handler receives). */

/* Copy the requested OID into buf (buf_max = capacity in subids); sets *out_len.
 * Returns 0 on success, -1 if it would overflow. */
MOXA_AGENTX_API int  MoxaAgentX_GetRequestOid(void *requests,
                                              oid *buf, size_t buf_max,
                                              size_t *out_len);

/* Set the request's value to an OCTET STRING of `len` bytes. Returns 0. */
MOXA_AGENTX_API int  MoxaAgentX_SetOctetString(void *requests,
                                               const char *s, size_t len);

/* Set the request's value to an INTEGER. Returns 0. */
MOXA_AGENTX_API int  MoxaAgentX_SetInt(void *requests, long value);

/* Read the incoming INTEGER SET value into *value. Returns 0 on success. */
MOXA_AGENTX_API int  MoxaAgentX_GetSetInt(void *requests, long *value);

/* Mark the request with an SNMP error (e.g. SNMP_ERR_GENERR). Returns 0. */
MOXA_AGENTX_API int  MoxaAgentX_SetError(void *requests, int snmp_err);

/* Mark the request's value as noSuchInstance (the OID has no value right now).
 * Unlike an error, a walk skips it and continues. Returns 0. */
MOXA_AGENTX_API int  MoxaAgentX_SetNoSuchInstance(void *requests);

/* SET-phase helpers. `reqinfo` is the agent_request_info* the handler receives. */

/* net-snmp SET/GET mode (reqinfo->mode): MODE_GET, MODE_SET_RESERVE1, ... */
MOXA_AGENTX_API int  MoxaAgentX_GetMode(void *reqinfo);

/* ASN type of the incoming value (requestvb->type) — for MODE_SET_RESERVE1. */
MOXA_AGENTX_API int  MoxaAgentX_GetVarType(void *requests);

/* Copy the incoming OCTET-STRING SET value into buf (NUL-terminated); sets
 * *out_len. Returns 0 on success, -1 if it would overflow. */
MOXA_AGENTX_API int  MoxaAgentX_GetSetString(void *requests,
                                             char *buf, size_t buf_max,
                                             size_t *out_len);

/* Spawn a dedicated OS thread that runs the AgentX select/process loop.
 * Does NOT use any async runtime; safe to call from a tokio process (the loop
 * lives on its own thread). Returns 0 on success. */
MOXA_AGENTX_API int  MoxaAgentX_RunInThread(void);

/* Stop the loop and shut net-snmp down. */
MOXA_AGENTX_API void MoxaAgentX_Shutdown(void);

#ifdef __cplusplus
}
#endif

#endif /* LIB_MOXA_SNMP_AGENTX_H */
