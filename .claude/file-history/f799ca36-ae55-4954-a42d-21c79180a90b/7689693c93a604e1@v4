    if (config_uri == NULL)
    {
        return -1;
    }
    if (ies_set_init() != 0)
    {
        return -1;
    }

    set_value = json_value_init_boolean(value ? 1 : 0);
    if (set_value == NULL)
    {
        return -1;
    }

    snprintf(uri, sizeof(uri), "/api/v1/setting/data/%s?save", config_uri);
    result = LibFrameworkUri_PatchUri(s_handle, uri, s_token, set_value, &resp);

    json_value_free(set_value);
    json_value_free(resp);
    return (int) result;
}
