### G. Daemon subagent 範本(hybrid 模式)

```c
/* fiber_check daemon */

/* per-OID handler */
static int handle_fiberCheckStatTxPower(netsnmp_mib_handler *h, ...) {
    int port = oid_get_index(requests);
    int tx_dbm = fiber_shm_read_tx(port);
    snmp_set_var_typed_value(..., ASN_INTEGER, &tx_dbm, sizeof(tx_dbm));
    return SNMP_ERR_NOERROR;
}

/* handler dispatch table */
static const struct {
    const char *uri_index;
    Netsnmp_Node_Handler *handler;
} sHandlers[] = {
    { "fiberCheckStatTxPower", handle_fiberCheckStatTxPower },
    { "fiberCheckStatRxPower", handle_fiberCheckStatRxPower },
    { NULL, NULL }
};

int main(void) {
    MoxaAgentX_Init("fiber_check");
    ies_mapping_iterate_by_owner("fiber_check", register_cb, sHandlers);
    MoxaAgentX_RunInThread();
    /* daemon 主迴圈跑 SFP polling */
    while (running) fiber_main_tick();
    MoxaAgentX_Shutdown();
}
```

### H. SET 路徑在 subagent 端的處理

```c
static int handle_ifAdminStatus_set(...) {
    if (reqinfo->mode == MODE_SET_RESERVE1) {
        /* validate type, range */
        return SNMP_ERR_NOERROR;
    }
    if (reqinfo->mode == MODE_SET_ACTION) {
        /* 透過 mapping lib 查 URI */
        const ies_mapping_entry_t *e = ies_mapping_lookup_by_oid(oid, olen);
        if (!e) return SNMP_ERR_GENERR;

        /* 組 URI,呼 framework REST(維持 SET source-of-truth) */
        char uri_path[256];
        snprintf(uri_path, sizeof(uri_path),
                 "/api/v1/setting/data/%s/%d/%s",
                 e->uri, port_idx, e->uri_index);
        return LibFrameworkUri_PatchUri(handle, uri_path, token, val_json);
    }
}
