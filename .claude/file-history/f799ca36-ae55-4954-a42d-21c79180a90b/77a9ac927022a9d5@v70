        if ( NULL == fgets(iput_buf, sizeof(iput_buf), iput_fp) )
        {
            break;
        }
        if ( '#' == iput_buf[0] )
        {
            fprintf(oput_fp,"%s", iput_buf);
            continue;
        }

        memset(oput_buf, 0, sizeof(oput_buf));

        if ( IES_NOERR == REMAPPER_UTIL_BUF_HANDLE_STDRMON_EVENT_TABLE(
            stdrmodb_eventTable_handler,
            stdrmodb_eventTable_oid, 
            iput_buf, strlen(iput_buf),
            oput_buf, sizeof(oput_buf)) )
        {
            fprintf(oput_fp,"%s", oput_buf);
        }
        else
        {
            LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", 
                __func__, __LINE__ );
            goto out;
        }
    }

    ret = IES_NOERR;
out:
    if ( NULL != iput_fp )
    {
        fclose(iput_fp);
    }

    if ( NULL != oput_fp )
    {
        fclose(oput_fp);
    }
    return ret;
}


