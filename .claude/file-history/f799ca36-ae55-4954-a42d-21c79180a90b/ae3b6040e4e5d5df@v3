 *           framework REST 呼叫 / 4-phase。
 * Subagent 收到 SET 時呼這個就好,不用自己重做 1000 行。
 */
int MoxaSnmpSet_ApplyToFramework(
    netsnmp_agent_request_info *reqinfo,
    netsnmp_request_info       *requests,
    const ies_mapping_entry_t  *entry,
    struct LibFrameworkUri_Handle *uri_handle,
    const char                 *security_token);

/* 給 Aricent ISS 用的 adapter — Aricent SET callback 簽名跟
 * net-snmp 不同,thin wrapper 內做風格轉換。 */
INT4 MoxaIesAutoMibs_AricentSet(
    tSNMP_OID_TYPE *pOid,
