add_h2('11.6 自動產生 adapter 的 macro 範例')
add_para('因為 ~500 個 handler 手寫 adapter 太繁瑣,建議用 macro 自動展開。一個 X-macro 範例:')
add_code('''/* RW_OID_LIST.h — 在新 lib 內定義 */
#define RW_OID_LIST(X)                                                       \\
    X(NcIfAdminStatusSet,           {1,3,6,1,2,1,2,2,1,7})                  \\
    X(NcIfAliasSet,                 {1,3,6,1,2,1,31,1,1,1,18})              \\
    X(NcIfLinkUpDownTrapEnableSet,  {1,3,6,1,2,1,31,1,1,1,14})              \\
    X(nmhSetVrrpConfigEnable,       {1,3,6,1,4,1,8691,605,3,1,1,1})         \\
    /* ... */

/* generate.h — adapter 自動展開 */
#define GENERATE_ADAPTER(name, oid_init)                                     \\
    INT4 name##_AricentAdapter(/* Aricent SET params */) {                  \\
        static const oid lookup_oid[] = oid_init;                            \\
        const ies_mapping_entry_t *e =                                       \\
            ies_mapping_lookup_by_oid(lookup_oid,                            \\
                sizeof(lookup_oid)/sizeof(oid));                             \\
        if (!e) return SNMP_FAILURE;                                         \\
        netsnmp_agent_request_info reqinfo = { .mode = MODE_SET_ACTION };   \\
        netsnmp_request_info requests;                                       \\
        /* fill from Aricent params */                                       \\
        return MoxaSnmpSet_ApplyToFramework(&reqinfo, &requests, e, ...);   \\
    }

RW_OID_LIST(GENERATE_ADAPTER)

/* 啟動時呼 hook function 把 Aricent 原本 SetHandler 替換成 adapter */
void MoxaIesAutoMibs_HookAllAricentSetHandlers(void) {
    #define HOOK_SET(name, oid_init) \\
        AricentSwapSetHandler(oid_init, name##_AricentAdapter);
    RW_OID_LIST(HOOK_SET)
}''')

add_para('或用外部 Python script 從 grep 結果產 .c 檔,在 buildroot build 階段先跑 generator,**手工只需維護 X-macro 清單**。')

