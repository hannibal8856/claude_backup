add_h2('5.7 Framework SET handler — 跳過 HTTP loopback 的 in-process commit')
add_para('framework SET 跟 daemon / ISS 不同,**自己就是 framework**,呼 lib 的 Layer 2 MoxaSnmpSet_ApplyToFramework 等於是走 HTTP 給自己。'
         '直接呼下層 config_operation 函式更快,~10x。')
add_code('''/* framework AgentX SET handler (跳過 HTTP) */
fn framework_set_handler(oid: &[u32], val: SnmpValue, phase: SnmpSetPhase)
    -> Result<()>
{
    let entry = ies_mapping_lookup_by_oid_via_ffi(oid)?;

    match phase {
        SnmpSetPhase::TestSet => {
            /* phase 1:用 plugin.validate() 跑 schema validation */
            let mut plugins = APP_STATE.plugins_config.lock().unwrap();
            let plugin = plugins.iter_mut()
                .find(|p| p.get_name() == extract_plugin_name(&entry.uri))?;
            plugin.validate(&val.to_json(), &configs.pre_running_config, &request_info)
                  .map_err(|_| SNMP_ERR_BADVALUE)?;
            Ok(())
        }
        SnmpSetPhase::CommitSet => {
            /* phase 2:真寫入 (in-process) */
            let mut configs = APP_STATE.configs.lock().unwrap();
            let mut plugins = APP_STATE.plugins_config.lock().unwrap();

            /* 共用 setting_write 內部呼的同一個 function */
            config_operation::update_config(
                &mut plugins,
                &userinfo,
                &entry.uri,
                val.to_json(),
                &mut configs.pre_running_config,
            )?;

            /* commit 走既有 _save_as_startup_config */
            _save_as_startup_config(&data, &mut configs,
                                    configs.running_config.clone());
            Ok(())
        }
        SnmpSetPhase::UndoSet => { /* revert */ }
        SnmpSetPhase::CleanupSet => { /* nothing */ }
    }
}''')
