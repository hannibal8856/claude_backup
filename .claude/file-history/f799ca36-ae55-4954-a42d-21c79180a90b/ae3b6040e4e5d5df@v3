add_h2('5.3 ISS Aricent SetHandler 替換 pattern')
add_para('以 ifAdminStatus 為例,Aricent SNMPRegisterMib 註冊 ifTable RW entry 時的 callback 設定:')
add_code('''/* ISS 內,沿用 Aricent pattern */
static tMibData ifTableEntries[] = {
    /* ifAdminStatus (RW) — GET 走 Aricent,SET 改走 lib adapter */
    { {1,3,6,1,2,1,2,2,1,7},
        IfAdminStatusGet,                /* GetHandler 不動,享 AgentX 加速 */
        MoxaIesAutoMibs_AricentSet,      /* ← 改成 lib adapter */
        IfAdminStatusTest,               /* TestHandler 保留 (ISS-specific 約束) */
        IfAdminStatusDep,                /* DepHandler 保留 (依賴檢查) */
        ... },
    /* 其他 RW entry 同樣 swap SetHandler 為 MoxaIesAutoMibs_AricentSet */
};

SNMPRegisterMib(&ifmibOID, ifTableEntries, SNMP_MSR_TGR_FALSE);''')
add_para('Adapter 內部做風格轉換 + 呼 Layer 2:')
add_code('''INT4 MoxaIesAutoMibs_AricentSet(tSNMP_OID_TYPE *pOid, ...) {
    /* (1) Aricent OID 物件 → 標準 oid array */
    oid std_oid[MAX_OID_LEN];
    size_t std_oid_len;
    aricent_oid_to_std(pOid, std_oid, &std_oid_len);

    /* (2) lookup mapping entry — 拿 URI + flag + val_type */
    const ies_mapping_entry_t *entry =
        ies_mapping_lookup_by_oid(std_oid, std_oid_len);
    if (!entry) return SNMP_FAILURE;

    /* (3) Aricent SET value → net-snmp request_info 風格 */
    netsnmp_agent_request_info reqinfo = { .mode = MODE_SET_ACTION };
    netsnmp_request_info requests;
    aricent_to_netsnmp_request(pSnmpIndex, pRetVal, &requests);

    /* (4) 共用 SET 邏輯 (Layer 2) */
    int rc = MoxaSnmpSet_ApplyToFramework(&reqinfo, &requests, entry,
                                            gFrameworkHandle, gSecurityToken);

    return (rc == SNMP_ERR_NOERROR) ? SNMP_SUCCESS : SNMP_FAILURE;
}''')

