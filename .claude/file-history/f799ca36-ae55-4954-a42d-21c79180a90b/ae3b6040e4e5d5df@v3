add_h2('5.6 Framework GET handler — URI 分流到 config_layer / status_layer')
add_para('Framework subagent 的 GET handler 透過 URI prefix 自動分流,直接呼 framework 內部 function,跳過 HTTP。'
         '本質上是「無 HTTP 的 REST handler」,跟 actix-web setting_read / setting_status_read 共用同一份下層 code。')
add_code('''/* framework AgentX GET handler (broad ownership) */
fn framework_get_handler(oid: &[u32]) -> Result<Vec<u8>> {
    /* (1) 透過 Rust FFI 拿 mapping entry */
    let entry = ies_mapping_lookup_by_oid_via_ffi(oid)?;

    /* (2) 由 URI prefix 分流到對應 layer */
    let value = if entry.uri.starts_with("setting/data/") {
        /* config OID:讀 in-memory AppState (跟 REST setting_read 同) */
        let configs = APP_STATE.configs.lock().unwrap();
        navigate_json(&configs.running_config, &entry.uri)?

    } else if entry.uri.starts_with("status/") {
        /* status OID:呼 plugin.get_status() (跟 REST setting_status_read 同) */
        let mut plugins = APP_STATE.plugins_status.lock().unwrap();
        let plugin_name = extract_plugin_name(&entry.uri);
        let plugin = plugins.iter_mut()
            .find(|p| p.get_name() == plugin_name)
            .ok_or(ErrorType::NotFound)?;
        plugin.get_status(&entry.uri, &request_info)?

    } else {
        return Err(SNMP_ERR_NOSUCHNAME);
    };

    /* (3) JSON 值轉 ASN.1 SNMP value */
    Ok(encode_asn1_by_val_type(value, entry.val_type))
}''')
