/* Vincent's retry-poll replacement for hardcoded SET sleeps.
 * Polls a framework status URI every POLL_INTERVAL_MS up to POLL_MAX_RETRIES.
 * Worst case wait: 20 * 5 = 100 ms per call site (vs 400 ms / 1 s / 2 s).
 * Best case: ~5 ms when system is already ready.
 * If status URI is missing or never ready, helper returns -1 and caller
 * still proceeds — the SET has already been accepted by framework REST. */
#define MOXA_SNMP_POLL_MAX_RETRIES                                     (20)
#define MOXA_SNMP_POLL_INTERVAL_MS                                      (5)
#define MOXA_SNMP_POLL_CMD_MAX_RETRIES                                 (80)  /* commands: up to 400 ms */
#define MOXA_SNMP_POLL_STATUS_URI \
        MOXA_SNMP_URI_STATUS_PATH("system/ready")
