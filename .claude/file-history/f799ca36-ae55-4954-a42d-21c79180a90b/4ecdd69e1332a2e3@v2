#define MOXA_SNMP_MAX_TABLE_ENTRY_OID                          ( 18 * 1024 )
#define MOXA_SNMP_MAX_TABLE_ENTRY_BUFFER                 ( 4 * 1024 * 1024 )
#define MOXA_SNMP_MAX_TABLE_ENTRY_TIMEOUT              ( 800 * 1000 * 1000 ) /* in nanoseconds  */
