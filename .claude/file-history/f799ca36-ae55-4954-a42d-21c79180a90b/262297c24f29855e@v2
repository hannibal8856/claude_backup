LIB_MOXA_RUST_SNMP_AGENTX_SITE = "$(TOPDIR)/dl/lib_moxa_rust_snmp_agentx"
LIB_MOXA_RUST_SNMP_AGENTX_DEPENDENCIES = \
	lib_moxa_snmp_agentx

define LIB_MOXA_RUST_SNMP_AGENTX_BUILD_CMDS
	$(TARGET_MAKE_ENV) $(MAKE1) \
		-C $(@D) \
		TARGET=$(RUSTC_TARGET_NAME) \
		RUST_TARGET_DIR=$(BR2_MOXA_RUST_TARGET_DIR)
endef

define LIB_MOXA_RUST_SNMP_AGENTX_INSTALL_TARGET_CMDS
	@if [ "${RUST_CLIPPY_SCAN_CONFIG}" = "true" ]; then \
		mkdir -p $(BINARIES_DIR)/cargo/lib_moxa_rust_snmp_agentx; \
		cp -rf $(@D)/rust_clippy_scan_result $(BINARIES_DIR)/cargo/lib_moxa_rust_snmp_agentx; \
	fi
endef

$(eval $(generic-package))
