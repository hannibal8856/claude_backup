LIB_MOXA_SNMP_AGENTX_SITE="$(TOPDIR)/dl/lib_moxa_snmp_agentx"
LIB_MOXA_SNMP_AGENTX_INSTALL_STAGING=YES
LIB_MOXA_SNMP_AGENTX_DEPENDENCIES=3rdparty_net_snmp

define LIB_MOXA_SNMP_AGENTX_BUILD_CMDS
	$(TARGET_MAKE_ENV) $(MAKE) -C $(@D) CC=$(TARGET_CC)
endef

define LIB_MOXA_SNMP_AGENTX_INSTALL_STAGING_CMDS
	$(TARGET_MAKE_ENV) $(MAKE) -C $(@D) DESTDIR=$(STAGING_DIR) install CC=$(TARGET_CC)
endef

define LIB_MOXA_SNMP_AGENTX_INSTALL_TARGET_CMDS
	$(TARGET_MAKE_ENV) $(MAKE) -C $(@D) DESTDIR=$(TARGET_DIR) install CC=$(TARGET_CC)
endef

$(eval $(generic-package))
