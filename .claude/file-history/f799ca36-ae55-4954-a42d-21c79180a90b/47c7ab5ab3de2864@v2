#define IES_MAX_SYS_BUF      (64)

enum {
    IES_FLAG_SNMP_INIT = 0,

    IES_FLAG_SNMP_URI_MOD_ON_SET,         // uri modified on set
    IES_FLAG_SNMP_URI_COMMAND,            // use URI-Command Layer
    IES_FLAG_SNMP_URI_STATUS,             // use URI Status Layer
    IES_FLAG_SNMP_URI_REDUNDANT_PORT,     // special handle : redundant port interface
    IES_FLAG_SNMP_URI_IDX_FROM_OID,       // URI Index is get from OID Index
    IES_FLAG_SNMP_URI_FILTER_DEL,         // special handle : will del uri config by filter command.
    IES_FLAG_SNMP_URI_MOD_BY_IDX,         // special handle : URI modified by index
    IES_FLAG_SNMP_URI_INTERFACE,          /* special handle  : the port interface in URI is 0-base, 
                                                              in SNMP is 1-base. */
    IES_FLAG_SNMP_URI_PBMP,               // special handle : URI PortBitMAP
    IES_FLAG_SNMP_URI_CONFIG_CHAIN,       /* special handle : in some case, config-change will 
                                             cause chain-reaction of config-change. */

    IES_FLAG_SNMP_GENERAL_TABLE,          // use generat table handler for URI Table
    IES_FLAG_SNMP_READ_CREATE,            // use read-create flow
    IES_FLAG_SNMP_READ_CREATE_v2,         // use read-create v2 flow
    IES_FLAG_SNMP_READ_CREATE_vRMON,      // use read-create vRMON flow
    IES_FLAG_SNMP_READ_CREATE_OID_URI,    // use read-create flow, but URI Index is get from OID Index

    IES_FLAG_SNMP_REPLACE_TRUTH_VALUE,    /* replace MIB enable/disable into URI True/False
                                             the MIB syntax use truth_value for enable/disable */

    IES_FLAG_SNMP_REPLACE_BIT_VALUE,      // BITs handle

    IES_FLAG_SNMP_REPLACE_BIT_2OCT,       // special handle : BITs handle for 2OCTs

    IES_FLAG_SNMP_REPLACE_TABLE_2ENTRY,   /* special handle : SNMP_Table remap 2 URI_Entry 
                                                              instead of URI_Table */

    IES_FLAG_SNMP_REPLACE_TABLE_2ENTRY_ARRAY,
                                          /* special handle : SNMP Table remap 2 URI Entry ARRAY.
                                                              use entry array for store SNMP single value table 
                                                              oid index equal 2 (array index - 1) */

    IES_FLAG_SNMP_REPLACE_TABLE_2PORTS_PBMP,
                                          /* special handle : SNMP Table remap 2 portsPbmp.   */

    IES_FLAG_SNMP_SYSTEM_COMMAND,         /* system command : always return certain value on read.
                                                              write certaion value will force system
                                                              to trigger some action.        */


    IES_FLAG_SNMP_OID_VALID_BY_IDX,       // special handle : OID VALID by index

    IES_FLAG_SNMP_LA_REPLACE_BIT,         // special handle : for LA MIB BITs Setting

    IES_FLAG_SNMP_TR2_REPLACE_URI,        // special handle : for TurboRing2 URI Structure

    IES_FLAG_SNMP_MANAGEMENT_VLAN,        // special handle : for mxVLAN management-VLAN handler

    IES_FLAG_SNMP_ISS_REMAP_TBL,          /* special handle : indicate mxMIB was build from 
                                                              different ISS private mib. 
                                                              This shall be removed latter on. */

    IES_FLAG_SNMP_ISS_REMAP_MERGE_TABLE, /* special handle  : for some reason, this mib table is merged 
                                                              from 2 different mib table.
                                                              This shall be removed latter on. */

    IES_FLAG_SNMP_MAKEUP_INDEX,          /* special handle  : for some reason, iss won't generate table index for mib_db,
                                                              so we have to makeup index for it */
    IES_FLAG_SNMP_MAKEUP_INDEX_FOR_ISS,  /* special handle  : for some reason, iss won't generate table index for mib_db,
                                                              so we have to makeup index for it */
    IES_FLAG_SNMP_GENERATE_SYS_OID,      /* special handle  : generate system object ID */
    IES_FLAG_SNMP_CHANGE_VALUE_SCALE,    /* special handle  : for some reason, value scale different from snmp and uri_config */
    IES_FLAG_SNMP_URI_FIXED_VALUE,       /* special handle  : fixed value in snmpd */
    IES_FLAG_SNMP_MULTIPLE_INDEX_TABLE,  /* special handle  : oid index is 1 but this is multiple index table */
    IES_FLAG_SNMP_INDEX_NOT_START_FROM_1,/* special handle  : oid index Not start 1. from 0 or from portChannel-index */
    IES_FLAG_SNMP_INDEX_NOT_IN_ORDER,    /* special handle :  In some table ( like laConfigMainTable ) , the table-index
                                                              may not be in-order. So the table-index should be
                                                              genegrated from ISS like iftable, not auto-generate by
                                                              SNMP-Framework.
                                          */
    IES_FLAG_SNMP_AGENTX_OWNED,          /* Entry is owned by ISS AgentX subagent — skip local
                                            netsnmp_register_* in mox_snmp_init_entry. master snmpd
                                            will route this OID to ISS subagent via AgentX,
                                            bypassing the URI hook materialization path. */
    IES_FLAG_SNMP_MAX,
};


