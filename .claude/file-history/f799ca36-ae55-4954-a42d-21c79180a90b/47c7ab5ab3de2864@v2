    ( ( 0 == strncmp(__entry_uri_string, __uri, strlen(__uri)) ) ? IES_NOERR : IES_ERR )

#define IES_SNMP_COMPARE_NAME(__entry_name_string, __name) \
    ( ( 0 == strncmp(__entry_name_string, __name, strlen(__name)) ) ? IES_NOERR : IES_ERR )

