def add_title(slide, text, subtitle=None):
    box = slide.shapes.add_textbox(Inches(0.5), Inches(0.3), W - Inches(1.0), Inches(0.9))
    tf = box.text_frame
    tf.word_wrap = True
    p = tf.paragraphs[0]
    p.alignment = PP_ALIGN.LEFT
    run = p.add_run()
    run.text = text
    _set_font(run, size=28, bold=True, color=C_PRIMARY)
    if subtitle:
        p2 = tf.add_paragraph()
        run2 = p2.add_run()
        run2.text = subtitle
        _set_font(run2, size=14, color=C_MUTED, italic=True)
    # 底線
    line = slide.shapes.add_shape(MSO_SHAPE.RECTANGLE,
                                   Inches(0.5), Inches(1.25), W - Inches(1.0), Emu(20000))
    line.fill.solid()
    line.fill.fore_color.rgb = C_PRIMARY
    line.line.fill.background()


def add_body_box(slide, top=Inches(1.45), left=Inches(0.6), width=None, height=None):
    if width is None: width = W - Inches(1.2)
    if height is None: height = H - top - Inches(0.4)
    box = slide.shapes.add_textbox(left, top, width, height)
    box.text_frame.word_wrap = True
    return box.text_frame


def add_footer(slide, n_current, n_total, label="SNMP Plan C+D — RD Review (Internal Draft)"):
    box = slide.shapes.add_textbox(Inches(0.5), H - Inches(0.4),
