    tf = box.text_frame
    p = tf.paragraphs[0]
    p.alignment = PP_ALIGN.LEFT
    r1 = p.add_run(); r1.text = label
    _set_font(r1, size=9, color=C_MUTED, italic=True)
    p2 = tf.add_paragraph()
    p2.alignment = PP_ALIGN.RIGHT
    r2 = p2.add_run(); r2.text = f"{n_current} / {n_total}"
    _set_font(r2, size=9, color=C_MUTED)


def add_table(slide, headers, rows,
              left=Inches(0.6), top=Inches(1.5),
              width=None, height=None,
              col_widths=None, font_size=10):
    if width is None: width = W - Inches(1.2)
    if height is None: height = Inches(0.5 + 0.4 * len(rows))
    n_cols = len(headers)
    n_rows = 1 + len(rows)
    tbl_shape = slide.shapes.add_table(n_rows, n_cols, left, top, width, height)
    tbl = tbl_shape.table

    if col_widths:
        for i, w in enumerate(col_widths):
            tbl.columns[i].width = w

    for i, h in enumerate(headers):
        cell = tbl.rows[0].cells[i]
        cell.fill.solid()
        cell.fill.fore_color.rgb = C_PRIMARY
        tf = cell.text_frame
        tf.text = ''
        p = tf.paragraphs[0]
        p.alignment = PP_ALIGN.CENTER
        run = p.add_run()
        run.text = h
        _set_font(run, size=font_size + 1, bold=True, color=RGBColor(255,255,255))

    for ri, row in enumerate(rows):
        for ci, val in enumerate(row):
            cell = tbl.rows[ri + 1].cells[ci]
            if ri % 2 == 1:
                cell.fill.solid()
                cell.fill.fore_color.rgb = C_LIGHTBG
            tf = cell.text_frame
            tf.text = ''
            p = tf.paragraphs[0]
            p.alignment = PP_ALIGN.LEFT
            run = p.add_run()
            run.text = str(val)
            _set_font(run, size=font_size, color=C_TEXT)


def add_code_box(slide, text, top=Inches(1.5), left=Inches(0.6),
                  width=None, height=Inches(3.5), font_size=10):
    if width is None: width = W - Inches(1.2)
    box = slide.shapes.add_textbox(left, top, width, height)
    box.fill.solid()
    box.fill.fore_color.rgb = C_LIGHTBG
    tf = box.text_frame
    tf.word_wrap = True
    for i, line in enumerate(text.split('\n')):
        if i == 0:
            p = tf.paragraphs[0]
        else:
            p = tf.add_paragraph()
        run = p.add_run()
        run.text = line
        _set_font(run, name=FONT_CODE, size=font_size, color=C_TEXT)


