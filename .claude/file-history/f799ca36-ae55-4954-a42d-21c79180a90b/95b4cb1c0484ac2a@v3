};


/****************************************************************************
 Description        : 

    這個 table 的 read 
 
*****************************************************************************/
ies_handle_t 
remapper_handle_read_mxigmpdb_igmpsnpStatusVlanMulticastForwardTable
(
    u8 *iputURI,
    u8 *iputFile,
    u8 *oputFile
)
{
    FILE               *iput_fp                = NULL;
    FILE               *oput_fp                = NULL;
    char                iput_buf[IES_MAX_FILE] = {0x0};
    char                oput_buf[IES_MAX_FILE] = {0x0};
    ies_handle_t        ret                    = IES_ERR;

    iput_fp = fopen((char *)iputFile, "r");
    if ( NULL == iput_fp )
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", 
            __func__, __LINE__ );
        goto out;
    }

    oput_fp = fopen((char *)oputFile, "w");
    if ( NULL == oput_fp )
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", 
            __func__, __LINE__ );
        goto out;
    }

    while ( !feof(iput_fp) )
    {
        if ( NULL == fgets(iput_buf, sizeof(iput_buf), iput_fp) )
        {
            break;
        }
        if ( '#' == iput_buf[0] )
        {
            fprintf(oput_fp,"%s", iput_buf);
            continue;
        }

        memset(oput_buf, 0, sizeof(oput_buf));

        if ( IES_NOERR == REMAPPER_UTIL_BUF_HANDLE_PBMP_TABLE( 
            mxigmpdb_igmpsnpStatusVlanMulticastForwardTable_handler,  
            mxigmpdb_igmpsnpStatusVlanMulticastForwardTable_oid, 
            iput_buf, strlen(iput_buf),
            oput_buf, sizeof(oput_buf)) )
        {
            fprintf(oput_fp,"%s", oput_buf);
        }
        else
        {
            LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", 
                __func__, __LINE__ );
            goto out;
        }
    }

    ret = IES_NOERR;
out:
    if ( NULL != iput_fp )
    {
        fclose(iput_fp);
    }

    if ( NULL != oput_fp )
    {
        fclose(oput_fp);
    }
    return ret;
}


