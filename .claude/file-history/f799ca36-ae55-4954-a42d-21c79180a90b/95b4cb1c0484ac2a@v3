remapper_tableOid_t                mxigmpdb_igmpsnpStatusVlanMulticastForwardTable_oid     [] = {1,3,6,1,4,1,8691,603,7,2,2,3,1};

struct remapper_tableEntryHandler  mxigmpdb_igmpsnpStatusVlanMulticastForwardTable_handler [] = 
