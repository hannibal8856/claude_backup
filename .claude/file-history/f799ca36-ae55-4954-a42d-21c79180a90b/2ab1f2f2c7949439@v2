    --line-strong: #aab5ad;
    --accent: #1c774a;         /* framework subagent — the fast, migrated path */
    --accent-ink: #0f4d2f;
    --accent-soft: #dcede3;
    --iss: #a85a24;            /* ISS branch */
    --iss-soft: #f2e4d5;
    --legacy: #5d6b8a;         /* in-master ies-auto-mibs — the remaining path */
    --legacy-soft: #e2e6ee;
