/*
 * lib_moxa_ies_auto_mibs — mapping table (data).
 *
 * B1 (plan Task 8): system_information config OIDs.
 *
 * `uri` is the config-layer path (== the dlmod's REST URI minus the
 * "/api/v1/setting/data/" prefix); the framework subagent GET handler feeds it
 * to config_operation::get_config_from_path, which is byte-identical to the
 * REST GET the dlmod currently performs (rust_moxa_config_layer::_setting_get).
 * `val_type` uses net-snmp ASN_* numbering (4 = ASN_OCTET_STR, 2 = ASN_INTEGER).
 * `mode` records the OID's native access (0x01 RONLY, 0x03 RWRITE); the subagent
 * always registers read-only regardless.
 */
#include "lib_moxa_ies_auto_mibs.h"

/* system_information config OIDs (source: plugin_moxa_system_information
 * snmp_config/snmp_system_information.c sSystemInfoOid[]). */
