 * $param[in]    cmdString   checking command is success or not

 * @returns      0 means success, others fail.
 */
int32_t moxaSnmpHandle_UtilCfgTriggerURICommand( char       *cmdPath,
                                                 JSON_Value *jsonVal,
                                                 char       *cmdString )
{
    int32_t      ret                               = (-1);
    const char  *uriDataPath                       = NULL;
    char         uriPath[MOXA_SNMP_MAX_URI_LENGTH] = {0x0};
    JSON_Value  *jsonValCmdResult                  = NULL;
    char        *jsonValCmdString                  = NULL;
    char        *debugMessage                      = NULL;
