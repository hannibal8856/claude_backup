        {
            LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__ );
            return (-1);
        }
    }

    // trigger command
    snprintf(uriPath, sizeof(uriPath),
        MOXA_SNMP_URI_COMMAND_PATH("%s"), cmdPath);

    moxaSnmpHandle_UtilDumpJsonVal(__func__, __LINE__, uriPath, jsonVal);

    uriDataPath = uriPath;
    if ( LibFrameworkUri_PostUri(gUriHandle, uriDataPath, security_token, jsonVal, &jsonValCmdResult) != 0 )
    {
