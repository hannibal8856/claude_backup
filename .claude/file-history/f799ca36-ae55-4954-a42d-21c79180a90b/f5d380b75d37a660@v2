    /* remove " " around result */
    snprintf(uriPath, sizeof(uriPath),
        MOXA_SNMP_URI_COMMAND_PATH("%s"), jsonValCmdString + 1 );         /* remove first <"> */
    tmp = moxaSnmpHandle_UtilStringStrchr(uriPath, strlen(uriPath), '\"'); /* remove last <">  */
    if ( tmp == NULL )
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "%% %s@%d can't remove last `\"` \n",
            __func__, __LINE__);
        goto config_end;
    }
    *tmp = '\0';

    // get command result part 2 : result string from command result
    if ( moxaSnmpHandle_UtilCfgGetURIConfig(uriPath, &jsonValResult) != 0 )
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "%% %s@%d can't UtilCfgGetURIConfig \n",
            __func__, __LINE__);
        goto config_end;
    }

    jsonObjResult = json_value_get_object(jsonValResult);
    if ( jsonObjResult == NULL )
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "%% %s@%d can't get jsonObjResult \n",
            __func__, __LINE__);
        goto config_end;
    }

    jsonStrResult = json_object_dotget_string(jsonObjResult, (const char *)"output");
    if ( jsonStrResult == NULL )
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "%% %s@%d can't json_object_dotget_string \n",
            __func__, __LINE__);
        goto config_end;
    }

    // get command result part 3 : check result string
    if ( 0 != strncmp(jsonStrResult, cmdString, strlen(cmdString)) )
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "%% %s@%d jsonStrResult=('%s') cmdString('%s') \n",
            __func__, __LINE__, jsonStrResult, cmdString);
        goto config_end;
    }

    ret = 0;

config_end:


    if ( jsonValCmdString != NULL )
    {
        json_free_serialized_string(jsonValCmdString);
    }

    if ( jsonValResult != NULL )
    {
        json_value_free(jsonValResult);
        jsonValResult = NULL;
    }

    if ( jsonValCmdResult != NULL )
    {
        json_value_free(jsonValCmdResult);
        jsonValCmdResult = NULL;
    }

    return ret;
}


/**
 * @brief get uri pBMP from uriPath

 * $param[in]    uriPath     uri path
 * $param[out]   setBuf      snmp set buffer

 * @returns      0 means success, others fail.
 */
int32_t moxaSnmpHandle_UtilPBMP_GetURIConfig( char                     *uriPath,
                                              struct moxaSnmpSetBuffer *setBuf   )
{
    int32_t             ret        = (-1);
    JSON_Value         *jsonVal    = NULL;
    JSON_Array         *jsonArray  = NULL;
    int32_t             count      = 0;
    int32_t             jsonBoolen = 0;

    if ( moxaSnmpHandle_UtilCfgGetURIConfig(uriPath, &jsonVal ) != 0 )
    {
        LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "%% %s@%d : can't get jsonVal from uriPath('%s')\n",
            __func__, __LINE__, uriPath );
        goto config_end;
    }

    if ( json_value_get_type(jsonVal) == JSONNull )
    {
        json_value_free(jsonVal);
        jsonVal = NULL;
        return 0;
    }

    jsonArray = json_value_get_array(jsonVal);
    if ( jsonArray == NULL )
    {
        LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "%% %s@%d : can't get jsonArray from jsonVal\n",
            __func__, __LINE__ );
        goto config_end;
    }

    count = json_array_get_count(jsonArray);

    setBuf->type         = MOXA_SNMP_VALUE_BIT_BUF;
    setBuf->valBitBufLen = count;

    for ( int i = 0; i < count; i++ )
    {
        jsonBoolen = json_array_get_boolean( jsonArray, i );
        if ( jsonBoolen == MOXA_SNMP_JSON_INVALID )
        {
            LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "%% %s@%d : can't get jsonBoolen from jsonArray('%d')\n",
                __func__, __LINE__, i );
            goto config_end;
        }
        setBuf->valBitBuf[i] = ( jsonBoolen == MOXA_SNMP_JSON_TRUE ) ?
            MOXA_SNMP_BIT_ENABLE : MOXA_SNMP_BIT_DISABLE;
    }

    ret = 0;

config_end:

    if ( jsonVal != NULL )
    {
        json_value_free(jsonVal);
        jsonVal = NULL;
    }
    return ret;
}



/**
 * @brief set setBuf into uriPath for Port BitMap format

 * $param[in]    uriPath     uri path
 * $param[out]   setBuf      snmp set buffer

 * @returns      0 means success, others fail.
 */
int32_t moxaSnmpHandle_UtilPBMP_SetURIConfig( char                     *uriPath,
                                              struct moxaSnmpSetBuffer *setBuf   )
{
    int32_t             ret         = (-1);
    JSON_Value         *jsonVal     = NULL;
    JSON_Array         *jsonArray   = NULL;
    int32_t             jsonBoolen  = 0;
    int32_t             maxPortNo      = 0;
    int32_t             maxPortChannel = 0;
    int32_t             maxPortList    = 0;

    jsonVal = json_value_init_array();
    if ( jsonVal == NULL )
    {
        LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "%% %s@%d : can't init jsonVal\n",
            __func__, __LINE__ );
        goto config_end;
    }

    jsonArray = json_value_get_array(jsonVal);
    if ( jsonArray == NULL )
    {
        LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "%% %s@%d : can't get jsonArray from jsonVal\n",
            __func__, __LINE__ );
        goto config_end;
    }

    LibSystem_GetMaxPortNumInSystem(&maxPortNo);
    maxPortChannel = maxPortNo / 2 ;
    maxPortList    = maxPortNo + maxPortChannel;

    if ( setBuf->valBitBufLen > maxPortList )
    {
        setBuf->valBitBufLen = maxPortList;
    }

    for ( int i = 0; i < setBuf->valBitBufLen; i++ )
    {
        jsonBoolen = ( setBuf->valBitBuf[i] == MOXA_SNMP_BIT_ENABLE ) ?
            MOXA_SNMP_JSON_TRUE : MOXA_SNMP_JSON_FALSE ;

        if ( json_array_append_boolean(jsonArray, jsonBoolen) != JSONSuccess )
        {
            LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "%% can't append boolen for jsonArray('%d')\n",
                __func__, __LINE__, i );
        }
    }

    if ( moxaSnmpHandle_UtilCfgPatchURIConfig( uriPath, jsonVal ) != 0 )
    {
            LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "%% %s@%d : can't PatchURIConfig('%s')\n",
                __func__, __LINE__, uriPath );
            goto config_end;
    }

    ret = 0;

config_end:

    if ( jsonVal != NULL )
    {
        json_value_free(jsonVal);
        jsonVal = NULL;
    }
    return ret;
}


