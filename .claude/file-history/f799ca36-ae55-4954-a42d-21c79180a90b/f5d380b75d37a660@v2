/**
 * @brief check oidIndex to tell this is normal-port or port-channel-port
          and return internal-interface-port-number

 * $param[in]    oidIndex   oid table index
 * @param[out]   ifaceType  LA_NORMAL_PORT / LA_PORT_CHANNEL
 * @param[out]   ifacePort  internal interface port


 * @returns      0 means success, others fail.
 */
int32_t moxaSnmpHandle_UtilPortGetIfacePort( int32_t   oidIndex,
                                             int32_t  *ifaceType,
                                             int32_t  *ifacePort   )
{

    int32_t  ret  = (-1);
    int32_t  minPortInDevice;
    int32_t  maxPortInDevice;
    int32_t  maxPortNumber;

    minPortInDevice = 0;
    maxPortInDevice = gMaxPortInDevice - 1;
    maxPortNumber   = gMaxPortInDevice + gMaxPortChannel;

    if ( oidIndex >= minPortInDevice && oidIndex <= maxPortInDevice )
    {
        *ifaceType = LA_NORMAL_PORT;
        *ifacePort = oidIndex;
    }
    else
    if ( oidIndex > maxPortInDevice && oidIndex < maxPortNumber )
    {
        *ifaceType = LA_PORT_CHANNEL;
        *ifacePort = oidIndex - gMaxPortInDevice;
    }
    else
    {
        LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__ );
        return (-1);
    }
    return 0;
}


