/**
 * @brief Get L3 IpIfTable json val

 * @param[in]    ifIndex       ifIndex of IFMIB
 * @param[in]    ipIfValue_p   pointer of jason value

 * @returns      > 0 means success, = 0 means not found, and others are fail.
 */
int32_t moxaSnmpHandle_UtilGetIpIfInfo(uint32_t ifIndex,
                                            JSON_Value     **ipIfValue_p)
{
    JSON_Value *jsonVal    = NULL;    
    FILE    *fp;
    int     rv = 0, len = 0;
    char    cmd[80] = {0};
    char    outbuf[128] = {0};
    
    LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "%s@%d : ifIndex=%d\n", __func__, __LINE__, ifIndex);
    snprintf(cmd, sizeof(cmd), "python3 /usr/bin/get_ip_iftable.py -i %d", ifIndex);
    fp = popen(cmd, "r");
    if (fp == NULL)
    {
        return -1;
    }
        
    if (fgets(outbuf, sizeof(outbuf), fp) != NULL)
    {
        len = strlen(outbuf);
    }
    else
    {
        len = 0;
    }    
    
    rv = pclose(fp);
    if (rv == -1)
    {  /* Error reported by pclose() */
        return -1;
    }

    LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "len=%d, outbuf='%s'\n", len, outbuf);
    if (len > 0)
    {
        /* char *testStr = "{\"ifName\": \"vlan60\"}"; */
        *ipIfValue_p = json_parse_string(outbuf);
        if(*ipIfValue_p == NULL) 
        {
            LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "%s@%d : json_parse_string failed\n", __func__, __LINE__);
            return -1;
        }
    }
    
    return len;
}

