/**
 * @brief auto generate table-index-entry
          following is the reason for this function.
          1. coz for most of the case, there is no table-index-entry in the db-file generated 
             from iss.

          2. when generate db for None-ISS MIB entry.
             With this function, No need to generate table-index-entry.

          3. NetSNMP need table-index-entry to hadle SNMP request from table-index-entry.

 * @param[in]    entry     moxa snmp entry

 * @returns      0 means success, others fail.
 */
int32_t moxaSnmpHandle_UtilMibEntryGenerateTableIndexEntry( struct ies_auto_mibs_entry *entry )
{
    static char                          tableURI[IES_MAX_URI] = {0x0};

    if ( 1 == moxaSnmpHandle_UtilMibEntryCheckSingleIndexTable(entry) &&
         0 == MOXA_SNMP_ENTRY_FLAGS_CHK(IES_FLAG_SNMP_INDEX_NOT_START_FROM_1, entry->flags) &&
         0 == MOXA_SNMP_ENTRY_FLAGS_CHK(IES_FLAG_SNMP_INDEX_NOT_IN_ORDER,     entry->flags) &&
         0 == MOXA_SNMP_ENTRY_FLAGS_CHK(IES_FLAG_SNMP_ISS_REMAP_MERGE_TABLE,  entry->flags)   )
    {
        if ( 1 == moxaSnmpHandle_UtilMibEntryGetTableEntryOID(entry) )
        {
            snprintf(tableURI, sizeof(tableURI), "%s", entry->uri);
        }
        else
        if ( 0 != MOXA_SNMP_COMPARE_URI(tableURI, entry->uri) )
        {
            struct ies_auto_mibs_entry  *indexEntry  = NULL;
            if ( moxaSnmpHandle_UtilMibEntryCheckFromIss(entry) )
            {
                IES_FLAG_BITS_SET(IES_FLAG_SNMP_MAKEUP_INDEX_FOR_ISS, entry->flags);
            }
            if ( 2 == moxaSnmpHandle_UtilMibEntryGetTableEntryOID(entry) )
            {
                if ( IES_FLAG_BITS_CHK(IES_FLAG_SNMP_MAKEUP_INDEX_FOR_ISS, entry->flags) )
                {
                    LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "%s@%d : MAKEUP_INDEX_FOR_ISS \n", __func__, __LINE__);
                    LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "uri   : %s \n", entry->uri);
                }
                if ( moxaSnmpHandle_UtilMibEntryCreateIndexEntry(entry, &indexEntry) != 0 )
                {
                    LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
                    return (-1);
                }
                if ( moxaSnmpHandle_UtilMibEntryRegisterToNetSNMP(indexEntry) != 0 )
                {
                    LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
                    return (-1);
                }
            }
        }
    }
    return 0;
}

/**
 * @brief use select for usleep

 * @param[in]    usec           microsecond

   use select for useleep function which is more
   accurate than use usleep directly.

 * @returns      0 means success, others fail.
 */
int32_t moxaSnmpHandle_UtilUSleep( unsigned long usec )
{
    struct timeval tv;

    memset(&tv, 0, sizeof(tv));
    tv.tv_sec  = 0;
    tv.tv_usec = usec;
    select(0, NULL, NULL, NULL, &tv);

    return 0;
}

/**
 * @brief Vincent's retry-poll replacement for hardcoded SET sleeps.
 *        Polls a framework status URI until it reports {"ready":true}
 *        or max_retries exhausted.
 *
 *        Best case: returns 0 in ~poll_ms (e.g., 5 ms)
 *        Worst case: returns -1 in max_retries*poll_ms (e.g., 100 ms)
 *
 *        Caller proceeds either way; framework has already accepted the SET.
 *        Polling just confirms application is done so we can return sooner.
 */
int32_t moxaSnmpHandle_UtilPollIssReady( struct LibFrameworkUri_Handle *handle,
                                          const char *status_uri,
                                          const char *token,
                                          int         max_retries,
                                          int         poll_ms )
{
    int             i;
    struct timeval  tv;

    if ( handle == NULL || status_uri == NULL || token == NULL )
    {
        return (-1);
    }

    for ( i = 0; i < max_retries; i++ )
    {
        JSON_Value  *jv    = NULL;
        JSON_Object *obj   = NULL;
        int          ready = 0;

        if ( LibFrameworkUri_GetUri(handle, status_uri, token, &jv) == 0 )
        {
            if ( jv != NULL )
            {
                obj = json_value_get_object(jv);
                if ( obj != NULL &&
                     json_object_get_boolean(obj, "ready") == 1 )
                {
                    ready = 1;
                }
            }
        }
        if ( jv != NULL )
        {
            json_value_free(jv);
        }
        if ( ready )
        {
            return 0;
        }

        memset(&tv, 0, sizeof(tv));
        tv.tv_sec  = 0;
        tv.tv_usec = poll_ms * 1000;
        select(0, NULL, NULL, NULL, &tv);
    }
    return (-1);
}


/**
 * @brief handle snprint format string into buf

 * @param[in]    buf           buffer for snprintf
 * @param[in]    bufLen        buffer total len for snprintf
 * @param[out]   bufPosition   buffer current position for snprintf
 * @param[in]    fmtString     format string for snprintf
 * @param[in]    ...           format string parameter for snprintf

 * @returns      0 means success, others fail.
 */
int32_t moxaSnmpHandle_UtilStringSnprintf(char   *buf,
                                         int      bufLen,
                                         int     *bufPosition,
                                         char    *fmtString,
                                                  ... )
{
    char   *bufIndex;
    int     bufRemainLen;
    int     len;
    va_list ap;

    bufRemainLen = bufLen - *bufPosition;
    bufIndex     = &buf[*bufPosition];

    va_start(ap, fmtString);
    len = vsnprintf(bufIndex, bufRemainLen, fmtString, ap);
    va_end(ap);

    bufRemainLen -= len;
    if (bufRemainLen > 0 )
    {
        *bufPosition += len;
        return 0;
    }
    LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__ );
    return (-1);
}

/**
 * @brief handle transfer object-id-string to oid

 * @param[in]    buf           object-id-string buffer
 * @param[in]    bufLen        object-id-string buffer len
 * @param[out]   retOID        return oid buffer
 * @param[out]   retOIDLen     return oid buffer len
 * @param[in]    retOIDMaxLen  return oid buffer max len

 * @returns      0 means success, others fail.
 */
int32_t moxaSnmpHandle_UtilStringToObjectID( const char *buf,
                                             int         bufLen,
                                             oid        *retOID,
                                             size_t     *retOIDLen,
                                             int         maxOidBufLen )
{
    char *end           = buf + bufLen;
    char *token         = NULL;
    int   oidBufIndex   = 0;
    char  tmpOidStr[32] = {0x0};
    int   tmpOidStrLen  = 0;

    for ( token = (char *) buf; buf < end; buf++ )
    {
        if ( *buf == ',' || *buf == '.' || *buf == '\'' )
        {
            tmpOidStrLen = buf - token;
            if ( tmpOidStrLen >= sizeof(tmpOidStr) )
            {
                LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__ );
                return (-1);
            }
            memcpy(tmpOidStr, token, tmpOidStrLen);
            token = buf + 1;
            retOID[oidBufIndex] = atoi(tmpOidStr);
            oidBufIndex++;
            if ( oidBufIndex >= maxOidBufLen )
            {
                LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__ );
                return (-1);
            }
        }
    }
    *retOIDLen = oidBufIndex;
    return 0;
}



/**
 * @brief handle transfer string to hex-value

 * @param[in]    buf     hex string buffer
 * @param[in]    bufLen  hex string buffer Len

 * @returns      parsing result
 */
char moxaSnmpHandle_UtilStringToHexValue( const char *buf,
                                          int         bufLen )
{
    char *end      = buf + bufLen;
    char  retToken = 0;
    int   count    = 0;

    while ( buf < end )
    {
        if ( *buf >= '0' && *buf <= '9' )
        {
            count = *buf - '0';
        }
        else
        if ( *buf >= 'a' && *buf <= 'f' )
        {
            count = *buf - 'a' + 10;
        }
        else
        if ( *buf >= 'A' && *buf <= 'F' )
        {
            count = *buf - 'A' + 10;
        }
        else
        {
            count = 0;
        }
        retToken  = ( ( retToken << 4 ) & 0xf0 );
        retToken |= ( count & 0x0f );
        buf++;
    }
    return retToken;
}

/**
 * @brief handle transfer ip-string to ipv4-value

 * @param[in]    buf     ip string buffer
 * @param[in]    bufLen  ip string buffer len
 * @param[in]    retVal  return value

 * @returns      0 means success, others fail.
 */
int32_t moxaSnmpHandle_UtilStringToIPv4Value( const char   *buf,
                                              int           bufLen,
                                              unsigned int *retVal )
{
    char        *end = (char *)buf + bufLen;
    unsigned int val, tmp;
    int          i;

    val = 0;
    for ( i = 0; i < 4; i++ )
    {
        tmp   = 0;
        val <<= 8;
        while ( buf < end )
        {
            if ( *buf >= '0' && *buf <= '9' )
            {
                tmp *= 10;
                tmp += *buf - '0';
            }
            else
            if ( '.' == *buf ||
                '\'' == *buf ||
                '"'  == *buf ||
                '-'  == *buf )
            {
                buf++;
                break;
            }
            else
            {
                return (-1);
            }
            buf++;
        }
        if ( tmp > 0xff )
        {
            return (-1);
        }
        val |= tmp;
    }

    *retVal = ntohl(val);
    return 0;
}


/**
 * @brief handle transfer u64string to counter64 value

 * @param[in]    buf        u64string buf
 * @param[in]    bufLen     u64string buf len
 * @param[in]    retC64Val  return counter64 value

 * @returns      0 means success, others fail.
 */
int32_t moxaSnmpHandle_UtilStringToCount64Value( const char          *buf,
                                                 int                  bufLen,
                                                 struct counter64    *retC64Val )
{
    unsigned long long cal = 0;

    for ( int i = 0; i < bufLen; i++, buf++)
    {
        if ( *buf >= '0' && *buf <= '9')
        {
            cal = *buf - '0' + cal * 10;
        }
        else
        {
            /* only process 0 ~ 9 */
            LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__ );
            return (-1);
        }

    }
    retC64Val->high = ( cal >> 32 ) & 0x00000000ffffffff;
    retC64Val->low  = ( cal )       & 0x00000000ffffffff;
    return 0;
}


/**
 * @brief strchr within bufLen

 * @param[in]    buf      buffer
 * @param[in]    bufLen   buffer len
 * @param[in]    token    token to parse

 * @returns      a pointer to the first occurrence of the character c in the string s.
                 NULL means fail
 */
char * moxaSnmpHandle_UtilStringStrchr( char *buf,
                                        int   bufLen,
                                        char  token  )
{
    char *end = buf + bufLen;

    while( buf < end )
    {
        if( token == *buf )
        {
            return buf;
        }
        buf++;
    }
    return NULL;
}


/**
 * @brief handle transfer snmp hex OctString to bitValue

 * @param[in]    request          netsnmp request
 * @param[out]   setBuffer        return value buffer

 * @returns      0 means success, others fail.
 */
int32_t moxaSnmpHandle_UtilSnmpRequestToBitValue( netsnmp_request_info       *request ,
                                                  struct moxaSnmpSetBuffer   *setBuffer )
{
#define CHECK_MOXA_SNMP_BITS_ENABLE(index, indexBuff)   ( ((indexBuff)[(index)/8]) & ( 0x01 << ( 8 - (( index % 8 ) + 1)) ) )
    char *buf;
    int   reqBitLen = 0;
    int   i;

    reqBitLen = request->requestvb->val_len * 8;
    buf       = request->requestvb->val.string;

    if ( reqBitLen > MOXA_SNMP_MAX_BIT_VALUE_LEN )
    {
        LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__ );
        return (-1);
    }

    for ( i = 0; i < reqBitLen; i++ )
    {
        setBuffer->valBitBuf[i] = ( CHECK_MOXA_SNMP_BITS_ENABLE(i, buf) ) ?
            MOXA_SNMP_BIT_ENABLE : MOXA_SNMP_BIT_DISABLE;
    }
    setBuffer->valBitBufLen = reqBitLen;

    return 0;
#undef CHECK_MOXA_SNMP_BITS_ENABLE
}


/**
 * @brief get snmp-set-buffer

 * @param[in]    reqinfo   netsnmp register handle
 * @param[in]    request   netsnmp request
 * @param[in]    entry     moxa snmp entry
 * @param[out]   setBuffer moxa snmp set value buffer

 * @returns      0 means success, others fail.
 */
int32_t moxaSnmpHandle_UtilSnmpGetSetBuffer( netsnmp_agent_request_info *reqinfo,
                                             netsnmp_request_info       *request,
                                             struct ies_auto_mibs_entry *entry,
                                             struct moxaSnmpSetBuffer   *setBuffer  )
{

    switch(entry->val_type)
    {
        case SNMP_DATA_TYPE_INTEGER32:
        // case SNMP_DATA_TYPE_INTEGER: same as SNMP_DATA_TYPE_INTEGER32
        case SNMP_DATA_TYPE_TIME_TICKS:
        case SNMP_DATA_TYPE_COUNTER32:
        //case SNMP_DATA_TYPE_COUNTER: same as SNMP_DATA_TYPE_COUNTER32
        case SNMP_DATA_TYPE_UNSIGNED32:
        //case SNMP_DATA_TYPE_GAUGE32: same as SNMP_DATA_TYPE_UNSIGNED32
        //case SNMP_DATA_TYPE_GAUGE:   same as SNMP_DATA_TYPE_UNSIGNED32
            setBuffer->valStrBufLen = snprintf(setBuffer->valStrBuf, MOXA_SNMP_MAX_STR_VALUE_LEN,
                "%d", *request->requestvb->val.integer);
            setBuffer->type = MOXA_SNMP_VALUE_STR_BUF;
            break;
        case SNMP_DATA_TYPE_IP_ADDR_PRIM:
            {
                unsigned  char *ipStr = NULL;

                ipStr = ( unsigned char * ) request->requestvb->val.string;
                setBuffer->valStrBufLen = snprintf(setBuffer->valStrBuf, MOXA_SNMP_MAX_STR_VALUE_LEN,
                    "%d.%d.%d.%d",
                    ipStr[0], ipStr[1], ipStr[2], ipStr[3]);
                setBuffer->type = MOXA_SNMP_VALUE_STR_BUF;
            }
            break;
        case SNMP_DATA_TYPE_MAC_ADDRESS:
            {
                unsigned  char *macStr = NULL;

                macStr = ( unsigned char * ) request->requestvb->val.string;
                setBuffer->valStrBufLen = snprintf(setBuffer->valStrBuf, MOXA_SNMP_MAX_STR_VALUE_LEN,
                    "%2.2x:%2.2x:%2.2x:%2.2x:%2.2x:%2.2x",
                    macStr[0], macStr[1], macStr[2], macStr[3], macStr[4], macStr[5]);
                setBuffer->type = MOXA_SNMP_VALUE_STR_BUF;
            }
            break;
        case SNMP_DATA_TYPE_OCTET_PRIM:
        case SNMP_DATA_TYPE_OPAQUE:
            {
                int reqValLen = request->requestvb->val_len;
                if ( entry->oct_type == IES_URI_SNMP_OCT_STRING_ASCII )
                {
                    if ( reqValLen >= ( MOXA_SNMP_MAX_STR_VALUE_LEN - 1 ) )
                    {
                        return (-1);
                    }
                    memcpy(setBuffer->valStrBuf, request->requestvb->val.string, reqValLen);
                    setBuffer->valStrBuf[reqValLen] = '\0';
                    setBuffer->valStrBufLen         = reqValLen;
                    setBuffer->type                 = MOXA_SNMP_VALUE_STR_BUF;
                }
                else
                {
                    if ( moxaSnmpHandle_UtilSnmpRequestToBitValue(request, setBuffer) != 0 )
                    {
                        return (-1);
                    }
                    setBuffer->type = MOXA_SNMP_VALUE_BIT_BUF;
                }
            }
            break;
        case SNMP_DATA_TYPE_OBJECT_ID:
            {
                oid *valOid       =  request->requestvb->val.objid;
                int  valOidLen    = (request->requestvb->val_len) / 4;
                int  valStringLen = 0;
                int  valOidIndex  = 0;
                for ( valOidIndex = 0; valOidIndex < valOidLen; valOidIndex++ )
                {
                    if ( moxaSnmpHandle_UtilStringSnprintf((char *)setBuffer->valStrBuf, MOXA_SNMP_MAX_STR_VALUE_LEN,
                            &valStringLen, "%d.", (unsigned int) valOid[valOidIndex]) != 0 )
                    {
                        return (-1);
                    }
                }
                valStringLen --; // skip last `.`
                setBuffer->valStrBuf[valStringLen] = '\0';
                setBuffer->valStrBufLen            = valStringLen;
                setBuffer->type                    = MOXA_SNMP_VALUE_STR_BUF;
            }
            break;
        default:
            /* not support */
            LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__ );
            return (-1);
    }
    return 0;
}


/**
 * @brief update snmp-get-request

 * @param[in]    reqinfo    netsnmp register handle
 * @param[in]    request    netsnmp request
 * @param[in]    entry      moxa snmp entry
 * @param[in]    valStr     value string
 * @param[in]    reqOid     request oid
 * @param[in]    reqOidLen  request oid len

 * @returns      0 means success, others fail.
 */
int32_t moxaSnmpHandle_UtilSnmpUpdateGetRequest( netsnmp_agent_request_info *reqinfo,
                                                 netsnmp_request_info       *request,
                                                 struct ies_auto_mibs_entry *entry,
                                                 char                       *valStr,
                                                 oid                        *reqOid,
                                                 int                         reqOidLen )
{
    unsigned int u32Value = 0x0;

    switch(entry->val_type)
    {
        case SNMP_DATA_TYPE_INTEGER32:
        // case SNMP_DATA_TYPE_INTEGER: same as SNMP_DATA_TYPE_INTEGER32
            u32Value = atoi(valStr);
            snmp_set_var_typed_value(request->requestvb, ASN_INTEGER,
                (u_char *)&u32Value, sizeof(u32Value));
            break;
        case SNMP_DATA_TYPE_TIME_TICKS:
            u32Value = atoi(valStr);
            snmp_set_var_typed_value(request->requestvb, ASN_TIMETICKS,
                (u_char *)&u32Value, sizeof(u32Value));
            break;
        case SNMP_DATA_TYPE_GAUGE32:
        //case SNMP_DATA_TYPE_GAUGE:
        //case SNMP_DATA_TYPE_UNSIGNED32:
            u32Value = atoi(valStr);
            snmp_set_var_typed_value(request->requestvb, ASN_GAUGE,
                (u_char *)&u32Value, sizeof(u32Value));
            break;
        case SNMP_DATA_TYPE_COUNTER32:
        //case SNMP_DATA_TYPE_COUNTER: same as SNMP_DATA_TYPE_COUNTER32
            u32Value = atoi(valStr);
            snmp_set_var_typed_value(request->requestvb, ASN_COUNTER,
                (u_char *)&u32Value, sizeof(u32Value));
            break;
        case SNMP_DATA_TYPE_IP_ADDR_PRIM:
            if ( strlen(valStr) == 0 )
            {
                u32Value = 0;
            }
            else
            if ( moxaSnmpHandle_UtilStringToIPv4Value(valStr, strlen(valStr), &u32Value) != 0 )
            {
                return (-1);
            }
            snmp_set_var_typed_value(request->requestvb, ASN_IPADDRESS,
                (u_char *)&u32Value, sizeof(u32Value));
            break;
        case SNMP_DATA_TYPE_MAC_ADDRESS:
            {
                char  macAddr [6] = {0x0};
                char *tmp         = NULL;
                int   i           = 0;

                if ( strlen(valStr) == 0 )
                {
                    memset(macAddr, 0, sizeof(macAddr));
                }
                else
                {
                    for ( i = 0, tmp = valStr; i < 6; i++ )
                    {
                        macAddr[i] = moxaSnmpHandle_UtilStringToHexValue(tmp, 2);
                        tmp += 2;
                        if ( ':' == *tmp )
                        {
                            tmp++;
                        }
                    }
                }
                snmp_set_var_typed_value( request->requestvb, ASN_OCTET_STR,
                    (u_char *)macAddr, sizeof(macAddr));
            }
            break;
        case SNMP_DATA_TYPE_OCTET_PRIM:
        case SNMP_DATA_TYPE_OPAQUE:
            {
                char binValue[128] = {0x0};
                int  binValueLen;

                if ( entry->oct_type == IES_URI_SNMP_OCT_STRING_ASCII )
                {
                    snmp_set_var_typed_value( request->requestvb, ASN_OCTET_STR,
                        (u_char *)valStr, strlen(valStr));
                }
                else
                {
                    binValueLen = strlen(valStr) / 2;
                    if ( binValueLen >= sizeof(binValue)  )
                    {
                        LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__ );
                        return (-1);
                    }
                    for ( int i = 0; i < binValueLen; i++ )
                    {
                        binValue[i] = moxaSnmpHandle_UtilStringToHexValue(&valStr[i * 2], 2);
                    }
                    snmp_set_var_typed_value( request->requestvb, ASN_OCTET_STR,
                        (u_char *)binValue, binValueLen);
                }
            }
            break;
        case SNMP_DATA_TYPE_OBJECT_ID:
            {
                oid     oidValue[MAX_OID_LEN] = {0x0};
                size_t  oidValueLen;

                if ( strlen(valStr) == 0 )
                {
                    memset(oidValue, 0, 1);
                    oidValueLen = 1;
                }
                else
                if ( moxaSnmpHandle_UtilStringToObjectID(
                        valStr, strlen(valStr),
                        oidValue, &oidValueLen, MAX_OID_LEN ) != 0 )
                {
                    LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__ );
                    return (-1);
                }
                snmp_set_var_typed_value( request->requestvb, ASN_OBJECT_ID,
                    (const u_char *)oidValue, oidValueLen * sizeof(oid));
            }
            break;
        case SNMP_DATA_TYPE_COUNTER64:
            {
                struct counter64   c64Value = {0x0};

                if ( moxaSnmpHandle_UtilStringToCount64Value(valStr, strlen(valStr), &c64Value) != 0 )
                {
                    LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__ );
                    return (-1);
                }
                snmp_set_var_typed_value(request->requestvb, ASN_COUNTER64,
                    (u_char *)&c64Value, sizeof(c64Value));
            }
            break;
        default:
            /* not support */
            LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__ );
            return (-1);
    }
    snmp_set_var_objid(request->requestvb, reqOid, reqOidLen);
    return 0;
}


