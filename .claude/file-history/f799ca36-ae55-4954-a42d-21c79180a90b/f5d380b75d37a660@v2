/**
 * @brief function body for table Entry list head

 * @param[in]    handleType      MOXA_SNMP_TABLE_ENTRY_LIST_HEAD_CREATE / MOXA_SNMP_TABLE_ENTRY_LIST_HEAD_DUMP
 * @param[out]   retListHead     return free moxaSnmpTableEntry_listHead;

 * @returns      0 means success, others fail.
 */
int32_t __UtilUriTableEntryHandle( int32_t                              handleType,
                                   struct moxaSnmpTableEntry_listHead **retListHead  )
{
#define MAX_SNMP_TABLE_LIST_HEAD  1024

static struct moxaSnmpTableEntry_listHead     bufTblEntryListHead[MAX_SNMP_TABLE_LIST_HEAD]  = {0x0};
static int                                    cntTblEntryListHead                            = 0;


    struct moxaSnmpTableEntry_listHead *listHead;

    if ( handleType == MOXA_SNMP_TABLE_ENTRY_LIST_HEAD_CREATE )
    {
        listHead = &bufTblEntryListHead[cntTblEntryListHead];
        cntTblEntryListHead++;

        if ( cntTblEntryListHead >= MAX_SNMP_TABLE_LIST_HEAD )
        {
           LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
           return (-1);
        }

        memset(listHead, 0, sizeof(*listHead));
        *retListHead = listHead;

        return 0;
    }
    else
    if ( handleType == MOXA_SNMP_TABLE_ENTRY_LIST_HEAD_DUMP )
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "%s@%d dump <<< \n", __func__, __LINE__);
        for ( int i = 0; i < cntTblEntryListHead; i++ )
        {
            struct ies_auto_mibs_entry  *entry = NULL;
            int                          index = 0;

            listHead = &bufTblEntryListHead[i];

            entry    = LIST_FIRST(listHead);
            index    = 0;

            LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "\n");
            LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "listHead [%02d] %s\n", i, entry->uri);
            LIST_FOREACH(entry, listHead, listNode)
            {
                index++;
                LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "[%02d] %s\n", index, entry->uri_index);
            }
            LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "\n");
        }
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "%s@%d dump >>> \n", __func__, __LINE__);
        return 0;
    }

    LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
    return (-1);

#undef MAX_SNMP_TABLE_LIST_HEAD
}


