        if ( debugMessage != NULL  )
        {
            LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "%s@%d debugMessage = %s\n",
                __func__, __LINE__, debugMessage );
            json_free_serialized_string(debugMessage);
        }
        goto config_end;
    }

    /* Vincent retry-poll: 2 s hard sleep → up to 400 ms poll
     * (commands can take longer than data SETs; allow more retries) */
    moxaSnmpHandle_UtilPollIssReady(gUriHandle, MOXA_SNMP_POLL_STATUS_URI,
                                     security_token,
                                     MOXA_SNMP_POLL_CMD_MAX_RETRIES,
                                     MOXA_SNMP_POLL_INTERVAL_MS);

    moxaSnmpHandle_UtilDumpJsonVal(__func__, __LINE__, uriPath, jsonValCmdResult);

