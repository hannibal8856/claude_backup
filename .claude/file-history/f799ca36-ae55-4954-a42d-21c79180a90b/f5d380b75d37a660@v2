/**
 * @brief create list-head entry for uri Mib Table entry
          needed for creating uri-MIB-table oid-value-file

 * @param[in]    entry        moxa snmp entry

 * @returns      0 means success, others fail.
 */
int32_t moxaSnmpHandle_UtilUriTableEntryCreateListHead( struct ies_auto_mibs_entry  *entry )
{
    static struct ies_auto_mibs_entry  *indexEntry = NULL;
    struct moxaSnmpTableEntry_listHead *listHead   = NULL;

    if ( moxaSnmpHandle_UtilMibEntryCheckFromUri(entry)          &&
         moxaSnmpHandle_UtilMibEntryCheckSingleIndexTable(entry) )
    {
        if ( 1 == moxaSnmpHandle_UtilMibEntryGetTableEntryOID(entry) )
        {
            indexEntry = entry;
            if ( moxaSnmpHandle_UtilUriTableEntryGetNewListHead(&listHead) != 0 )
            {
                LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
                return (-1);
            }
            indexEntry->listHead = listHead;
        }
    }
    else
    {
        indexEntry = NULL;
    }

    if ( indexEntry != NULL )
    {
         if ( 0 == MOXA_SNMP_COMPARE_URI(indexEntry->uri, entry->uri) )
         {
             entry->listHead = indexEntry->listHead;
             listHead        = indexEntry->listHead;
             LIST_INSERT_TAIL_FOR_MOXA_SNMP_ENTRY(listHead, entry, listNode);
         }
    }
    return 0;
}


/**
 * @brief create index-entry for moxa snmp entry

 * @param[in]    entry        moxa snmp entry
 * @param[out]   retEntry     return index-entry for moxa snmp entry

 * @returns      0 means success, others fail.
 */
int32_t moxaSnmpHandle_UtilMibEntryCreateIndexEntry( struct ies_auto_mibs_entry  *entry,
                                                     struct ies_auto_mibs_entry **retEntry )
{
    struct ies_auto_mibs_entry *entryIndex = NULL;

    entryIndex = (struct ies_auto_mibs_entry *) malloc ( sizeof(*entry) );

    if ( entryIndex == NULL )
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
        return (-1);
    }
    memcpy(entryIndex, entry, sizeof(*entry));

    entryIndex->oid_list[entryIndex->oid_len - 1] = 1;
    entryIndex->val_type                          = SNMP_DATA_TYPE_INTEGER;
    entryIndex->mode                              = HANDLER_CAN_RONLY;

    memcpy(entryIndex->flags, entry->flags, sizeof(entry->flags));
    snprintf(entryIndex->name,      IES_MAX_URI_INDEX, "%s", "index");
    snprintf(entryIndex->uri_index, IES_MAX_URI_INDEX, "%s", "index");

    *retEntry = entryIndex;
    return 0;
}


/**
 * @brief register moxa snmp entry into netSNMP

 * @param[in]    entry        moxa snmp entry

 * @returns      0 means success, others fail.
 */
int32_t moxaSnmpHandle_UtilMibEntryRegisterToNetSNMP( struct ies_auto_mibs_entry  *entry )
{
    netsnmp_handler_registration       *reginfo    = NULL;

    if ( moxaSnmpHandle_UtilUriTableEntryCreateListHead(entry) != 0 )
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n",
            __func__, __LINE__);
        return (-1);
    }

    reginfo = netsnmp_create_handler_registration(
        entry->uri,
        mox_snmp_handle_entry,
        entry->oid_list,
        entry->oid_len,
        entry->mode);


    if ( reginfo == NULL  )
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n",
            __func__, __LINE__);
        return (-1);
    }


    reginfo->my_reg_void  = (void *) entry;

    if ( moxaSnmpHandle_UtilMibEntryCheckScalar(entry) )
    {
        if ( MIB_REGISTERED_OK != netsnmp_register_scalar(reginfo) )
        {
            LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n",
                __func__, __LINE__);
            return (-1);
        }
    }
    else
    {
        reginfo->handler->flags |= MIB_HANDLER_AUTO_NEXT;
        if ( MIB_REGISTERED_OK != netsnmp_register_handler(reginfo) )
        {
            LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n",
                __func__, __LINE__);
            return (-1);
        }
    }

    if ( cnt_reginfo >= MAX_BUF_REGINFO )
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n",
            __func__, __LINE__);
        return (-1);
    }
    buf_reginfo[cnt_reginfo] = reginfo;
    cnt_reginfo++;
    return 0;
}

