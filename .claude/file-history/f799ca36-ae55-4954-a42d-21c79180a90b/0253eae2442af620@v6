/*-------------------------------------------------------------------+
 * Function           : ies_auto_mibs_load_mibs
 *
 * Description        :
        

+-------------------------------------------------------------------*/
ies_handle_t 
ies_auto_mibs_load_mibs(void)
{

    memset(buf_reginfo, 0, sizeof(buf_reginfo));
    cnt_reginfo = 0;

/** Begin MIB : RFC1213 */
    MOX_SNMP_INIT_ENTRY(stdsnmdb_MibEntry);
    /* Plan C: register ifmibdb normally; agentx_owned.list (read in
       mox_snmp_init_entry) decides per-column — RO ifTable/ifXTable columns are
       skipped (→ ISS subagent), RW (ifAdminStatus) stays local (→ framework SET). */
    MOX_SNMP_INIT_ENTRY(ifmibdb_MibEntry);
/** End   MIB : RFC1213 */

/** Begin MIB : LLDP */
    MOX_SNMP_INIT_ENTRY(stdllddb_MibEntry);
    MOX_SNMP_INIT_ENTRY(stdot1db_MibEntry);
    MOX_SNMP_INIT_ENTRY(stdot3db_MibEntry);
    MOX_SNMP_INIT_ENTRY(stdcipdb_MibEntry);
    MOX_SNMP_INIT_ENTRY(stdpnodb_MibEntry);
    MOX_SNMP_INIT_ENTRY(mx_lldp_MibEntry);
/** End   MIB : LLDP */

/** Begin MIB : Port Mirror */
    //## mxPortMirror.mib

    MOX_SNMP_INIT_ENTRY(mx_portMirror_MibEntry);
/** End   MIB : Port Mirror */


/** Begin MIB : EtherLike-MIB */
    MOX_SNMP_INIT_ENTRY(stdethdb_MibEntry);
/** End   MIB : EtherLike-MIB */

/** Begin MIB : Port*/
    MOX_SNMP_INIT_ENTRY(mxPortdb_MibEntry);
/** End   MIB : Port */

/** Begin MIB : vlan */
    MOX_SNMP_INIT_ENTRY(stdvladb_MibEntry);
    MOX_SNMP_INIT_ENTRY(stdbrgdb_MibEntry);
    MOX_SNMP_INIT_ENTRY(stdbridb_MibEntry);
    MOX_SNMP_INIT_ENTRY(mx_vlan_MibEntry);
/** End   MIB : vlan */

/** Begin MIB : RSTP */
    MOX_SNMP_INIT_ENTRY(mxRSTPdb_MibEntry);
    MOX_SNMP_INIT_ENTRY(std1w1db_MibEntry);
    MOX_SNMP_INIT_ENTRY(std1d1db_MibEntry);
/** End   MIB : RSTP */

/** Begin MIB : StormCtrl */
    MOX_SNMP_INIT_ENTRY(mxStcldb_MibEntry);
/** End   MIB : StormCtrl */

/** Begin MIB : MOXA-QOS */
    MOX_SNMP_INIT_ENTRY(mxQosdb_MibEntry);
/** End   MIB : MOXA-QOS */

/** Begin MIB : LA */
    MOX_SNMP_INIT_ENTRY(stdladb_MibEntry);
    MOX_SNMP_INIT_ENTRY(mxLAdb_MibEntry);
/** End   MIB : LA */

/** Begin MIB : PortSecurity */
    MOX_SNMP_INIT_ENTRY(mxPsmsdb_MibEntry);
    MOX_SNMP_INIT_ENTRY(mxPsspdb_MibEntry);
/** End   MIB : PortSecurity */

/** Begin MIB : trustAccess */
    MOX_SNMP_INIT_ENTRY(mxSysTrustAccess_MibEntry);
/** End   MIB : trustAccess */

/** Begin MIB: mxSNMP       */
    MOX_SNMP_INIT_ENTRY(mxSnmp_MibEntry);
    MOX_SNMP_INIT_ENTRY(mxTrap_MibEntry);
/** End   MIB: mxSNMP       */

#if !defined(INCLUDE_MOXA_L3)
/** Begin MIB: mxDhcpSrv    */
    MOX_SNMP_INIT_ENTRY(mx_dhcpSrvdb_MibEntry);
/** End   MIB: mxDhcpSrv    */
#endif

/** Begin MIB: stdrmondb    */
    MOX_SNMP_INIT_ENTRY(stdrmodb_MibEntry);
    MOX_SNMP_INIT_ENTRY(mx_RMON_MibEntry);
/** End   MIB: stdrmondb    */

/** Begin MIB: IGMP         */
    MOX_SNMP_INIT_ENTRY(mxIgmpdb_MibEntry);
/** End   MIB: IGMP         */

/** Begin MIB: mxTr2    */
    MOX_SNMP_INIT_ENTRY(mxTurboRingV2_MibEntry);
/** End   MIB: mxTr2    */

/** Begin MIB: pNAC    */
    MOX_SNMP_INIT_ENTRY(mxDot1xdb_MibEntry);
    MOX_SNMP_INIT_ENTRY(mxRadiusdb_MibEntry);
    MOX_SNMP_INIT_ENTRY(stdpnadb_MibEntry);
/** End   MIB: pNAC    */

#if !defined(MOXA_TURBO_CHAIN_HIDE_UI)
/** Begin MIB: turboChain    */
    MOX_SNMP_INIT_ENTRY(mxTcdb_MibEntry);
/** End   MIB: turboChain    */
#endif

/** Begin MIB: mxCounter    */
    MOX_SNMP_INIT_ENTRY(mxTcstdb_MibEntry);
/** End   MIB: mxCounter    */


/** Begin MIB: WarningNotification    */
    MOX_SNMP_INIT_ENTRY(mx_event_general_MibEntry);
    MOX_SNMP_INIT_ENTRY(mx_event_switching_MibEntry);
    MOX_SNMP_INIT_ENTRY(mx_event_poe_MibEntry);
    /* Plan D (Design C PoC): portEvent config OIDs are now owned by the
     * app_moxa_framework AgentX subagent (GET in-process + SET via loopback
     * REST). Do not register them in-master here so the subagent is sole owner.
     * NOTE PoC only migrates the portOn scalars; the rest of this array
     * (portOff/rateLimit scalars + the portsPbmp table) are temporarily
     * unserved until the full mapping lands. */
    /* MOX_SNMP_INIT_ENTRY(mx_event_port_MibEntry); */
#if defined(MOXA_INTEL_TEMP_CTRL)
    MOX_SNMP_INIT_ENTRY(mx_event_hardware_MibEntry);
#endif
#if defined(MOXA_TRACKING)
    MOX_SNMP_INIT_ENTRY(mx_event_tracking_MibEntry);
#endif
#if defined(INCLUDE_MOXA_L3)
    MOX_SNMP_INIT_ENTRY(mx_event_routing_MibEntry);
#endif
/** End   MIB: WarningNotification    */

#if !defined(MOXA_DUAL_HOMING_HIDE_UI)
/** Begin MIB: dualHoming    */
    MOX_SNMP_INIT_ENTRY(mxDualdb_MibEntry);
/** End   MIB: dualHoming    */
#endif

/** Begin MIB: rateLimit(PortDisable)    */
    MOX_SNMP_INIT_ENTRY(mxRlpsdb_MibEntry);
/** End   MIB: rateLimit(PortDisable)    */

/** Begin MIB: email    */
    MOX_SNMP_INIT_ENTRY(mx_email_MibEntry);
/** End   MIB: email    */

/** Begin MIB : Syslog server */
    MOX_SNMP_INIT_ENTRY(mx_syslogServer_MibEntry);
/** End   MIB : Syslog server */

/** Begin MIB : Event log */
    MOX_SNMP_INIT_ENTRY(mx_eventLog_MibEntry);
/** End   MIB : Event log */

/** Begin MIB: mxDeviceIO  */
    MOX_SNMP_INIT_ENTRY(mx_deviceIO_MibEntry);
/** End   MIB: mxDeviceIO  */

/** Begin MIB : Login Policy */
    MOX_SNMP_INIT_ENTRY(mx_LoginPolicy_MibEntry);
/** End   MIB : Login Policy */

/** Begin MIB : Password Policy */
    MOX_SNMP_INIT_ENTRY(mx_PasswordPolicy_MibEntry);
/** End   MIB : Password Policy */

/** Begin MIB : mxGeneralInfo */
    MOX_SNMP_INIT_ENTRY(mx_generalInfomation_MibEntry);
/** End   MIB : mxGeneralInfo */

/** Begin MIB : mxDhcpSnp */
    MOX_SNMP_INIT_ENTRY(mxDhcpSnpdb_MibEntry);
/** End   MIB : mxDhcpSnp */

#if defined(INCLUDE_MOXA_L3)
/** Begin MIB : mxVrrp */
    MOX_SNMP_INIT_ENTRY(mxVrrpdb_MibEntry);
/** End   MIB : mxVrrp */

/** Begin MIB : stdvrrp */
    MOX_SNMP_INIT_ENTRY(vrrpdb_MibEntry);
/** End   MIB : stdvrrp */

/** Begin MIB : stdvrrp3 */    
    MOX_SNMP_INIT_ENTRY(vrrp3db_MibEntry);
/** End   MIB : stdvrrp3 */

    MOX_SNMP_INIT_ENTRY(stdipdb_MibEntry);
    MOX_SNMP_INIT_ENTRY(mxArpdb_MibEntry);
    MOX_SNMP_INIT_ENTRY(mxIpIfdb_MibEntry);

/** Begin MIB: static route    */
    MOX_SNMP_INIT_ENTRY(mxStaticRoutedb_MibEntry);
/** End   MIB: static route    */

/** Begin MIB: unicast routing table    */
    MOX_SNMP_INIT_ENTRY(mxUnicastRoutingTabledb_MibEntry);
/** End   MIB: unicast routing table    */

/** Begin MIB: OSPF    */
    MOX_SNMP_INIT_ENTRY(stdospdb_MibEntry);
    MOX_SNMP_INIT_ENTRY(mxOspfdb_MibEntry);
/** End   MIB: OSPF    */
#endif

/** Begin MIB : MAB */
    MOX_SNMP_INIT_ENTRY(mxMabdb_MibEntry);
/** End   MIB : MAB */

#if defined(MOXA_MACSEC)
/** Begin MIB : mxMacsec */
    MOX_SNMP_INIT_ENTRY(mxMacsecdb_MibEntry);
/** End   MIB : mxMacsec */
#endif

#if defined(MOXA_TRACKING)
/** Begin MIB: mxTracking    */
    MOX_SNMP_INIT_ENTRY(mxTrackingdb_MibEntry);
/** End   MIB: mxTracking    */
#endif


    return IES_NOERR;
} 


