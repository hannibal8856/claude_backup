/****************************************************************************
 Description        : 
    
    將 input URI 轉成 以下的格式
    char  uri_col_buf[IES_MAX_URI_COL][IES_MAX_URI_COL_LEN] = {0x0};
    使用  '/' 作 uri_col_buf[idx] 的分隔
    
*****************************************************************************/
ies_handle_t
remapper_util_buf_handle_get_uri_col_buf
(
    u8    *iputURI,
    char  *uri_col_buf_input,
    int   *uri_col_idx
)
{
    char  *iputURICol = NULL;
    int    i = 0;

    for ( i = 0, *uri_col_idx = 0, iputURICol = ( char * ) &iputURI[0]; 
          i < IES_MAX_URI; 
          /* blank */ )
    {
        if ( '/'   == iputURI[i] ||  '\0' == iputURI[i] )
        {
            if ( '/' == iputURI[i] )
            {
                iputURI[i] = '\0';
                snprintf(uri_col_buf_input + ( *uri_col_idx * IES_MAX_URI_COL_LEN ), 
                    IES_MAX_URI_COL_LEN, "%s/", iputURICol);
                *uri_col_idx = *uri_col_idx + 1;
                if ( *uri_col_idx >= IES_MAX_URI_COL )
                {
                    
                }
                iputURICol = ( char * ) &iputURI[ i + 1 ];
            }
            else
            if ( '\0' == iputURI[i] )
            {
                snprintf(uri_col_buf_input + ( *uri_col_idx * IES_MAX_URI_COL_LEN ), 
                    IES_MAX_URI_COL_LEN, "%s", iputURICol);
                break;
            }
        }
        i++;
    }
    return IES_NOERR;
}


/****************************************************************************
 Description        : 

    input-buf 屬於以下格式
    oid='value' 
    此 function 會抽出 oid 跟 'value'

*****************************************************************************/
ies_handle_t
remapper_util_buf_handle_get_oid_and_value
(
    char                              *iput_buf,
    int                                iput_buf_len,
    int                               *oid_buf,
    int                               *oid_buf_idx,
    char                             **ret_buf_val
)
{
    char                              *iput_buf_tmp          = NULL;
    int                                get_value = 0, i = 0;
    
    for ( i = 0, iput_buf_tmp = &iput_buf[0], *oid_buf_idx = 0, get_value = 0; 
          i < iput_buf_len; 
          /* blank */ )
    {
        if ( '.' == iput_buf[i] || '=' == iput_buf[i] )
        {
            if ( '=' == iput_buf[i] )
            {
                get_value    = 1;
                *ret_buf_val = &iput_buf[i+1];
            }
            iput_buf[i]          = '\0';
            oid_buf[*oid_buf_idx] = atoi(iput_buf_tmp);
            if ( 1 == get_value )
            {
                break;
            }
            i++;
            iput_buf_tmp = &iput_buf[i];
            *oid_buf_idx = *oid_buf_idx + 1;
            if ( *oid_buf_idx >= IES_MAX_OID )
            {
                LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__ );
                return IES_ERR;
            }
        }
        else
        {
            i++;
        }
    }

    
    if ( i > iput_buf_len )
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__ );
        return IES_ERR;
    }

    return IES_NOERR;
}



