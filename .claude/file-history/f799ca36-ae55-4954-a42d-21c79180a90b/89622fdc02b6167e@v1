/**
 * @brief handle transfer object-id-string to oid

 * @param[in]    buf           object-id-string buffer
 * @param[in]    bufLen        object-id-string buffer len
 * @param[out]   retOID        return oid buffer
 * @param[out]   retOIDLen     return oid buffer len
 * @param[in]    retOIDLenMax  return oid buffer max len

 * @returns      0 means success, others fail.
 */
int32_t moxaIssUriRemap_Util_StringObjectIDToOID( const char     *buf,
                                                  const uint32_t  bufLen,
                                                  uint32_t       *retOID,
                                                  uint32_t       *retOIDLen,
                                                  const uint32_t  retOIDLenMax )
{
    char     *end           = ( char *) buf + bufLen;
    char     *token         = NULL;
    uint32_t  oidBufIndex   = 0;
    char      tmpOidStr[32] = {0x0};
    uint32_t  tmpOidStrLen  = 0;

    LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "%s@%d : %s(%d) \n",
        __func__, __LINE__, buf, bufLen);

    for ( token = (char *) buf; buf <= end; buf++ )
    {
        if ( *buf == ',' || *buf == '.' || *buf == '\'' || *buf == '\0' )
        {
            tmpOidStrLen = buf - token;
            if ( tmpOidStrLen >= sizeof(tmpOidStr) )
            {
                LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "%% %s@%d : tmpOidStrLen(%d) exceed max(%d)\n",
                    __func__, __LINE__, tmpOidStrLen, sizeof(tmpOidStr));
                return (-1);
            }
            memset(tmpOidStr, 0, sizeof(tmpOidStr));
            memcpy(tmpOidStr, token, tmpOidStrLen);
            tmpOidStr[tmpOidStrLen] = '\0';
            token = (char *) buf + 1;
            retOID[oidBufIndex] = atoi(tmpOidStr);
            oidBufIndex++;
            if ( oidBufIndex >= retOIDLenMax )
            {
                LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "%% %s@%d : oidBufIndex(%d) exceed retOIDLenMax %d\n",
                    __func__, __LINE__, oidBufIndex, retOIDLenMax);
                return (-1);
            }
        }
    }
    *retOIDLen = oidBufIndex;

    return 0;
}

/****************************************************************************
 Description        : 

    更新過的 strchr 

    只會針對 buf 長度做 strchr

*****************************************************************************/
char * 
remapper_util_buf_strchr
(
    char *buf, 
    int   buf_len, 
    char  token
)
{
    char *end = buf + buf_len;
    while( buf < end ){
        if( token == *buf ){
            return buf;
        }
        buf++;
    }
    return NULL;
}

/****************************************************************************
 Description        : 

    更新過的 snprintf 

    可以對一塊 buf 的不同位址(idx), 作 snprintf 的動作 
    好比說 如果用一個 int array 作 oid 的儲存
    可以使用以下的方式印整個 oid
    {
        int  oid_buf[]     = {1,3,6,1,2,1,2,2,1,1};
        int  oid_buf_idx   = 0;
        char tmp_buf[1024] = {0x0};
        int  tmp_buf_idx   = 0;

        oid_buf_idx = sizeof(oid_buf) / sizeof(oid_buf_idx[0]);

        for ( i = 0; i <= oid_buf_idx; i++ )
        {
            remapper_util_buf_sprintf((char *)tmp_buf, sizeof(tmp_buf), 
                &tmp_buf_idx, " %d ", (unsigned int)oid_buf[i]);
        }

        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "%s@%d oid %s \n", __func__, __LINE__, tmp_buf);
    }
*****************************************************************************/
ies_handle_t 
remapper_util_buf_sprintf
(
    char   *iput_buf, 
    int     iput_buf_len, 
    int    *iput_buf_idx, 
    char   *fmt, 
    ...
)
{

    char   *iput_buf_current_position;
    int     iput_buf_available_len;
    int     len;
    va_list ap;

    if ( *iput_buf_idx >= iput_buf_len )
    {
        return IES_ERR;
    }
    
    iput_buf_available_len    = iput_buf_len - *iput_buf_idx;
    iput_buf_current_position = &iput_buf[*iput_buf_idx];

    va_start(ap, fmt);
    len = vsnprintf(iput_buf_current_position, iput_buf_available_len, fmt, ap);
    va_end(ap);

    iput_buf_available_len -= len;
    if (iput_buf_available_len > 0 ) 
    {
        *iput_buf_idx += len;
        return IES_NOERR;
    }
    return IES_ERR;
}


/****************************************************************************
 Description        : 

    類似 atoi 的轉換，只是將轉換的方式從 Dec 改成 Hex

    舉例來說：
    input_buf[] = "4032"; ( 4個 byte )，
    經過此 function 的轉換

    oput_buf     會變成 0x4032 ( 2個 byte )
    oput_buf_idx 會是   2

*****************************************************************************/
ies_handle_t 
remapper_util_buf_atox
(
    char         *iput_buf, 
    int           iput_buf_len, 
    char         *oput_buf,
    int           oput_buf_len, 
    int          *oput_buf_idx
)
{
    int           i;
    char          tmp, sum;

    for ( i = 0, *oput_buf_idx = 0, sum = 0; 
          i < iput_buf_len ; 
          i++ ) 
    {
        if ( *iput_buf >= '0' && *iput_buf <= '9' ) 
        {
            tmp = *iput_buf - '0';
        } 
        else 
        if ( *iput_buf >= 'a' && *iput_buf <= 'f' ) 
        {
            tmp = *iput_buf - 'a' + 10;
        } 
        else 
        if ( *iput_buf >= 'A' && *iput_buf <= 'F' ) 
        {
            tmp = *iput_buf - 'A' + 10;
        } 
        else 
        if ( *iput_buf == 0x00 || *iput_buf == '\r' || *iput_buf == '\n' ) 
        {
            break;
        }
        else 
        {
            return IES_ERR;
        }
        sum  = sum << 4;
        sum |= tmp & 0xf;
        if ( 0 == ( i + 1 ) % 2 ) 
        {
            *oput_buf_idx            = i / 2;
             oput_buf[*oput_buf_idx] = sum;
            *oput_buf_idx            = *oput_buf_idx + 1 ;
            sum                      = 0;
            if ( *oput_buf_idx >= oput_buf_len )
            {
                return IES_ERR;
            }
        }
        iput_buf ++;
    }
    return IES_NOERR;
}


/****************************************************************************
 Description        : 

    確認 data port 在 read / update 時的轉換方式

    OID_PORT_NORMAL 代表 不需轉換
    OID_PORT_FILTER 代表 需要濾掉這些資訊
    OID_PORT_UPDATE 代表 需要更新 port 的 內容 
                         而更新的內容會回傳到 oput_port 中

*****************************************************************************/
iss_remapper_port_t
remapper_util_check_data_port
(
    int              iput_port, 
    int             *oput_port, 
    ies_uri_handle_t type,
    iss_remap_port_t port_type
)
{
    if ( IES_URI_HANDLE_TYPE_READ == type )
    {
        // read 面對的 port 是從 1 開始的
        if ( iput_port >= 1 && iput_port <= gMaxPortInSystem )
        {
            return OID_PORT_NORMAL;
        }
        else
        if ( iput_port > gMaxPortInSystem && iput_port <= gMaxPortInPlatform )
        {
            return OID_PORT_FILTER;
        }
        else
        if ( iput_port > gMaxPortInPlatform && iput_port < (gMaxPortInPlatform + ( gMaxPortInPlatform / 2 ) + 1 /* vlanMgmt */) )
        {
            iput_port  = iput_port - gMaxPortInPlatform;
            *oput_port = gMaxPortInSystem + iput_port;
            return OID_PORT_UPDATE;
        }
        else
        if ( iput_port == ( gMaxPortInPlatform + ( gMaxPortInPlatform / 2 ) + 1 /* vlanMgmt */ ) )
        {
            *oput_port = gMaxPortInSystem + gMaxPortChannel + 1;
            return OID_PORT_FILTER;
        }
#if !defined(INCLUDE_MOXA_L3)
        else
        if ( iput_port > (gMaxPortInPlatform + ( gMaxPortInPlatform / 2 ) + 1 /* vlanMgmt */) && iput_port <= MOXA_MAX_IVR_IF_INDEX )
        {
            iput_port  = iput_port - gMaxPortInPlatform;
            *oput_port = gMaxPortInSystem + iput_port;
            return OID_PORT_UPDATE;
        }
#else
        else if ( iput_port >= MOXA_MIN_IVR_IF_INDEX && iput_port <= MOXA_MAX_IVR_IF_INDEX )  /* L3 Vlan Interface */
        {            
            return OID_PORT_NORMAL;
        }
        else if (iput_port >= MOXA_MIN_LOOPBACK_IF_INDEX && iput_port < MOXA_MAX_LOOPBACK_IF_INDEX) /* Loopback interface */
        {
            return OID_PORT_NORMAL;
        }
#endif

    }
    else
    if ( IES_URI_HANDLE_TYPE_UPDATE == type )
    {

        // update 面對的 port 是從 0 開始的
        if ( REMAP_PORT_TYPE_1BASE == port_type )
        {
            iput_port -= 1;
        }
        if ( iput_port >= 0 && iput_port < gMaxPortInSystem )
        {
            return OID_PORT_NORMAL;
        }
        else
        if ( iput_port >= gMaxPortInSystem && iput_port < ( gMaxPortInSystem + gMaxPortChannel /* vlanMgmt */ ) )
        {
            iput_port  = iput_port - gMaxPortInSystem;
            *oput_port = gMaxPortInPlatform + iput_port;
            if ( REMAP_PORT_TYPE_1BASE == port_type )
            {
                *oput_port = *oput_port + 1;
            }
            return OID_PORT_UPDATE;
        }
        else
        if ( iput_port == ( gMaxPortInSystem + gMaxPortChannel + 1 ) /* vlanMgmt */ )
        {
            iput_port  = iput_port - gMaxPortInSystem;
            *oput_port = gMaxPortInPlatform + iput_port;
            if ( REMAP_PORT_TYPE_1BASE == port_type )
            {
                *oput_port = *oput_port + 1;
            }
            return OID_PORT_UPDATE;
        }
        else if ( iput_port > (gMaxPortInPlatform + ( gMaxPortInPlatform / 2 ) + 1 /* vlanMgmt */) && iput_port <= MOXA_MAX_IVR_IF_INDEX )
        {
            iput_port  = iput_port - gMaxPortInSystem;
            *oput_port = gMaxPortInPlatform + iput_port;
            if ( REMAP_PORT_TYPE_1BASE == port_type )
            {
                *oput_port = *oput_port + 1;
            }
            return OID_PORT_UPDATE;
        }
    }
    LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d iput_port = %d\n", __func__, __LINE__, iput_port );
    return OID_PORT_ERROR;
}

/****************************************************************************
 Description        : 

    從 每個 mib 中 找到需要更新的 table 的 handler

*****************************************************************************/
iss_remapper_handle_t 
remapper_util_lookup_mib_table_handler_for_general
(
    struct remapper_mib_handler *mib_table,
    int                          mib_tableCount,
    u8                          *iputURI,
    u8                          *oputURI,
    u8                          *iputFile,
    u8                          *oputFile,
    ies_uri_handle_t             type
)
{

    struct remapper_mib_handler *mib_table_handler = NULL;
    ies_handle_t                 ret               = IES_ERR;
    int i; 
    
    for ( i = 0; i < mib_tableCount; i++ )
    {
        mib_table_handler = &mib_table[i];

        if ( COMPARE_ISS_SNMP_URI(iputURI, mib_table_handler->uri )  )
        {
            if ( IES_URI_HANDLE_TYPE_READ == type ) 
            {
                ret = mib_table_handler->read(iputURI, iputFile, oputFile);
            }
            else
            if ( IES_URI_HANDLE_TYPE_UPDATE == type ) 
            {
                ret = mib_table_handler->update(iputURI, oputURI, iputFile, oputFile);
            }
            else
            {
                return REMAP_ERROR;
            }
            return ( IES_NOERR == ret ) ? REMAP_NOERR : REMAP_ERROR ; 
        }
    }
    return REMAP_NOT_FOUND;
}

