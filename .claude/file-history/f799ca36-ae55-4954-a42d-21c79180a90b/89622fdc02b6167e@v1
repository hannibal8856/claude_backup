/****************************************************************************
 Description        : 

    Recombination of pbmp array in bits

*****************************************************************************/
ies_handle_t
remapper_util_pbmp_table_reorganize
(
    char                              *pbmp_bit_array,
    int                                pbmp_bit_array_len
)
{
    int                                i = 0;
    int                                vaild_bit_length   = gMaxPortInPlatform + gMaxPortChannel;
    int                                invalid_bit_length = gMaxPortInPlatform - gMaxPortInSystem;

    if ( pbmp_bit_array_len < vaild_bit_length )
        return IES_ERR;

    if ( invalid_bit_length == 0 )
        return IES_NOERR;

    for (i = gMaxPortInSystem; i < vaild_bit_length - invalid_bit_length; i++)
    {
        pbmp_bit_array[i] = pbmp_bit_array[i + invalid_bit_length];
        pbmp_bit_array[i + invalid_bit_length] = 0x0;
    }

    return IES_NOERR;
}


/****************************************************************************
 Description        :

    轉換 port-bit-map 型態的 table 

*****************************************************************************/
ies_handle_t
remapper_util_buf_handle_pbmap_table
(
    struct remapper_tableEntryHandler *handle_table,
    int                                handle_table_len,
    int                               *oid_table,
    int                                oid_table_len,
    char                              *iput_buf,
    int                                iput_buf_len,
    char                              *oput_buf,
    int                                oput_buf_len
)
{

    int                                oid_buf[IES_MAX_OID]  = {0x0};
    int                                oid_buf_idx           = 0;
    char                              *iput_buf_val          = NULL;
    int                                oput_buf_idx          = 0;
    int                                entry_oid = 0, j = 0, rem_len = 0;
    char                               pbmap_array[ISS_MAX_BIT_VALUE + 8 /* just in case */ ]  = {0x0};
    int                                pbmap_array_len = 0;
    char                               pbmp_bit_array[(ISS_MAX_BIT_VALUE + 8) * HALF_BYTES_BITS_NUM] = {0x0};
    int                                pbmp_bit_array_len = (ISS_MAX_BIT_VALUE + 8) * HALF_BYTES_BITS_NUM;
    char                               pbmp_hex_array[ISS_MAX_HEX_VALUE + 8] = {0x0};
    int                                pbmp_hex_array_len = ISS_MAX_HEX_VALUE + 8;

    int                                pbmp_maxPortEffectValue = get_pbmp_array_len(gMaxPortInSystem + gMaxPortChannel);

    snprintf(oput_buf, oput_buf_len, "%s", iput_buf);

    if ( IES_NOERR != remapper_util_buf_handle_get_oid_and_value(
            iput_buf, iput_buf_len, 
            oid_buf, &oid_buf_idx, &iput_buf_val) )
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__ );
        return IES_ERR;
    }

    if ( oid_buf_idx < oid_table_len )
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__ );
        return IES_ERR;
    }

    entry_oid = oid_buf[oid_table_len];

    if ( 0 == remapper_util_snmp_check_transfer_by_oid(handle_table, handle_table_len, entry_oid) )
    {
        return IES_NOERR;
    }

    if ( IES_NOERR != remapper_util_snmp_trans_val_to_pbmap(
            iput_buf_val, pbmap_array, ISS_MAX_BIT_VALUE, &pbmap_array_len, &rem_len) )
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__ );
        return IES_ERR;
    }

    /* Convert pbmp value into bits format */
    if ( IES_NOERR != remapper_util_snmp_trans_pbmp_hex_val_to_bits(
            pbmap_array, pbmap_array_len, pbmp_bit_array, pbmp_bit_array_len) )
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__ );
        return IES_ERR;
    }

    /* Recombine the pbmp array based on gMaxPortInSystem and gMaxPortChannel */
    if ( IES_NOERR != remapper_util_pbmp_table_reorganize(pbmp_bit_array, pbmp_bit_array_len) )
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__ );
        return IES_ERR;
    }

    /* Convert pbmp value back to hex format */
    if ( IES_NOERR != remapper_util_snmp_trans_pbmp_bits_val_to_hex(
            pbmp_hex_array, pbmp_hex_array_len, pbmp_bit_array, pbmp_bit_array_len) )
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__ );
        return IES_ERR;
    }

    memcpy(pbmap_array, pbmp_hex_array, pbmp_hex_array_len);

    oput_buf_idx = 0;
    memset(oput_buf, 0, oput_buf_len);
    for ( j = 0; j < oid_buf_idx; j++ )
    {
        remapper_util_buf_sprintf((char *)oput_buf, oput_buf_len, 
            &oput_buf_idx, "%d.", (unsigned int)oid_buf[j]);
    }

    remapper_util_buf_sprintf((char *)oput_buf, oput_buf_len, 
        &oput_buf_idx, "%d='", (unsigned int)oid_buf[oid_buf_idx]);

    for ( j = 0; j < pbmp_maxPortEffectValue; j++ )
    {
        remapper_util_buf_sprintf((char *)oput_buf, oput_buf_len, 
            &oput_buf_idx, "%x", (unsigned char )pbmap_array[j]);
    }

    for ( j = 0; j < rem_len - pbmp_maxPortEffectValue; j++ )
    {
        remapper_util_buf_sprintf((char *)oput_buf, oput_buf_len, 
            &oput_buf_idx, "0");
    }

    remapper_util_buf_sprintf((char *)oput_buf, oput_buf_len, 
        &oput_buf_idx, "'\n");


    return IES_NOERR;
}



