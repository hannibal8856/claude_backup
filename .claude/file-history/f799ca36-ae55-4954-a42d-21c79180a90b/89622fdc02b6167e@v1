/****************************************************************************
 Description        : 

   將此 port-bit-map value 轉成 hex array 的格式
   iput_buf_val 的格式會是如下
    1. 'value'\n
    2. '0xhex_value'\n

*****************************************************************************/
ies_handle_t
remapper_util_snmp_trans_val_to_pbmap
(
    char *iput_buf_val,
    char *pbmp_array,
    int   pbmp_array_max,
    int  *pbmp_array_len,
    int  *rem_len
)
{
    int iput_buf_val_len = 0;
    int i;
    char *tmp;

    if ( '\'' == iput_buf_val[0] )
    {
        iput_buf_val++;
    }

    if ( 0 == strncmp("0x", iput_buf_val, 2) ) 
    {
        iput_buf_val += 2;
    }
    
    iput_buf_val_len = strlen(iput_buf_val);
    
    tmp = remapper_util_buf_strchr(iput_buf_val, strlen(iput_buf_val), '\n' );
    if ( NULL != tmp )
    {
        *tmp = '\0';
        iput_buf_val_len -= 1;
    }

    tmp = remapper_util_buf_strchr(iput_buf_val, strlen(iput_buf_val), '\'' );
    if ( NULL != tmp )
    {
        *tmp = '\0';
        iput_buf_val_len = iput_buf_val_len - 1;
    }

    if ( pbmp_array_max < iput_buf_val_len )
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d max = %d %d\n", __func__, __LINE__, pbmp_array_max,  iput_buf_val_len );
        return IES_ERR;
    }

    *rem_len = iput_buf_val_len;

    for ( i = 0, *pbmp_array_len = 0; i < iput_buf_val_len; i++ )
    {
        if ( *iput_buf_val >= '0' && *iput_buf_val <= '9' )
        {
            *iput_buf_val = *iput_buf_val - '0';
        }
        else
        if ( *iput_buf_val >= 'a' && *iput_buf_val <= 'f' )
        {
            *iput_buf_val = *iput_buf_val - 'a' + 10;
        }
        else
        if ( *iput_buf_val >= 'A' && *iput_buf_val <= 'F' )
        {
            *iput_buf_val = *iput_buf_val - 'A' + 10;
        }
        else
        {
            LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d %2.2x\n", __func__, __LINE__, (unsigned char )*iput_buf_val);
            return IES_ERR;
        }
        pbmp_array[i]   = *iput_buf_val;
        *pbmp_array_len = *pbmp_array_len + 1;
        iput_buf_val    = iput_buf_val + 1;
    }

    return IES_NOERR;
}


/****************************************************************************
 Description        : 

   將此 ifindex-objID value 轉成 oid array 的格式

*****************************************************************************/
ies_handle_t
remapper_util_snmp_trans_val_to_ifidxObj
(
    char *iput_buf_val,
    int  *oid_array,
    int   oid_array_max,
    int  *oid_array_len
)
{
    int   i = 0;
    int   iput_buf_val_len = 0;
    char *iput_buf_tmp;
    int   get_last = 0;

    if ( '\'' == iput_buf_val[0] )
    {
        iput_buf_val++;
    }
    else
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__ );
        return IES_ERR;
    }

    iput_buf_val_len = strlen(iput_buf_val) - 1 /* \n */;

    if ( oid_array_max < iput_buf_val_len )
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d max = %d %d\n", __func__, __LINE__, oid_array_max,  iput_buf_val_len );
        return IES_ERR;
    }

    for ( i = 0, iput_buf_tmp = iput_buf_val; i < iput_buf_val_len; i++ )
    {
        if ( '.' == iput_buf_val[i] || ',' == iput_buf_val[i] ||'\'' == iput_buf_val[i] )
        {
            if ( '\'' == iput_buf_val[i] )
            {
                get_last = 1;
            }
            iput_buf_val[i]           = '\0';
            oid_array[*oid_array_len] = atoi(iput_buf_tmp);
            iput_buf_tmp              = &iput_buf_val[ i  + 1 ];
            if ( 0 == get_last )
            {
                *oid_array_len = *oid_array_len + 1;
            }
            else
            {
                break;
            }
        }
    }

    return IES_NOERR;
}

