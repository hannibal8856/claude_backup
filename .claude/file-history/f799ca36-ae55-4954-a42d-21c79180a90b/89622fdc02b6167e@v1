            oid_buf, &oid_buf_idx, &iput_buf_val) )
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__ );
        return IES_ERR;
    }

    port_oid_idx = oid_buf_idx - port_oid_offset;
    port = oid_buf[ port_oid_idx ];

    # if 0
    {
        char tmp_buf[1024] = {0x0};
        int  tmp_buf_idx   = 0;
        for ( i = 0; i <= oid_buf_idx; i++ )
        {
            remapper_util_buf_sprintf((char *)tmp_buf, sizeof(tmp_buf), &tmp_buf_idx, " %d ", (unsigned int)oid_buf[i]);
        }
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "%s@%d oid %s port %d value %s\n", __func__, __LINE__, tmp_buf, port, iput_buf_val );
    }
    #endif //

    ret_port  = remapper_util_check_data_port(port, &update_port, 
        IES_URI_HANDLE_TYPE_READ, REMAP_PORT_TYPE_DEFAULT);

    if ( OID_PORT_NORMAL == ret_port )
    {
        return IES_NOERR;
    }
    else
    if ( OID_PORT_FILTER == ret_port )
    {
        snprintf(oput_buf, oput_buf_len, "#\n");
        return IES_NOERR;
    }
    else
    if ( OID_PORT_UPDATE == ret_port )
    {
        for ( i = 0, oput_buf_idx = 0 ; i <= oid_buf_idx  ; i++ )
        {
            if ( i == port_oid_idx )
            {
                if ( IES_NOERR != remapper_util_buf_sprintf(
                    (char *)oput_buf, oput_buf_len, &oput_buf_idx, 
                    "%d", (unsigned int)update_port) )
                {
                    LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__ );
                    return IES_ERR;
                }
            }
            else
            {
                if ( IES_NOERR != remapper_util_buf_sprintf(
                    (char *)oput_buf, oput_buf_len, &oput_buf_idx, 
                    "%d", (unsigned int)oid_buf[i]) )
                {
                    LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__ );
                    return IES_ERR;
                }
            }

            if ( i != oid_buf_idx )
            {
                if ( IES_NOERR != remapper_util_buf_sprintf(
                    (char *)oput_buf, oput_buf_len, &oput_buf_idx, ".") )
                {
                    LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__ );
                    return IES_ERR;
                }
            }
            else
            {
                if ( IES_NOERR != remapper_util_buf_sprintf(
                    (char *)oput_buf, oput_buf_len, &oput_buf_idx, "=") )
                {
                    LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__ );
                    return IES_ERR;
                }
            }
        }

        if ( IES_NOERR != remapper_util_buf_sprintf(
                (char *)oput_buf, oput_buf_len, &oput_buf_idx, 
                "%s", iput_buf_val) )
        {
            LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__ );
            return IES_ERR;
        }
    }
    else
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__ );
        return IES_ERR;
    }
    return IES_NOERR;
}

/****************************************************************************
 Description        : 

    redundant interface entry 是兩個 OCT 的結構，
    而在 ISS 內，每個 OCT 是用 %02x 的格式來作輸出。

    所以如果 redundant Interface 是設成 1 跟 2 的話，
    這個值域會是 0x0102 or 0102。
 
*****************************************************************************/
ies_handle_t 
remapper_util_buf_handle_redundant_interface_entry
(
    char *iput_buf,
    int   iput_buf_len,
    char *oput_buf,
    int   oput_buf_len,
    ies_uri_handle_t type
)
{

#define MAX_REDUNDANT_OCTs_SIZE (2)
    int                 oid_buf[IES_MAX_OID]  = {0x0};
    int                 oid_buf_idx           = 0;
    char               *iput_buf_val          = NULL;
    char               *iput_buf_result       = NULL;
    int                 oput_buf_idx          = 0;
    iss_remapper_port_t ret_port              = OID_PORT_ERROR;
    char                hex_port_buf[2]       = {0x0};
    int                 hex_port_buf_idx      = 0;
    int                 port                  = 0;
    int                 port_update           = 0;
    char                port_buf[4]           = {0x0};
    int                 i, j; 

    if ( IES_URI_HANDLE_TYPE_READ == type )
    {
        if ( IES_NOERR != remapper_util_buf_handle_get_oid_and_value(
                iput_buf, iput_buf_len, 
                oid_buf, &oid_buf_idx, &iput_buf_val) )
        {
            LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__ );
            return IES_ERR;
        }
    }
    else
    {
        if ( IES_NOERR != remapper_util_buf_handle_get_result_and_value(
                iput_buf, iput_buf_len,
                &iput_buf_result, &iput_buf_val ) )
        {
            LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__ );
            return IES_ERR;
        }
    }

    if ( '\'' == iput_buf_val[0] )
    {
        iput_buf_val += 1;
    }
    
    if ( 0 == strncmp(iput_buf_val, "0x", 2) ) 
    {
        iput_buf_val += 2;
    }
    
    LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "%s@%d %s\n", __func__, __LINE__, iput_buf_val );
    
    if ( IES_URI_HANDLE_TYPE_READ == type )
    {
        for ( j = 0; j < oid_buf_idx  ; j++ )
        {
            if ( IES_NOERR != remapper_util_buf_sprintf(
                (char *)oput_buf, oput_buf_len, &oput_buf_idx, 
                "%d.", (unsigned int)oid_buf[j]) )
            {
                LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__ );
                return IES_ERR;
            }
        }
        if ( IES_NOERR != remapper_util_buf_sprintf(
             (char *)oput_buf, oput_buf_len, &oput_buf_idx, 
             "%d='", (unsigned int)oid_buf[oid_buf_idx]) )
        {
            LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__ );
            return IES_ERR;
        }
    }
    else
    {
        if ( IES_NOERR != remapper_util_buf_sprintf(
            (char *)oput_buf, oput_buf_len, &oput_buf_idx, 
            "%s='0x", iput_buf_result) )
        {
            LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__ );
            return IES_ERR;
        }
    }
    
    
    for ( i = 0; i < MAX_REDUNDANT_OCTs_SIZE; i++ )
    {
        memset(port_buf, 0, sizeof(port_buf));
        memcpy(port_buf, ( iput_buf_val + ( i * MAX_REDUNDANT_OCTs_SIZE ) ), MAX_REDUNDANT_OCTs_SIZE);
        port_buf[MAX_REDUNDANT_OCTs_SIZE] = '\0';

        if ( IES_NOERR != remapper_util_buf_atox(port_buf, MAX_REDUNDANT_OCTs_SIZE, 
            hex_port_buf, sizeof(hex_port_buf), &hex_port_buf_idx ) )
        {
            LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__ );
            return IES_ERR;
        }

        port = (int) hex_port_buf[0];
        // LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "%s@%d port_buf %s \n", __func__, __LINE__, port_buf );
        // LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "%s@%d port     %d \n", __func__, __LINE__, port );
        ret_port  = remapper_util_check_data_port(port, &port_update, 
            type, REMAP_PORT_TYPE_1BASE);

        if ( OID_PORT_NORMAL == ret_port )
        {
            port_update = port;
        }
        else
        if ( OID_PORT_FILTER == ret_port )
        {
            LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__ );
            return IES_ERR;
        }
        else
        if ( OID_PORT_UPDATE == ret_port )
        {
            ;
        }
        else
        {
            LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__ );
            return IES_ERR;
        }

        if ( IES_NOERR != remapper_util_buf_sprintf(
                (char *)oput_buf, oput_buf_len, &oput_buf_idx, 
                "%02x", port_update) )
        {
            LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__ );
            return IES_ERR;
        }
    }
    if ( IES_NOERR != remapper_util_buf_sprintf((char *)oput_buf, oput_buf_len, &oput_buf_idx, "'\n") )
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__ );
        return IES_ERR;
    }

    return IES_NOERR;
#undef MAX_REDUNDANT_OCTs_SIZE
}


/****************************************************************************
 Description        : 

    oid index table read 
 
*****************************************************************************/
ies_handle_t 
remapper_handle_entry_read_for_redundant_interface
(
    u8 *iputURI,
    u8 *iputFile,
    u8 *oputFile
)
{
    FILE               *iput_fp                = NULL;
    FILE               *oput_fp                = NULL;
    char                iput_buf[IES_MAX_FILE] = {0x0};
    char                oput_buf[IES_MAX_FILE] = {0x0};
    ies_handle_t        ret                    = IES_ERR;

    iput_fp = fopen((char *)iputFile, "r");
    if ( NULL == iput_fp )
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", 
            __func__, __LINE__ );
        ret = IES_ERR;
        goto out;
    }

    oput_fp = fopen((char *)oputFile, "w");
    if ( NULL == oput_fp )
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", 
            __func__, __LINE__ );
        ret = IES_ERR;
        goto out;
    }

    while ( !feof(iput_fp) )
    {
        if ( NULL == fgets(iput_buf, sizeof(iput_buf), iput_fp) )
        {
            break;
        }
        if ( '#' == iput_buf[0] )
        {
            fprintf(oput_fp,"%s", iput_buf);
            continue;
        }
        memset(oput_buf, 0, sizeof(oput_buf));
        if ( IES_NOERR == remapper_util_buf_handle_redundant_interface_entry(
            iput_buf, strlen(iput_buf), 
            oput_buf, sizeof(oput_buf), 
            IES_URI_HANDLE_TYPE_READ) )
        {
            fprintf(oput_fp,"%s", oput_buf);
        }
        else
        {
            LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", 
                __func__, __LINE__ );
            goto out;
        }
    }
    ret = IES_NOERR;
out:
    if ( NULL != iput_fp )
    {
        fclose(iput_fp);
    }

    if ( NULL != oput_fp )
    {
        fclose(oput_fp);
    }
    return ret;
}



