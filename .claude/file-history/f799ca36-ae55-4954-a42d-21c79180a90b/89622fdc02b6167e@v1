    LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__ );
    return IES_ERR;
}



/****************************************************************************
 Description        : 

    轉換 ifmib 型態的 table 

*****************************************************************************/
ies_handle_t
remapper_util_buf_handle_general_table
(
    struct remapper_tableEntryHandler_general *handle_table,
    int                                        handle_table_len,
    iss_remapper_table_t                       table_type,
    int                                       *oid_table,
    int                                        oid_table_len,
    char                                      *iput_buf,
    int                                        iput_buf_len,
    char                                      *oput_buf,
    int                                        oput_buf_len
)
{

    int                                        oid_buf[IES_MAX_OID]     = {0x0};
    int                                        oid_buf_idx              = 0;
    char                                      *iput_buf_val             = NULL;
    int                                        oput_buf_idx             = 0;
    iss_remapper_table_entry_handle_t          entry_type               = REMAP_ENTRY_NULL;
    iss_remapper_port_t                        ret_port                 = OID_PORT_ERROR;
    int                                        port                     = 0;
    int                                        update_port              = 0;
    int                                        port_oid_idx             = 0;
    int                                        oid_ifIndex[IES_MAX_OID] = {0x0};
    int                                        oid_ifIndex_len          = 0;
    int                                        entry_oid = 0;
    char                                       pbmap_array[ISS_MAX_BIT_VALUE + 8 /* just in case */ ]  = {0x0};
    int                                        pbmap_array_len = 0;
    int                                        pbmp_maxPortInSystem   = get_pbmp_array_len(gMaxPortInSystem);
    int                                        pbmp_maxPortInPlatform = get_pbmp_array_len(gMaxPortInPlatform);
    int                                        pbmp_maxPortChannel    = get_pbmp_array_len(gMaxPortChannel);
    int                                        i = 0, len = 0, rem_len = 0;


    snprintf(oput_buf, oput_buf_len, "%s", iput_buf);

    if ( IES_NOERR != remapper_util_buf_handle_get_oid_and_value(
            iput_buf, iput_buf_len, 
            oid_buf, &oid_buf_idx, &iput_buf_val) )
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__ );
        return IES_ERR;
    }

    if ( oid_buf_idx < oid_table_len )
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__ );
        return IES_ERR;
    }

    if ( REMAP_TABLE_NORMAL == table_type )
    {
        ; // No Need to do InputURI Transfer
    }
    else
    if ( REMAP_TABLE_PORT_INDEX                  == table_type || 
         REMAP_TABLE_PORT_INDEX_SECOND_FROM_LAST == table_type )
    {
        if ( REMAP_TABLE_PORT_INDEX_SECOND_FROM_LAST == table_type )
        {
            port_oid_idx = oid_buf_idx - 1;
        }
        else
        {
            port_oid_idx = oid_buf_idx;
        }

        port      = oid_buf[ port_oid_idx ];
        ret_port  = remapper_util_check_data_port(port, &update_port, 
            IES_URI_HANDLE_TYPE_READ, REMAP_PORT_TYPE_DEFAULT);
        if ( OID_PORT_NORMAL == ret_port )
        {
            return IES_NOERR;
        }
        else
        if ( OID_PORT_FILTER == ret_port )
        {
            snprintf(oput_buf, oput_buf_len, "#\n");
            return IES_NOERR;
        }
    }
    else
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__ );
        return IES_ERR;
    }

    entry_oid = oid_buf[oid_table_len];

    if ( 0 == remapper_util_snmp_check_transfer_by_oid_general(
        handle_table, handle_table_len, entry_oid, &entry_type) )
    {
        entry_type = REMAP_ENTRY_NML;
    }

    if ( REMAP_ENTRY_OID == entry_type ) 
    {
        if ( IES_NOERR != remapper_util_snmp_trans_val_to_ifidxObj(
                iput_buf_val, oid_ifIndex, IES_MAX_OID, &oid_ifIndex_len) )
        {
            LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__ );
            return IES_ERR;
        }
    }
    else
    if ( REMAP_ENTRY_PRMP == entry_type ) 
    {
        if ( IES_NOERR != remapper_util_snmp_trans_val_to_pbmap(
                iput_buf_val, pbmap_array, ISS_MAX_BIT_VALUE, &pbmap_array_len, &rem_len) )
        {
            LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__ );
            return IES_ERR;
        }
    }

    oput_buf_idx = 0;
    memset(oput_buf, 0, oput_buf_len);
    if ( REMAP_TABLE_NORMAL == table_type )
    {
        for ( i = 0; i < oid_buf_idx; i++ )
        {
            if ( IES_NOERR != remapper_util_buf_sprintf(
                (char *)oput_buf, oput_buf_len, &oput_buf_idx, 
                "%d.", (unsigned int)oid_buf[i]) )
            {
                LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__ );
                return IES_ERR;
            }
        }

        if ( IES_NOERR != remapper_util_buf_sprintf(
            (char *)oput_buf, oput_buf_len, &oput_buf_idx, 
            "%d='", (unsigned int)oid_buf[oid_buf_idx] ) )
        {
            LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__ );
            return IES_ERR;
        }
    }
    else
    if ( REMAP_TABLE_PORT_INDEX                  == table_type || 
         REMAP_TABLE_PORT_INDEX_SECOND_FROM_LAST == table_type )
    {
        for ( i = 0; i <= oid_buf_idx  ; i++ )
        {
            if ( i == port_oid_idx )
            {
                if ( IES_NOERR != remapper_util_buf_sprintf(
                    (char *)oput_buf, oput_buf_len, &oput_buf_idx, 
                    "%d", (unsigned int)update_port) )
                {
                    LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__ );
                    return IES_ERR;
                }
            }
            else
            {
                if ( IES_NOERR != remapper_util_buf_sprintf(
                    (char *)oput_buf, oput_buf_len, &oput_buf_idx, 
                    "%d", (unsigned int)oid_buf[i]) )
                {
                    LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__ );
                    return IES_ERR;
                }
            }

            if ( i != oid_buf_idx )
            {
                if ( IES_NOERR != remapper_util_buf_sprintf(
