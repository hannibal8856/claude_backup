static char
*get_bits(char pbmp_hex)
{
    /* data transform from hex to bit format and return as 4 array elements
     * For example:
     * pbmp_hex = 0xA -> bits[3]=1, bits[2]=0, bits[1]=1, bits[0]=0
     * pbmp_hex = 0x3 -> bits[3]=0, bits[2]=0, bits[1]=1, bits[0]=1
     * ...
     */

    int idx = 0, mask = 0, masked_n = 0, bit = 0;
    char *bits = malloc(sizeof(char) * HALF_BYTES_BITS_NUM);

    for (idx = 0; idx < HALF_BYTES_BITS_NUM; idx++)
    {
        mask =  1 << idx;
        masked_n = pbmp_hex & mask;
        bit = masked_n >> idx;
        bits[HALF_BYTES_BITS_NUM - 1 - idx] = bit;
    }

    return bits;
}

/****************************************************************************
 Description        :

    Transform hex pbmp value to bitwise format.

*****************************************************************************/
ies_handle_t
remapper_util_snmp_trans_pbmp_hex_val_to_bits
(
    char                              *pbmp_hex_array,
    int                                hex_array_len,
    char                              *pbmp_bit_array,
    int                                bit_array_len
)
{
    int idx = 0;
    char *bits_ret = NULL;

    for (idx = 0; idx < hex_array_len; idx++)
    {
        bits_ret = get_bits(pbmp_hex_array[idx]);
        memcpy ((pbmp_bit_array + (idx * HALF_BYTES_BITS_NUM)),
                bits_ret,
                sizeof(char) * HALF_BYTES_BITS_NUM);
        free(bits_ret);
    }

    return IES_NOERR;
}

/****************************************************************************
 Description        :

    Transform bit pbmp value to hex format.

*****************************************************************************/
ies_handle_t
remapper_util_snmp_trans_pbmp_bits_val_to_hex
(
    char                              *pbmp_hex_array,
    int                                hex_array_len,
    char                              *pbmp_bit_array,
    int                                bit_array_len
)
{
    int idx = 0, jdx = 0, offset = 0;

    for (idx = 0; idx < bit_array_len; idx++)
    {
        if (pbmp_bit_array[idx] == 1)
        {
            jdx = idx / HALF_BYTES_BITS_NUM;
            offset = idx % HALF_BYTES_BITS_NUM;
            pbmp_hex_array[jdx] += (1 << (HALF_BYTES_BITS_NUM - offset - 1));
        }
    }

    return IES_NOERR;
}

/****************************************************************************
 Description        :

    Insert number of 0 after array element with specified offset.

*****************************************************************************/
ies_handle_t
remapper_util_snmp_insert_zero_by_offset_and_len
(
    char                              *pbmp_bit_array,
    int                                bit_array_len,
    int                                offset,
    int                                len
)
{
    int idx = 0;

    for (idx = (bit_array_len - 1); idx >= (offset + len); idx--)
    {
        pbmp_bit_array[idx] = pbmp_bit_array[idx - len];
    }

    for (idx = 0; idx < len; idx++)
    {
        pbmp_bit_array[offset + idx] = 0;
    }

    return IES_NOERR;
}

/****************************************************************************
 Description        : 

    update port-bit-map 型態的 value

*****************************************************************************/
ies_handle_t
remapper_util_snmp_handle_pbmap_entry_update
(
    char                              *iput_buf,
    int                                iput_buf_len,
    char                              *oput_buf,
    int                                oput_buf_len
)
{

    char                              *iput_buf_val          = NULL;
    int                                oput_buf_idx          = 0;
    int                                j = 0, pad_len = 0, rem_len = 0;
    char                               pbmap_array[ISS_MAX_BIT_VALUE + 8 /* just in case */ ]  = {0x0};
    int                                pbmap_array_len = 0;
    char                               pbmp_bit_array[ISS_MAX_BIT_VALUE] = {0x0};
    int                                pbmp_bit_array_len = ISS_MAX_BIT_VALUE;
    char                               pbmp_hex_array[ISS_MAX_HEX_VALUE] = {0x0};
    int                                pbmp_hex_array_len = ISS_MAX_HEX_VALUE;


    snprintf(oput_buf, oput_buf_len, "%s", iput_buf);

    if ( IES_NOERR != remapper_util_snmp_table_get_value_from_buffer(
            iput_buf, iput_buf_len, &iput_buf_val) )
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__ );
        return IES_ERR;
    }

    if ( IES_NOERR != remapper_util_snmp_trans_val_to_pbmap(
            iput_buf_val, pbmap_array, ISS_MAX_BIT_VALUE, &pbmap_array_len, &rem_len) )
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__ );
        return IES_ERR;
    }

    /* Convert pbmp value into bits format */
    if ( IES_NOERR != remapper_util_snmp_trans_pbmp_hex_val_to_bits(
            pbmap_array, pbmap_array_len, pbmp_bit_array, pbmp_bit_array_len))
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__ );
        return IES_ERR;
    }

    oput_buf_idx = 0;
    memset(oput_buf, 0, oput_buf_len);
    remapper_util_buf_sprintf((char *)oput_buf, oput_buf_len, &oput_buf_idx, "result='0x");

    /* Insert 0 to transform trunk port index */
    pad_len = gMaxPortInPlatform - gMaxPortInSystem;
    if ( IES_NOERR != remapper_util_snmp_insert_zero_by_offset_and_len(
            pbmp_bit_array, pbmp_bit_array_len, gMaxPortInSystem, pad_len))
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__ );
        return IES_ERR;
    }

    /* Convert pbmp value back to hex format */
    if ( IES_NOERR != remapper_util_snmp_trans_pbmp_bits_val_to_hex(
            pbmp_hex_array, pbmp_hex_array_len, pbmp_bit_array, pbmp_bit_array_len))
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__ );
        return IES_ERR;
    }

    for (j = 0; j < pbmp_hex_array_len; j++)
    {
        remapper_util_buf_sprintf(
                (char *)oput_buf, oput_buf_len, &oput_buf_idx,
                "%x", (unsigned char )pbmp_hex_array[j]);
    }

    remapper_util_buf_sprintf((char *)oput_buf, oput_buf_len, &oput_buf_idx, "'\n");

    return IES_NOERR;
}




