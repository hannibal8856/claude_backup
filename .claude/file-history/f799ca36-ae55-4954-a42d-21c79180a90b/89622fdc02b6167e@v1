/****************************************************************************
 Description        : 

    genaral handler for ISS SNMP URI Remapper 

*****************************************************************************/
ies_handle_t 
IssSnmpURI_generalRemapper 
(
    u8                  *iputURI, 
    u8                  *oputURI, 
    u8                  *iputFile, 
    u8                  *oputFile, 
    ies_uri_handle_t     handleType
)
{
    struct iss_snmp_uri_remap_handler *handler;
    iss_remapper_handle_t              ret_handler = REMAP_ERROR;
    int i = 0, count = 0;
    
    if ( LIB_SYSTEM_RET_SUCCESS != LibSystem_GetMaxPortNumInSystem(&gMaxPortInSystem) )
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__ );
        return IES_ERR;
    }

    if ( LIB_SYSTEM_RET_SUCCESS != LibSystem_GetMaxPortNumOfPlatform(&gMaxPortInPlatform) )
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__ );
        return IES_ERR;
    }

    if ( gMaxPortInPlatform < gMaxPortInSystem ) /* should not happen */ 
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__ );
        return IES_ERR;
    }

    gMaxPortChannel = gMaxPortInSystem / 2;
    gMaxPortNumber  = gMaxPortInSystem + gMaxPortChannel;

    /* 
    LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "%s@%d gMaxPortInSystem   = %d\n", __func__, __LINE__, gMaxPortInSystem );
    LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "%s@%d gMaxPortInPlatform = %d\n", __func__, __LINE__, gMaxPortInPlatform );
    LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "%s@%d gMaxPortChannel    = %d\n", __func__, __LINE__, gMaxPortChannel );
    LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "%s@%d gMaxPortNumber     = %d\n", __func__, __LINE__, gMaxPortNumber );
    */

    count = sizeof(table_remap_handler)/sizeof(table_remap_handler[0]);

    for ( i = 0; i < count; i++ )
    {
        handler = &table_remap_handler[i];
        if ( COMPARE_ISS_SNMP_URI( iputURI, handler->uri ) )
        {
            if ( IES_URI_HANDLE_TYPE_READ == handleType )
            {
                ret_handler = handler->read(iputURI, iputFile, oputFile);
            }
            else
            if ( IES_URI_HANDLE_TYPE_UPDATE == handleType )
            {
                ret_handler = handler->update(iputURI, oputURI, iputFile, oputFile);
            }
            else
            {
                LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", 
                    __func__, __LINE__ );
                return IES_ERR;
            }
            if ( REMAP_NOT_FOUND == ret_handler )
            {
                goto out;
            }
            return ( REMAP_NOERR == ret_handler ) ? IES_NOERR : IES_ERR;
        }
    }
out:
    LibUtil_ExecShCmd(NULL, NULL, 0, "/bin/mv %s %s", iputFile, oputFile);
    if ( IES_URI_HANDLE_TYPE_UPDATE == handleType )
    {
        snprintf( (char *)oputURI, IES_MAX_URI, "%s", iputURI );
    }
    return IES_NOERR;
}


