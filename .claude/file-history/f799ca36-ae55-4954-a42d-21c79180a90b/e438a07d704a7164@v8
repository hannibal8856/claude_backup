use std::os::raw::{c_char, c_int, c_void};
use std::ffi::CString;

pub type Oid = u32;                       // net-snmp `oid` is unsigned long; validate width in Step 4
pub type MoxaHandler = extern "C" fn(*mut c_void, *mut c_void, *mut c_void, *mut c_void) -> c_int;

extern "C" {
    fn MoxaAgentX_Init(name: *const c_char) -> c_int;
    fn MoxaAgentX_RegisterScalar(descr: *const c_char, o: *const Oid, olen: usize,
                                 mode: c_int, h: MoxaHandler) -> c_int;
    fn MoxaAgentX_RunInThread() -> c_int;
}

pub fn init(name: &str) -> i32 {
    let c = CString::new(name).unwrap();
    unsafe { MoxaAgentX_Init(c.as_ptr()) }
}
pub fn register_scalar(descr: &str, oid: &[Oid], mode: i32, h: MoxaHandler) -> i32 {
    let c = CString::new(descr).unwrap();
    unsafe { MoxaAgentX_RegisterScalar(c.as_ptr(), oid.as_ptr(), oid.len(), mode, h) }
}
pub fn run_in_thread() -> i32 { unsafe { MoxaAgentX_RunInThread() } }
```

