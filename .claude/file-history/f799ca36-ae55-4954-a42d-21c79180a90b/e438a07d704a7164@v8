Create `src/agentx.c`:
```c
#include "lib_moxa_snmp_agentx.h"
#include <pthread.h>

static volatile int  g_running = 0;
static pthread_t     g_thr;

int MoxaAgentX_Init(const char *daemon_name)
{
    netsnmp_ds_set_boolean(NETSNMP_DS_APPLICATION_ID, NETSNMP_DS_AGENT_ROLE, 1);
    netsnmp_ds_set_string(NETSNMP_DS_APPLICATION_ID, NETSNMP_DS_AGENT_X_SOCKET,
                          "tcp:127.0.0.1:705");
    init_agent(daemon_name);
    init_snmp(daemon_name);   /* sends AgentX Open once a handler is registered */
    return 0;
}

int MoxaAgentX_RegisterScalar(const char *descr, const oid *o, size_t olen,
                              int mode, Netsnmp_Node_Handler *handler)
{
    netsnmp_handler_registration *reg =
        netsnmp_create_handler_registration(descr, handler, o, olen, mode);
    return netsnmp_register_scalar(reg);   /* scalar helper; table uses a separate fn later */
}

static void *loop(void *arg)
{
    (void) arg;
    while (g_running) {
        agent_check_and_process(1);   /* blocks up to select timeout, processes AgentX fds */
    }
    return NULL;
}

int MoxaAgentX_RunInThread(void)
{
    g_running = 1;
    return pthread_create(&g_thr, NULL, loop, NULL);
}

void MoxaAgentX_Shutdown(void)
{
    g_running = 0;
    snmp_shutdown("lib_moxa_snmp_agentx");
}
```

