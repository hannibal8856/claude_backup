int setup_snmpd_config
(
    snmp_service_cmd_t    type, 
    JSON_Value           *cfg_snmp, 
    JSON_Value           *cfg_snmpTrap, 
    JSON_Value           *cfg_uiService, 
    JSON_Value           *cfg_managementIp
)
{
    int32_t                ret                      = 0;
    int32_t                ret_cmd                  = 0;
    int32_t                ipv6_global_ucast_enable = 0;

    FILE                  *fp                    = NULL;
    JSON_Object           *jobj_cfg_snmp         = NULL;
    JSON_Object           *jobj_cfg_snmpTrap     = NULL;
    JSON_Object           *jobj_cfg_uiService    = NULL;
    JSON_Object           *jobj_cfg_managementIp = NULL;

    int32_t                uri_accessMode;
    int32_t                uri_version;
    char                  *uri_v1v2cCommunity_readWrite        = NULL;
    char                  *uri_v1v2cCommunity_readOnly         = NULL;
    JSON_Array            *uri_userAccountTable                = NULL;
    
    char                  *uri_ipv6_globalUnicastAddressPrefix = NULL;
    int32_t                uri_ipv6_udp_port;

    struct snmp_engine_id  engineID;

    jobj_cfg_snmp = json_value_get_object(cfg_snmp);
    if( jobj_cfg_snmp == NULL ) 
    {
        fprintf(stderr, "%s@%d : error json_value_get_object\n",
            __func__, __LINE__ );
        return FAILURE;
    }

    jobj_cfg_snmpTrap = json_value_get_object(cfg_snmpTrap);
    if( jobj_cfg_snmpTrap == NULL ) 
    {
        fprintf(stderr, "%s@%d : error json_value_get_object \n",
            __func__, __LINE__ );
        return FAILURE;
    }

    jobj_cfg_uiService = json_value_get_object(cfg_uiService);
    if( jobj_cfg_uiService == NULL ) 
    {
        fprintf(stderr, "%s@%d : error json_value_get_object \n",
            __func__, __LINE__ );
        return FAILURE;
    }

    if(gi4Uri_ipv6_support)
    {
        jobj_cfg_managementIp = json_value_get_object(cfg_managementIp);
        if( jobj_cfg_managementIp == NULL ) 
        {
            fprintf(stderr, "%s@%d : error json_value_get_object \n",
                __func__, __LINE__ );
            return FAILURE;
        }
    }

    if( type == STARTUP_SNMP_SERVICE)
    {
        LibUtil_ExecShCmd(NULL, NULL , 0, "/bin/mkdir -p " SNMP_CONF_RUNNING);
        fp = fopen(SNMP_CONF_FILE, "w+");
        if ( generate_snmp_engine_info(&engineID) == FAILURE )
        {
            fprintf(stderr, "%s@%d : error generate_snmp_engine_info \n",
                __func__, __LINE__ );
            return FAILURE;
        }
    }
    else
    {
        fp = fopen(SNMP_CONF_FILE_BAK, "w+");
        if ( get_file_snmp_engine_info(&engineID) == FAILURE )
        {
            fprintf(stderr, "%s@%d : error get_file_snmp_engine_info \n",
                __func__, __LINE__ );
            return FAILURE;
        }
    }

    /* Plan C PoC: enable AgentX master so ISS subagent can attach (tcp:127.0.0.1:705) */
    fprintf(fp, "master         agentx\n");
    fprintf(fp, "agentXSocket   tcp:127.0.0.1:705\n");
    fprintf(fp, "agentXTimeout  5\n");
    fprintf(fp, "agentXRetries  1\n");

    uri_version                         = (int32_t)json_object_dotget_number(jobj_cfg_snmp,         "version");
    uri_accessMode                      = (int32_t)json_object_dotget_number(jobj_cfg_uiService,    "snmpService.mode");
    uri_v1v2cCommunity_readWrite        = (char  *)json_object_dotget_string(jobj_cfg_snmp,         "v1v2cCommunity.readWrite");
    uri_v1v2cCommunity_readOnly         = (char  *)json_object_dotget_string(jobj_cfg_snmp,         "v1v2cCommunity.readOnly");
    if(gi4Uri_ipv6_support) 
    {
        uri_ipv6_globalUnicastAddressPrefix = (char  *)json_object_dotget_string(jobj_cfg_managementIp, "ipv6.globalUnicastAddressPrefix");
        uri_ipv6_udp_port                   = (int32_t)json_object_dotget_number(jobj_cfg_uiService,    "snmpService.port");
    
        ipv6_global_ucast_enable = ( strlen(uri_ipv6_globalUnicastAddressPrefix) > strlen("::") ) ? 1 : 0;
    }
    else
    {
        uri_ipv6_udp_port                   = (int32_t)json_object_dotget_number(jobj_cfg_uiService,    "snmpService.port");
        ipv6_global_ucast_enable = 0;
    }

    if ( uri_version == SNMP_VERSION_V1_V2c_V3 || uri_version == SNMP_VERSION_V1_V2c )
    {
        if ( uri_accessMode == SNMP_ACCESS_ENABLE )
        {
            fprintf(fp, "com2sec   readwrite  0.0.0.0/0 %s\n", uri_v1v2cCommunity_readWrite);
            fprintf(fp, "com2sec   readonly   0.0.0.0/0 %s\n", uri_v1v2cCommunity_readOnly);
            if ( ipv6_global_ucast_enable ) 
            {
                fprintf(fp, "com2sec6  readwrite  %s/64     %s\n", uri_ipv6_globalUnicastAddressPrefix, uri_v1v2cCommunity_readWrite);
                fprintf(fp, "com2sec6  readonly   %s/64     %s\n", uri_ipv6_globalUnicastAddressPrefix, uri_v1v2cCommunity_readOnly);
            }
            else
            {
                fprintf(fp, "com2sec6  readwrite  fe80::/64  %s\n", uri_v1v2cCommunity_readWrite);
                fprintf(fp, "com2sec6  readonly   fe80::/64  %s\n", uri_v1v2cCommunity_readOnly);
            }

        }
        else
        if ( uri_accessMode == SNMP_ACCESS_DISABLE )
        {
            fprintf(fp, "com2sec  readwrite  127.0.0.1/0 %s\n", uri_v1v2cCommunity_readWrite);
            fprintf(fp, "com2sec  readonly   127.0.0.1/0 %s\n", uri_v1v2cCommunity_readOnly);
        }
        else
        if ( uri_accessMode == SNMP_ACCESS_READ_ONLY )
        {
            fprintf(fp, "com2sec  readonly   0.0.0.0/0 %s\n", uri_v1v2cCommunity_readOnly);
            if ( ipv6_global_ucast_enable ) 
            {
                fprintf(fp, "com2sec6  readonly   %s/64     %s\n", uri_ipv6_globalUnicastAddressPrefix, uri_v1v2cCommunity_readOnly);
            }
            else
            {
                fprintf(fp, "com2sec6  readonly   fe80::/64  %s\n", uri_v1v2cCommunity_readOnly);
            }
        }

        if ( uri_accessMode == SNMP_ACCESS_ENABLE || uri_accessMode == SNMP_ACCESS_DISABLE )
        {
            fprintf(fp, "group MyRWGroup v1         readwrite\n");
            fprintf(fp, "group MyRWGroup v2c        readwrite\n");
            fprintf(fp, "group MyROGroup v1         readonly \n");
            fprintf(fp, "group MyROGroup v2c        readonly \n");
            fprintf(fp, "view all    included  .1   80       \n");
            /* Plan C: hide MIBs the framework does NOT register (ISS-leaked) so the
               exposed surface matches mainline; .68 (VRRP) is a framework vrrpdb
               handler bug that truncates walks — masked here, fix tracked separately. */
            fprintf(fp, "view all    excluded  .1.3.6.1.2.1.6\n");     /* tcp */
            fprintf(fp, "view all    excluded  .1.3.6.1.2.1.23\n");    /* rip2 */
            fprintf(fp, "view all    excluded  .1.3.6.1.2.1.26\n");    /* mau */
            fprintf(fp, "view all    excluded  .1.3.6.1.2.1.47\n");    /* entity */
            fprintf(fp, "view all    excluded  .1.3.6.1.2.1.67\n");    /* radius-std */
            /* .83/.85/.97/.185 are no longer registered by the ISS AgentX
             * subagent (see Register* call sites), so the master skips them on
             * its own — no view exclude needed. .241 stays registered and is
             * intentionally exposed, so it is not excluded either. */
            /* IP-MIB extras from RegisterSTDIPV (root .4 must stay registered —
             * it also owns .4.1-.4.24 that NOS7 exposes). Hide only the tables
             * NOS7 does not walk. */
            fprintf(fp, "view all    excluded  .1.3.6.1.2.1.4.31\n");  /* ipSystemStatsTable (ISS IP-MIB) */
            fprintf(fp, "view all    excluded  .1.3.6.1.2.1.4.32\n");  /* ipAddressPrefixTable (ISS IP-MIB) */
            fprintf(fp, "view all    excluded  .1.3.6.1.2.1.5.29\n");  /* icmpStatsTable */
            fprintf(fp, "view all    excluded  .1.3.6.1.2.1.5.30\n");  /* icmpMsgStatsTable */
            fprintf(fp, "view all    excluded  .1.3.6.1.2.1.7.7\n");   /* udpEndpointTable */
            fprintf(fp, "view all    excluded  .1.3.6.1.2.1.7.8\n");   /* udpHCInDatagrams */
            fprintf(fp, "view all    excluded  .1.3.6.1.2.1.7.9\n");   /* udpHCOutDatagrams */
            fprintf(fp, "view all    excluded  .1.3.6.1.2.1.68\n");    /* vrrp   (framework bug) */
            fprintf(fp, "view all    excluded  .1.3.6.1.2.1.207\n");   /* vrrpv3 (framework bug: >4s hang stalls walk) */
            fprintf(fp, "access MyRWGroup \"\"      any       noauth    exact  all    all    none\n");
            fprintf(fp, "access MyROGroup \"\"      any       noauth    exact  all    none   none\n");
        }
        else
        if ( uri_accessMode == SNMP_ACCESS_READ_ONLY )
        {
            fprintf(fp, "group MyROGroup v1         readonly \n");
            fprintf(fp, "group MyROGroup v2c        readonly \n");
            fprintf(fp, "view all    included  .1   80       \n");
            /* Plan C: hide MIBs the framework does NOT register (ISS-leaked) so the
               exposed surface matches mainline; .68 (VRRP) is a framework vrrpdb
               handler bug that truncates walks — masked here, fix tracked separately. */
            fprintf(fp, "view all    excluded  .1.3.6.1.2.1.6\n");     /* tcp */
            fprintf(fp, "view all    excluded  .1.3.6.1.2.1.23\n");    /* rip2 */
            fprintf(fp, "view all    excluded  .1.3.6.1.2.1.26\n");    /* mau */
            fprintf(fp, "view all    excluded  .1.3.6.1.2.1.47\n");    /* entity */
            fprintf(fp, "view all    excluded  .1.3.6.1.2.1.67\n");    /* radius-std */
            /* .83/.85/.97/.185 are no longer registered by the ISS AgentX
             * subagent (see Register* call sites), so the master skips them on
             * its own — no view exclude needed. .241 stays registered and is
             * intentionally exposed, so it is not excluded either. */
            /* IP-MIB extras from RegisterSTDIPV (root .4 must stay registered —
             * it also owns .4.1-.4.24 that NOS7 exposes). Hide only the tables
             * NOS7 does not walk. */
            fprintf(fp, "view all    excluded  .1.3.6.1.2.1.4.31\n");  /* ipSystemStatsTable (ISS IP-MIB) */
            fprintf(fp, "view all    excluded  .1.3.6.1.2.1.4.32\n");  /* ipAddressPrefixTable (ISS IP-MIB) */
            fprintf(fp, "view all    excluded  .1.3.6.1.2.1.5.29\n");  /* icmpStatsTable */
            fprintf(fp, "view all    excluded  .1.3.6.1.2.1.5.30\n");  /* icmpMsgStatsTable */
            fprintf(fp, "view all    excluded  .1.3.6.1.2.1.7.7\n");   /* udpEndpointTable */
            fprintf(fp, "view all    excluded  .1.3.6.1.2.1.7.8\n");   /* udpHCInDatagrams */
            fprintf(fp, "view all    excluded  .1.3.6.1.2.1.7.9\n");   /* udpHCOutDatagrams */
            fprintf(fp, "view all    excluded  .1.3.6.1.2.1.68\n");    /* vrrp   (framework bug) */
            fprintf(fp, "view all    excluded  .1.3.6.1.2.1.207\n");   /* vrrpv3 (framework bug: >4s hang stalls walk) */
            fprintf(fp, "access MyROGroup \"\"      any       noauth    exact  all    none   none\n");
        }

    }

    fprintf(fp, "agentAddress udp6:%d\n", uri_ipv6_udp_port);

    fprintf(fp, "sysservices            2 \n");
    fprintf(fp, "authtrapenable         1 \n");


    if ( uri_version == SNMP_VERSION_V1_V2c_V3 || uri_version == SNMP_VERSION_V3 )
    {

        fprintf(fp, "%s             %s\n", TOKEN_SNMP_ENGINEID, engineID.engine_id);
        fprintf(fp, "%s             %d\n", TOKEN_SNMP_ENGINE_BOOT, engineID.engine_boot);

        if ( uri_accessMode == SNMP_ACCESS_ENABLE ||  uri_accessMode == SNMP_ACCESS_READ_ONLY )
        {
            fprintf(fp, "engineIDNic tap0\n");
        }
        else
        if ( uri_accessMode == SNMP_ACCESS_DISABLE )
        {
            fprintf(fp, "engineIDNic  lo \n");
        }
        uri_userAccountTable = json_object_get_array(jobj_cfg_snmp, "userAccountTable");
        if ( setup_snmpd_userAccount(fp, uri_accessMode, SNMP_SERV_USER, uri_userAccountTable) == FAILURE )
        {
            fprintf(stderr, "%s@%d : error setup_snmpd_userAccount SNMP_SERV_USER \n",
                __func__, __LINE__ );
            return FAILURE;
        }
    }
    fclose(fp);
    
    
    if ( type == STARTUP_SNMP_SERVICE )
    {
        if ( uri_accessMode == SNMP_ACCESS_DISABLE)
        {
            _ControlIsSnmpd("stop");
        }
        else
        {
            _ControlIsSnmpd("restart");
            if (uri_version == SNMP_VERSION_V1_V2c_V3 || uri_version == SNMP_VERSION_V3) {
                _ExecGetSNMPv3StartEngineTime();
            }
        }
    }
    else
    {
        ret = LibUtil_ExecShCmd(&ret_cmd, NULL , 0, "/usr/bin/diff " SNMP_CONF_FILE " " SNMP_CONF_FILE_BAK " " );
        if ( ret_cmd != 0 )
        {
            ret = replace_snmpd_config_engineID(SNMP_CONF_FILE_BAK, SNMP_CONF_FILE);
            if ( ret != SUCCESS )
            {
                fprintf(stderr, "%s@%d : error replace_snmpd_config_engineID \n",
                    __func__, __LINE__ );
            }
            else
            {
                if ( uri_accessMode == SNMP_ACCESS_DISABLE)
                {
                    _ControlIsSnmpd("stop");
                }
                else
                {
                    _ControlIsSnmpd("restart");
                    if (uri_version == SNMP_VERSION_V1_V2c_V3 || uri_version == SNMP_VERSION_V3) {
                        _ExecGetSNMPv3StartEngineTime();
                    }
                }
            }
        }
    }

    return SUCCESS;
}

void setup_loginPolicy_config(JSON_Value *cfg)
{
    JSON_Object* jobj_cfg = json_value_get_object(cfg);

    FILE *fp = fopen(SNMP_ACCOUNT_LOCKOUT_CONF, "w+");
    if (fp) {
        fprintf(fp, "enable %d\n", json_object_get_boolean(jobj_cfg, "enableFailureLockout"));
        fprintf(fp, "retry %d\n", (int32_t)json_object_get_number(jobj_cfg, "retryFailureThreshold"));
        fprintf(fp, "lockTime %d\n", (int32_t)json_object_get_number(jobj_cfg, "failureLockoutTime")*60);
        fclose(fp);
    }

}


int main(int argc, char **argv)
{
    JSON_Value *cfg_snmp_pre         = NULL;
    JSON_Value *cfg_snmp_cur         = NULL;
    JSON_Value *cfg_snmpTrap_pre     = NULL;
    JSON_Value *cfg_snmpTrap_cur     = NULL;
    JSON_Value *cfg_uiService_pre    = NULL;
    JSON_Value *cfg_uiService_cur    = NULL;
    JSON_Value *cfg_managementIp_pre = NULL;
    JSON_Value *cfg_managementIp_cur = NULL;
    JSON_Value *cfg_loginPolicy_pre = NULL;
    JSON_Value *cfg_loginPolicy_cur = NULL;
    int         ret              = FAILURE;
    int         isIpConfigChanged = 0;

    cfg_managementIp_cur = json_parse_file(URI_CONFIG_CUR_RUNNING("managementIp.json"));
    if(cfg_managementIp_cur == NULL)
    {
        gi4Uri_ipv6_support = 0;
        //snprintf(logCmd, sizeof(logCmd),
        //                  "moxa_logger -p debug -t SNMP 'snmpd config without IPv6 address started'");
    }
    else
    {
        gi4Uri_ipv6_support = 1;
        //snprintf(logCmd, sizeof(logCmd),
        //                  "moxa_logger -p debug -t SNMP 'snmpd config with IPv6 address started'");
    }
    
    if ( argc == 2 && strcmp(argv[1],"start") == 0 )
    {
        cfg_snmp_cur         = json_parse_file(URI_CONFIG_CUR_RUNNING("snmp.json"));
        cfg_snmpTrap_cur     = json_parse_file(URI_CONFIG_CUR_RUNNING("snmpTrap.json"));
        cfg_uiService_cur    = json_parse_file(URI_CONFIG_CUR_RUNNING("uiServiceManagement.json"));
        cfg_loginPolicy_cur = json_parse_file(URI_CONFIG_CUR_RUNNING("loginPolicy.json"));

        if( setup_snmpd_config(STARTUP_SNMP_SERVICE, 
            cfg_snmp_cur, cfg_snmpTrap_cur, 
            cfg_uiService_cur, cfg_managementIp_cur) == FAILURE )
        {
            fprintf(stderr, "%s@%d : error setup_snmpd_config \n",
                __func__, __LINE__ );
        }
        else 
        {
            ret = SUCCESS;
        }


        setup_loginPolicy_config(cfg_loginPolicy_cur);
        json_value_free(cfg_snmp_cur);
        cfg_snmp_cur = NULL;
        json_value_free(cfg_snmpTrap_cur);
        cfg_snmpTrap_cur = NULL;
        json_value_free(cfg_uiService_cur);
        cfg_uiService_cur = NULL;
        json_value_free(cfg_loginPolicy_cur);
        cfg_loginPolicy_cur = NULL;
    }
    else 
    if ( argc == 2 && strcmp(argv[1],"reload") == 0 )
    {

        cfg_snmp_pre         = json_parse_file(URI_CONFIG_PRE_RUNNING("snmp.json"));
        cfg_snmp_cur         = json_parse_file(URI_CONFIG_CUR_RUNNING("snmp.json"));
        cfg_snmpTrap_pre     = json_parse_file(URI_CONFIG_PRE_RUNNING("snmpTrap.json"));
        cfg_snmpTrap_cur     = json_parse_file(URI_CONFIG_CUR_RUNNING("snmpTrap.json"));
        cfg_uiService_pre    = json_parse_file(URI_CONFIG_PRE_RUNNING("uiServiceManagement.json"));
        cfg_uiService_cur    = json_parse_file(URI_CONFIG_CUR_RUNNING("uiServiceManagement.json"));
        if(gi4Uri_ipv6_support)
        {
            cfg_managementIp_pre = json_parse_file(URI_CONFIG_PRE_RUNNING("managementIp.json"));
            isIpConfigChanged = json_value_equals(cfg_managementIp_pre, cfg_managementIp_cur);            
        }
        cfg_loginPolicy_pre = json_parse_file(URI_CONFIG_PRE_RUNNING("loginPolicy.json"));
        cfg_loginPolicy_cur = json_parse_file(URI_CONFIG_CUR_RUNNING("loginPolicy.json"));

        if( json_value_equals(cfg_snmp_pre,         cfg_snmp_cur          ) != 1 || 
            json_value_equals(cfg_snmpTrap_pre,     cfg_snmpTrap_cur      ) != 1 || 
            json_value_equals(cfg_uiService_pre,    cfg_uiService_cur     ) != 1 || 
            isIpConfigChanged)

        {
            if( setup_snmpd_config(RELOAD_SNMP_SERVICE, cfg_snmp_pre, cfg_snmpTrap_pre, 
                cfg_uiService_pre, cfg_managementIp_pre) == FAILURE )
            {
                fprintf(stderr, "%s@%d : error setup_snmpd_config \n",
                    __func__, __LINE__ );
            }
            else
            {
                ret = SUCCESS;
            }

        }
        else 
        {
            ret = SUCCESS;
        }

        if( json_value_equals(cfg_loginPolicy_pre, cfg_loginPolicy_cur) != 1) {
            setup_loginPolicy_config(cfg_loginPolicy_pre);
        }
        json_value_free(cfg_snmp_pre);
        cfg_snmp_pre = NULL;
        json_value_free(cfg_snmp_cur);
        cfg_snmp_cur = NULL;
        json_value_free(cfg_snmpTrap_pre);
        cfg_snmpTrap_pre = NULL;
        json_value_free(cfg_snmpTrap_cur);
        cfg_snmpTrap_cur = NULL;
        json_value_free(cfg_uiService_pre);
        cfg_uiService_pre = NULL;
        json_value_free(cfg_uiService_cur);
        cfg_uiService_cur = NULL;
        if(cfg_managementIp_pre != NULL)
        {
            json_value_free(cfg_managementIp_pre);
            cfg_managementIp_pre = NULL;
        }

        json_value_free(cfg_loginPolicy_pre);
        cfg_loginPolicy_pre = NULL;
        json_value_free(cfg_loginPolicy_cur);
        cfg_loginPolicy_cur = NULL;
    }
    else
