            fprintf(stderr, "%s@%d : error setup_snmpd_config \n",
                __func__, __LINE__ );

        }
        else 
        {
            ret = SUCCESS;
        }

        json_value_free(cfg_snmp_cur);
        cfg_snmp_cur = NULL;
        json_value_free(cfg_snmpTrap_cur);
        cfg_snmpTrap_cur = NULL;
        json_value_free(cfg_uiService_cur);        
        cfg_uiService_cur = NULL;
    }
    else
    if ( argc == 2 && strcmp(argv[1],"test_reload") == 0 )
    {
        cfg_snmp_pre         = json_parse_file(URI_CONFIG_PRE_RUNNING_TEST("snmp.json"));
        cfg_snmp_cur         = json_parse_file(URI_CONFIG_CUR_RUNNING_TEST("snmp.json"));
