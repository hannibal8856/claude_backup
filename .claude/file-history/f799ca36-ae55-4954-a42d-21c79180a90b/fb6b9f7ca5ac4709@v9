    {
        cfg_snmp_cur         = json_parse_file(URI_CONFIG_CUR_RUNNING_TEST("snmp.json"));
        cfg_snmpTrap_cur     = json_parse_file(URI_CONFIG_CUR_RUNNING_TEST("snmpTrap.json"));
