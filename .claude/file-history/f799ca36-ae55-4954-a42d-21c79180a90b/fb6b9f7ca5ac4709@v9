            ret = SUCCESS;
        }

        json_value_free(cfg_snmp_pre);
        cfg_snmp_pre = NULL;
        json_value_free(cfg_snmp_cur);
        cfg_snmp_cur = NULL;
        json_value_free(cfg_snmpTrap_pre);
        cfg_snmpTrap_pre = NULL;
        json_value_free(cfg_snmpTrap_cur);
        cfg_snmpTrap_cur = NULL;
        json_value_free(cfg_uiService_pre);
        cfg_uiService_pre = NULL;
        json_value_free(cfg_uiService_cur);
        cfg_uiService_cur = NULL;
        json_value_free(cfg_managementIp_pre);
        cfg_managementIp_pre = NULL;
    }
    else
    if ( argc == 2 && strcmp(argv[1],"test_path") == 0 )
    {
        char        plugIN_conf[MAX_PLUGIN_CONF]  = {0x0};
        setup_snmpd_plugin_conf(plugIN_conf, sizeof(plugIN_conf));
        fprintf(stderr, "plugIN_conf(%d) = \'%s\'\n", strlen(plugIN_conf), plugIN_conf);
        ret = SUCCESS;
    }
    else
    if ( argc == 2 && strcmp(argv[1],"test_default_engineID") == 0 )
    {
        struct snmp_engine_id engineID;
        if ( get_default_snmp_engine_info(&engineID) == FAILURE ) 
        {
            fprintf(stderr, "%s@%d : error get_default_snmp_engine_info \n",
                __func__, __LINE__ );
        }
        ret = SUCCESS;
    }
    else
    if ( argc == 2 && strcmp(argv[1],"test_file_engineID") == 0 )
    {
        struct snmp_engine_id engineID;
        if ( get_file_snmp_engine_info(&engineID) == FAILURE ) 
        {
            fprintf(stderr, "%s@%d : error get_file_snmp_engine_info \n",
                __func__, __LINE__ );
        }
        ret = SUCCESS;
    }
    else
    if ( argc == 2 && strcmp(argv[1],"test_generate_snmp_engine_info") == 0 )
    {
        struct snmp_engine_id engineID;
        if ( generate_snmp_engine_info(&engineID) == FAILURE ) 
        {
            fprintf(stderr, "%s@%d : error generate_snmp_engine_info \n",
                __func__, __LINE__ );
        }
        ret = SUCCESS;
    }

    json_value_free(cfg_managementIp_cur);
    cfg_managementIp_cur = NULL;

    if (ret == FAILURE)
    {
        fprintf(stderr, "%s@%d : error handle setup_snmpd_config \n",
            __func__, __LINE__ );
    }

    return ret;
}

