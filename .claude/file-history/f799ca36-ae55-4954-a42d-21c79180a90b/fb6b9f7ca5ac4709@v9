/*-------------------------------------------------------------------+
 * Function           : utilString_strchr
 *
 * Description        :
        

+-------------------------------------------------------------------*/
char * utilString_strchr(char *buf, int   buf_len, char  token)
{
    char *end = buf + buf_len;

    while( buf < end )
    {
        if( token == *buf )
        {
            return buf;
        }
        buf++;
    }
    return NULL;
}

/*-------------------------------------------------------------------+
   Function Name   : util_str_sprintf
   Description     : 

   Note            : 
+-------------------------------------------------------------------*/
int util_str_sprintf(char *buf, int buf_max, int *buf_pos, char *fmt, ... )
{

    char   *buf_index;
    int     buf_len;
    int     len;

    va_list ap;

    buf_len   = buf_max - *buf_pos;
    buf_index = &buf[*buf_pos];

    va_start(ap, fmt);
    len = vsnprintf(buf_index, buf_len, fmt, ap);
    va_end(ap);

    buf_len -= len;
    if ( buf_len > 4 /* just in case */ ) 
    {
        *buf_pos += len;
        return SUCCESS;
    }
    fprintf(stderr, "%s@%d : error \n",
        __func__, __LINE__);
    return FAILURE;
}

int util_get_hw_addr(char *dev_mac)
{
    if ( LIB_SYSTEM_RET_SUCCESS != LibSystem_GetMacAddress(dev_mac) )
    {
        fprintf(stderr, "%s@%d : error LibSystem_GetMacAddress \n",
            __func__, __LINE__);
        return FAILURE;
    }
    return SUCCESS;
}

int util_get_moxa_enterprise_id(char *enterprise_id, int max_enterprise_id)
{
    int buf_len = 0;
    char dev_mac[12] = {0x0};
    int i;
    memset(enterprise_id, 0, max_enterprise_id);
    if ( util_get_hw_addr(dev_mac) == FAILURE )
    {
        fprintf(stderr, "%s@%d : error util_get_hw_addr \n",
            __func__, __LINE__);
        return FAILURE;
    }

    if ( util_str_sprintf(enterprise_id, max_enterprise_id, &buf_len, "8000") == FAILURE )
    {
        fprintf(stderr, "%s@%d : error util_str_sprintf \n",
            __func__, __LINE__);
        return FAILURE;
    }

    if ( util_str_sprintf(enterprise_id, max_enterprise_id, &buf_len, "%04x", MOXA_SNMP_ENTERPRISE_ID) == FAILURE )
    {
        fprintf(stderr, "%s@%d : error util_str_sprintf \n",
            __func__, __LINE__);
        return FAILURE;
    }

    if ( util_str_sprintf(enterprise_id, max_enterprise_id, &buf_len, "03") == FAILURE )
    {
        fprintf(stderr, "%s@%d : error util_str_sprintf \n",
            __func__, __LINE__);
        return FAILURE;
    }

    for ( i = 0; i < 6; i++)
    {
        if ( util_str_sprintf(enterprise_id, max_enterprise_id, &buf_len, "%02x", dev_mac[i]) == FAILURE )
        {
            fprintf(stderr, "%s@%d : error util_str_sprintf \n",
                __func__, __LINE__);
            return FAILURE;
        }
    }

    return SUCCESS;
}


int util_check_file_exist(char *file_name)
{

    if( access(file_name, F_OK | R_OK | W_OK) == 0 )
    {
        fprintf(stderr, " %s %s found \n", __func__, file_name);
        return -1;
    }
    else
    {
        fprintf(stderr, " %s %s NOT found \n", __func__, file_name);
        return 0;
    }
}


int get_file_snmp_engine_info(struct snmp_engine_id *engineID)
{
    char line[80] = {0x0};
    FILE *fp  = NULL;
    char *buf = NULL;
    char *buf_end = NULL;
    int   buf_len = 0;

    fp = fopen(SNMP_CONF_ENGINEID, "r");
    while( !feof(fp) )
    {
        fgets(line, sizeof(line), fp);
        if ( 0 == strncmp(TOKEN_SNMP_ENGINEID, line, strlen(TOKEN_SNMP_ENGINEID) ) )
        {

            buf     = line + strlen(TOKEN_SNMP_ENGINEID) + 2;
            buf_end = utilString_strchr(buf, strlen(buf), '\'');
            if ( buf_end != NULL )
            {
                *buf_end = '\0';
            }
            buf_len = buf_end - buf;
            memset(engineID->engine_id, 0, MAX_SNMP_ENTERPRISE_ID);
            memcpy(engineID->engine_id, buf, buf_len);
        }
        else
        if ( 0 == strncmp(TOKEN_SNMP_ENGINE_BOOT, line, strlen(TOKEN_SNMP_ENGINE_BOOT)) )
        {
            buf = line + strlen(TOKEN_SNMP_ENGINE_BOOT) + 2;
            buf_end = utilString_strchr(buf, strlen(buf), '\'');
            if ( buf_end != NULL )
            {
                *buf_end = '\0';
            }
            buf_len = buf_end - buf;
            engineID->engine_boot = atoi(buf);
        }
    }
    fclose(fp);
    //fprintf(stderr, " %32s %16s  \'%s\'\n", __func__, TOKEN_SNMP_ENGINEID,    engineID->engine_id);
    //fprintf(stderr, " %32s %16s  \'%d\'\n", __func__, TOKEN_SNMP_ENGINE_BOOT, engineID->engine_boot);
    return SUCCESS;
}

int get_default_snmp_engine_info(struct snmp_engine_id *engineID)
{
    if ( util_get_moxa_enterprise_id(engineID->engine_id, MAX_SNMP_ENTERPRISE_ID) == FAILURE ) 
    {
        return FAILURE;
    }
    engineID->engine_boot = 1;

    //fprintf(stderr, " %32s %16s  \'%s\'\n", __func__, TOKEN_SNMP_ENGINEID,    engineID->engine_id);
    //fprintf(stderr, " %32s %16s  \'%d\'\n", __func__, TOKEN_SNMP_ENGINE_BOOT, engineID->engine_boot);

    return SUCCESS;
}

int generate_snmp_engine_info(struct snmp_engine_id *engineID)
{
    FILE                  *fp = NULL;
    struct snmp_engine_id  default_engineID;
    struct snmp_engine_id  file_engineID;
    struct snmp_engine_id *running_engineID = NULL; 
    
    if ( get_default_snmp_engine_info(&default_engineID) == FAILURE ) 
    {
        fprintf(stderr, "%s@%d : error get_default_snmp_engine_info\n",
            __func__, __LINE__);
        return FAILURE;
    }
    
    if ( util_check_file_exist( SNMP_CONF_ENGINEID ) == 0 ) 
    {
        LibUtil_ExecShCmd(NULL, NULL , 0, "/bin/mkdir -p " SNMP_PERMANENT );
        running_engineID = &default_engineID;
    }
    else
    {
        if ( get_file_snmp_engine_info(&file_engineID) == FAILURE )
        {
            fprintf(stderr, "%s@%d : error get_file_snmp_engine_info\n",
                __func__, __LINE__);
            return FAILURE;
        }

        if ( strlen(file_engineID.engine_id) == strlen(default_engineID.engine_id) &&
            0 == memcmp(default_engineID.engine_id, file_engineID.engine_id, strlen(default_engineID.engine_id)) )
        {
            file_engineID.engine_boot = file_engineID.engine_boot + 1;
            running_engineID = &file_engineID;
        }
        else
        {
            running_engineID = &default_engineID;
        }
    }
    memcpy(engineID, running_engineID, sizeof(*running_engineID));
    fp = fopen(SNMP_CONF_ENGINEID, "w+");
    fprintf(fp, TOKEN_SNMP_ENGINEID    "=\'%s\'\n", running_engineID->engine_id);
    fprintf(fp, TOKEN_SNMP_ENGINE_BOOT "=\'%d\'\n", running_engineID->engine_boot);
    fclose(fp);
    
    fp = fopen(SNMP_CONF_ENGINETIME, "w+");
    fprintf(fp, TOKEN_SNMP_ENGINE_TIME "=\'%d\'\n", 0);
    fprintf(fp, TOKEN_SNMP_ENGINE_MSG_MAXSIZE "=\'%d\'\n", 1472);
    fclose(fp);
    //fprintf(stderr, " %32s %16s  \'%s\'\n", __func__, TOKEN_SNMP_ENGINEID,    engineID->engine_id);
    //fprintf(stderr, " %32s %16s  \'%d\'\n", __func__, TOKEN_SNMP_ENGINE_BOOT, engineID->engine_boot);
    return SUCCESS;
}


int setup_snmpd_plugin_conf(char *plugINConf, int32_t maxPlugINConf)
{

    char     ret_buf[1024] = {0x0};
    char     line[80] = {0x0};
    int      ret      = FAILURE;
    int32_t  ret_cmd  = 0;
    int32_t  ret_find = 0;
    int      pos      = 0;
    FILE    *fp       = NULL;
    char    *tmp      = NULL;


    ret_cmd = LibUtil_ExecShCmd(&ret_find, ret_buf , sizeof(ret_buf), "/usr/bin/find %s -name \'*.conf\' > %s", SNMP_PLUGIN_CONF_PATH, SNMP_CONFIG_TMP_FILE);

    if ( ret_cmd != 0 )
    {
        fprintf(stderr, "%s@%d : error LibUtil_ExecShCmd\n",
            __func__, __LINE__);
        goto out;
    }
    
    if ( ret_find != 0 )
    {
        fprintf(stderr, "%s@%d : error /usr/bin/find  \n",
            __func__, __LINE__);
        goto out;
    }

    if ( util_str_sprintf(plugINConf, maxPlugINConf, &pos, "%s", SNMP_CONF_FILE) == FAILURE )
    {
        fprintf(stderr, "%s@%d : error util_str_sprintf  \n",
            __func__, __LINE__);
        goto out;
    }

    fp = fopen(SNMP_CONFIG_TMP_FILE, "r");

    if ( fp == NULL )
    {
        fprintf(stderr, "%s@%d : error can't find fp  \n",
            __func__, __LINE__);
        goto out;
    }
    while ( !feof(fp) )
    {
        memset(line, 0, sizeof(line));
        fgets(line, sizeof(line), fp);
        tmp = utilString_strchr(line, strlen(line), '\r');
        if ( tmp != NULL )
        {
            *tmp = '\0';
        }
        tmp = utilString_strchr(line, strlen(line), '\n');
        if ( tmp != NULL )
        {
            *tmp = '\0';
        }
        tmp = utilString_strchr(line, strlen(line), ' ');
        if ( tmp != NULL )
        {
            *tmp = '\0';
        }
        if ( strlen(line) <= strlen(SNMP_PLUGIN_CONF_PATH)) {
            continue;
        }
        if ( util_str_sprintf(plugINConf, maxPlugINConf, &pos, ",%s", line) == FAILURE )
        {
            fprintf(stderr, "%s@%d : error util_str_sprintf  \n",
                __func__, __LINE__);
            goto out;
        }
    }
    // fprintf(stderr, "%s@%d: \'%s\'\n", __func__, __LINE__, plugINConf);
    ret = SUCCESS;
out:
    if ( fp != NULL )
    {
        fclose(fp);
    }
    return ret;
}

int setup_snmpd_userAccount(FILE *fp, int32_t uri_accessMode, snmp_userAccount_t type, JSON_Array *uri_userAccountTable)
{
    JSON_Object *jobj_cfg_userAccount         = NULL;

    char        *uri_userName                 = NULL;
    int32_t      uri_authority;
    int32_t      uri_authenticationType;
    char        *uri_authenticationPasswd     = NULL;
    int32_t      uri_dataEncryptionMethod;
    char        *uri_dataEncryptionKey        = NULL;
    int          count;
    int          i;

    char         uri_authenticationPasswdNoMark[(64+16)*2+128+1] = {0};
    char         uri_authenticationPasswdDecrypted[64+1] = {0};
    int          isAuthenticationPasswdEncrypted = 0;

    char         uri_dataEncryptionKeyNoMark[(64+16)*2+128+1] = {0};
    char         uri_dataEncryptionKeyNDecrypted[64+1] = {0};
    int          isDataEncryptionKeyEncrypted = 0;

    count = json_array_get_count(uri_userAccountTable);
    for (i = 0; i < count; i++) 
    {
        jobj_cfg_userAccount     = json_array_get_object(uri_userAccountTable, i);
        uri_userName             = (char  *) json_object_dotget_string(jobj_cfg_userAccount, "userName" );
        uri_authenticationType   = (int32_t) json_object_dotget_number(jobj_cfg_userAccount, "authenticationType");
        uri_dataEncryptionMethod = (int32_t) json_object_dotget_number(jobj_cfg_userAccount, "dataEncryptionMethod");

        if ( type == SNMP_SERV_USER )
        {
            uri_authority  = json_object_dotget_number(jobj_cfg_userAccount, "authority");
        }
        else
        {
            uri_authority  = SNMP_USER_AUTHORITY_READ_ONLY;
        }


        if ( uri_authenticationType == SNMP_USER_AUTH_TYPE_NONE )
        {
            fprintf(fp, "%s %s  noauth\n", 
                 (( uri_accessMode == SNMP_ACCESS_READ_ONLY ) || ( uri_authority == SNMP_USER_AUTHORITY_READ_ONLY)) ? 
                 "rouser" : "rwuser", uri_userName);

            fprintf(fp, "createUser %s\n", uri_userName);
        }
        else
        {
            uri_authenticationPasswd = (char *)json_object_dotget_string(jobj_cfg_userAccount, "authenticationPasswd" );

#ifdef MOXA_PASSWORD_POLICY_CHECK
            if (LibEncrypt_PasswordPolicyCheckTagRemove(uri_authenticationPasswd, uri_authenticationPasswdDecrypted) == LIB_ENCRYPT_DEF_TRUE) {
                isAuthenticationPasswdEncrypted = 1;
            }
#else
            if (LibEncrypt_IsEncryptedData(uri_authenticationPasswd) == LIB_ENCRYPT_DEF_TRUE) {
                isAuthenticationPasswdEncrypted = 1;
                LibEncrypt_KeyExtract(uri_authenticationPasswd, uri_authenticationPasswdNoMark);
                LibEncrypt_AesDecryptWithFixedKey(uri_authenticationPasswdNoMark, uri_authenticationPasswdDecrypted);
            }
#endif

            fprintf(fp, "%s %s  auth\n", 
                 (( uri_accessMode == SNMP_ACCESS_READ_ONLY ) || ( uri_authority == SNMP_USER_AUTHORITY_READ_ONLY)) ? 
                 "rouser" : "rwuser", uri_userName);

	    char* szAuthenticationType = "";
	    switch(uri_authenticationType)
	    {
		case SNMP_USER_AUTH_TYPE_MD5:
			szAuthenticationType = "MD5";
		break;
                case SNMP_USER_AUTH_TYPE_SHA:
                        szAuthenticationType = "SHA";
                break;
                case SNMP_USER_AUTH_TYPE_SHA_224:
                        szAuthenticationType = "SHA-224";
                break;
                case SNMP_USER_AUTH_TYPE_SHA_256:
                        szAuthenticationType = "SHA-256";
                break;
                case SNMP_USER_AUTH_TYPE_SHA_384:
                        szAuthenticationType = "SHA-384";
                break;
                case SNMP_USER_AUTH_TYPE_SHA_512:
                        szAuthenticationType = "SHA-512";
                break;
 	    }

            fprintf(fp, "createUser %s %s %s ", 
                uri_userName, 
                szAuthenticationType, 
                isAuthenticationPasswdEncrypted ? uri_authenticationPasswdDecrypted : uri_authenticationPasswd);

            if ( uri_dataEncryptionMethod == SNMP_USER_ENCRYPTION_DISABLE )
            {
                fprintf(fp, "\n");
            }
            else
            {
                uri_dataEncryptionKey = (char *)json_object_dotget_string(jobj_cfg_userAccount, "dataEncryptionKey" );

#ifdef MOXA_PASSWORD_POLICY_CHECK
                if (LibEncrypt_PasswordPolicyCheckTagRemove(uri_dataEncryptionKey, uri_dataEncryptionKeyNDecrypted) == LIB_ENCRYPT_DEF_TRUE) {
                    isDataEncryptionKeyEncrypted = 1;
                }
#else
                if (LibEncrypt_IsEncryptedData(uri_dataEncryptionKey) == LIB_ENCRYPT_DEF_TRUE) {
                    isDataEncryptionKeyEncrypted = 1;
                    LibEncrypt_KeyExtract(uri_dataEncryptionKey, uri_dataEncryptionKeyNoMark);
                    LibEncrypt_AesDecryptWithFixedKey(uri_dataEncryptionKeyNoMark, uri_dataEncryptionKeyNDecrypted);
                }
#endif

                fprintf(fp, "%s %s\n", 
                    ( uri_dataEncryptionMethod == SNMP_USER_ENCRYPTION_AES ) ? "AES" : "DES", 
                    isDataEncryptionKeyEncrypted ? uri_dataEncryptionKeyNDecrypted : uri_dataEncryptionKey);
            }
        }
    }
    return SUCCESS;
}


int replace_snmpd_config_engineID( char *snmpConfSource, char *snmpConfDest)
{
    FILE                  *fpSrc  = NULL;
    FILE                  *fpDst  = NULL;
    struct snmp_engine_id  engineID;
    char                   fileBuf[400] = {0x0};
    if ( generate_snmp_engine_info(&engineID) == FAILURE )
    {
        fprintf(stderr, "%s@%d : error generate_snmp_engine_info \n",
            __func__, __LINE__ );
        return FAILURE;
    }
    fpSrc = fopen(snmpConfSource, "r");
    if ( fpSrc == NULL )
    {
        fprintf(stderr, "%s@%d : error fopen \n",
            __func__, __LINE__ );
        return FAILURE;
    }
    fpDst = fopen(snmpConfDest, "w+");
    if ( fpDst == NULL )
    {
        fprintf(stderr, "%s@%d : error fopen \n",
            __func__, __LINE__ );
        fclose(fpSrc);
        return FAILURE;
    }

    while(!feof(fpSrc))
    {
        memset(fileBuf, 0, sizeof(fileBuf));
        if ( fgets(fileBuf, sizeof(fileBuf), fpSrc) == NULL )
        {
            fprintf(stderr, "%s@%d : \n", __func__, __LINE__ );
            break;
        }

        if ( strncmp(fileBuf, TOKEN_SNMP_ENGINEID, strlen(TOKEN_SNMP_ENGINEID)) == 0 )
        {
            // replace engineID
            fprintf(fpDst, "%s             %s\n", TOKEN_SNMP_ENGINEID, engineID.engine_id);
        }
        else
        if ( strncmp(fileBuf, TOKEN_SNMP_ENGINE_BOOT, strlen(TOKEN_SNMP_ENGINE_BOOT)) == 0 )
        {
            // replace boot count
            fprintf(fpDst, "%s             %d\n", TOKEN_SNMP_ENGINE_BOOT, engineID.engine_boot);
        }
        else
        {
            fprintf(fpDst, "%s", fileBuf);
        }
    }
    fclose(fpSrc);
    fclose(fpDst);
    return SUCCESS;
}


static void _System(const char *aProgram, char * const *aArgList)
{
    pid_t child_pid = fork();
    if (child_pid != 0) {
        int child_status;
        wait(&child_status);
    } else {
        execvp(aProgram, aArgList);
        /* The execvp function returns only if an error occurs. */
        fprintf(stderr, "%s:%d: execvp error: %s", __func__, __LINE__, strerror(errno));
        abort();
    }
}

static void _ControlIsSnmpd(const char *aCmd)
{

    FILE *fp               = NULL;
    char plugIN_conf[MAX_PLUGIN_CONF] = {0x0};
    char *arg_list[]       = { "/bin/systemctl", /* argv[0], the name of the program. */
                               (char *)aCmd,
                               "app_moxa_snmp_server.service",
                               NULL /* The argument list must end with a NULL. */ };

    if ( setup_snmpd_plugin_conf(plugIN_conf, sizeof(plugIN_conf)) == FAILURE )
    {
        fprintf(stderr, "%s@%d : error setup_snmpd_plugin_conf\n",
            __func__, __LINE__);
        return;
    }

    fp = fopen(SNMP_CONF_INIT_SH, "w");
    if ( fp == NULL )
    {
        fprintf(stderr, "%s@%d : error fopen %s\n",
            __func__, __LINE__, SNMP_CONF_INIT_SH);
     
        return;
    }
    fprintf(fp, "#!/bin/sh\n");
    fprintf(fp, "/bin/snmpd -f -C -c  %s -p /var/run/snmpd.pid\n", plugIN_conf);
    fclose(fp);

    _System("/bin/systemctl", arg_list);
}


static void _ExecGetSNMPv3StartEngineTime()
{
    char *const arg_list[] = {SNMPV3_CONF_GET_START_ENGINETIME_SH, NULL};

