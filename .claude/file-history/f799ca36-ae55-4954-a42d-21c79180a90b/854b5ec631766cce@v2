#define     MOXA_SNMP_ENTRY_FLAGS_SET(flagBitsNum, flagBitsArray)   ( ((flagBitsArray)[(flagBitsNum)/8]) |= ( (0x01 << ((flagBitsNum) % 8))) )
#define     MOXA_SNMP_ENTRY_FLAGS_CLR(flagBitsNum, flagBitsArray)   ( ((flagBitsArray)[(flagBitsNum)/8]) &= (~(0x01 << ((flagBitsNum) % 8))) )
#define     MOXA_SNMP_ENTRY_FLAGS_CHK(flagBitsNum, flagBitsArray)   ( ((flagBitsArray)[(flagBitsNum)/8]) &  ( (0x01 << ((flagBitsNum) % 8))) )

#define     LIST_INSERT_TAIL_FOR_MOXA_SNMP_ENTRY(head, elm, field) do { \
    struct ies_auto_mibs_entry *e1  = NULL;  \
    struct ies_auto_mibs_entry *e2  = NULL;  \
    if ( LIST_EMPTY(head) )                  \
    {                                        \
        LIST_INSERT_HEAD(head, elm, field);  \
    }                                        \
    else                                     \
    {                                        \
        LIST_FOREACH(e1, head, field) {      \
            e2 = e1;                         \
        }                                    \
        LIST_INSERT_AFTER(e2, elm, field);   \
    }                                        \
} while(0);

#define MOXA_SNMP_COMPARE_URI(__entry_uri_string, __uri) \
