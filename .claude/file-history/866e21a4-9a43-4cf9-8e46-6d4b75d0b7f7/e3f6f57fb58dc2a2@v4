ies_handle_t 
entry_handle_update_result
(
    netsnmp_agent_request_info *reqinfo,
    netsnmp_request_info       *request,
    ies_handle_done_t          done,
    FILE                       *fp 
)
{

    if ( NULL != fp ) 
    {
        fclose(fp);
    }

    if ( DONE_FOR_NO_ERROR == done ) 
    {
        netsnmp_set_request_error(reqinfo, request, SNMP_ERR_NOERROR);
        return IES_NOERR;
    } 
    else 
    if ( DONE_FOR_NO_SUCH_NAME == done ) 
    {
        netsnmp_set_request_error(reqinfo, request, SNMP_ERR_NOSUCHNAME);
        return IES_NOERR;
    } 
    // else 
    // if ( DONE_FOR_BAD_VALUE == done )  {
        netsnmp_set_request_error(reqinfo, request, SNMP_ERR_BADVALUE);
        return IES_ERR;
    //}
}

/*-------------------------------------------------------------------+
 * Function           : entry_handle_exception
 *
 * Description        :
        

+-------------------------------------------------------------------*/
ies_handle_t 
entry_handle_exception
(
    oid                          *req_oid,
    int                           req_oid_len,
    netsnmp_handler_registration *reginfo,
    netsnmp_agent_request_info   *reqinfo,
    netsnmp_request_info         *request,
    FILE                         *fp,
    struct ies_auto_mibs_entry   *entry
)
{
    netsnmp_subtree              *next_subtree = NULL;
    ies_handle_done_t             done;
    int                           ret;

    if ( NULL != fp ) 
    {
        fclose(fp);
    }

    // get next entry
    next_subtree = netsnmp_subtree_find_prev( req_oid, req_oid_len, NULL, NULL );
    while( next_subtree && 
           snmp_oid_compare(next_subtree->name_a, 
             next_subtree->namelen, 
             reginfo->rootoid, 
             reginfo->rootoid_len) <= 0 ) 
    {
        next_subtree = next_subtree->next;
    }

    if ( next_subtree ) 
    {
        snmp_set_var_objid( request->requestvb, next_subtree->name_a, next_subtree->namelen );
        next_subtree->reginfo->handler->flags |= MIB_HANDLER_AUTO_NEXT_OVERRIDE_ONCE;
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "%s line %d MIB_HANDLER_AUTO_NEXT_OVERRIDE_ONCE \n", __func__, __LINE__);
        ret = netsnmp_call_handlers( next_subtree->reginfo, reqinfo, request );
        request->processed = 1;
        done = ( SNMP_ERR_NOERROR == ret ) ? DONE_FOR_NO_ERROR : DONE_FOR_BAD_VALUE;
        return entry_handle_update_result(reqinfo, request, done, NULL);
    }
    LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "%s line %d\n", __func__, __LINE__);
    return entry_handle_update_result(reqinfo, request, DONE_FOR_NO_SUCH_NAME, NULL);

}


/*-------------------------------------------------------------------+
 * Function           : entry_handle_get_value_from_file
 *
 * Description        :
        

+-------------------------------------------------------------------*/
ies_handle_t 
entry_handle_get_value_from_file
(
    netsnmp_handler_registration *reginfo,
    netsnmp_agent_request_info   *reqinfo,
    netsnmp_request_info         *request, 
    struct ies_auto_mibs_entry   *entry,
    FILE                         *fp, 
    ies_table_handle_t            type
)
{

    char                          file_buf [IES_MAX_FILE_BUF] = {0x0};
    oid                           file_oid [MAX_OID_LEN]      = {0x0};
    int                           file_oid_len;
    char                         *file_oid_str                = NULL;
    char                         *file_val_str                = NULL;
    oid                          *req_oid;
    int                           req_oid_len;
    ies_handle_done_t             done                        = DONE_FOR_BAD_VALUE;
    ies_handle_t                  ret                         = IES_ERR;
    int                           next, i;

    
    next         = 0;
    req_oid      = (oid  *)request->requestvb->name;
    req_oid_len  = request->requestvb->name_length;

    if ( IES_NOERR == IS_SCALAR_ENTRY(entry) )
    {
        while ( 1 )
        {
            memset(file_buf, 0, sizeof(file_buf));
            memset(file_oid, 0, sizeof(file_oid));
            file_oid_len = 0;
            if ( NULL == utilSNMP_fgets(file_buf, sizeof(file_buf), fp, entry) ) 
            {
                return entry_handle_exception(req_oid, req_oid_len, reginfo, reqinfo, request, fp, entry);
            }
            
            if ( '#' == file_buf[0] )
            {
                continue;
            }

            file_oid_str = file_buf;
            file_val_str = utilString_strchr(file_buf, sizeof(file_buf), '=');
            if ( NULL == file_val_str ) 
            {
                LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
                return entry_handle_update_result(reqinfo, request, done, fp);
            }
            *file_val_str = '\0';
            file_val_str += 2;
            
            file_oid_len = utilSNMP_get_oid_from_oidstr(file_oid_str, strlen(file_oid_str), file_oid);
            if ( IES_AUTO_MIBS_TBL_GET == type ) 
            {
                if ( ( req_oid_len == file_oid_len ) &&
                     ( 0 == memcmp(req_oid, file_oid, req_oid_len * sizeof(oid)) ) ) 
                {
                    if ( IES_NOERR != get_value_from_file(file_oid, file_oid_len, 
                            file_val_str, reqinfo, request, entry)  ) 
                    {
                        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
                    } 
                    else 
                    {
                        done = DONE_FOR_NO_ERROR;
                    }
                    return entry_handle_update_result(reqinfo, request, done, fp);
                }
                else
                {
                    LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
                    break;
                }
            } 
            else
            {
                LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
                break;
            }
        }
    }
    else
    {
        utilSNMP_dump_oid("entry_handle_get_value_from_req_oid", req_oid, req_oid_len);
        ret = fileBuffer_get_oidEntry(
            &gfileBufCtrlBlock, 
            req_oid, req_oid_len,
            file_oid, &file_oid_len, file_buf,
            ( IES_AUTO_MIBS_TBL_GET == type ) ? FILE_BUF_GET_CURR_ENTRY : FILE_BUF_GET_NEXT_ENTRY );
        if ( ret == IES_ERR )
        {
            LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "%s line %d\n", __func__, __LINE__);
            return entry_handle_exception(req_oid, req_oid_len, reginfo, reqinfo, request, fp, entry);
        }
        else
        if ( ret == IES_ERR_NOT_FOUND )
        {
            LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "%s line %d\n", __func__, __LINE__);
            return entry_handle_exception(req_oid, req_oid_len, reginfo, reqinfo, request, fp, entry);
        }
        else
        if ( ret == IES_NOERR )
        {
            utilSNMP_dump_oid("entry_handle_get_value_from_file_oid", file_oid, file_oid_len);
            if ( IES_NOERR != get_value_from_file(file_oid, file_oid_len, file_buf, reqinfo, request, entry)  )
            {
                LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
                done = DONE_FOR_BAD_VALUE;
            }
            else
            {
                done = DONE_FOR_NO_ERROR;
            }
            return entry_handle_update_result(reqinfo, request, done, fp);
        }
    }
    LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
    return entry_handle_update_result(reqinfo, request, done, fp);
}

/*-------------------------------------------------------------------+
 * Function           : entry_handle_check_value_file
 *
 * Description        :
        

+-------------------------------------------------------------------*/
ies_handle_t 
entry_handle_check_value_file
(
    char                        fname[IES_MAX_FILE], 
    struct ies_auto_mibs_entry *entry
)
{
#define MAX_TABLE_TIMEOUT   ( 800 * 1000 * 1000 )
#define MAX_TABLE_TIMELAST  ( 200 * 1000 * 1000 )
    struct timespec file_time_now;
    struct timespec file_time_tmp;
    struct timespec file_time_tmp_last;
    FILE *fp = NULL;
    char file_buf[64];
    char *tmp;
    ies_handle_t ret = IES_ERR;

    fp = fopen(fname, "r");
    if ( NULL == fp ) 
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "%s line %d regen for no fopen\n", __func__, __LINE__);
        return IES_ERR;
    }

    if ( NULL == fgets(file_buf, sizeof(file_buf), fp) ) 
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "%s line %d regen for no fgets\n", __func__, __LINE__);
        fclose(fp);
        return IES_ERR;
    }
    fclose(fp);

    if ( IES_NOERR == IS_SCALAR_ENTRY(entry) )
    {
        return IES_ERR;
    }
    if ( strlen(gSnmpTblSnapShot.fname) != strlen(fname) )
    {
        return IES_ERR;
    }
    if ( 0 != strncmp(gSnmpTblSnapShot.fname, fname, strlen(fname)) )
    {
        return IES_ERR;
    }

    if ( 0 != clock_gettime(CLOCK_MONOTONIC, &file_time_now) ) 
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
        return IES_ERR;
    }

    if ((file_time_now.tv_nsec - gSnmpTblSnapShot.time_lastUpdate.tv_nsec) < 0 ) 
    {
      file_time_tmp_last.tv_sec  = file_time_now.tv_sec  - gSnmpTblSnapShot.time_lastUpdate.tv_sec  - 1 ;
      file_time_tmp_last.tv_nsec = file_time_now.tv_nsec - gSnmpTblSnapShot.time_lastUpdate.tv_nsec + 1000000000;
    } 
    else 
    {
      file_time_tmp_last.tv_sec  = file_time_now.tv_sec  - gSnmpTblSnapShot.time_lastUpdate.tv_sec;
      file_time_tmp_last.tv_nsec = file_time_now.tv_nsec - gSnmpTblSnapShot.time_lastUpdate.tv_nsec;
    }

    if ( 0 != clock_gettime(CLOCK_MONOTONIC, &gSnmpTblSnapShot.time_lastUpdate) ) 
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
        return IES_ERR;
    }

    if ((file_time_now.tv_nsec - gSnmpTblSnapShot.timeTemp.tv_nsec) < 0 ) 
    {
      file_time_tmp.tv_sec  = file_time_now.tv_sec  - gSnmpTblSnapShot.timeTemp.tv_sec  - 1 ;
      file_time_tmp.tv_nsec = file_time_now.tv_nsec - gSnmpTblSnapShot.timeTemp.tv_nsec + 1000000000;
    } 
    else 
    {
      file_time_tmp.tv_sec  = file_time_now.tv_sec  - gSnmpTblSnapShot.timeTemp.tv_sec;
      file_time_tmp.tv_nsec = file_time_now.tv_nsec - gSnmpTblSnapShot.timeTemp.tv_nsec;
    }

    if ( file_time_tmp_last.tv_sec >= 1 || file_time_tmp_last.tv_nsec >= MAX_TABLE_TIMELAST )
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "%s@%d MAX_TABLE_TIMELAST \'%02ld\'  \'%09ld\' \n", 
            __func__, __LINE__, file_time_tmp_last.tv_sec , file_time_tmp_last.tv_nsec);
        return IES_ERR;
    } 
    else
    {
        return IES_NOERR;
    }
    if ( file_time_tmp.tv_sec >= 1 || file_time_tmp.tv_nsec >= MAX_TABLE_TIMEOUT )
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "%s@%d MAX_TABLE_TIMEOUT \'%02ld\'  \'%09ld\' \n", 
            __func__, __LINE__, file_time_tmp.tv_sec , file_time_tmp.tv_nsec);
        return IES_ERR;
    }
    return IES_NOERR;
#undef MAX_ENTRY_TIMEOUT
#undef MAX_TABLE_TIMELAST
}


/*-------------------------------------------------------------------+
 * Function           : mox_snmp_iss_uri_read_inplace
 *
 * Description        :
 *   In-process equivalent of:
 *     /sbin/ies_uri_handle_client --type read --uri <uri> --file <fname>
 *
 *   Avoids fork+exec of /bin/sh and the helper binary (~25 ms on
 *   ARM Cortex-A) by calling the same library functions directly.
+-------------------------------------------------------------------*/
static ies_handle_t
mox_snmp_iss_uri_read_inplace(const char *uri, const char *fname)
{
    unsigned char iputFile[IES_MAX_FILE];

    /* If the hook .so is not available, fall back to the legacy
     * fork+exec helper so we never regress vs. the old behaviour. */
    if ( 1 != mox_snmp_uri_hook_load() )
    {
        if ( 0 != LibUtil_ExecShCmd(NULL, NULL, 0,
                AUTO_MIB_CMD_URI_CTRL_CLIENT
                " --type read "
                " --uri  %s   "
                " --file %s   ",
                uri, fname) )
        {
            LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
            return IES_ERR;
        }
        return IES_NOERR;
    }

    snprintf((char *)iputFile, sizeof(iputFile), "%s_remap", fname);

    if ( IES_NOERR != g_ies_uri_handle_read((const unsigned char *)uri, iputFile) )
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
#if defined(INCLUDE_MOXA_L3)
        /* Workaround for OSPF virtNbrTable problem (mantis #6342);
         * mirrors ies_uri_handle_client.c. */
        if ( memcmp(uri, "fsmistdospfdb/", strlen("fsmistdospfdb/")) != 0 )
        {
            return IES_ERR;
        }
        /* fall through to remap */
#else
        return IES_ERR;
#endif
    }

    if ( IES_NOERR != g_IssSnmpURI_readRemapper((unsigned char *)uri,
                                                  iputFile,
                                                  (unsigned char *)fname) )
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
        unlink((const char *)iputFile);
        return IES_ERR;
    }

    unlink((const char *)iputFile);
    return IES_NOERR;
}


/*-------------------------------------------------------------------+
 * Function           : entry_handle_generate_iss_value_file
 *
 * Description        :


+-------------------------------------------------------------------*/
ies_handle_t
entry_handle_generate_iss_value_file
(
    struct ies_auto_mibs_entry   *entry, 
    FILE                        **ret_fp
)
{

    FILE                        *fp = NULL;
    char                         fname[IES_MAX_FILE]     = {0x0};
    char                         file_uri[IES_MAX_FILE]  = {0x0};
    ies_handle_t                 ret;
    char                        *tmp = NULL;
    int                          len = 0;
    struct timespec              timeBefore, timeAfter;
    struct sysinfo               info;

    if ( 0 != clock_gettime(CLOCK_MONOTONIC, &timeBefore) ) 
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
    }

    sysinfo(&info);

    if ( IES_FLAG_BITS_CHK(IES_FLAG_SNMP_ISS_REMAP_TBL, entry->flags) ) 
    {
        if ( IES_NOERR != ies_mibs_handle_iss_remap_table_fname_and_file_uri(entry, fname, file_uri) )
        {
            LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
            return IES_ERR;
        }
    } 
    else
    if ( IES_FLAG_BITS_CHK(IES_FLAG_SNMP_ISS_REMAP_MERGE_TABLE, entry->flags) )
    {
        if ( IES_NOERR != ies_mibs_handle_iss_remap_merge_table_fname_and_file_uri(entry, fname, file_uri) )
        {
            LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
            return IES_ERR;
        }
    }
    else
    {
        snprintf(file_uri, IES_MAX_FILE, "%s", entry->uri);
        while ( 1 ) 
        {
            tmp = utilString_strchr(file_uri, strlen(file_uri), '/');
            if ( NULL == tmp ) 
            {
                break;
            } 
            *tmp = '_';
        }
        if ( IES_NOERR == IS_SCALAR_ENTRY(entry) ) 
        {
            snprintf(fname, IES_MAX_FILE, "%s/%s_ent", AUTO_MIB_PATH, file_uri);
        } 
        else 
        {
            snprintf(fname, IES_MAX_FILE, "%s/%stbl",   AUTO_MIB_PATH, file_uri);
        }
    }

    if ( IES_NOERR != entry_handle_check_value_file(fname, entry) ) 
    {

        unlink(fname);
        util_table_snapshot_reset();

        if ( IES_FLAG_BITS_CHK(IES_FLAG_SNMP_GENERATE_SYS_OID, entry->flags) )
        {
            ret = ies_mibs_handle_generate_system_object_id(entry, fname);
            if ( IES_NOERR != ret )
            {
                LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
                return IES_ERR;
            }
        }
        else
        if ( IES_FLAG_BITS_CHK(IES_FLAG_SNMP_ISS_REMAP_TBL, entry->flags) )
        {
            if ( IES_NOERR != mox_snmp_iss_uri_read_inplace(entry->uri, fname) )
            {

                LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d uri %s fname %s\n", __func__, __LINE__, entry->uri, fname);
                return IES_ERR;
            }

            char fnameResult[IES_MAX_FILE] = {0x0};
            sprintf(fnameResult, "%s_result", fname);
            if ( 0 != generate_iss_remap_table(file_uri, fname, fnameResult, info.uptime ) )
            {

                LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
                return IES_ERR;
            }
            unlink(fname);
            rename(fnameResult, fname);
        }
        else
        if ( IES_FLAG_BITS_CHK(IES_FLAG_SNMP_ISS_REMAP_MERGE_TABLE, entry->flags) )
        {
            if ( 0 != LibUtil_ExecShCmd(NULL, NULL, 0, 
                "/sbin/generate_iss_snmp_merge_table "
                " %s %s %ld %d", file_uri, fname, info.uptime, gMaxPortInDevice ) )
            {

                LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
                return IES_ERR;
            }
        }
        else
        {
            if ( IES_NOERR != mox_snmp_iss_uri_read_inplace(entry->uri, fname) )
            {

                LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d uri %s fname %s\n", __func__, __LINE__, entry->uri, fname);
                return IES_ERR;
            }
        }

        if ( IES_FLAG_BITS_CHK(IES_FLAG_SNMP_MAKEUP_INDEX_FOR_ISS, entry->flags) )
        {
            char oid_str[IES_MAX_OID] = {0x0};
            int  oid_str_len          = 0;
            int  i                    = 0;

            while ( i < ( entry->oid_len - entry->oid_index) ) 
            {
                ies_uri_snmp_sprintf((char *)oid_str, IES_MAX_OID, &oid_str_len, "%d.", (unsigned int) entry->oid_list[i]);
                i++;
            }
            if ( 0 != LibUtil_ExecShCmd(NULL, NULL, 0, 
                "/bin/iss_snmp_makeup_index "
                "%s %s_result %ld %s ", fname, fname, info.uptime, oid_str) )
            {
                LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
                return IES_ERR;
            }

            unlink(fname);
            {
                char fnameSrc[IES_MAX_FILE + 8];
                snprintf(fnameSrc, sizeof(fnameSrc), "%s_result", fname);
                if ( 0 != rename(fnameSrc, fname) )
                {
                    LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
                    return IES_ERR;
                }
            }
        }

        if ( 0 != clock_gettime(CLOCK_MONOTONIC, &timeAfter) )
        {
            LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
        }

        util_timeDiff("get_val_from_iss", &timeBefore, &timeAfter);
        util_table_snapshot_setup(fname, entry);
    }

    fp = fopen(fname, "r");

    if ( NULL == fp ) 
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
        return IES_ERR;
    }
    *ret_fp = fp;
    return IES_NOERR;
}




/*-------------------------------------------------------------------+
 * Function           : entry_handle_generate_uri_value_file
 *
 * Description        :
        

+-------------------------------------------------------------------*/
ies_handle_t 
entry_handle_generate_uri_value_file
(
    struct ies_auto_mibs_entry   *entry, 
    FILE                        **ret_fp
)
{

    struct LibFrameworkUri_Handle *uri_handle = NULL;
    JSON_Value                    *json_val   = NULL;
    char                          *val_str    = NULL;
    char                          *json_val_str = NULL;
    char                           uri_string[IES_MAX_URI] = {0x0};
    char                           sys_cmd_buf[IES_MAX_SYS_BUF] = {0x0};
    ies_handle_t                   ret;
    char                          *tmp = NULL;
    FILE                          *fp = NULL;
    char                           fname[IES_MAX_FILE]    = {0x0};
    char                           file_uri[IES_MAX_FILE] = {0x0};
    int                            len = 0, i;
    struct sysinfo                 info;
    int                            uri_iface = 0;
    char                           val_buf[MOXA_SNMP_MAX_STR_VALUE_LEN] = {0x0};

    snprintf(file_uri, IES_MAX_FILE, "%s", entry->uri);
    while ( 1 ) 
    {
        tmp = utilString_strchr(file_uri, strlen(file_uri), '/');
        if ( NULL == tmp ) 
        {
            break;
        } 
        *tmp = '_';
    }

    if ( IES_NOERR == IS_SCALAR_ENTRY(entry) ) 
    {
        snprintf(fname, IES_MAX_FILE, "%s/%s_ent",  AUTO_MIB_PATH, file_uri);
    } 
    else 
    {
        snprintf(fname, IES_MAX_FILE, "%s/%stbl",   AUTO_MIB_PATH, file_uri);
    }

    if ( IES_NOERR != entry_handle_check_value_file(fname, entry) ) 
    {

        unlink(fname);
        util_table_snapshot_reset();

        if ( IES_FLAG_BITS_CHK(IES_FLAG_SNMP_URI_FIXED_VALUE, entry->flags) )
        {
            ret = ies_auto_mibs_handle_uri_fixed_value(entry, sys_cmd_buf, IES_MAX_SYS_BUF);
            if ( IES_NOERR != ret )
            {
                LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
                return IES_ERR;
            }
            val_str = sys_cmd_buf;
        }
        else
        {
            uri_handle = LibFrameworkUri_CreateHandle(flask_server_ip, 80);
            if ( NULL == uri_handle ) 
            {

                LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
                return SNMP_ERR_BADVALUE;
            }
            if ( IES_FLAG_BITS_CHK(IES_FLAG_SNMP_TR2_REPLACE_URI, entry->flags) )
            {
                snprintf( uri_string, sizeof(uri_string), 
                    IES_FLAG_BITS_CHK(IES_FLAG_SNMP_URI_STATUS, entry->flags)  ? 
                        IES_URI_STATUS_PATH("/%s") :  IES_URI_CONFIG_PATH("/%s"), 
                    entry->mod_uri );
            }
            else
            {
                snprintf( uri_string, sizeof(uri_string), 
                    IES_FLAG_BITS_CHK(IES_FLAG_SNMP_URI_STATUS, entry->flags)  ? 
                        IES_URI_STATUS_PATH("/%s") :  IES_URI_CONFIG_PATH("/%s"), 
                    entry->uri );
            }

            if ( moxaSnmpHandle_UtilCfgGetURIConfigString( uri_string, val_buf, sizeof(val_buf) ) != 0 )
            {
                LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
                return mox_snmp_flask_handle_result(uri_handle, json_val, ret);
            }
            val_str = val_buf;
        }

        sysinfo(&info);
        if ( IES_NOERR == IS_SCALAR_ENTRY(entry) ) 
        {

            fp = fopen(fname, "w+");
            fprintf(fp, "# %ld\n", info.uptime);
            for ( i = 0; i < entry->oid_len - 1; i ++) 
            {
                fprintf(fp, "%d.", (int) entry->oid_list[i]);
            }
            if ( IES_FLAG_BITS_CHK(IES_FLAG_SNMP_REPLACE_TRUTH_VALUE, entry->flags) )  
            {
                if ( 0 == strncmp( val_str, "true", strlen("true")) ) 
                {
                    fprintf(fp, "%d.0='1'\n", 
                        (int) entry->oid_list[entry->oid_len - 1]);
                } 
                else 
                if ( 0 == strncmp( val_str, "false", strlen("false"))  )
                {
                    fprintf(fp, "%d.0='2'\n", 
                        (int) entry->oid_list[entry->oid_len - 1]);
                } 
                else 
                {
                    LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
                    return mox_snmp_flask_handle_result(uri_handle, json_val, ret);
                }
            } 
            else
            if ( IES_FLAG_BITS_CHK(IES_FLAG_SNMP_URI_INTERFACE, entry->flags) )  
            {
                uri_iface = atoi(val_str);
                fprintf(fp, "%d.0='%d'\n", 
                    (int) entry->oid_list[entry->oid_len - 1], uri_iface + 1);
            }
            else
            {
                fprintf(fp, "%d.0='%s'\n", 
                    (int) entry->oid_list[entry->oid_len - 1], val_str);
            }

            fclose(fp);
        } 
        else 
        {

            fp = fopen(fname, "w+");
            if ( NULL == fp ) 
            {

                LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d fname = %s\n", __func__, __LINE__, fname );
                return mox_snmp_flask_handle_result(uri_handle, json_val, ret);
            }
            fprintf(fp, "%s", val_str);
            fclose(fp);

            if ( 0 != LibUtil_ExecShCmd(NULL, NULL, 0, 
                "/sbin/generate_uri_snmp_table "
                " %s %s %s_result %ld %d", entry->uri, fname, fname, info.uptime, gMaxPortInDevice) )
            {

                ret = IES_ERR;
                LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
                return mox_snmp_flask_handle_result(uri_handle, json_val, ret);
            }

            {
                char fnameSrc[IES_MAX_FILE + 8];
                snprintf(fnameSrc, sizeof(fnameSrc), "%s_result", fname);
                if ( 0 != rename(fnameSrc, fname) )
                {

                    ret = IES_ERR;
                    LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
                    return mox_snmp_flask_handle_result(uri_handle, json_val, ret);
                }
            }
            util_table_snapshot_setup(fname, entry);
        }

        if ( NULL != json_val ) 
        {
            json_value_free(json_val);
            json_val = NULL;
        }
        LibFrameworkUri_ReleaseHandle(uri_handle);
    }

    fp = fopen(fname, "r");

    if ( NULL == fp ) 
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
        return IES_ERR;
    }
    *ret_fp = fp;
    return IES_NOERR;
}


/*-------------------------------------------------------------------+
 * Function           : mox_snmp_flask_handle_result
 *
 * Description        :
        

+-------------------------------------------------------------------*/
int 
mox_snmp_flask_handle_result
(
    struct LibFrameworkUri_Handle *uri_handle,
    JSON_Value                    *json_val,
    int                            ret
)
{
    if ( NULL != json_val ) 
    {
        json_value_free(json_val);
        json_val = NULL;
    }
    LibFrameworkUri_ReleaseHandle(uri_handle);
    return ( IES_NOERR == ret ) ? SNMP_ERR_NOERROR : SNMP_ERR_BADVALUE ;
}

