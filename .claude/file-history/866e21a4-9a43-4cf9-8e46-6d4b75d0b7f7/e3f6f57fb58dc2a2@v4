/*-------------------------------------------------------------------+
 * Function           : mox_snmp_flask_handle_entry_set
 *
 * Description        :
        

+-------------------------------------------------------------------*/
int 
mox_snmp_flask_handle_entry_set
(
    netsnmp_agent_request_info    *reqinfo,
    netsnmp_request_info          *request,
    struct ies_auto_mibs_entry    *entry
)
{
    struct LibFrameworkUri_Handle *uri_handle = NULL;
    JSON_Value                    *json_val   = NULL;
    JSON_Value                    *json_ret   = NULL;
    char                          *json_ret_string = NULL;
    unsigned  char                *ip_str     = NULL;
    unsigned  char                *mac_str    = NULL;
    char                           uri_string[IES_MAX_URI]            = {0x0};
    char                           val_string[IES_MAX_SNMP_VALUE]     = {0x0};
    char                           val_string_set[IES_MAX_SNMP_VALUE] = {0x0};
    int                            val_string_len                     = 0;
    struct uriPort_entry           uri_port_entry[AUTO_MIB_MAX_DEV_PORT] = {0x0};
    char                           oct_char_tmp;
    int                            ret = IES_ERR;
    oid                           *req_oid;
    int                            req_oid_len;
    oid                           *val_oid                        = NULL;
    int                            val_oid_len                    = 0;
    int                            val_oid_index                  = 0;
    int                            index;
    int                            req_val_len = 0;
    int                            uri_iface;
    int                            uri_number  = 0;
    int                            i, count;
    struct timespec                timeBefore;
    struct timespec                timeAfter;

    if ( 0 != clock_gettime(CLOCK_MONOTONIC, &timeBefore) ) 
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
    }

    entry_handle_remove_file(entry);

    uri_handle = LibFrameworkUri_CreateHandle(flask_server_ip, 80);
    if ( NULL == uri_handle ) 
    {

        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
        return SNMP_ERR_BADVALUE;
    }

    req_oid     = (oid *)request->requestvb->name;
    req_oid_len = request->requestvb->name_length;

    if ( IES_FLAG_BITS_CHK(IES_FLAG_SNMP_READ_CREATE,       entry->flags) ||
         IES_FLAG_BITS_CHK(IES_FLAG_SNMP_READ_CREATE_v2,    entry->flags) ||
         IES_FLAG_BITS_CHK(IES_FLAG_SNMP_READ_CREATE_vRMON, entry->flags) ||
         IES_FLAG_BITS_CHK(IES_FLAG_SNMP_GENERAL_TABLE,     entry->flags) ||
         IES_FLAG_BITS_CHK(IES_FLAG_SNMP_URI_COMMAND,       entry->flags) ||
         IES_FLAG_BITS_CHK(IES_FLAG_SNMP_LA_REPLACE_BIT,    entry->flags) ||
         IES_FLAG_BITS_CHK(IES_FLAG_SNMP_URI_FILTER_DEL,    entry->flags) ||
         IES_FLAG_BITS_CHK(IES_FLAG_SNMP_SYSTEM_COMMAND,    entry->flags) ||
         IES_FLAG_BITS_CHK(IES_FLAG_SNMP_REPLACE_TABLE_2ENTRY_ARRAY, entry->flags )||
         IES_FLAG_BITS_CHK(IES_FLAG_SNMP_REPLACE_TABLE_2PORTS_PBMP,  entry->flags ) )
    {
        ;
    } 
    else 
    if ( IES_FLAG_BITS_CHK(IES_FLAG_SNMP_URI_MOD_BY_IDX, entry->flags) ) 
    {
        
        if ( IES_NOERR != handle_uri_mod_by_idx_table( req_oid, req_oid_len, entry, uri_string ) ) 
        {
            LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
            LibFrameworkUri_ReleaseHandle(uri_handle);
            return SNMP_ERR_BADVALUE;
        }

    } 
    else 
    if ( IES_FLAG_BITS_CHK(IES_FLAG_SNMP_OID_VALID_BY_IDX, entry->flags) ) 
    {
        
        if ( IES_NOERR != handle_oid_valid_by_idx_table( (int *)req_oid, req_oid_len, entry, uri_string ) ) 
        {
            LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
            LibFrameworkUri_ReleaseHandle(uri_handle);
            return SNMP_ERR_BADVALUE;
        }

    } 
    else 
    {
        if ( 0 == entry->oid_index ||
             IES_FLAG_BITS_CHK(IES_FLAG_SNMP_REPLACE_TABLE_2ENTRY, entry->flags)) 
        {

            if ( IES_FLAG_BITS_CHK(IES_FLAG_SNMP_REPLACE_TABLE_2ENTRY, entry->flags) ) 
            {
                index = req_oid[req_oid_len - 1];
                if ( 1 != index ) 
                {
                    LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
                    LibFrameworkUri_ReleaseHandle(uri_handle);
                    return SNMP_ERR_BADVALUE;
                }
            }

            snprintf(uri_string, sizeof(uri_string),
                IES_URI_CONFIG_PATH("/%s"),
                ( IES_FLAG_BITS_CHK(IES_FLAG_SNMP_URI_MOD_ON_SET, entry->flags) ) ? 
                entry->mod_uri : entry->uri);

        } 
        else 
        if ( 1 == entry->oid_index ) 
        {
            index = req_oid[req_oid_len - 1];
            if ( index >= 1 ) 
            {
                index--;
            } 
            else 
            {
                LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
                LibFrameworkUri_ReleaseHandle(uri_handle);
                return SNMP_ERR_BADVALUE;
            }

            if ( IES_FLAG_BITS_CHK(IES_FLAG_SNMP_URI_MOD_ON_SET, entry->flags) ) 
            {
                snprintf(uri_string, sizeof(uri_string), 
                    IES_URI_CONFIG_PATH("/%s%d/%s"), 
                    entry->mod_uri, index, entry->mod_uri_index);
            } 
            else 
            {
                snprintf(uri_string, sizeof(uri_string), 
                    IES_URI_CONFIG_PATH("/%s%d/%s"), 
                    entry->uri, index, entry->uri_index);
            }
        } 
        else 
        {
            /* no multi-index-table */
            LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
            LibFrameworkUri_ReleaseHandle(uri_handle);
            return SNMP_ERR_BADVALUE;
        }
    }
    switch(entry->val_type) 
    {
        case SNMP_DATA_TYPE_INTEGER32:
        // case SNMP_DATA_TYPE_INTEGER: same as SNMP_DATA_TYPE_INTEGER32
        case SNMP_DATA_TYPE_TIME_TICKS:
        case SNMP_DATA_TYPE_COUNTER32: 
        //case SNMP_DATA_TYPE_COUNTER: same as SNMP_DATA_TYPE_COUNTER32
        case SNMP_DATA_TYPE_UNSIGNED32:
        //case SNMP_DATA_TYPE_GAUGE32: same as SNMP_DATA_TYPE_UNSIGNED32
        //case SNMP_DATA_TYPE_GAUGE:   same as SNMP_DATA_TYPE_UNSIGNED32
            uri_number = 1;
            if ( IES_FLAG_BITS_CHK(IES_FLAG_SNMP_REPLACE_TRUTH_VALUE, entry->flags) ) 
            {
                if ( 1 == *request->requestvb->val.integer ) 
                {
                    snprintf(val_string, sizeof(val_string), "true");
                } 
                else 
                if ( 2 == *request->requestvb->val.integer )
                {
                    snprintf(val_string, sizeof(val_string), "false");
                }
                else
                {
                    LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
                    goto out;
                }
            }
            else 
            if ( IES_FLAG_BITS_CHK(IES_FLAG_SNMP_URI_INTERFACE, entry->flags) ) 
            {
                memcpy(&uri_iface, request->requestvb->val.integer, sizeof(uri_iface));
                snprintf(val_string, sizeof(val_string), "%d", uri_iface - 1);
            }
            else 
            {
                snprintf(val_string, sizeof(val_string), "%d", *request->requestvb->val.integer);
            }
            break; 
        case SNMP_DATA_TYPE_IP_ADDR_PRIM:
            ip_str = (unsigned char *) request->requestvb->val.string;
            snprintf(val_string, sizeof(val_string), "%d.%d.%d.%d", ip_str[0], ip_str[1], ip_str[2], ip_str[3]);
            break; 
        case SNMP_DATA_TYPE_MAC_ADDRESS:
            mac_str = (unsigned char *) request->requestvb->val.string;
            snprintf(val_string, sizeof(val_string), "%2.2x:%2.2x:%2.2x:%2.2x:%2.2x:%2.2x", mac_str[0], mac_str[1], mac_str[2], mac_str[3], mac_str[4], mac_str[5]);
            break; 
        case SNMP_DATA_TYPE_OCTET_PRIM:
        case SNMP_DATA_TYPE_OPAQUE:
            if ( IES_FLAG_BITS_CHK(IES_FLAG_SNMP_REPLACE_BIT_VALUE, entry->flags) ||
                 IES_FLAG_BITS_CHK(IES_FLAG_SNMP_LA_REPLACE_BIT,    entry->flags) ||
                 IES_FLAG_BITS_CHK(IES_FLAG_SNMP_MANAGEMENT_VLAN,   entry->flags) ) 
            {
                break;
            }
            else
            if ( IES_FLAG_BITS_CHK(IES_FLAG_SNMP_REPLACE_BIT_2OCT, entry->flags) ) 
            {
                if ( IES_NOERR != utilSNMP_setOCT_to_hexValue(request, &oct_char_tmp ) )
                {
                    LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
                    goto out;
                }
                val_string_len = snprintf(val_string, sizeof(val_string), "%2.2x", oct_char_tmp);
            } 
            else 
            if ( IES_FLAG_BITS_CHK(IES_FLAG_SNMP_URI_PBMP, entry->flags) ) 
            {
                count = sizeof(uri_port_entry) / sizeof(uri_port_entry[0]);
                for ( i = 0; i < count; i++ )
                {
                    uri_port_entry[i].enable = IES_SNMP_BITS_DISABLE;
                }
                if ( IES_NOERR != utilSNMP_setOCT_to_portEntry( request, uri_port_entry, gMaxPortInDevice) )
                {
                    LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__ );
                    goto out;
                }
                break; 
            } 
            else 
            {
                req_val_len  = request->requestvb->val_len;
                if ( req_val_len >= IES_MAX_SNMP_VALUE - 10 /* just in case */ ) 
                {
                    LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__ );
                    goto out;
                }
                memcpy(&val_string[0], request->requestvb->val.string, req_val_len);
                val_string_len = req_val_len; //  just val_string 
                val_string[val_string_len] = '\0';
            }
            break; 
        case SNMP_DATA_TYPE_OBJECT_ID:
            val_oid        = request->requestvb->val.objid;
            val_oid_len    = (request->requestvb->val_len) / 4;
            val_string_len = 0;
            for ( val_oid_index = 0; val_oid_index < val_oid_len; val_oid_index++ )
            {
                if ( IES_NOERR != ies_uri_snmp_sprintf((char *)val_string, IES_MAX_SNMP_VALUE,
                    &val_string_len, "%d.", (unsigned int)val_oid[val_oid_index]) )
                {
                    LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__ );
                    goto out;
                }
            }
            val_string_len --; // skip last `.`
            val_string[val_string_len] = '\0';
            break;
        case SNMP_DATA_TYPE_COUNTER64:
            /* not support yet */
        case SNMP_DATA_TYPE_NULL:
        case SNMP_DATA_TYPE_SEQUENCE:
        case SNMP_DATA_TYPE_IMP_OCTET_PRIM:
        case SNMP_DATA_TYPE_IMP_OBJECT_ID:
        case SNMP_DATA_TYPE_ROW_STATUS:
        default:
            LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "%s@%d: not support yet !!\n", __func__, __LINE__);
            goto out;
    }

    if ( IES_FLAG_BITS_CHK(IES_FLAG_SNMP_READ_CREATE_v2, entry->flags) ) 
    {
        if ( IES_NOERR != ies_auto_mibs_handle_set_for_readCreate_v2(reqinfo, request, entry, val_string) ) 
        {
            LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__ );
            goto out;
        }
    }
    else
    if ( IES_FLAG_BITS_CHK(IES_FLAG_SNMP_READ_CREATE_vRMON, entry->flags) ) 
    {
        if ( IES_NOERR != ies_auto_mibs_handle_set_for_readCreate_vRMON(reqinfo, request, entry, val_string) ) 
        {
            LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__ );
            goto out;
        }
    }
