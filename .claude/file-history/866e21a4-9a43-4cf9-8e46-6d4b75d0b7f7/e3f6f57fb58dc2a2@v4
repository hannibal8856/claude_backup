+-------------------------------------------------------------------*/
char * 
utilString_strchr
(
    char *buf, 
    int   buf_len, 
    char  token
)
{
    char *end = buf + buf_len;

    while( buf < end )
    {
        if( token == *buf )
        {
            return buf;
        }
        buf++;
    }
    return NULL;
}


/*-------------------------------------------------------------------+
 * Function           : utilString_bitValue_for2OCT
 *
 * Description        : for BIT Operation 
        

+-------------------------------------------------------------------*/
char
utilString_bitValue_for2OCT
(
    char *buf, 
    int   buf_len
)
{
    char *end = buf + buf_len;
    char retToken = 0;
    int  count = 0;
    char tmp;

    while ( buf < end ) 
    {
        if ( *buf >= '0' && *buf <= '9' ) 
        {
            count = *buf - '0';
        } 
        else 
        if ( *buf >= 'a' && *buf <= 'f' ) 
        {
            count = *buf - 'a' + 10;
        } 
        else 
        if ( *buf >= 'A' && *buf <= 'F' ) 
        {
            count = *buf - 'A' + 10;
        } 
        else 
        {
            count = 0;
        }
        retToken  = ( ( retToken << 4 ) & 0xf0 );
        retToken |= ( count & 0x0f );
        buf++;
    }
    return retToken;
}

/*-------------------------------------------------------------------+
 * Function           : utilString_strIPv4
 *
 * Description        :
        

+-------------------------------------------------------------------*/
ies_handle_t 
utilString_strIPv4
(
    const char   *buf, 
    int           len, 
    unsigned int *retVal
)
{
    unsigned int val, tmp;
    char *end;
    int i;

    val = 0;
    end = (char *)buf + len;
    if ( '\'' == *buf ) {
        buf++; // skip 1st '\''
    }
    if ( '\"' == *buf ) {
        buf++; // skip 1st '"'
    }
    for ( i = 0; i < 4; i++ ) 
    {
        tmp   = 0;
        val <<= 8;
        while ( buf < end )
        {
            if ( *buf >= '0' && *buf <= '9' ) 
            {
                tmp *= 10;
                tmp += *buf - '0';
            } 
            else 
            if ( '.' == *buf || 
                '\'' == *buf || 
                '"' == *buf ||
                '-'  == *buf ) 
            {
                buf++;
                break;
            } 
            else 
            {
                // should no go here !!
                return IES_ERR;
            }
            buf++;
        }
        if ( tmp > 0xff ) 
        {
            return IES_ERR;
        }
        val |= tmp;
    }
    
    *retVal = ntohl(val);
    return IES_NOERR;
}


/*-------------------------------------------------------------------+
 * Function           : entry_handle_remove_file
 *
 * Description        :
        

+-------------------------------------------------------------------*/
void 
entry_handle_remove_file
(
    struct ies_auto_mibs_entry *entry
)
{

    char                        fname[IES_MAX_FILE];
    char                        file_uri[IES_MAX_FILE];
    char                       *tmp = NULL;

    if ( IES_FLAG_BITS_CHK(IES_FLAG_SNMP_URI_COMMAND, entry->flags) ) 
    {
        return;
    }

    if ( IES_FLAG_BITS_CHK(IES_FLAG_SNMP_ISS_REMAP_TBL, entry->flags) ) 
    {
        if ( IES_NOERR != ies_mibs_handle_iss_remap_table_fname_and_file_uri(entry, fname, file_uri) )
        {
            LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
            return;
        }
    } 
    else
    if ( IES_FLAG_BITS_CHK(IES_FLAG_SNMP_ISS_REMAP_MERGE_TABLE, entry->flags) )
    {
        if ( IES_NOERR != ies_mibs_handle_iss_remap_merge_table_fname_and_file_uri(entry, fname, file_uri) )
        {

            LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
            return ;
        }
    }
    else 
    {
        snprintf(file_uri, IES_MAX_FILE, "%s", entry->uri);
        while ( 1 ) 
        {
            tmp = utilString_strchr(file_uri, strlen(file_uri), '/');
            if ( NULL == tmp ) 
            {
                break;
            } 
            *tmp = '_';
        }
        if ( IES_NOERR == IS_SCALAR_ENTRY(entry) ) 
        {
            snprintf(fname, IES_MAX_FILE, "%s/%s_ent", AUTO_MIB_PATH, file_uri);
        } 
        else 
        {
            snprintf(fname, IES_MAX_FILE, "%s/%stbl",   AUTO_MIB_PATH, file_uri);
        }
    }
    unlink(fname);

    return;
}

/**
 * @brief handle transfer object-id-string to oid

 * @param[in]    buf           object-id-string buffer
 * @param[in]    bufLen        object-id-string buffer len
 * @param[out]   retOID        return oid buffer
 * @param[out]   retOIDLen     return oid buffer len
 * @param[in]    retOIDLenMax  return oid buffer max len

 * @returns      0 means success, others fail.
 */
int32_t moxaSnmpHandle_UtilSnmp_ObjectIDStringToOID( const char     *buf,
                                                     const uint32_t  bufLen,
                                                     oid            *retOID,
                                                     uint32_t       *retOIDLen,
                                                     const uint32_t  retOIDLenMax )
{
    char     *end           = buf + bufLen;
    char     *token         = NULL;
    uint32_t  oidBufIndex   = 0;
    char      tmpOidStr[32] = {0x0};
    uint32_t  tmpOidStrLen  = 0;

    LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "%s@%d : %s(%d) \n",
        __func__, __LINE__, buf, bufLen);

    for ( token = (char *) buf; buf <= end; buf++ )
    {
        if ( *buf == ',' || *buf == '.' || *buf == '\'' || *buf == '\0' )
        {
            tmpOidStrLen = buf - token;
            if ( tmpOidStrLen >= sizeof(tmpOidStr) )
            {
                LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "%% %s@%d : tmpOidStrLen(%d) exceed max(%d)\n",
                    __func__, __LINE__, tmpOidStrLen, sizeof(tmpOidStr));
                return (-1);
            }
            memset(tmpOidStr, 0, sizeof(tmpOidStr));
            memcpy(tmpOidStr, token, tmpOidStrLen);
            tmpOidStr[tmpOidStrLen] = '\0';
            token = buf + 1;
            retOID[oidBufIndex] = atoi(tmpOidStr);
            oidBufIndex++;
            if ( oidBufIndex >= retOIDLenMax )
            {
                LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "%% %s@%d : oidBufIndex(%d) exceed retOIDLenMax %d\n",
                    __func__, __LINE__, oidBufIndex, retOIDLenMax);
                return (-1);
            }
        }
    }
    *retOIDLen = oidBufIndex;

    return 0;
}

