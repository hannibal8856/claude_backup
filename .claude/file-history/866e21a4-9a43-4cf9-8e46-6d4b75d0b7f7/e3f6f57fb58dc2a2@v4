/*-------------------------------------------------------------------+
   Function Name   : util_table_snapshot_setup
   Description     : 

   Note            : 
+-------------------------------------------------------------------*/
ies_handle_t 
util_table_snapshot_setup(char *fname, struct ies_auto_mibs_entry *entry)
{
    snprintf(gSnmpTblSnapShot.fname, sizeof(gSnmpTblSnapShot.fname), "%s", fname);
    if ( 0 != clock_gettime(CLOCK_MONOTONIC, &gSnmpTblSnapShot.timeTemp) ) 
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
        return IES_ERR;
    }
    if ( 0 != clock_gettime(CLOCK_MONOTONIC, &gSnmpTblSnapShot.time_lastUpdate) ) 
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
        return IES_ERR;
    }
    if ( IES_NOERR != fileBuffer_init(
        &gfileBufCtrlBlock, fname, entry->oid_list, entry->oid_len - 1 ) )
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
        return IES_ERR;
    }

    LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "%s@%d gSnmpTblSnapShot.fname \'%d\'  \'%s\' \n", 
        __func__, __LINE__, strlen(gSnmpTblSnapShot.fname) , gSnmpTblSnapShot.fname);
    LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "%s@%d                  fname \'%d\'  \'%s\' \n", 
        __func__, __LINE__, strlen(fname) , fname);
    return IES_NOERR;
}

/*-------------------------------------------------------------------+
 * Function           : utilStoken_update_security_token
 *
 * Description        :
        

+-------------------------------------------------------------------*/
ies_handle_t 
utilStoken_update_security_token(void)
{
    ies_handle_t  ret = 0;
    FILE         *fp  = NULL;
    FILE         *fp_token = NULL;
    char          security_token_file[64]  = {0x0};
    char          line[128] = {0};
    char          username[RWUSER_NAME_SIZE] = {0};
    // Token username is the original username prefixed with "snmp."
    char          token_username[RWUSER_NAME_SIZE+5] = {0};
    int           rwuser_count = 0;

    snprintf(security_token_file, sizeof(security_token_file), 
        "%s/s_token", AUTO_MIB_PATH);
    unlink(security_token_file);

    if ( 0 != LibUtil_CreateToken("snmp", "snmp", security_token_file) )
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
        return IES_ERR;
    }

    fp = fopen(security_token_file, "r");
    if ( NULL == fp ) 
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
        return IES_ERR;
    }
    if (NULL == fgets(security_tokens[0], TOKEN_SIZE, fp) ) 
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
        ret = IES_ERR;
    }

    fclose(fp);

    if ( IES_ERR == ret ) 
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
        return IES_ERR;
    }

    // Create new token for snmpv3 rwuser
    fp = fopen(SNMPD_CONFIG_FILE, "r");
    if (NULL == fp)
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
        return IES_ERR;
    }

    while (fgets(line, sizeof(line), fp) != NULL)
    {
        if (sscanf(line, "rwuser %s", username))
        {
            if (rwuser_count >= MAX_TOKEN_NUM - 1)
            {
                break;
            }

            snprintf(rwuser_list[rwuser_count], RWUSER_NAME_SIZE, username);

            // Create token for rwuser
            snprintf(security_token_file, sizeof(security_token_file), "%s/%s.s_token",
                     AUTO_MIB_PATH, username);
            unlink(security_token_file);

            // Prefix the username with "snmp."
            snprintf(token_username, sizeof(token_username), "snmp.%s", username);
            if (0 != LibUtil_CreateToken(token_username, "snmp", security_token_file))
            {
                LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
                fclose(fp);
                return IES_ERR;
            }

            // Restore token to token array
            fp_token = fopen(security_token_file, "r");
            if ( NULL == fp_token ) 
            {
                LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
                fclose(fp);
                return IES_ERR;
            }
            if (NULL == fgets(security_tokens[rwuser_count + 1], TOKEN_SIZE, fp_token) ) 
            {
                LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
                ret = IES_ERR;
            }
            fclose(fp_token);

            rwuser_count++;
        }
    }

    fclose(fp); // snmpd.conf

    if ( IES_ERR == ret ) 
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
        return IES_ERR;
    }

    return IES_NOERR;
}

