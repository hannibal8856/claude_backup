/* Plan C (agentx_owned.list): one list, two consumers.
 *
 * The list holds mod_uri prefixes. At registration time an RO entry whose URI
 * matches is not registered locally at all, so the snmpd master routes it to
 * whichever AgentX subagent claimed the OID. RW entries are always registered
 * locally, because SET has to stay on the framework path.
 *
 * A RW column's GET is a different question. Reading it through the local
 * ies_uri_handle path costs ~600ms, and a walk bundles it with the RO columns
 * of the same table into one multi-varbind GETNEXT, so one slow column drags
 * the whole table down. For any RW column whose group is delegated we forward
 * just the GET to the subagent and keep SET local.
 *
 * Forwarding needs a "probe": an OID the subagent owns, used to make
 * netsnmp_subtree_find() resolve to the subagent's registration. Probing the
 * column itself is useless -- the RW column IS registered locally, so the
 * lookup finds us, and the request is then handed to a non-AgentX handler
 * while still reporting success. That failure is silent and ugly: wrong value
 * types (OCTET STRING came back as INTEGER 0), scalars turning into
 * noSuchInstance, GETNEXT looping inside the column so a whole-tree walk
 * collapsed from 193 varbinds to 13, and no AgentX traffic on the wire at all.
 *
 * So probes are not hand-listed. The registration loop already knows exactly
 * which OIDs it handed over -- every entry it skips is one -- and records them
 * as candidates. A candidate later shadowed by a synthesised index column is
 * struck off: moxaSnmpHandle_UtilMibEntryGenerateTableIndexEntry() re-registers
 * a table's column 1 in-master for tables that kept any column locally, which
 * silently takes that OID back from the subagent.
 *
 * Selection prefers a candidate from the column's own table, then falls back to
 * any candidate under the same prefix. Both halves are needed: one prefix can
 * span several subagent registrations (ifmibdb/ covers ifTable and ifXTable
 * separately, and they are distinct registrations), while a table may have no
 * usable candidate of its own (mxportdb/portConfigTable's only RO column is its
 * index, which gets synthesised back locally).
 *
 * A probe does not need an instance sub-id: a bare column OID, and even the
 * table-entry OID one level up, resolve to the subagent's registration. */
#define AGENTX_PROBE_MAX         (128)
/* Defined here rather than with the rest of the agentx_owned machinery below,
 * because the per-prefix probe caches are sized by it and live up here. */
#define AGENTX_OWNED_MAX         (32)

struct mox_agentx_probe
{
    char uri[IES_MAX_URI];      /* delegated entry's URI -- identifies its table */
    int  prefix_idx;            /* which agentx_owned.list line matched          */
    oid  oid_list[IES_MAX_OID];
    int  oid_len;
    int  shadowed;              /* taken back by a locally synthesised index     */
};
static struct mox_agentx_probe gAgentXProbe[AGENTX_PROBE_MAX];
static int gAgentXProbeCount = 0;

static int mox_snmp_entry_agentx_prefix_idx (struct ies_auto_mibs_entry *entry);
static int mox_snmp_agentx_prefix_getfwd    (int prefix_idx);
static int mox_snmp_agentx_prefix_probe     (int prefix_idx, const oid **probe_oid);
static int mox_snmp_agentx_prefix_nodelegate(int prefix_idx);

/* DEBUG INSTRUMENTATION (ADR-0025 root-cause hunt) -------------------------
 * +getfwd is a silent no-op on stdethdb/ and mxportdb/: the GET falls cleanly
 * back to the local path with correct values, so the failure is invisible from
 * the wire. The GETFWD_* traces below make every decision point observable.
 * Enable at runtime with `moxa_snmp_tools --enable`; output lands in
 * /run/util_debug/debug_log_5. Remove once the root cause is recorded. */
#define MOX_GETFWD_OIDBUF        (320)

static const char *
mox_snmp_getfwd_oid_str (const oid *oid_list, int oid_len,
                         char *buf, size_t buflen)
{
    size_t n = 0;
    int    i;

    if ( buf == NULL || buflen == 0 )
    {
        return "";
    }
    buf[0] = '\0';
    if ( oid_list == NULL )
    {
        return buf;
    }
    for ( i = 0; i < oid_len; i++ )
    {
        int w = snprintf(buf + n, buflen - n, ".%lu", (unsigned long) oid_list[i]);
        if ( w <= 0 || (size_t) w >= buflen - n )
        {
            break;
        }
        n += (size_t) w;
    }
    return buf;
}

/* Every entry the registration loop hands to a subagent becomes a candidate. */
static void mox_snmp_probe_note_delegated (struct ies_auto_mibs_entry *entry,
                                           int                         prefix_idx)
{
    struct mox_agentx_probe *p;
    char                     oidbuf[MOX_GETFWD_OIDBUF];

    /* Split from the original single condition so the two causes are told
     * apart: hitting AGENTX_PROBE_MAX used to return silently, and its
     * symptom is identical to the bug under investigation. */
    if ( gAgentXProbeCount >= AGENTX_PROBE_MAX )
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP,
            "GETFWD T1 OVERFLOW: AGENTX_PROBE_MAX=%d reached, dropping "
            "prefix_idx=%d uri=%s\n",
            AGENTX_PROBE_MAX, prefix_idx, entry->uri);
        return;
    }
    if ( entry->oid_len <= 0 || entry->oid_len > IES_MAX_OID )
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP,
            "GETFWD T1 BADOID: prefix_idx=%d uri=%s oid_len=%d (max %d)\n",
            prefix_idx, entry->uri, entry->oid_len, IES_MAX_OID);
        return;
    }
    p = &gAgentXProbe[gAgentXProbeCount++];
    memset(p, 0, sizeof(*p));
    snprintf(p->uri, sizeof(p->uri), "%s", entry->uri);
    p->prefix_idx = prefix_idx;
    p->oid_len    = entry->oid_len;
    memcpy(p->oid_list, entry->oid_list, sizeof(oid) * (size_t) entry->oid_len);

    LibUtil_DbgTrace(kDbgFlgIssUriSNMP,
        "GETFWD T1 NOTE: slot=%d/%d prefix_idx=%d uri=%s oid=%s\n",
        gAgentXProbeCount - 1, AGENTX_PROBE_MAX, prefix_idx, p->uri,
        mox_snmp_getfwd_oid_str(p->oid_list, p->oid_len, oidbuf, sizeof(oidbuf)));
}

/* A synthesised index column re-registered in-master disqualifies that OID. */
static void mox_snmp_probe_note_shadowed (const oid *oid_list, int oid_len)
{
    int  i;
    int  hits = 0;
    char oidbuf[MOX_GETFWD_OIDBUF];

    for ( i = 0; i < gAgentXProbeCount; i++ )
    {
        if ( gAgentXProbe[i].oid_len == oid_len &&
             memcmp(gAgentXProbe[i].oid_list, oid_list,
                    sizeof(oid) * (size_t) oid_len) == 0 )
        {
            gAgentXProbe[i].shadowed = 1;
            hits++;
        }
    }

    LibUtil_DbgTrace(kDbgFlgIssUriSNMP,
        "GETFWD T1b SHADOW: oid=%s struck %d of %d candidate(s)\n",
        mox_snmp_getfwd_oid_str(oid_list, oid_len, oidbuf, sizeof(oidbuf)),
        hits, gAgentXProbeCount);
}

/* Is this registration one of ours?
 *
 * netsnmp_subtree_find() returning non-NULL does NOT mean the OID belongs to
 * a subagent -- a hit on our own registration answers locally and still looks
 * like success. That gap is what let the GET-forward path be believed broken
 * for two rounds (ADR-0030), and it is the only thing standing between a
 * mis-specified probe and a request forwarded to the wrong place.
 *
 * Walk the handler chain rather than testing reginfo->handler directly:
 * netsnmp_register_scalar() and MIB_HANDLER_AUTO_NEXT wrap us in a helper, so
 * mox_snmp_handle_entry is not always the first link. */
static int mox_snmp_reg_is_local (netsnmp_handler_registration *reginfo)
{
    netsnmp_mib_handler *h;

    if ( reginfo == NULL )
    {
        return 0;
    }
    for ( h = reginfo->handler; h != NULL; h = h->next )
    {
        if ( h->access_method == mox_snmp_handle_entry )
        {
            return 1;
        }
    }
    return 0;
}

/* Derived probes, one per agentx_owned.list line.
 *
 * A prefix with no delegated RO entry never gets a candidate recorded, so
 * +getfwd cannot work for it at all: every column is RW, so every column is
 * registered in-master. That rules out the eleven all-RW prefixes (mxqosdb/,
 * stdlldp/, mxradiusdb/, ...) structurally, not by policy.
 *
 * The way out is that ISS registers whole MIB roots rather than individual
 * OIDs, so a node ABOVE the in-master columns still falls inside its subtree.
 * Walk up from the entry's own OID and take the first ancestor whose
 * registration is not ours -- deepest first, so the match is the closest
 * enclosing foreign subtree rather than something far up the tree.
 *
 * Cached per prefix: the answer cannot change without a re-registration, and
 * the walk costs one netsnmp_subtree_find() per level. */
static struct mox_agentx_probe gAgentXDerived[AGENTX_OWNED_MAX];
static signed char             gAgentXDerivedState[AGENTX_OWNED_MAX];
                                    /* 0 = not tried, 1 = derived, -1 = none */

static const struct mox_agentx_probe *
mox_snmp_probe_derive (struct ies_auto_mibs_entry *entry, int prefix_idx)
{
    struct mox_agentx_probe *p;
    char                     oidbuf[MOX_GETFWD_OIDBUF];
    int                      len;

    if ( prefix_idx < 0 || prefix_idx >= AGENTX_OWNED_MAX ||
         entry->oid_len <= 0 || entry->oid_len > IES_MAX_OID )
    {
        return NULL;
    }
    if ( gAgentXDerivedState[prefix_idx] != 0 )
    {
        return ( gAgentXDerivedState[prefix_idx] > 0 )
                   ? &gAgentXDerived[prefix_idx] : NULL;
    }

    p = &gAgentXDerived[prefix_idx];
    memset(p, 0, sizeof(*p));

    for ( len = entry->oid_len - 1; len >= 3; len-- )
    {
        netsnmp_subtree *sub = netsnmp_subtree_find(entry->oid_list,
                                                    (size_t) len, NULL, NULL);

        if ( sub == NULL || sub->reginfo == NULL ||
             sub->reginfo->handler == NULL ||
             mox_snmp_reg_is_local(sub->reginfo) )
        {
            continue;
        }

        snprintf(p->uri, sizeof(p->uri), "%s", entry->uri);
        p->prefix_idx = prefix_idx;
        p->oid_len    = len;
        memcpy(p->oid_list, entry->oid_list, sizeof(oid) * (size_t) len);
        gAgentXDerivedState[prefix_idx] = 1;

        LibUtil_DbgTrace(kDbgFlgIssUriSNMP,
            "GETFWD T5 DERIVE: prefix_idx=%d uri=%s probe_oid=%s "
            "(from oid_len=%d, handlerName=%s)\n",
            prefix_idx, entry->uri,
            mox_snmp_getfwd_oid_str(p->oid_list, p->oid_len,
                                    oidbuf, sizeof(oidbuf)),
            entry->oid_len,
            (sub->reginfo->handlerName != NULL)
                ? sub->reginfo->handlerName : "(null)");
        return p;
    }

    gAgentXDerivedState[prefix_idx] = -1;
    LibUtil_DbgTrace(kDbgFlgIssUriSNMP,
        "GETFWD T5 DERIVE: prefix_idx=%d uri=%s -> NONE "
        "(no non-local ancestor above %s)\n",
        prefix_idx, entry->uri,
        mox_snmp_getfwd_oid_str(entry->oid_list, entry->oid_len,
                                oidbuf, sizeof(oidbuf)));
    return NULL;
}

/* An explicit probe=<oid> on the list line, materialised as a probe. It wins
 * over everything else: it is the operator naming the OID that resolves to
 * the subagent, and the escape hatch for whatever derivation cannot reach. */
static struct mox_agentx_probe gAgentXListProbe[AGENTX_OWNED_MAX];

static const struct mox_agentx_probe *
mox_snmp_probe_from_list (struct ies_auto_mibs_entry *entry, int prefix_idx)
{
    struct mox_agentx_probe *p;
    const oid               *list_oid = NULL;
    int                      list_len;

    list_len = mox_snmp_agentx_prefix_probe(prefix_idx, &list_oid);
    if ( list_len <= 0 || list_oid == NULL )
    {
        return NULL;
    }

    p = &gAgentXListProbe[prefix_idx];
    if ( p->oid_len != list_len )
    {
        memset(p, 0, sizeof(*p));
        snprintf(p->uri, sizeof(p->uri), "%s", entry->uri);
        p->prefix_idx = prefix_idx;
        p->oid_len    = list_len;
        memcpy(p->oid_list, list_oid, sizeof(oid) * (size_t) list_len);
    }
    return p;
}

static const struct mox_agentx_probe *
mox_snmp_probe_for_entry (struct ies_auto_mibs_entry *entry, int prefix_idx)
{
    const struct mox_agentx_probe *fallback = NULL;
    const struct mox_agentx_probe *listed   = NULL;
    int i;
    int skipped_shadowed = 0;
    int skipped_prefix   = 0;
    int considered       = 0;
    char oidbuf[MOX_GETFWD_OIDBUF];

    /* Operator intent beats anything derived from the entries. */
    listed = mox_snmp_probe_from_list(entry, prefix_idx);
    if ( listed != NULL )
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP,
            "GETFWD T2 LISTED: uri=%s prefix_idx=%d probe_oid=%s\n",
            entry->uri, prefix_idx,
            mox_snmp_getfwd_oid_str(listed->oid_list, listed->oid_len,
                                    oidbuf, sizeof(oidbuf)));
        return listed;
    }

    for ( i = 0; i < gAgentXProbeCount; i++ )
    {
        if ( gAgentXProbe[i].shadowed )
        {
            skipped_shadowed++;
            continue;
        }
        if ( gAgentXProbe[i].prefix_idx != prefix_idx )
        {
            skipped_prefix++;
            continue;
        }
        considered++;
        if ( strcmp(gAgentXProbe[i].uri, entry->uri) == 0 )
        {
            LibUtil_DbgTrace(kDbgFlgIssUriSNMP,
                "GETFWD T2 SAMETABLE: uri=%s prefix_idx=%d probe_uri=%s probe_oid=%s "
                "(scanned=%d considered=%d skip_shadowed=%d skip_prefix=%d)\n",
                entry->uri, prefix_idx, gAgentXProbe[i].uri,
                mox_snmp_getfwd_oid_str(gAgentXProbe[i].oid_list,
                                        gAgentXProbe[i].oid_len,
                                        oidbuf, sizeof(oidbuf)),
                gAgentXProbeCount, considered, skipped_shadowed, skipped_prefix);
            return &gAgentXProbe[i];            /* same table wins */
        }
        if ( fallback == NULL )
        {
            fallback = &gAgentXProbe[i];        /* same prefix, other table */
        }
    }

    /* No candidate from the delegated RO entries -- either this prefix has
     * none at all (all-RW), or every one of them was shadowed. Derive. */
    if ( fallback == NULL )
    {
        const struct mox_agentx_probe *derived =
            mox_snmp_probe_derive(entry, prefix_idx);
        if ( derived != NULL )
        {
            LibUtil_DbgTrace(kDbgFlgIssUriSNMP,
                "GETFWD T2 DERIVED: uri=%s prefix_idx=%d probe_oid=%s "
                "(scanned=%d considered=%d skip_shadowed=%d skip_prefix=%d)\n",
                entry->uri, prefix_idx,
                mox_snmp_getfwd_oid_str(derived->oid_list, derived->oid_len,
                                        oidbuf, sizeof(oidbuf)),
                gAgentXProbeCount, considered, skipped_shadowed, skipped_prefix);
            return derived;
        }
    }

    LibUtil_DbgTrace(kDbgFlgIssUriSNMP,
        "GETFWD T2 %s: uri=%s prefix_idx=%d probe_uri=%s probe_oid=%s "
        "(scanned=%d considered=%d skip_shadowed=%d skip_prefix=%d)\n",
        (fallback != NULL) ? "FALLBACK" : "NULL",
        entry->uri, prefix_idx,
        (fallback != NULL) ? fallback->uri : "-",
        (fallback != NULL)
            ? mox_snmp_getfwd_oid_str(fallback->oid_list, fallback->oid_len,
                                      oidbuf, sizeof(oidbuf))
            : "-",
        gAgentXProbeCount, considered, skipped_shadowed, skipped_prefix);

    return fallback;
}

/* Forward a single GET/GETNEXT request to the ISS AgentX subagent, bypassing
 * the slow local ies_uri_handle path. agentx_master_handler marks the request
 * delegated and sends it async; net-snmp fills the value when ISS replies.
 * Returns 0 if handed to ISS, -1 if ISS is not registered (caller falls back). */
static int
mox_snmp_forward_get_to_iss (const oid                  *probe_oid,
                             int                         probe_oid_len,
                             netsnmp_agent_request_info *reqinfo,
                             netsnmp_request_info       *request)
{
    netsnmp_subtree      *iss_sub;
    netsnmp_request_info *saved_next;
    char                  oidbuf[MOX_GETFWD_OIDBUF];

    iss_sub = netsnmp_subtree_find(probe_oid, (size_t) probe_oid_len,
                                   NULL, NULL);

    /* DEBUG (ADR-0025): the check below only proves the subtree is non-NULL --
     * it never verifies the registration belongs to the AgentX subagent, so a
     * hit on in-master's own subtree answers locally and still reports success.
     * Print the registration's identity so the two are told apart. Compare
     * access_method against the mxrstpdb/ positive control: same pointer means
     * the same handler, without needing the agentx symbol to be visible. */
    if ( iss_sub == NULL )
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP,
            "GETFWD T3 FIND: probe_oid=%s -> subtree=NULL\n",
            mox_snmp_getfwd_oid_str(probe_oid, probe_oid_len,
                                    oidbuf, sizeof(oidbuf)));
    }
    else if ( iss_sub->reginfo == NULL || iss_sub->reginfo->handler == NULL )
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP,
            "GETFWD T3 FIND: probe_oid=%s -> subtree=%p reginfo=%p handler=%p "
            "(incomplete)\n",
            mox_snmp_getfwd_oid_str(probe_oid, probe_oid_len,
                                    oidbuf, sizeof(oidbuf)),
            (void *) iss_sub, (void *) iss_sub->reginfo,
            (iss_sub->reginfo != NULL) ? (void *) iss_sub->reginfo->handler : NULL);
    }
    else
    {
        char rootbuf[MOX_GETFWD_OIDBUF];

        LibUtil_DbgTrace(kDbgFlgIssUriSNMP,
            "GETFWD T3 FIND: probe_oid=%s -> handlerName=%s handler_name=%s "
            "rootoid=%s priority=%d access_method=%p\n",
            mox_snmp_getfwd_oid_str(probe_oid, probe_oid_len,
                                    oidbuf, sizeof(oidbuf)),
            (iss_sub->reginfo->handlerName != NULL)
                ? iss_sub->reginfo->handlerName : "(null)",
            (iss_sub->reginfo->handler->handler_name != NULL)
                ? iss_sub->reginfo->handler->handler_name : "(null)",
            mox_snmp_getfwd_oid_str(iss_sub->reginfo->rootoid,
                                    (int) iss_sub->reginfo->rootoid_len,
                                    rootbuf, sizeof(rootbuf)),
            iss_sub->reginfo->priority,
            (void *) iss_sub->reginfo->handler->access_method);
    }

    /* DEBUG (ADR-0025, hypothesis under test): the comment above this function
     * asserts a bare column OID resolves to the subagent's registration. The
     * probe that worked under 6185d43 carried an instance sub-id (.1); the
     * derived one does not. Look the .1 variant up too and print both, so the
     * assertion is tested rather than assumed. Lookup only -- nothing is
     * forwarded here. */
    if ( probe_oid_len > 0 && probe_oid_len < IES_MAX_OID )
    {
        oid             inst_oid[IES_MAX_OID];
        netsnmp_subtree *inst_sub;

        memcpy(inst_oid, probe_oid, sizeof(oid) * (size_t) probe_oid_len);
        inst_oid[probe_oid_len] = 1;
        inst_sub = netsnmp_subtree_find(inst_oid, (size_t) probe_oid_len + 1,
                                        NULL, NULL);
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP,
            "GETFWD T3b INSTANCE: probe_oid=%s -> %s / bare -> %s "
            "(access_method inst=%p bare=%p)\n",
            mox_snmp_getfwd_oid_str(inst_oid, probe_oid_len + 1,
                                    oidbuf, sizeof(oidbuf)),
            (inst_sub != NULL) ? "found" : "NULL",
            (iss_sub != NULL) ? "found" : "NULL",
            (inst_sub != NULL && inst_sub->reginfo != NULL &&
             inst_sub->reginfo->handler != NULL)
                ? (void *) inst_sub->reginfo->handler->access_method : NULL,
            (iss_sub != NULL && iss_sub->reginfo != NULL &&
             iss_sub->reginfo->handler != NULL)
                ? (void *) iss_sub->reginfo->handler->access_method : NULL);
    }

    if ( iss_sub == NULL || iss_sub->reginfo == NULL ||
         iss_sub->reginfo->handler == NULL )
    {
        return -1;                      /* ISS AgentX subagent not connected */
    }

    /* Resolving to our OWN registration is the failure this check exists for:
     * netsnmp_call_handlers() would then re-enter the local path, answer from
     * it, and report success -- indistinguishable from a real forward. A probe
     * that is wrong, or derived from a tree with no subagent above it, lands
     * here. Refusing makes the caller fall through to the local read, so the
     * worst case of a bad probe is "no speed-up", never a wrong or lost value. */
    if ( mox_snmp_reg_is_local(iss_sub->reginfo) )
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP,
            "GETFWD T3 LOCAL: probe_oid=%s resolved to our own registration, "
            "refusing to forward\n",
            mox_snmp_getfwd_oid_str(probe_oid, probe_oid_len,
                                    oidbuf, sizeof(oidbuf)));
        return -1;
    }

    /* Forward only THIS request; detach siblings so netsnmp_call_handlers does
     * not pull the rest of the chain (this handler is invoked per request). */
    saved_next    = request->next;
    request->next = NULL;
    (void) netsnmp_call_handlers(iss_sub->reginfo, reqinfo, request);
    request->next = saved_next;

    return 0;
}

/*-------------------------------------------------------------------+
 * Function           : mox_snmp_handle_entry
 *
 * Description        :
        all the get function from ISS, use file operation.
        all function from framework use flask
        all the set function , use flask
+-------------------------------------------------------------------*/
int
mox_snmp_handle_entry
(
    netsnmp_mib_handler                   *handler,
    netsnmp_handler_registration          *reginfo,
    netsnmp_agent_request_info            *reqinfo,
    netsnmp_request_info                  *request 
)
{
    struct ies_auto_mibs_entry             entry_buf;
    struct ies_auto_mibs_entry            *entry = NULL;
    FILE                                  *fp    = NULL;
    int                                    ret;
    struct timespec                        timeBefore;
    struct timespec                        timeAfter;
    char                                   snmp_username[RWUSER_NAME_SIZE] = {0};
    int                                    token_cnt = 0;
    
    if ( request->processed )
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "%s line %d\n", __func__, __LINE__);
        return SNMP_ERR_NOERROR;
    }
    if ( 0 != clock_gettime(CLOCK_MONOTONIC, &timeBefore) ) 
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
    }

    memset(&entry_buf, 0                   , sizeof(entry_buf));
    memcpy(&entry_buf, reginfo->my_reg_void, sizeof(entry_buf));

    entry = &entry_buf;

    if ( IES_AUTO_MIBS_MAGIC_ENTRY != entry->magic ) 
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "%s: Bad Magic \n", __func__);
        return SNMP_ERR_NOSUCHNAME; 
    }

    // Default token for snmp v1, v2c and v3(read-only user)
    snprintf(security_token, sizeof(security_token), "%s", security_tokens[0]);
    // Identify SNMPv3 read-write username and use different token to access
    if (reqinfo->asp->pdu->securityName)
    {
        snprintf(snmp_username, RWUSER_NAME_SIZE, reqinfo->asp->pdu->securityName);
        // Search token array
        for (token_cnt = 0; token_cnt < MAX_TOKEN_NUM - 1; token_cnt++) {
            if (strncmp(snmp_username, rwuser_list[token_cnt], RWUSER_NAME_SIZE) == 0) {
                memset(security_token, 0, sizeof(security_token));
                snprintf(security_token, sizeof(security_token), "%s", security_tokens[token_cnt+1]);
                break;
            }
        }
    }

    if ( MODE_IS_GET(reqinfo->mode) )
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "%s@%d: entry %s \n",
            __func__, __LINE__, entry->uri );

        /* Plan C (agentx_owned.list): a RW column in a group marked +getfwd
         * forwards its GET to the subagent; SET stays local. Which columns is
         * derived from the entry itself -- no hand-maintained column list --
         * but whether a group forwards at all is opt-in per list line. */
        if ( entry->mode & HANDLER_CAN_SET )
        {
            int prefix_idx = mox_snmp_entry_agentx_prefix_idx(entry);
            int getfwd     = mox_snmp_agentx_prefix_getfwd(prefix_idx);

            /* DEBUG (ADR-0025): ADR-0025 left open whether these RW columns
             * reach this gate at all -- the synthesised table registration may
             * hang them off a different handler. This line settles it: no T4
             * GATE for a column means the request never got here. */
            LibUtil_DbgTrace(kDbgFlgIssUriSNMP,
                "GETFWD T4 GATE: uri=%s prefix_idx=%d getfwd=%d\n",
                entry->uri, prefix_idx, getfwd);

            if ( prefix_idx >= 0 && getfwd )
            {
                const struct mox_agentx_probe *probe =
                    mox_snmp_probe_for_entry(entry, prefix_idx);
                int fwd_rc = -1;

                if ( probe != NULL )
                {
                    fwd_rc = mox_snmp_forward_get_to_iss(probe->oid_list,
                                                         probe->oid_len,
                                                         reqinfo, request);
                }
                LibUtil_DbgTrace(kDbgFlgIssUriSNMP,
                    "GETFWD T4 RESULT: uri=%s probe=%s fwd_rc=%d -> %s\n",
                    entry->uri, (probe != NULL) ? "found" : "NULL", fwd_rc,
                    (fwd_rc == 0) ? "FORWARDED" : "fall through to local");
                if ( fwd_rc == 0 )
                {
                    return SNMP_ERR_NOERROR;
                }
                /* no usable probe, or subagent gone → fall through to local */
            }
        }

        /* Plan E (ADR-0003): trustedIp GET/GETNEXT are served natively by the
         * framework's table_iterator (which wins the wire for reads); in-master
         * only handles trustedIp SET. No GET forwarding needed here. */

        if ( moxaSnmpHandle_ChkEntryGetValue(entry) == 0 )
        {
            if ( moxaSnmpHandle_ExeEntryGetValue(reqinfo, request, entry) == 0 )
            {
                return SNMP_ERR_NOERROR;
            }
            return SNMP_ERR_BADVALUE;
        }

        if ( moxaSnmpHandle_UtilMibEntryCheckFromUri(entry) )
        {
            if ( IES_NOERR != entry_handle_generate_uri_value_file(entry, &fp) ) 
            {

                LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d \n", __func__, __LINE__);

                if ( 0 != clock_gettime(CLOCK_MONOTONIC, &timeAfter) ) 
                {
                    LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
                }
                util_timeDiff("mib get bad 2", &timeBefore, &timeAfter);
                return SNMP_ERR_BADVALUE;
            }
        } 
        else 
        {
            if ( IES_NOERR != entry_handle_generate_iss_value_file(entry, &fp) ) 
            {

                LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d \n", __func__, __LINE__);

                if ( 0 != clock_gettime(CLOCK_MONOTONIC, &timeAfter) ) 
                {
                    LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
                }
                util_timeDiff("mib get bad 3", &timeBefore, &timeAfter);
                return SNMP_ERR_BADVALUE;
            }
        }

        ret = entry_handle_get_value_from_file(
            reginfo, reqinfo, request, entry, 
            fp, ( MODE_GET == reqinfo->mode ) ? IES_AUTO_MIBS_TBL_GET : IES_AUTO_MIBS_TBL_GET_NEXT);

        if ( IES_NOERR == IS_SCALAR_ENTRY(entry) ) 
        {
            entry_handle_remove_file(entry);
        }

        if ( 0 != clock_gettime(CLOCK_MONOTONIC, &timeAfter) ) 
        {
            LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
        }

        if ( IES_NOERR == ret ) 
        {
            util_timeDiff("mib_get_success", &timeBefore, &timeAfter);
        } 
        else 
        {
            util_timeDiff("mib get bad 4", &timeBefore, &timeAfter);
        }
        return ( IES_NOERR == ret ) ? SNMP_ERR_NOERROR : SNMP_ERR_BADVALUE;

    } 
    else 
    if ( MODE_IS_SET(reqinfo->mode) ) 
    {
        if ( MODE_SET_COMMIT == reqinfo->mode ) 
        {
            LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "%s@%d: entry %s \n",
                __func__, __LINE__, entry->uri );
            if ( moxaSnmpHandle_ChkEntrySetValue(entry) == 0 )
            {
                if ( moxaSnmpHandle_ExeEntrySetValue(reqinfo, request, entry) == 0 )
                {
                    return SNMP_ERR_NOERROR;
                }
                return SNMP_ERR_BADVALUE;
            }
            return mox_snmp_flask_handle_entry_set(reqinfo, request, entry);
        }
        else
        if ( reqinfo->mode == MODE_SET_RESERVE1 )
        {
            LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "%s@%d: entry %s \n",
                __func__, __LINE__, entry->uri );
            if ( moxaSnmpHandle_ChkEntryDep(entry) == 0 )
            {
                if ( moxaSnmpHandle_ExeEntryDep(reqinfo, request, entry) == 0 )
                {
                    return SNMP_ERR_NOERROR;
                }
                return SNMP_ERR_BADVALUE;
            }
        }
        return SNMP_ERR_NOERROR;
    }
    // TBD: only support GET/SET for now !!
    LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d \n", __func__, __LINE__);
    return SNMP_ERR_BADVALUE;
}

/*-------------------------------------------------------------------+
 * Function           : mox_snmp_init_entry
 *
 * Description        :
        register MIB entry into NetSNMP

+-------------------------------------------------------------------*/
/* Plan C: agentx_owned.list — RO entries whose URI prefix matches are NOT
 * registered locally, so snmpd master longest-prefix-routes them to the ISS
 * AgentX subagent (fast GET). RW entries are always kept local (SET via
 * framework). Empty/absent list = legacy (register everything). */
#define AGENTX_OWNED_LIST_FILE   "/etc/moxa/netsnmp/agentx_owned.list"
/* AGENTX_OWNED_MAX is defined above, next to AGENTX_PROBE_MAX. */
#define AGENTX_OWNED_PREFIX_LEN  (64)
#define AGENTX_OWNED_LINE_LEN    (256)
static char gAgentXOwnedPrefix[AGENTX_OWNED_MAX][AGENTX_OWNED_PREFIX_LEN];
static int  gAgentXOwnedGetFwd[AGENTX_OWNED_MAX];
static int  gAgentXOwnedNoDeleg[AGENTX_OWNED_MAX];
static oid  gAgentXOwnedProbe[AGENTX_OWNED_MAX][IES_MAX_OID];
static int  gAgentXOwnedProbeLen[AGENTX_OWNED_MAX];
static int  gAgentXOwnedCount  = 0;
static int  gAgentXOwnedLoaded = 0;

/* "1.3.6.1.4.1.8691.603.6" / ".1.3.6.1..." -> sub-identifiers. Hand-rolled
 * rather than read_objid(), which resolves names through the MIB tree and so
 * depends on parser state this early path does not need. */
static int mox_snmp_parse_dotted_oid (const char *s, oid *out, int max)
{
    int len = 0;

    if ( s == NULL || out == NULL )
    {
        return 0;
    }
    while ( *s == '.' ) s++;
    while ( *s >= '0' && *s <= '9' && len < max )
    {
        unsigned long v = 0;
        while ( *s >= '0' && *s <= '9' )
        {
            v = (v * 10) + (unsigned long) (*s - '0');
            s++;
        }
        out[len++] = (oid) v;
        if ( *s != '.' )
        {
            break;
        }
        s++;
    }
    return len;
}

/* A line is "<uri-prefix>" or "<uri-prefix> <flags...>". Two flags:
 *
 *   +getfwd        also forward the GET of this group's RW columns to the
 *                  subagent (SET still stays local). Without it the line does
 *                  the RO registration skip and nothing else, which is what
 *                  most groups want -- forwarding a RW column's GET only pays
 *                  off when the local read of that column is slow.
 *   +nodelegate    forward only: keep this group's RO entries registered
 *                  locally instead of handing them to the subagent. For a
 *                  group that is nearly all RW, delegating the odd RO column
 *                  loses it outright when the subagent does not serve it,
 *                  and the group was listed for forwarding, not for coverage.
 *   probe=<oid>    use this OID to locate the subagent's registration instead
 *                  of deriving one. Only needed when derivation cannot find a
 *                  non-local ancestor; the OID is never fetched, it only
 *                  resolves the registration, so any node inside the
 *                  subagent's subtree works. */
static void mox_snmp_load_agentx_owned_list(void)
{
    FILE *fp;
    char  line[AGENTX_OWNED_LINE_LEN];

    gAgentXOwnedCount = 0;
    fp = fopen(AGENTX_OWNED_LIST_FILE, "r");
    if (fp == NULL) {
        return;                         /* legacy: no file → register everything locally */
    }
    while (fgets(line, sizeof(line), fp) != NULL &&
           gAgentXOwnedCount < AGENTX_OWNED_MAX) {
        char  *p = line;
        char  *flags;
        size_t n;

        /* A line longer than the buffer comes back from the next fgets() and
         * would be parsed as an entry of its own. That is not theoretical: a
         * comment ending in "... columns" yielded the prefix "s", which
         * strncmp-matches every std*db/ URI and would delegate all of them.
         * Swallow the tail so only the head of the line is ever an entry. */
        n = strlen(line);
        if (n > 0 && line[n-1] != '\n') {
            int c;
            while ((c = fgetc(fp)) != EOF && c != '\n')
                ;
        }

        while (*p == ' ' || *p == '\t') p++;          /* skip leading ws */
        if (*p == '#' || *p == '\n' || *p == '\r' || *p == '\0') continue;
        n = strlen(p);
        while (n > 0 && (p[n-1]=='\n'||p[n-1]=='\r'||p[n-1]==' '||p[n-1]=='\t'))
            p[--n] = '\0';                            /* strip trailing ws */
        if (n == 0) continue;
        flags = p + strcspn(p, " \t");                /* split prefix from flags */
        if (*flags != '\0') {
            *flags++ = '\0';
        }
        gAgentXOwnedGetFwd[gAgentXOwnedCount] =
            (strstr(flags, "+getfwd") != NULL) ? 1 : 0;
        gAgentXOwnedNoDeleg[gAgentXOwnedCount] =
            (strstr(flags, "+nodelegate") != NULL) ? 1 : 0;
        gAgentXOwnedProbeLen[gAgentXOwnedCount] = 0;
        {
            const char *pr = strstr(flags, "probe=");
            if ( pr != NULL )
            {
                gAgentXOwnedProbeLen[gAgentXOwnedCount] =
                    mox_snmp_parse_dotted_oid(pr + 6,
                        gAgentXOwnedProbe[gAgentXOwnedCount], IES_MAX_OID);
            }
        }
        strncpy(gAgentXOwnedPrefix[gAgentXOwnedCount], p, AGENTX_OWNED_PREFIX_LEN-1);
        gAgentXOwnedPrefix[gAgentXOwnedCount][AGENTX_OWNED_PREFIX_LEN-1] = '\0';
        gAgentXOwnedCount++;
    }
    fclose(fp);
}

static int mox_snmp_agentx_prefix_getfwd(int prefix_idx)
{
    if (prefix_idx < 0 || prefix_idx >= gAgentXOwnedCount) {
        return 0;
    }
    return gAgentXOwnedGetFwd[prefix_idx];
}

/* Does this line forward without delegating? */
static int mox_snmp_agentx_prefix_nodelegate(int prefix_idx)
{
    if (prefix_idx < 0 || prefix_idx >= gAgentXOwnedCount) {
        return 0;
    }
    return gAgentXOwnedNoDeleg[prefix_idx];
}

/* The probe= OID for this line, or 0 if the line does not carry one. */
static int mox_snmp_agentx_prefix_probe(int prefix_idx, const oid **probe_oid)
{
    if (prefix_idx < 0 || prefix_idx >= gAgentXOwnedCount) {
        return 0;
    }
    if (probe_oid != NULL) {
        *probe_oid = gAgentXOwnedProbe[prefix_idx];
    }
    return gAgentXOwnedProbeLen[prefix_idx];
}

/* Which agentx_owned.list line covers this entry, or -1. Access mode is not
 * considered here -- the RO case drives the registration skip, the RW case
 * drives GET forwarding, and both need the same prefix answer. */
static int mox_snmp_entry_agentx_prefix_idx(struct ies_auto_mibs_entry *entry)
{
    int i;
    if (!gAgentXOwnedLoaded) {
        mox_snmp_load_agentx_owned_list();
        gAgentXOwnedLoaded = 1;
    }
    for (i = 0; i < gAgentXOwnedCount; i++) {
        if (strncmp(entry->uri, gAgentXOwnedPrefix[i],
                    strlen(gAgentXOwnedPrefix[i])) == 0) {
            return i;
        }
    }
    return -1;
}

static int mox_snmp_entry_is_agentx_owned(struct ies_auto_mibs_entry *entry)
{
    int prefix_idx;

    if (entry->mode & HANDLER_CAN_SET) {
        return 0;                       /* RW → keep local; SET goes via framework */
    }
    prefix_idx = mox_snmp_entry_agentx_prefix_idx(entry);
    if (prefix_idx < 0) {
        return 0;
    }
    /* +nodelegate splits what a list line does. Listing a prefix normally means
     * two things at once -- hand its RO entries to the subagent, and forward
     * its RW columns' GETs -- but a group that is nearly all RW wants only the
     * second. Delegating the odd RO column there costs a whole column when the
     * subagent does not serve it: mxqosdb/ lost qosConfigMeterColorModeType
     * that way, 15 columns down to 14, silently (ADR-0031). */
    if (mox_snmp_agentx_prefix_nodelegate(prefix_idx)) {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP,
            "GETFWD T0 NODELEG: uri=%s prefix_idx=%d kept local (forward-only line)\n",
            entry->uri, prefix_idx);
        return 0;
    }
    return 1;
}

ies_handle_t
mox_snmp_init_entry
(
    struct ies_auto_mibs_entry *entry_array,
    int                         entry_array_len
)
{
    int i, j;
    netsnmp_handler_registration *reginfo = NULL;
    struct ies_auto_mibs_entry   *entry   = NULL;
    
    
    for( i = 0; i < entry_array_len; i++ ) 
    {
        entry = NULL;
        entry = (struct ies_auto_mibs_entry *) malloc ( sizeof(*entry) );

        if ( entry == NULL )
        {
            LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", 
                __func__, __LINE__);

            return IES_ERR;
        }

        memset(entry, 0, sizeof(*entry));
        memcpy(entry, &entry_array[i], sizeof(*entry));

        entry->magic = IES_AUTO_MIBS_MAGIC_ENTRY;

        if ( IES_NOERR != ies_auto_mibs_setup_entry_flags(entry) )
        {
            LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n",
                __func__, __LINE__);

            return IES_ERR;
        }

        /* Plan C: RO + agentx_owned prefix → skip local register, let snmpd
         * master route this OID to the ISS AgentX subagent. */
        if ( !gAgentXOwnedLoaded )
        {
            mox_snmp_load_agentx_owned_list();
            gAgentXOwnedLoaded = 1;
        }
        if ( mox_snmp_entry_is_agentx_owned(entry) )
        {
            /* Handed to the subagent. Only +getfwd groups ever look a probe up,
             * so only they need candidates recorded (the table is bounded). */
            int prefix_idx = mox_snmp_entry_agentx_prefix_idx(entry);
            if ( mox_snmp_agentx_prefix_getfwd(prefix_idx) )
            {
                mox_snmp_probe_note_delegated(entry, prefix_idx);
            }
            free(entry);
            continue;
        }

        if ( moxaSnmpHandle_UtilMibEntryGenerateTableIndexEntry(entry) != 0 )
        {
            LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n",
                __func__, __LINE__);

            return IES_ERR;
        }

        if ( moxaSnmpHandle_UtilMibEntryRegisterToNetSNMP(entry) != 0 )
        {
            LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d, name=%s\r\n",
                __func__, __LINE__, entry->name);

            return IES_ERR;
        }
    }
    return IES_NOERR;
}

/*-------------------------------------------------------------------+
 * Function           : exit_ies_auto_mibs
 *
 * Description        :
        

+-------------------------------------------------------------------*/
void exit_ies_auto_mibs(void)
{
    int                           i;
    netsnmp_handler_registration *reginfo = NULL;
    

    for ( i = 0; i < cnt_reginfo; i++ ) 
    {
        reginfo = buf_reginfo[i];
        if ( NULL != reginfo ) 
        {
            if ( NULL != reginfo->my_reg_void ) 
            {
                free(reginfo->my_reg_void);
            } 
            else 
            {
                LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n",  __func__, __LINE__);
                break;
            }
        } 
        else 
        {
            LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", 
                __func__, __LINE__);
            break;
        }
    }

    event_handler_exit();

    return;
}

/*-------------------------------------------------------------------+
 * Function           : init_ies_auto_mibs
 *
 * Description        :
        

+-------------------------------------------------------------------*/
void init_ies_auto_mibs(void)
{
    LibUtil_SetDbgFlgBits(kDbgFlgIssUriSNMP);

    if ( LIB_SYSTEM_RET_SUCCESS != LibSystem_GetMaxPortNumInSystem(&aMaxPortNumPtr) )
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", 
            __func__, __LINE__);
        return;
    }

    if ( LIB_SYSTEM_RET_SUCCESS != LibSystem_GetProductId(&gProductId) )
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", 
            __func__, __LINE__);
        return;
    }

    if ( LIB_SYSTEM_RET_SUCCESS != LibSystem_GetMaxPortChannelNumInSystem(&gMaxPortChannel) )
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n",
            __func__, __LINE__);
        return;
    }

    gMaxPortInDevice = aMaxPortNumPtr;
    gMaxPortNumber   = gMaxPortInDevice + gMaxPortChannel;
    LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "%s@%d gMaxPortInDevice = %d\n", 
        __func__, __LINE__, gMaxPortInDevice);
    LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "%s@%d gMaxPortChannel  = %d\n", 
        __func__, __LINE__, gMaxPortChannel);
    LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "%s@%d gMaxPortNumber   = %d\n", 
        __func__, __LINE__, gMaxPortNumber);
    LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "%s@%d gProductId       = %8.8x\n", 
        __func__, __LINE__, gProductId);

    if ( IES_NOERR != utilStoken_delete_security_token() ) 
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
        return;
    }

    if ( 0 != LibUtil_ExecShCmd(NULL, NULL, 0, 
            "/bin/rm -rf %s/*", AUTO_MIB_PATH) ) 
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", 
            __func__, __LINE__);
        return;
    }

    if ( 0 != LibUtil_ExecShCmd(NULL, NULL, 0, 
            "/bin/mkdir -p %s", AUTO_MIB_PATH) ) 
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", 
            __func__, __LINE__);
        return;
    }

    if ( IES_NOERR != event_handler_init() )
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
        return;
    }

    util_table_snapshot_reset();

    if ( IES_NOERR != utilStoken_update_security_token() ) 
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
        return;
    }


    if ( IES_NOERR != ies_auto_mibs_load_mibs() ) 
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "Error in %s line %d\n", __func__, __LINE__);
        return;
    }


    LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "%s Done !!\n", __func__);
    LibUtil_ClearDbgFlgBits(kDbgFlgIssUriSNMP);
    return;
}

#endif // _IES_AUTO_MIBS_C_
