#!/bin/bash
# walkstats.sh <label> <root-oid> [reps] [threshold_ms]
#
# Walk an OID subtree while capturing the wire, then report the three numbers
# that matter for the 50 ms requirement:
#
#   avg / worst / share of responses over the threshold
#
# Average alone hides the tail, which is the thing the requirement is about —
# mx_device_io was the case that proved it (median flat, worst 153 ms -> 10.1 s).
# So worst and the >threshold share are reported alongside, never instead.
#
# Latency is measured request-to-response on the wire, paired by
# snmp.request_id (tools/latency_stats.sh does the arithmetic), not from the
# client's wall clock — wall clock folds in snmpwalk's own scheduling.
set -u

LABEL="${1:?usage: walkstats.sh <label> <root-oid> [reps] [threshold_ms]}"
ROOT="${2:?usage: walkstats.sh <label> <root-oid> [reps] [threshold_ms]}"
REPS="${3:-5}"
TH="${4:-50}"

D=192.168.127.253
IF=eth3
OUT="$HOME/pcap/$(date +%Y-%m-%d)_${LABEL}.pcap"
mkdir -p "$HOME/pcap"

sudo -n /usr/sbin/tcpdump -i "$IF" -s0 -U -Z "$USER" -w "$OUT" \
     "host $D and udp port 161" 2>"$OUT.log" &
sleep 3
pgrep -f "tcpdump -i $IF" >/dev/null || { echo "!! tcpdump did not start"; cat "$OUT.log"; exit 1; }

echo "=== $LABEL : $REPS x walk $ROOT ==="
for i in $(seq 1 "$REPS"); do
    S=$(date +%s.%N)
    # Absolute path: ~/.local/bin/snmpwalk is a pysnmp build that hangs.
    N=$(/usr/bin/snmpwalk -v2c -c public -On -t 5 "$D" "$ROOT" 2>/dev/null | awk 'END{print NR}')
    E=$(date +%s.%N)
    printf '  run %d: %6.3f s  %s varbinds\n' "$i" "$(echo "$E - $S" | bc)" "$N"
    sleep 1
done

sleep 2
sudo -n pkill -f "tcpdump -i $IF" 2>/dev/null
sleep 1

echo -n "  wire: "
bash "$HOME/WORK/SNMP_50ms/tools/latency_stats.sh" "$OUT" "$TH"
