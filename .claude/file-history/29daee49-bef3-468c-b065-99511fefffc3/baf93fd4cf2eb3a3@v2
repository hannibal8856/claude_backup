/*
 * lib_moxa_ies_auto_mibs — OID <-> URI mapping data (Layer-1) + lookup.
 *
 * Plan D B seed. C source of truth for "which OID maps to which config-layer
 * URI". Consumers (framework subagent via lib_moxa_rust_ies_auto_mibs) look up
 * an OID to get its URI, then read the value in-process.
 *
 * Pure data + lookup; no net-snmp calls (moxa_oid has the same width as the
 * net-snmp `oid` type, unsigned long).
 */
#ifndef LIB_MOXA_IES_AUTO_MIBS_H
#define LIB_MOXA_IES_AUTO_MIBS_H

#include <stddef.h>

#ifdef __cplusplus
extern "C" {
#endif

/* Exported even though the library builds with -fvisibility=hidden. */
#define MOXA_IES_API __attribute__((visibility("default")))

/* Same width as net-snmp `oid` (unsigned long). */
typedef unsigned long moxa_oid;

/* One OID <-> URI mapping row. */
/* `table_col` — how the framework subagent handler resolves an OID's value.
 * Grows as new table shapes are migrated. KEEP IN SYNC with the Rust mirror in
 * lib_moxa_rust_ies_auto_mibs (COL_* consts) + the handler in snmp_subagent.rs. */
#define IES_COL_SCALAR         0  /* plain config leaf: get_config_from_path(uri)             */
#define IES_COL_ROW_INDEX      1  /* index column, value = trailing OID sub-id (portsPbmp
                                   * portIndex, turboring ring index); row assumed present    */
#define IES_COL_PBMP_VALUE     2  /* portsPbmp value: config bool array[port-1] as TruthValue */
#define IES_COL_IDXTBL_VALUE   3  /* index-table value: "<uri><row-1>/<column>" (0-based)     */
#define IES_COL_IDXTBL_INDEX   4  /* index-table index: trailing OID sub-id, if the row exists */
#define IES_COL_TR2RING_VALUE  5  /* turboring ring value: "<uri>/ring<row>/<column>" (1-based) */
#define IES_COL_ROWSTATUS      6  /* SNMP RowStatus: not a config leaf; life-cycle of the
                                   * index-table row (create/destroy / valid), see ADR-0001 */
#define IES_COL_TR2RING_IFACE  7  /* turboring ring "interface" (REDUNDANT_PORT): ONE OCTET
                                   * STRING built from TWO config objects,
                                   * "<uri>/ring<row>/{firstPort,secondPort}" = {iftype,index}.
                                   * Not a single config leaf, so it cannot reuse
                                   * IES_COL_TR2RING_VALUE's "<uri>/ring<row>/<column>" path. */

/* --- index-table columns whose backing field is a 2-element JSON string array.
 * fiber_check stores a {low, high} pair in ONE field ("txPowerWarning",
 * "rxPowerWarning", "txPowerLimit", "rxPowerLimit") but the MIB gives each end
 * its own column, so one field feeds two OIDs. Path is built exactly like
 * IES_COL_IDXTBL_VALUE ("<uri><row-1>/<column>"); only the value extraction
 * differs. Mirrors plugin_snmp_fiber_check.c's _GetStringArrayFirst/Second. */
#define IES_COL_IDXTBL_ARR_LO  8  /* array[0] as OCTET STRING (plugin: ...ArrayFirst)  */
#define IES_COL_IDXTBL_ARR_HI  9  /* array[1] as OCTET STRING (plugin: ...ArraySecond) */
#define IES_COL_IDXTBL_ARR_STR 10 /* whole array as "[<a>, <b>]" — the status
                                   * *Limit columns; plugin: _GetStringArray      */
#define IES_COL_CONST_FALSE    11 /* no backing field at all: GET always returns the
                                   * SNMPv2 TruthValue false(2). fiber_check's
                                   * resetToDefault is an action column — plugin:
                                   * _GetDummyFalse. SET is handled per-group.    */

struct ies_map_entry {
    const moxa_oid *oid;       /* OID subids, no instance                       */
    size_t          oid_len;
    const char     *uri;       /* config-layer URI base, e.g. "ifmibdb/ifTable/" */
    const char     *uri_index; /* index/leaf name, e.g. "ifAdminStatus"          */
    int             val_type;  /* SNMP_DATA_TYPE_* (numeric)                      */
    int             mode;      /* HANDLER_CAN_RONLY (0x01) / RWRITE (0x03)        */
    int             table_col; /* one of IES_COL_* above                         */
    int             is_status; /* 1 = read from the status layer (net_*.h URI had
                                * a "stat/" prefix), not the config layer.        */
    int             is_iface;  /* 1 = port interface index: the config layer is
                                * 0-based but SNMP is 1-based, so GET adds 1 and
                                * SET subtracts 1 (IES_FLAG_SNMP_URI_INTERFACE).
                                * in-master does this in ies_auto_mibs.c:2498/2794. */
};

/* Exact-match lookup by OID (no instance). Returns a pointer to a static table
 * entry (valid for program lifetime) or NULL if not found. */
MOXA_IES_API const struct ies_map_entry *
ies_map_lookup_by_oid(const moxa_oid *o, size_t olen);

/* Iterate the table (so the subagent can register every mapped OID). */
MOXA_IES_API size_t ies_map_count(void);
MOXA_IES_API const struct ies_map_entry *ies_map_entry_at(size_t i);

/* Physical port count (LibSystem max port num in system) — in-master's
 * gMaxPortInDevice. Needed by IES_COL_TR2RING_IFACE to encode a PORT_CHANNEL
 * interface as `index + 1 + max_port_num`. Returns 0 if LibSystem fails. */
MOXA_IES_API unsigned int ies_max_port_num(void);

/* Write a config value via the framework's own REST endpoint (loopback), the
 * same path the dlmod uses today: PATCH /api/v1/setting/data/<config_uri>?save
 * (deviceName is POST /api/v1/setting/agent/...). `config_uri` is the mapping's
 * config-layer path (e.g. "systemInformation/systemName"). Returns 0 on success.
 * (Config SET is rare; latency here is irrelevant.) */
MOXA_IES_API int ies_config_set(const char *config_uri, const char *value);

/* Same as ies_config_set but writes a JSON number (for INTEGER OIDs). */
MOXA_IES_API int ies_config_set_int(const char *config_uri, long value);

/* Same as ies_config_set but writes a JSON boolean (nonzero -> true). Used for
 * config fields stored as booleans but exposed as SNMP INTEGER TruthValues. */
MOXA_IES_API int ies_config_set_bool(const char *config_uri, int value);

/* PATCH a raw JSON value (parsed from `json_text`, e.g. a boolean array
 * "[true,false,…]"). Used by the portsPbmp SET: the caller reads the array,
 * flips one element, and writes the whole array back. */
MOXA_IES_API int ies_config_set_json(const char *config_uri, const char *json_text);

/* --- mxFiberCheck data processing (src/fiber_check.c) ---------------------
 *
 * Six of mxFiberCheck's columns are not plain leaves: four map onto the two
 * ends of a 2-element JSON string array, one renders that whole array, and one
 * is a pure action. All ported from the dlmod plugin this group replaces
 * (plugin_moxa_fiber_check/snmp/plugin_snmp_fiber_check.c).
 */

/* Extraction only — the caller supplies the field's JSON text, because the
 * framework subagent already has the value in-process and must not go back over
 * loopback HTTP for every OID of a 264-varbind walk. `which` is 0 (low) or 1
 * (high); a missing element yields "". Returns 0 on success. */
MOXA_IES_API int ies_fc_array_elem(const char *json_text, int which,
                                   char *out, size_t out_len);

/* The same array rendered as `[<low>, <high>]` — byte-identical to the dlmod's
 * _GetStringArray, including the space after the comma. Returns 0 on success. */
MOXA_IES_API int ies_fc_array_pair(const char *json_text,
                                   char *out, size_t out_len);

/* `option` for ies_fc_set(). Order matters: everything below IES_FC_MODE_AUTO
 * carries a numeric `value`, the rest are actions taking NULL (mirrors the
 * plugin's enum, whose `aConfigOption < kModeAuto` test gates validation). */
#define IES_FC_TEMP_WARN_C    0
#define IES_FC_TEMP_WARN_F    1
#define IES_FC_TX_POWER_HI    2
#define IES_FC_TX_POWER_LO    3
#define IES_FC_RX_POWER_HI    4
#define IES_FC_RX_POWER_LO    5
#define IES_FC_MODE_AUTO      6
#define IES_FC_MODE_USER      7
#define IES_FC_RESET_DEFAULT  8

/* Write one fiber-check config option for `port_index` (0-based, as the config
 * layer numbers ports). Read-modify-writes the whole row exactly as the dlmod
 * does, so the C/F pair stays consistent and empty thresholds are back-filled
 * with the SFF defaults before any partial write. Returns 0 on success. */
MOXA_IES_API int ies_fc_set(unsigned int port_index, int option,
                            const char *value);

#ifdef __cplusplus
}
#endif

#endif /* LIB_MOXA_IES_AUTO_MIBS_H */
