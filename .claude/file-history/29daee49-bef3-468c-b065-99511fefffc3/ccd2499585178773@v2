/// Render a config field as SNMP INTEGER, mirroring the in-master / generic
/// handler: JSON number as-is, JSON bool -> TruthValue (true->1, false->2).
/// `None` -> noSuchInstance.
fn set_int_or_truth(requests: *mut c_void, item: &serde_json::Value, key: &str) {
    let n = item
        .get(key)
        .and_then(|v| v.as_i64().or_else(|| v.as_bool().map(|b| if b { 1 } else { 2 })));
    match n {
        Some(n) => {
            agentx::set_int(requests, n);
        }
        None => {
            agentx::set_no_such_instance(requests);
        }
    }
}

/// Plan E (ADR-0006, iss0 promotion): net-snmp `table_iterator` node handler for
/// the L3 VLAN interface table. Reads the CURRENT config each request (no startup
/// snapshot) so GET reflects config changes with no reboot. GET-only (RONLY); SET
/// (incl. rowStatus createAndGo/destroy) stays in-master (readCreate_v2_mxIpif.c).
/// Columns (byte-identical to the current in-master rendering, DUT-verified):
///   1=index(INTEGER row), 2=ifVlanId(INTEGER — see note), 3=adminStatusUpEnable,
///   4=mtu, 5=proxyArpEnable (all INTEGER, bool->1/2), 6=rowStatus(active(1)/
///   notInService(2)), 7=ipv4.ipAddress(IpAddress), 8=ipv4.netmask(IpAddress).
/// NOTE col2: in-master renders `ifName`="vlanN" through atoi() -> always 0 (the
/// leading 'v' is non-numeric). This handler instead returns the parsed VLAN id
/// (per MIB SYNTAX Integer32 0..4094) — a deliberate fix of that in-master bug.
extern "C" fn l3vlanif_iter_handler(
    _handler: *mut c_void,
    _reginfo: *mut c_void,
    _reqinfo: *mut c_void,
    requests: *mut c_void,
) -> c_int {
    let oid = match agentx::get_request_oid(requests) {
        Some(o) => o,
        None => {
            agentx::set_no_such_instance(requests);
            return agentx::SNMP_ERR_NOERROR;
        }
    };
    // Instance OID = ROOT + [1 (entry), col, row]; net-snmp resolved it already.
    let rl = L3VLANIF_ROOT.len();
    if oid.len() < rl + 3 {
        agentx::set_no_such_instance(requests);
        return agentx::SNMP_ERR_NOERROR;
    }
    let col = oid[rl + 1];
    let row = oid[oid.len() - 1] as usize;

    let rows = l3vlanif_rows();
    let Some(item) = rows.get(row.wrapping_sub(1)) else {
        agentx::set_no_such_instance(requests);
        return agentx::SNMP_ERR_NOERROR;
    };
    match col {
        1 => {
            agentx::set_int(requests, row as i64);
        }
        2 => {
            // ifVlanId = the VLAN number parsed from ifName "vlanN" (MIB SYNTAX
            // Integer32 0..4094). This deliberately FIXES the in-master atoi()
            // rendering, which returned 0 because ifName starts with 'v'.
            match item
                .get("ifName")
                .and_then(|v| v.as_str())
                .and_then(|s| s.strip_prefix("vlan"))
                .and_then(|d| d.parse::<i64>().ok())
            {
                Some(n) => {
                    agentx::set_int(requests, n);
                }
                None => {
                    agentx::set_no_such_instance(requests);
                }
            }
        }
        3 => set_int_or_truth(requests, item, "adminStatusUpEnable"),
        4 => set_int_or_truth(requests, item, "mtu"),
        5 => set_int_or_truth(requests, item, "proxyArpEnable"),
        6 => {
            // Mirror in-master / handle_rowstatus_get: valid==false -> notInService,
            // else (true or absent) -> active.
            let rs = match item.get("valid").and_then(|v| v.as_bool()) {
                Some(false) => RS_NOT_IN_SERVICE,
                _ => RS_ACTIVE,
            };
            agentx::set_int(requests, rs);
        }
        7 => match item
            .get("ipv4")
            .and_then(|v| v.get("ipAddress"))
            .and_then(|v| v.as_str())
            .and_then(ipv4_to_bytes)
        {
            Some(b) => {
                agentx::set_ipaddress(requests, &b);
            }
            None => {
                agentx::set_no_such_instance(requests);
            }
        },
        8 => match item
            .get("ipv4")
            .and_then(|v| v.get("netmask"))
            .and_then(|v| v.as_str())
            .and_then(ipv4_to_bytes)
        {
            Some(b) => {
                agentx::set_ipaddress(requests, &b);
            }
            None => {
                agentx::set_no_such_instance(requests);
            }
        },
        _ => {
            agentx::set_no_such_instance(requests);
        }
    }
    agentx::SNMP_ERR_NOERROR
}

/// Start the AgentX subagent on its own thread (non-blocking). Registers every
/// mapped config OID read-only and connects to the snmpd master.
pub fn start_snmp_subagent(
    plugins: Arc<Mutex<Plugins>>,
    configs: Arc<Mutex<Configs>>,
    status_operation: Arc<Mutex<StatusOperation>>,
    plugins_status: Arc<Mutex<plugins_moxa_framework::status::Plugins>>,
) {
    let _ = STATE.set(SubagentState {
        plugins,
        configs,
        status_operation,
        plugins_status,
        status_snap: Mutex::new(StatusSnap {
            by_plugin: HashMap::new(),
        }),
    });

    agentx::init("app_moxa_framework");
    // Every group registration lives in GROUPS — see that table for what each
    // group is and why it is served the way it is.
    for g in GROUPS {
        register_group(g);
    }
    // Fallback: any mapped OID not covered by a group is registered one by one.
    // The skip set comes from GROUPS itself, so a group is never double-registered.
    for oid in lib_moxa_rust_ies_auto_mibs::all_oids() {
        if GROUPS.iter().any(|g| oid_under(&oid, g.root)) {
            continue;
        }
        agentx::register_instance(
            "moxaIesConfig",
            &oid,
            agentx::HANDLER_CAN_RWRITE,
            moxa_config_handler,
        );
    }
    agentx::run_in_thread();
}
