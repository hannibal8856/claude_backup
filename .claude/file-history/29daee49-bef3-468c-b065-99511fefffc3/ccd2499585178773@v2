//! AgentX subagent for app_moxa_framework (Plan D B).
//!
//! B1 (Design C): the framework, as an AgentX subagent, FULLY owns the config
//! OIDs listed in `lib_moxa_ies_auto_mibs` (the dlmod is removed).
//! - GET maps OID -> config-layer URI and reads the value in-process via
//!   `config_operation::get_config_from_path` + `remove_password_from_config` —
//!   the exact pair the REST `_setting_get` uses (byte-identical, fast).
//! - SET reuses the framework's own REST PATCH via `ies_config_set` — the exact
//!   loopback path the dlmod used (byte-identical; SET is rare, latency moot).

use std::collections::HashMap;
use std::os::raw::{c_int, c_uint, c_void};
use std::sync::{Arc, Mutex, OnceLock};
use std::time::{Duration, Instant};

use lib_moxa_rust_ies_auto_mibs::col;
use lib_moxa_rust_ies_auto_mibs::fc;
use lib_moxa_rust_snmp_agentx as agentx;
use plugins_moxa_framework::config::Plugins;
use qstring::QString;
use rust_moxa_common::config_configs::Configs;
use rust_moxa_common::user_info::{UserInfo, UserInfoRole};
use rust_moxa_config_layer::config_operation;
use rust_moxa_status_operation::StatusOperation;

/// How long a per-plugin status snapshot stays valid (mirrors in-master table
/// snapshot reuse across a walk). plugin_moxa_io has cache_timeout=0, so without
/// this every OID would re-scan hardware.
const STATUS_SNAP_TTL: Duration = Duration::from_secs(2);

/// Per-plugin status root, refreshed at most once per TTL on the AgentX thread.
struct StatusSnap {
    /// plugin name -> (fetched_at, plugin status object)
    by_plugin: HashMap<String, (Instant, serde_json::Value)>,
}

/// Live handles into the running framework state, shared with the subagent
/// thread (same `Arc<Mutex<…>>` the actix workers use).
struct SubagentState {
    plugins: Arc<Mutex<Plugins>>,
    configs: Arc<Mutex<Configs>>,
    status_operation: Arc<Mutex<StatusOperation>>,
    plugins_status: Arc<Mutex<plugins_moxa_framework::status::Plugins>>,
    status_snap: Mutex<StatusSnap>,
}

static STATE: OnceLock<SubagentState> = OnceLock::new();

/// Fixed read identity for SNMP GETs (Task 5): reads are identity-less — VACM
/// authorizes at the master and per-OID config values are uniform. Matches the
/// admin identity `LibUtil_CreateToken` bakes for today's SNMP reads.
fn sys_read_userinfo() -> UserInfo {
    UserInfo {
        username: "snmp@moxa^service".to_string(),
        role: UserInfoRole::admin,
        nonce: String::new(),
        from_ip: "127.0.0.1".to_string(),
    }
}

/// First path segment = status plugin name (e.g. "io" from "io/power/system/0").
fn status_plugin_name(path: &str) -> Option<&str> {
    path.split('/').find(|s| !s.is_empty())
}

/// Walk `path` under a plugin status root. The first segment is the plugin name
/// (already selected); remaining segments index into `root`.
fn navigate_plugin_status(root: &serde_json::Value, path: &str) -> serde_json::Value {
    let mut cur = root;
    let mut skip_plugin = true;
    for attr in path.split('/').filter(|s| !s.is_empty()) {
        if skip_plugin {
            skip_plugin = false;
            continue;
        }
        cur = match attr.parse::<usize>() {
            Ok(i) => &cur[i],
            Err(_) => &cur[attr],
        };
        if cur.is_null() {
            return serde_json::Value::Null;
        }
    }
    cur.clone()
}

/// fiber_check's config table URI, as stored in the mapping. Its SET path is
/// special-cased whole (see handle_fc_set).
const FC_CONFIG_URI: &str = "mxfiberCheck/general/portTable/";

/// SET for a fiber_check config column: pick the dlmod option this OID means,
/// then hand the row to the ported read-modify-write. Returns 0 on success.
fn handle_fc_set(entry: &lib_moxa_rust_ies_auto_mibs::MapEntry, requests: *mut c_void) -> i32 {
    let row = match agentx::get_request_oid(requests).and_then(|o| o.last().copied()) {
        Some(r) if r >= 1 => r,
        _ => return -1,
    };
    // SNMP rows are 1-based, the config layer's port array is 0-based.
    let port = (row - 1) as u32;

    // resetToDefault: an action, and the only value that does anything is
    // true(1) — the dlmod rejects everything else outright.
    if entry.table_col == col::CONST_FALSE {
        return match agentx::get_set_int(requests) {
            Some(1) => lib_moxa_rust_ies_auto_mibs::fc_set(port, fc::RESET_DEFAULT, None),
            _ => -1,
        };
    }

    // mode is an INTEGER selecting between the two whole-row actions.
    if entry.uri_index == "mode" {
        return match agentx::get_set_int(requests) {
            Some(0) => lib_moxa_rust_ies_auto_mibs::fc_set(port, fc::MODE_AUTO, None),
            Some(1) => lib_moxa_rust_ies_auto_mibs::fc_set(port, fc::MODE_USER, None),
            _ => -1,
        };
    }

    // The remaining columns are numeric strings.
    let option = match (entry.uri_index.as_str(), entry.table_col) {
        ("temperatureWarningC", _) => fc::TEMP_WARN_C,
        ("temperatureWarningF", _) => fc::TEMP_WARN_F,
        ("txPowerWarning", col::IDXTBL_ARR_HI) => fc::TX_POWER_HI,
        ("txPowerWarning", col::IDXTBL_ARR_LO) => fc::TX_POWER_LO,
        ("rxPowerWarning", col::IDXTBL_ARR_HI) => fc::RX_POWER_HI,
        ("rxPowerWarning", col::IDXTBL_ARR_LO) => fc::RX_POWER_LO,
        _ => return -1,
    };
    match agentx::get_set_string(requests) {
        Some(s) => lib_moxa_rust_ies_auto_mibs::fc_set(port, option, Some(&s)),
        None => -1,
    }
}

/// True for the fiber_check column kinds whose backing field is a 2-element
/// JSON string array rather than a scalar leaf.
fn is_fc_array_col(table_col: i32) -> bool {
    table_col == col::IDXTBL_ARR_LO
        || table_col == col::IDXTBL_ARR_HI
        || table_col == col::IDXTBL_ARR_STR
}

/// Extract this column's OCTET STRING out of an array-valued field.
///
/// The extraction lives in C (`lib_moxa_ies_auto_mibs`, ported from the dlmod)
/// so the formatting stays byte-identical to the build being replaced; the
/// *fetch* stays here, because the value was already read in-process and going
/// back over loopback HTTP per OID is what Plan E exists to remove.
fn fc_array_value(value: &serde_json::Value, table_col: i32) -> Option<String> {
    let json = serde_json::to_string(value).ok()?;
    match table_col {
        col::IDXTBL_ARR_LO => lib_moxa_rust_ies_auto_mibs::fc_array_elem(&json, 0),
        col::IDXTBL_ARR_HI => lib_moxa_rust_ies_auto_mibs::fc_array_elem(&json, 1),
        _ => lib_moxa_rust_ies_auto_mibs::fc_array_pair(&json),
    }
}

/// Status GET with a short per-plugin snapshot (fix 2): one `get_status` per
/// plugin per TTL, then path navigation in-process — same idea as in-master's
/// table snapshot, so a walk does not re-hit hardware for every OID.
fn get_status_with_snap(
    state: &SubagentState,
    path: &str,
) -> Result<serde_json::Value, ()> {
    let plugin = status_plugin_name(path).ok_or(())?;
    {
        let snap = state.status_snap.lock().unwrap();
        if let Some((at, root)) = snap.by_plugin.get(plugin) {
            if at.elapsed() < STATUS_SNAP_TTL {
                return Ok(navigate_plugin_status(root, path));
            }
        }
    }

    let ui = sys_read_userinfo();
    let query = QString::from("");
    let root = {
        let mut status_op = state.status_operation.lock().unwrap();
        let mut plugins_status = state.plugins_status.lock().unwrap();
        status_op
            .get_status_from_path(&mut plugins_status, plugin, &ui, &query)
            .map_err(|_| ())?
    };
    let value = navigate_plugin_status(&root, path);
    state
        .status_snap
        .lock()
        .unwrap()
        .by_plugin
        .insert(plugin.to_string(), (Instant::now(), root));
    Ok(value)
}

/// Read-only GET handler shared by every registered config OID.
fn handle_get(requests: *mut c_void) -> c_int {
    let state = match STATE.get() {
        Some(s) => s,
        None => {
            agentx::set_error(requests, agentx::SNMP_ERR_GENERR);
            return agentx::SNMP_ERR_NOERROR;
        }
    };

    // 1. the requested OID
    let oid = match agentx::get_request_oid(requests) {
        Some(o) => o,
        None => {
            agentx::set_error(requests, agentx::SNMP_ERR_GENERR);
            return agentx::SNMP_ERR_NOERROR;
        }
    };

    // 2. OID -> config-layer URI
    let entry = match lib_moxa_rust_ies_auto_mibs::lookup_by_oid(&oid) {
        Some(e) => e,
        None => {
            agentx::set_no_such_instance(requests);
            return agentx::SNMP_ERR_NOERROR;
        }
    };

    // 2b. table columns:
    //   1 = portsPbmp index, 2 = portsPbmp value, 4 = index-table index,
    //   6 = RowStatus (ADR-0001).
    match entry.table_col {
        col::ROW_INDEX => {
            let port = *oid.last().unwrap_or(&0) as i64;
            agentx::set_int(requests, port);
            return agentx::SNMP_ERR_NOERROR;
        }
        col::PBMP_VALUE => return handle_pbmp_value_get(state, requests, &entry.uri, &oid),
        col::IDXTBL_INDEX => {
            return handle_idx_table_index_get(
                state,
                requests,
                &entry.uri,
                &oid,
                entry.is_status,
            )
        }
        col::ROWSTATUS => return handle_rowstatus_get(state, requests, &entry.uri, &oid),
        col::TR2RING_IFACE => return handle_tr2_iface_get(state, requests, &entry.uri, &oid),
        // An action column with no backing field: fiber_check's resetToDefault
        // reads as TruthValue false(2) always (dlmod's _GetDummyFalse). SET is
        // what actually does something — see handle_set.
        col::CONST_FALSE => {
            agentx::set_int(requests, 2);
            return agentx::SNMP_ERR_NOERROR;
        }
        _ => {}
    }

    // config path: index-table value col (3) -> "<uri><row-1>/<column>";
    // turboring ring col (5) -> "<uri>/ring<row>/<column>" (row 1-based);
    // a scalar (0) uses the URI as-is.
    let idx_path;
    let path: &str = if entry.table_col == col::IDXTBL_VALUE || is_fc_array_col(entry.table_col) {
        // The array columns address exactly the same field as a plain value
        // column; only the extraction from that field differs.
        let row = *oid.last().unwrap_or(&0);
        if row < 1 {
            agentx::set_no_such_instance(requests);
            return agentx::SNMP_ERR_NOERROR;
        }
        idx_path = format!("{}{}/{}", entry.uri, row - 1, entry.uri_index);
        &idx_path
    } else if entry.table_col == col::TR2RING_VALUE {
        let row = *oid.last().unwrap_or(&0);
        if row < 1 {
            agentx::set_no_such_instance(requests);
            return agentx::SNMP_ERR_NOERROR;
        }
        idx_path = format!("{}/ring{}/{}", entry.uri, row, entry.uri_index);
        &idx_path
    } else {
        &entry.uri
    };

    // Status-layer entry (stat/ prefix or URI_STATUS flag): read from the status
    // layer at `path` (a scalar's path is the URI; a table's is the row path).
    if entry.is_status {
        return handle_status_get(state, requests, path, entry.val_type, entry.table_col);
    }

    // 3. read the value in-process — byte-identical to REST `_setting_get`.
    //    Lock order (configs then plugins) matches config_layer::setting_read.
    let ui = sys_read_userinfo();
    let configs = state.configs.lock().unwrap();
    let mut plugins = state.plugins.lock().unwrap();

    let value = match config_operation::get_config_from_path(
        &mut plugins,
        &ui,
        path,
        &configs.running_config,
        None,
        false,
    ) {
        Ok(v) => v,
        Err(_) => {
            // Config path not present (missing row / a URI needing a remap we
            // don't apply) -> noSuchInstance so a walk continues.
            agentx::set_no_such_instance(requests);
            return agentx::SNMP_ERR_NOERROR;
        }
    };
    let value = if value.is_null() {
        value
    } else {
        match config_operation::remove_password_from_config(&mut plugins, path, value) {
            Ok(v) => v,
            Err(_) => {
                agentx::set_no_such_instance(requests);
                return agentx::SNMP_ERR_NOERROR;
            }
        }
    };

    // fiber_check array column: the field is a 2-element string array feeding
    // one or two MIB columns. Extraction is the dlmod's, in C.
    if is_fc_array_col(entry.table_col) {
        match fc_array_value(&value, entry.table_col) {
            Some(s) => agentx::set_octet_string(requests, &s),
            None => agentx::set_no_such_instance(requests),
        };
        return agentx::SNMP_ERR_NOERROR;
    }

    // 4. set the value per the mapped type (byte-identical to the old handler).
    match entry.val_type {
        agentx::ASN_INTEGER => {
            // Config leaf may be a JSON bool (true->1, false->2, per SNMPv2
            // TruthValue == ies-auto-mibs get_value.c:95), a number, or a
            // numeric string; accept all three.
            let n = value
                .as_i64()
                .or_else(|| value.as_bool().map(|b| if b { 1 } else { 2 }))
                .or_else(|| value.as_str().and_then(|s| s.parse().ok()));
            match n {
                Some(n) => {
                    // Port interface index is 0-based in config, 1-based in SNMP
                    // (in-master ies_auto_mibs.c:2498 does the same +1).
                    let n = if entry.is_iface { n + 1 } else { n };
                    agentx::set_int(requests, n);
                }
                None => {
                    agentx::set_no_such_instance(requests);
                }
            }
        }
        _ => match value.as_str() {
            Some(s) => {
                agentx::set_octet_string(requests, s);
            }
            None => {
                agentx::set_no_such_instance(requests);
            }
        },
    }
    agentx::SNMP_ERR_NOERROR
}

/// `iftype` value meaning "port-channel" in the config layer's interface objects
/// (mirror of `lib_moxa_rust_iss::interface_utility::InterfaceType::PortChannel`;
/// PhysicalPort is 1). Not worth a dependency on that crate for one constant.
const IFTYPE_PORT_CHANNEL: u64 = 2;

/// GET for the turboring ring `interface` column (in-master's REDUNDANT_PORT):
/// ONE 2-byte OCTET STRING built from TWO config objects,
/// `<uri>/ring<N>/firstPort` and `<uri>/ring<N>/secondPort`, each `{iftype,index}`.
///
/// Byte-identical to in-master, whose value is produced by
/// `generate_uri_snmp_table`'s `gen_value_redundant_port_entry`: the config index
/// is 0-based and SNMP is 1-based, and a port-channel sits past the physical
/// ports. That tool emits `format!("{first:02x}{second:02x}")` and the entry's
/// `oct_type = IES_URI_SNMP_OCT_STRING_HEX` then converts each hex pair back into
/// one byte — so the two bytes are just the SNMP port numbers.
fn handle_tr2_iface_get(
    state: &SubagentState,
    requests: *mut c_void,
    uri: &str,
    oid: &[agentx::Oid],
) -> c_int {
    let row = match oid.last() {
        Some(&r) if r >= 1 => r,
        _ => {
            agentx::set_no_such_instance(requests);
            return agentx::SNMP_ERR_NOERROR;
        }
    };
    let max_port_num = lib_moxa_rust_ies_auto_mibs::max_port_num();
    let ui = sys_read_userinfo();
    let configs = state.configs.lock().unwrap();
    let mut plugins = state.plugins.lock().unwrap();

    let mut bytes = [0u8; 2];
    for (i, port_key) in ["firstPort", "secondPort"].iter().enumerate() {
        let path = format!("{}/ring{}/{}", uri, row, port_key);
        let value = match config_operation::get_config_from_path(
            &mut plugins,
            &ui,
            &path,
            &configs.running_config,
            None,
            false,
        ) {
            Ok(v) => v,
            Err(_) => {
                // Missing ring row -> noSuchInstance so a walk continues.
                agentx::set_no_such_instance(requests);
                return agentx::SNMP_ERR_NOERROR;
            }
        };
        let iftype = value.get("iftype").and_then(|v| v.as_u64());
        let index = value.get("index").and_then(|v| v.as_u64());
        let (iftype, index) = match (iftype, index) {
            (Some(t), Some(n)) => (t, n as u32),
            _ => {
                agentx::set_no_such_instance(requests);
                return agentx::SNMP_ERR_NOERROR;
            }
        };
        let mut port = index + 1;
        if iftype == IFTYPE_PORT_CHANNEL {
            port += max_port_num;
        }
        bytes[i] = port as u8;
    }
    agentx::set_octet_bytes(requests, &bytes);
    agentx::SNMP_ERR_NOERROR
}

/// GET for a portsPbmp value column: read the per-port boolean array at `uri`
/// and return `array[port-1]` as a TruthValue (true->1, false->2).
fn handle_pbmp_value_get(
    state: &SubagentState,
    requests: *mut c_void,
    uri: &str,
    oid: &[agentx::Oid],
) -> c_int {
    let port = match oid.last() {
        Some(&p) if p >= 1 => p as usize,
        _ => {
            agentx::set_no_such_instance(requests);
            return agentx::SNMP_ERR_NOERROR;
        }
    };
    let ui = sys_read_userinfo();
    let configs = state.configs.lock().unwrap();
    let mut plugins = state.plugins.lock().unwrap();
    let arr = match config_operation::get_config_from_path(
        &mut plugins,
        &ui,
        uri,
        &configs.running_config,
        None,
        false,
    ) {
        Ok(v) => v,
        Err(_) => {
            agentx::set_no_such_instance(requests);
            return agentx::SNMP_ERR_NOERROR;
        }
    };
    // `arr` is the JSON boolean array; the SNMP value is array[port-1].
    match arr.get(port - 1) {
        Some(v) => {
            let n = v
                .as_bool()
                .map(|b| if b { 1 } else { 2 })
                .or_else(|| v.as_i64());
            match n {
                Some(n) => {
                    agentx::set_int(requests, n);
                }
                None => {
                    agentx::set_no_such_instance(requests);
                }
            }
        }
        None => {
            agentx::set_no_such_instance(requests);
        }
    }
    agentx::SNMP_ERR_NOERROR
}

/// SET for a portsPbmp value column: read the per-port boolean array, flip
/// `array[port-1]` to the incoming TruthValue (1 -> true, else -> false), and
/// PATCH the whole array back. Returns 0 on success, non-zero on failure.
fn handle_pbmp_value_set(uri: &str, requests: *mut c_void) -> i32 {
    let state = match STATE.get() {
        Some(s) => s,
        None => return -1,
    };
    let oid = match agentx::get_request_oid(requests) {
        Some(o) => o,
        None => return -1,
    };
    let port = match oid.last() {
        Some(&p) if p >= 1 => p as usize,
        _ => return -1,
    };
    let sv = match agentx::get_set_int(requests) {
        Some(v) => v,
        None => return -1,
    };

    // Read the current array (lock order: configs then plugins).
    let mut bools: Vec<bool> = {
        let ui = sys_read_userinfo();
        let configs = state.configs.lock().unwrap();
        let mut plugins = state.plugins.lock().unwrap();
        let arr = match config_operation::get_config_from_path(
            &mut plugins,
            &ui,
            uri,
            &configs.running_config,
            None,
            false,
        ) {
            Ok(v) => v,
            Err(_) => return -1,
        };
        match arr.as_array() {
            Some(a) => a.iter().map(|v| v.as_bool().unwrap_or(false)).collect(),
            None => return -1,
        }
    };
    if port - 1 >= bools.len() {
        return -1;
    }
    bools[port - 1] = sv == 1;

    // Serialize "[true,false,…]" by hand (no serde_json dep) and PATCH it whole.
    let json = format!(
        "[{}]",
        bools
            .iter()
            .map(|b| if *b { "true" } else { "false" })
            .collect::<Vec<_>>()
            .join(",")
    );
    lib_moxa_rust_ies_auto_mibs::config_set_json(uri, &json)
}

/* SNMP RowStatus (RFC 2579) — same integers as MOXA_SNMP_READ_CREATE_*. */
const RS_ACTIVE: i64 = 1;
const RS_NOT_IN_SERVICE: i64 = 2;
const RS_CREATE_AND_GO: i64 = 4;
const RS_CREATE_AND_WAIT: i64 = 5;
const RS_DESTROY: i64 = 6;

/// Config array path for an index-table URI base (`"snmpTrap/host/"` -> `"snmpTrap/host"`).
fn index_table_array_uri(uri: &str) -> &str {
    uri.strip_suffix('/').unwrap_or(uri)
}

fn read_config_value(state: &SubagentState, path: &str) -> Result<serde_json::Value, ()> {
    let ui = sys_read_userinfo();
    let configs = state.configs.lock().unwrap();
    let mut plugins = state.plugins.lock().unwrap();
    config_operation::get_config_from_path(
        &mut plugins,
        &ui,
        path,
        &configs.running_config,
        None,
        false,
    )
    .map_err(|_| ())
}

/// GET RowStatus: missing row -> noSuchInstance; `valid` true/absent -> active(1);
/// `valid` false -> notInService(2). Mirrors in-master mapping onto config `valid`.
fn handle_rowstatus_get(
    state: &SubagentState,
    requests: *mut c_void,
    uri: &str,
    oid: &[agentx::Oid],
) -> c_int {
    let row = match oid.last() {
        Some(&r) if r >= 1 => r as usize,
        _ => {
            agentx::set_no_such_instance(requests);
            return agentx::SNMP_ERR_NOERROR;
        }
    };
    let arr_uri = index_table_array_uri(uri);
    let arr = match read_config_value(state, arr_uri) {
        Ok(v) => v,
        Err(_) => {
            agentx::set_no_such_instance(requests);
            return agentx::SNMP_ERR_NOERROR;
        }
    };
    let Some(host) = arr.get(row - 1) else {
        agentx::set_no_such_instance(requests);
        return agentx::SNMP_ERR_NOERROR;
    };
    if host.is_null() {
        agentx::set_no_such_instance(requests);
        return agentx::SNMP_ERR_NOERROR;
    }
    let rs = match host.get("valid").and_then(|v| v.as_bool()) {
        Some(false) => RS_NOT_IN_SERVICE,
        _ => RS_ACTIVE,
    };
    agentx::set_int(requests, rs);
    agentx::SNMP_ERR_NOERROR
}

fn default_trap_host(valid: bool) -> serde_json::Value {
    serde_json::json!({
        "hostName": null,
        "mode": null,
        "v1v2cCommunity": null,
        "valid": valid,
    })
}

/// SET RowStatus: createAndGo/Wait pad up to the SNMP index; destroy removes;
/// active/notInService flip `valid`. Whole-array PATCH like portsPbmp.
fn handle_rowstatus_set(uri: &str, requests: *mut c_void) -> i32 {
    let state = match STATE.get() {
        Some(s) => s,
        None => return -1,
    };
    let oid = match agentx::get_request_oid(requests) {
        Some(o) => o,
        None => return -1,
    };
    let row = match oid.last() {
        Some(&r) if r >= 1 => r as usize,
        _ => return -1,
    };
    let cmd = match agentx::get_set_int(requests) {
        Some(v) => v,
        None => return -1,
    };
    let arr_uri = index_table_array_uri(uri);
    let max_rows = if arr_uri == "snmpTrap/host" { 2 } else { 16 };
    if row > max_rows {
        return -1;
    }

    let mut hosts: Vec<serde_json::Value> = match read_config_value(state, arr_uri) {
        Ok(v) => match v.as_array() {
            Some(a) => a.clone(),
            None => return -1,
        },
        Err(_) => Vec::new(),
    };

    match cmd {
        RS_ACTIVE | RS_NOT_IN_SERVICE => {
            if row - 1 >= hosts.len() {
                return -1;
            }
            if let Some(obj) = hosts[row - 1].as_object_mut() {
                obj.insert("valid".into(), serde_json::Value::Bool(cmd == RS_ACTIVE));
            } else {
                return -1;
            }
        }
        RS_CREATE_AND_GO | RS_CREATE_AND_WAIT => {
            let valid = cmd == RS_CREATE_AND_GO;
            while hosts.len() < row {
                hosts.push(default_trap_host(false));
            }
            if let Some(obj) = hosts[row - 1].as_object_mut() {
                obj.insert("valid".into(), serde_json::Value::Bool(valid));
            } else {
                hosts[row - 1] = default_trap_host(valid);
            }
        }
        RS_DESTROY => {
            if row - 1 >= hosts.len() {
                return -1;
            }
            hosts.remove(row - 1);
        }
        _ => return -1,
    }

    let json = match serde_json::to_string(&hosts) {
        Ok(s) => s,
        Err(_) => return -1,
    };
    lib_moxa_rust_ies_auto_mibs::config_set_json(arr_uri, &json)
}

/// GET for a config index-table index column: the value is the row number, but
/// only for rows that exist (the fixed-size array element "<uri><row-1>" is
/// present). Rows past the array end -> noSuchInstance.
fn handle_idx_table_index_get(
    state: &SubagentState,
    requests: *mut c_void,
    uri: &str,
    oid: &[agentx::Oid],
    is_status: bool,
) -> c_int {
    let row = match oid.last() {
        Some(&r) if r >= 1 => r,
        _ => {
            agentx::set_no_such_instance(requests);
            return agentx::SNMP_ERR_NOERROR;
        }
    };
    let path = format!("{}{}", uri, row - 1);
    // Row exists iff the array element "<uri><row-1>" resolves (config or status).
    let exists = if is_status {
        matches!(get_status_with_snap(state, &path), Ok(ref v) if !v.is_null())
    } else {
        let ui = sys_read_userinfo();
        let configs = state.configs.lock().unwrap();
        let mut plugins = state.plugins.lock().unwrap();
        matches!(
            config_operation::get_config_from_path(
                &mut plugins,
                &ui,
                &path,
                &configs.running_config,
                None,
                false,
            ),
            Ok(ref v) if !v.is_null()
        )
    };
    if exists {
        agentx::set_int(requests, row as i64);
    } else {
        agentx::set_no_such_instance(requests);
    }
    agentx::SNMP_ERR_NOERROR
}

/// GET for a status-layer scalar: read `path` from the status layer (parallel to
/// config_operation for config OIDs) and set the value per the mapped SNMP type.
fn handle_status_get(
    state: &SubagentState,
    requests: *mut c_void,
    path: &str,
    val_type: c_int,
    table_col: i32,
) -> c_int {
    let value = match get_status_with_snap(state, path) {
        Ok(v) => v,
        Err(_) => {
            agentx::set_no_such_instance(requests);
            return agentx::SNMP_ERR_NOERROR;
        }
    };
    // Status-side array columns (fiber_check's txPowerLimit / rxPowerLimit).
    if is_fc_array_col(table_col) {
        match fc_array_value(&value, table_col) {
            Some(s) => agentx::set_octet_string(requests, &s),
            None => agentx::set_no_such_instance(requests),
        };
        return agentx::SNMP_ERR_NOERROR;
    }
    match val_type {
        agentx::ASN_INTEGER => {
            let n = value
                .as_i64()
                .or_else(|| value.as_bool().map(|b| if b { 1 } else { 2 }))
                .or_else(|| {
                    value.as_str().and_then(|s| match s {
                        // plugin_moxa_io Status.status strings
                        "on" | "true" => Some(1),
                        "off" | "false" => Some(2),
                        other => other.parse().ok(),
                    })
                });
            match n {
                Some(n) => {
                    agentx::set_int(requests, n);
                }
                None => {
                    agentx::set_no_such_instance(requests);
                }
            }
        }
        SNMP_DATA_TYPE_MAC => match value.as_str().and_then(mac_to_bytes) {
            Some(b) => {
                agentx::set_octet_bytes(requests, &b);
            }
            None => {
                agentx::set_no_such_instance(requests);
            }
        },
        _ => match value.as_str() {
            Some(s) => {
                agentx::set_octet_string(requests, s);
            }
            None => {
                agentx::set_no_such_instance(requests);
            }
        },
    }
    agentx::SNMP_ERR_NOERROR
}

/// Moxa data-type tag for a MacAddress column (ies_auto_mibs.h SNMP_DATA_TYPE_MAC_ADDRESS
/// = 0xf4). Carried through unchanged in `MapEntry.val_type`, so it is distinguishable
/// from a plain OCTET string (0x04) here.
const SNMP_DATA_TYPE_MAC: c_int = 0xf4;

/// Parse the first 6 colon-separated hex octets of a MAC string to 6 raw bytes —
/// byte-identical to the in-master C engine (moxa_snmp_handle_util.c: reads exactly
/// 6 groups, ignoring any extra, e.g. turboRing's 7-group status form
/// "00:00:00:00:00:00:00"). `None` if fewer than 6 groups or a group is not hex.
fn mac_to_bytes(s: &str) -> Option<[u8; 6]> {
    let mut out = [0u8; 6];
    let mut it = s.split(':');
    for slot in out.iter_mut() {
        *slot = u8::from_str_radix(it.next()?, 16).ok()?;
    }
    Some(out)
}

/// Look up the mapping entry for the OID a request targets.
fn request_entry(requests: *mut c_void) -> Option<lib_moxa_rust_ies_auto_mibs::MapEntry> {
    let oid = agentx::get_request_oid(requests)?;
    lib_moxa_rust_ies_auto_mibs::lookup_by_oid(&oid)
}

/// Write handler (Design C): SET reuses the framework's own REST PATCH via
/// `ies_config_set`, byte-identical to the dlmod. Called in MODE_SET_ACTION.
fn handle_set(requests: *mut c_void) -> c_int {
    let entry = match request_entry(requests) {
        Some(e) => e,
        None => {
            agentx::set_error(requests, agentx::SNMP_ERR_COMMITFAILED);
            return agentx::SNMP_ERR_NOERROR;
        }
    };
    // Read-only: index columns and status-layer entries.
    //
    // TR2RING_IFACE is read-write in the MIB but SET is not implemented yet: the
    // value is a composite of two config OBJECTS, so writing it means decoding
    // each byte back to {iftype,index} — which needs the port-channel count as
    // well as the physical port count (in-master splits the ranges in
    // ies_auto_mibs.c:1297 utilURI_get_interface_entry_from_port). Refuse
    // explicitly: without this the OID falls through to the scalar branch below
    // and would PATCH the group root `turboringv2` with a raw string.
    if entry.table_col == col::ROW_INDEX
        || entry.table_col == col::IDXTBL_INDEX
        || entry.table_col == col::TR2RING_IFACE
        || entry.is_status
    {
        agentx::set_error(requests, agentx::SNMP_ERR_NOTWRITABLE);
        return agentx::SNMP_ERR_NOERROR;
    }
    // fiber_check config columns. Every one of them is a read-modify-write of
    // the whole row: the C/F pair has to move together, the two ends of a power
    // threshold live in one array field, empty thresholds get back-filled with
    // the SFF defaults first, and resetToDefault clears the lot. Writing the
    // single addressed field would silently desynchronise the row, so all of
    // them go through the ported dlmod routine in lib_moxa_ies_auto_mibs.
    if entry.uri == FC_CONFIG_URI {
        let rc = handle_fc_set(&entry, requests);
        if rc != 0 {
            agentx::set_error(requests, agentx::SNMP_ERR_COMMITFAILED);
        }
        return agentx::SNMP_ERR_NOERROR;
    }
    // portsPbmp value column: whole-array read-modify-write.
    if entry.table_col == col::PBMP_VALUE {
        let rc = handle_pbmp_value_set(&entry.uri, requests);
        if rc != 0 {
            agentx::set_error(requests, agentx::SNMP_ERR_COMMITFAILED);
        }
        return agentx::SNMP_ERR_NOERROR;
    }
    // RowStatus: create/destroy / valid (ADR-0001); not a config leaf path.
    if entry.table_col == col::ROWSTATUS {
        let rc = handle_rowstatus_set(&entry.uri, requests);
        if rc != 0 {
            agentx::set_error(requests, agentx::SNMP_ERR_COMMITFAILED);
        }
        return agentx::SNMP_ERR_NOERROR;
    }

    // Scalar (0) or a path-addressable value column (index-table / turboring ring):
    // SET writes the field directly (no read-modify-write).
    let idx_path;
    let path: &str = if entry.table_col == col::IDXTBL_VALUE
        || entry.table_col == col::TR2RING_VALUE
    {
        match agentx::get_request_oid(requests).and_then(|o| o.last().copied()) {
            Some(row) if row >= 1 => {
                idx_path = if entry.table_col == col::TR2RING_VALUE {
                    format!("{}/ring{}/{}", entry.uri, row, entry.uri_index)
                } else {
                    format!("{}{}/{}", entry.uri, row - 1, entry.uri_index)
                };
                &idx_path
            }
            _ => {
                agentx::set_error(requests, agentx::SNMP_ERR_COMMITFAILED);
                return agentx::SNMP_ERR_NOERROR;
            }
        }
    } else {
        &entry.uri
    };

    let rc = match entry.val_type {
        agentx::ASN_INTEGER => match agentx::get_set_int(requests) {
            None => -1,
            Some(sv) => {
                // A config field exposed as SNMP INTEGER may be stored as a JSON
                // boolean (enable/trap/…). Read its current type and write back
                // the matching one: TruthValue 1 -> true, anything else -> false.
                if config_field_is_bool(path) {
                    lib_moxa_rust_ies_auto_mibs::config_set_bool(path, sv == 1)
                } else {
                    // Mirror of the GET side: SNMP is 1-based, config is 0-based
                    // (in-master ies_auto_mibs.c:2794 does the same -1).
                    let sv = if entry.is_iface { sv - 1 } else { sv };
                    lib_moxa_rust_ies_auto_mibs::config_set_int(path, sv)
                }
            }
        },
        _ => match agentx::get_set_string(requests) {
            Some(s) => lib_moxa_rust_ies_auto_mibs::config_set(path, &s),
            None => -1,
        },
    };
    if rc != 0 {
        agentx::set_error(requests, agentx::SNMP_ERR_COMMITFAILED);
    }
    agentx::SNMP_ERR_NOERROR
}

/// True if the config leaf at `uri` is currently a JSON boolean (so a SET should
/// write a boolean, not a number).
fn config_field_is_bool(uri: &str) -> bool {
    let state = match STATE.get() {
        Some(s) => s,
        None => return false,
    };
    let ui = sys_read_userinfo();
    let configs = state.configs.lock().unwrap();
    let mut plugins = state.plugins.lock().unwrap();
    config_operation::get_config_from_path(
        &mut plugins,
        &ui,
        uri,
        &configs.running_config,
        None,
        false,
    )
    .map(|v| v.is_boolean())
    .unwrap_or(false)
}

/// mxTurboRingV2 subtree root. Registered as ONE subtree handler instead of a
/// per-OID instance each: with per-OID registrations every instance is its own
/// AgentX subtree, so a GETNEXT landing in an unregistered gap makes the master
/// probe them one at a time — DUT-measured 18 round-trips (~0.107s each) for a
/// single GETNEXT across the gap after the ring table (3.9s total). One subtree
/// answers it in a single round-trip; the ordered index below does the search.
const TR2_ROOT: &[agentx::Oid] = &[1, 3, 6, 1, 4, 1, 8691, 603, 3, 4];

/// True if `oid` lies strictly under `root` (shares the prefix, and is longer).
fn oid_under(oid: &[agentx::Oid], root: &[agentx::Oid]) -> bool {
    oid.len() > root.len() && oid.iter().zip(root.iter()).all(|(a, b)| a == b)
}

/// How a registered group is served on the wire.
enum RegKind {
    /// net-snmp `table_iterator`: a live row count plus a per-cell handler. The
    /// index is always a single INTEGER row number (every table here is shaped
    /// that way), so it is not spelled out per row.
    IterTable {
        min_col: u32,
        max_col: u32,
        row_count: extern "C" fn() -> c_uint,
        handler: agentx::MoxaHandler,
    },
    /// ONE subtree handler for the whole group. GETNEXT is then answered
    /// in-process from the sorted OID index (`handle_getnext`) instead of the
    /// master probing candidate OIDs one AgentX round-trip at a time — that
    /// probing is what made a walk across an unregistered gap take seconds
    /// (DUT-measured 18 round-trips ~0.107s each; see ADR-0009).
    Subtree,
}

/// One registered OID group.
struct GroupReg {
    name: &'static str,
    root: &'static [agentx::Oid],
    kind: RegKind,
}

/// **THE registration list.** Everything the subagent registers as a group lives
/// here — adding a group means adding a row. The per-OID fallback loop in
/// `start_snmp_subagent` derives its skip set from this same table, so a group
/// can never be registered twice or accidentally left un-skipped.
static GROUPS: &[GroupReg] = &[
    // Plan E (ADR-0003): GET served live here (reads config per request, so no
    // reboot needed); SET — including trustedIp RowStatus — stays in-master,
    // which wins the wire by priority.
    GroupReg {
        name: "trustedIpTable",
        root: TRUSTEDIP_ROOT,
        kind: RegKind::IterTable {
            min_col: 1,
            max_col: 4,
            row_count: trustedip_row_count,
            handler: trustedip_iter_handler,
        },
    },
    // Plan E (ADR-0006): same shape; SET (rowStatus createAndGo/destroy) stays
    // in-master in readCreate_v2_mxTrap_host.c.
    GroupReg {
        name: "snmpTrapHostTable",
        root: SNMPTRAP_HOST_ROOT,
        kind: RegKind::IterTable {
            min_col: 1,
            max_col: 5,
            row_count: snmptrap_host_row_count,
            handler: snmptrap_host_iter_handler,
        },
    },
    // Plan E (ADR-0006, iss0 promotion): SET stays in-master (readCreate_v2_mxIpif.c).
    GroupReg {
        name: "l3VlanIfTable",
        root: L3VLANIF_ROOT,
        kind: RegKind::IterTable {
            min_col: 1,
            max_col: 8,
            row_count: l3vlanif_row_count,
            handler: l3vlanif_iter_handler,
        },
    },
    // ADR-0009. Safe as a subtree because mxTurboRingV2 has no RowStatus and
    // in-master does not register it (its MOX_SNMP_INIT_ENTRY is commented out),
    // so taking the whole subtree cannot shadow an in-master SET path.
    GroupReg {
        name: "mxTurboRingV2",
        root: TR2_ROOT,
        kind: RegKind::Subtree,
    },
];

/// Every mapped OID, sorted — the ordered index GETNEXT searches. Built once;
/// the mapping table is static for the program's lifetime.
static SORTED_OIDS: OnceLock<Vec<Vec<agentx::Oid>>> = OnceLock::new();

fn sorted_oids() -> &'static Vec<Vec<agentx::Oid>> {
    SORTED_OIDS.get_or_init(|| {
        let mut v = lib_moxa_rust_ies_auto_mibs::all_oids();
        v.sort();
        v
    })
}

/// Which `Subtree` registration this request came from — the group whose root
/// prefixes `oid`. `None` if the OID is not inside a subtree we registered.
fn subtree_root_containing(oid: &[agentx::Oid]) -> Option<&'static [agentx::Oid]> {
    GROUPS
        .iter()
        .filter(|g| matches!(g.kind, RegKind::Subtree))
        .find(|g| oid.len() >= g.root.len() && oid[..g.root.len()] == *g.root)
        .map(|g| g.root)
}

/// Register one group the way its `kind` says.
fn register_group(g: &GroupReg) {
    match g.kind {
        RegKind::IterTable {
            min_col,
            max_col,
            row_count,
            handler,
        } => {
            agentx::register_iter_table(
                g.name,
                g.root,
                agentx::ASN_INTEGER,
                min_col,
                max_col,
                row_count,
                handler,
            );
        }
        RegKind::Subtree => {
            agentx::register_handler(
                g.name,
                g.root,
                agentx::HANDLER_CAN_RWRITE,
                moxa_config_handler,
            );
        }
    }
}

/// GETNEXT inside a `Subtree` group: answer with the next mapped OID after the
/// requested one that actually HAS a value, staying within the subtree this
/// request came from.
///
/// Stepping over valueless OIDs must happen here, in-process: a GETNEXT that
/// answers noSuchInstance ends the client's walk. (With per-OID registrations
/// the master did this stepping itself — one AgentX round-trip per candidate,
/// which is exactly what made it slow.)
fn handle_getnext(requests: *mut c_void) -> c_int {
    let oid = match agentx::get_request_oid(requests) {
        Some(o) => o,
        None => return agentx::SNMP_ERR_NOERROR,
    };
    // Only ever answer within the subtree that sent us this request; OIDs past
    // it belong to other registrations.
    let root = match subtree_root_containing(&oid) {
        Some(r) => r,
        None => return agentx::SNMP_ERR_NOERROR,
    };
    let oids = sorted_oids();
    // First mapped OID strictly greater than the requested one (OIDs compare
    // lexicographically, which is exactly SNMP OID ordering).
    let mut idx = oids.partition_point(|o| o.as_slice() <= oid.as_slice());
    while let Some(next) = oids.get(idx) {
        if !oid_under(next, root) {
            break; // walked past the end of this subtree
        }
        agentx::set_request_oid(requests, next);
        handle_get(requests);
        if agentx::get_var_type(requests) != agentx::SNMP_NOSUCHINSTANCE {
            return agentx::SNMP_ERR_NOERROR;
        }
        idx += 1;
    }
    // Nothing left here: restore the varbind so net-snmp sees this registration
    // as having produced no answer and moves on to the next one.
    agentx::set_request_oid(requests, &oid);
    agentx::clear_value(requests);
    agentx::SNMP_ERR_NOERROR
}

/// Dispatch by net-snmp mode: GET in-process, SET via loopback REST PATCH.
fn dispatch(reqinfo: *mut c_void, requests: *mut c_void) -> c_int {
    match agentx::get_mode(reqinfo) {
        agentx::MODE_GET => handle_get(requests),
        // Only the TR2_ROOT subtree registration produces GETNEXT here; per-OID
        // instance registrations are resolved to MODE_GET by net-snmp.
        agentx::MODE_GETNEXT => handle_getnext(requests),
        agentx::MODE_SET_RESERVE1 => {
            let entry = request_entry(requests);
            // Index columns (portsPbmp portIndex = 1, index-table index = 4) are
            // read-only; value columns (2, 3) are writable (MODE_SET_ACTION).
            if entry
                .as_ref()
                .map(|e| {
                    e.table_col == col::ROW_INDEX
                        || e.table_col == col::IDXTBL_INDEX
                        || e.is_status
                })
                .unwrap_or(false)
            {
                agentx::set_error(requests, agentx::SNMP_ERR_NOTWRITABLE);
                return agentx::SNMP_ERR_NOERROR;
            }
            // Reject a SET whose type doesn't match the mapped OID's type.
            let expected = match entry {
                Some(e) if e.val_type == agentx::ASN_INTEGER => agentx::ASN_INTEGER,
                _ => agentx::ASN_OCTET_STR,
            };
            if agentx::get_var_type(requests) != expected {
                agentx::set_error(requests, agentx::SNMP_ERR_WRONGTYPE);
            }
            agentx::SNMP_ERR_NOERROR
        }
        agentx::MODE_SET_ACTION => handle_set(requests),
        // RESERVE2 / COMMIT / FREE / UNDO: nothing to do (action already applied).
        _ => agentx::SNMP_ERR_NOERROR,
    }
}

/// net-snmp `Netsnmp_Node_Handler`. Panics must never cross into C, so the body
/// runs under catch_unwind and degrades to genErr.
extern "C" fn moxa_config_handler(
    _handler: *mut c_void,
    _reginfo: *mut c_void,
    reqinfo: *mut c_void,
    requests: *mut c_void,
) -> c_int {
    let res =
        std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| dispatch(reqinfo, requests)));
    match res {
        Ok(code) => code,
        Err(_) => {
            agentx::set_error(requests, agentx::SNMP_ERR_GENERR);
            agentx::SNMP_ERR_NOERROR
        }
    }
}

/// Parse a dotted IPv4 string ("192.168.1.5") to 4 bytes. None if malformed.
fn ipv4_to_bytes(s: &str) -> Option<[u8; 4]> {
    let mut out = [0u8; 4];
    let mut n = 0usize;
    for part in s.split('.') {
        if n >= 4 {
            return None;
        }
        out[n] = part.parse::<u8>().ok()?;
        n += 1;
    }
    if n == 4 {
        Some(out)
    } else {
        None
    }
}

/// trustedIp table OID (the table object; entry = ROOT.1, columns ROOT.1.c.row).
const TRUSTEDIP_ROOT: &[agentx::Oid] = &[1, 3, 6, 1, 4, 1, 8691, 602, 1, 4, 1, 2];

/// Live row count of the trustedIp config array (net-snmp iterator polls this on
/// every walk). 0 on any error -> empty table.
fn trustedip_rows() -> Vec<serde_json::Value> {
    let Some(state) = STATE.get() else {
        return Vec::new();
    };
    match read_config_value(state, "trustedAccess/trustedIp") {
        Ok(v) => v.as_array().cloned().unwrap_or_default(),
        Err(_) => Vec::new(),
    }
}

extern "C" fn trustedip_row_count() -> c_uint {
    trustedip_rows().len() as c_uint
}

/// Plan E (ADR-0003, refresh-gap fix): net-snmp `table_iterator` node handler for
/// trustedIp. Reads the CURRENT config each request (no startup snapshot), so GET
/// reflects config changes with no reboot. Columns: 1=index(INTEGER),
/// 2=ipAddress(IPADDRESS), 3=netmask(IPADDRESS), 4=rowStatus(INTEGER
/// active(1)/notInService(2)) — byte-identical to the old table_data_set. GET-only
/// (RONLY); SET stays in-master.
extern "C" fn trustedip_iter_handler(
    _handler: *mut c_void,
    _reginfo: *mut c_void,
    _reqinfo: *mut c_void,
    requests: *mut c_void,
) -> c_int {
    let oid = match agentx::get_request_oid(requests) {
        Some(o) => o,
        None => {
            agentx::set_no_such_instance(requests);
            return agentx::SNMP_ERR_NOERROR;
        }
    };
    // Instance OID = ROOT + [1 (entry), col, row]; net-snmp resolved it already.
    let rl = TRUSTEDIP_ROOT.len();
    if oid.len() < rl + 3 {
        agentx::set_no_such_instance(requests);
        return agentx::SNMP_ERR_NOERROR;
    }
    let col = oid[rl + 1];
    let row = oid[oid.len() - 1] as usize;

    let rows = trustedip_rows();
    let Some(item) = rows.get(row.wrapping_sub(1)) else {
        agentx::set_no_such_instance(requests);
        return agentx::SNMP_ERR_NOERROR;
    };
    match col {
        1 => {
            agentx::set_int(requests, row as i64);
        }
        2 => match item.get("ipAddress").and_then(|v| v.as_str()).and_then(ipv4_to_bytes) {
            Some(b) => {
                agentx::set_ipaddress(requests, &b);
            }
            None => {
                agentx::set_no_such_instance(requests);
            }
        },
        3 => match item.get("netmask").and_then(|v| v.as_str()).and_then(ipv4_to_bytes) {
            Some(b) => {
                agentx::set_ipaddress(requests, &b);
            }
            None => {
