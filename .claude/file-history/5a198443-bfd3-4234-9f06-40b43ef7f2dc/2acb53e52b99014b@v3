.…602.8.6.2.2.1.2.1 = 0    .…602.8.6.2.2.1.2.2 = 2    io/power/poe/status
.…602.8.6.2.3.1.2.1 = 0                               io/di/status
.…602.8.6.2.4.1.2.1 = 0    .…602.8.6.2.4.1.2.2 = 0    io/relay/status
