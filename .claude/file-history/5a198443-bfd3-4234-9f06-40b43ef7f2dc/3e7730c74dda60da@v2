# Profiling (optional)
rust_moxa_profiling = { path = "../../rust_moxa_profiling-custom", optional = true }
# net for AsyncFd (the AgentX descriptor), time for the select timeout,
# signal for the profiling handlers. Not optional any more: src/snmp_agentx.rs
# always needs it.
tokio = { version = "1", features = ["signal", "net", "time"] }
futures-util = "0.3"

lib_moxa_rust_snmp_agentx = { path = "../../lib_moxa_rust_snmp_agentx-custom" }
# OID -> URI for the subagent's GET path. Same table snmpd builds from, so a
# change to ies-auto-mibs reaches both sides from one place.
lib_moxa_rust_ies_auto_mibs = { path = "../../lib_moxa_rust_ies_auto_mibs-custom" }
# Both are what rust_moxa_status_layer already takes: the status layer's own
# call signature needs a QString, and it answers in serde_json values.
qstring = "0.7.2"
serde_json = "1.0"

