static pthread_t    g_thread;

int
MoxaAgentX_Init(const char *daemon_name)
{
    /* Become an AgentX sub-agent (not the master) and dial the master socket. */
    netsnmp_ds_set_boolean(NETSNMP_DS_APPLICATION_ID,
                           NETSNMP_DS_AGENT_ROLE, 1);
    netsnmp_ds_set_string(NETSNMP_DS_APPLICATION_ID,
                          NETSNMP_DS_AGENT_X_SOCKET, "tcp:127.0.0.1:705");

    init_agent(daemon_name);
    netsnmp_init_table_dataset();   /* enable the table_data_set helper */
    init_snmp(daemon_name);   /* opens the AgentX session to the master */
    return 0;
}

/* Plan E (ADR-0003, refresh-gap fix): live read-only table via net-snmp
 * table_iterator. Unlike table_data_set (a one-time startup snapshot), the
 * iterator asks the framework for the CURRENT row count and column values on
 * every request, so SNMP GET/GETNEXT/GETBULK reflect config changes with no
 * reboot/refresh. C owns the net-snmp plumbing; Rust supplies row_count (stashed
 * in iinfo->myvoid) and the node handler (fills column values from live config).
 * Index = one INTEGER row number 1..count. Modeled on net-snmp vacm_context.c.
 * MoxaRowCountFn is declared in the public header. */

static netsnmp_variable_list *
moxa_iter_get_first(void **loop_ctx, void **data_ctx,
                    netsnmp_variable_list *put_index,
                    netsnmp_iterator_info *iinfo)
{
    MoxaRowCountFn row_count = (MoxaRowCountFn) iinfo->myvoid;
    long           row = 1;

    if (row_count == NULL || row_count() < 1)
    {
        return NULL;                 /* empty table -> clean endOfMibView */
    }
    *loop_ctx = (void *) (intptr_t) row;
    *data_ctx = (void *) (intptr_t) row;
    snmp_set_var_typed_value(put_index, ASN_INTEGER,
                             (const u_char *) &row, sizeof(row));
    return put_index;
}

static netsnmp_variable_list *
moxa_iter_get_next(void **loop_ctx, void **data_ctx,
                   netsnmp_variable_list *put_index,
                   netsnmp_iterator_info *iinfo)
{
    MoxaRowCountFn row_count = (MoxaRowCountFn) iinfo->myvoid;
    long           row = (long) (intptr_t) (*loop_ctx);

    row++;
    if (row_count == NULL || (unsigned int) row > row_count())
    {
        return NULL;                 /* past the last row -> stop the walk */
    }
    *loop_ctx = (void *) (intptr_t) row;
    *data_ctx = (void *) (intptr_t) row;
    snmp_set_var_typed_value(put_index, ASN_INTEGER,
                             (const u_char *) &row, sizeof(row));
    return put_index;
}

int
MoxaAgentX_RegisterIterTable(const char *name, const oid *root, size_t root_len,
                             int index_asn, unsigned int min_col,
                             unsigned int max_col, MoxaRowCountFn row_count,
                             Netsnmp_Node_Handler *handler)
{
    netsnmp_handler_registration    *reg;
    netsnmp_table_registration_info *tinfo;
    netsnmp_iterator_info           *iinfo;

    reg = netsnmp_create_handler_registration(name, handler, root, root_len,
                                              HANDLER_CAN_RONLY);
    if (reg == NULL)
    {
        return -1;
    }
    reg->priority = 200;   /* GET-serving sibling; SET stays in-master */

    tinfo = SNMP_MALLOC_TYPEDEF(netsnmp_table_registration_info);
    iinfo = SNMP_MALLOC_TYPEDEF(netsnmp_iterator_info);
    if (tinfo == NULL || iinfo == NULL)
    {
        SNMP_FREE(tinfo);
        SNMP_FREE(iinfo);
        netsnmp_handler_registration_free(reg);
        return -1;
    }
    netsnmp_table_helper_add_index(tinfo, index_asn);
    tinfo->min_column = min_col;
    tinfo->max_column = max_col;

    iinfo->get_first_data_point = moxa_iter_get_first;
    iinfo->get_next_data_point  = moxa_iter_get_next;
    iinfo->table_reginfo        = tinfo;
    iinfo->myvoid               = (void *) row_count;

    return netsnmp_register_table_iterator2(reg, iinfo);
}

int
MoxaAgentX_RegisterScalar(const char *descr, const oid *o, size_t olen,
                          int mode, Netsnmp_Node_Handler *handler)
{
    netsnmp_handler_registration *reg =
        netsnmp_create_handler_registration(descr, handler, o, olen, mode);

    if (reg == NULL)
    {
        return -1;
    }
    return netsnmp_register_scalar(reg);
}

int
MoxaAgentX_RegisterTestInt(const char *descr, const oid *o, size_t olen, long value)
{
    static int s_val;   /* single test value; persists for net-snmp's pointer */
    s_val = (int) value;
    return netsnmp_register_read_only_int_instance(descr, o, olen, &s_val, NULL);
}

int
MoxaAgentX_RegisterInstance(const char *descr, const oid *o, size_t olen,
                            int mode, Netsnmp_Node_Handler *handler)
{
    netsnmp_handler_registration *reg =
        netsnmp_create_handler_registration(descr, handler, o, olen, mode);

    if (reg == NULL)
    {
        return -1;
    }
    /* Plan E (ADR-0003): lower precedence than in-master (default 127) so the
     * in-master ies-auto-mibs registration wins the wire (SET stays in-master);
     * framework is the sibling subtree that in-master forwards GET to. */
    reg->priority = 200;
    return netsnmp_register_instance(reg);
}

int
MoxaAgentX_RegisterHandler(const char *descr, const oid *o, size_t olen,
                           int mode, Netsnmp_Node_Handler *handler)
{
    netsnmp_handler_registration *reg =
        netsnmp_create_handler_registration(descr, handler, o, olen, mode);

    if (reg == NULL)
    {
        return -1;
    }
    /* Same priority policy as RegisterInstance; register_handler (not
     * register_instance) keeps namelen equal to in-master column regs so
     * priority — not namelen — decides the children-chain head. */
    reg->priority = 200;
    reg->handler->flags |= MIB_HANDLER_AUTO_NEXT;
    return netsnmp_register_handler(reg);
}

int
MoxaAgentX_GetRequestOid(void *requests, oid *buf, size_t buf_max, size_t *out_len)
{
    netsnmp_request_info *req = (netsnmp_request_info *) requests;
    size_t n;

    if (req == NULL || req->requestvb == NULL || buf == NULL || out_len == NULL)
    {
        return -1;
    }
    n = req->requestvb->name_length;
    if (n > buf_max)
    {
        return -1;
    }
    memcpy(buf, req->requestvb->name, n * sizeof(oid));
    *out_len = n;
    return 0;
}

