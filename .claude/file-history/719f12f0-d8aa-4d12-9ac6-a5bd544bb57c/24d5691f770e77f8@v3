/* Reset the varbind to "no value" (ASN_NULL). A GETNEXT handler that walked off
 * the end of its subtree uses this to hand the request back untouched, so
 * net-snmp moves on to the next registration instead of returning our probe. */
int
MoxaAgentX_ClearValue(void *requests)
{
    netsnmp_request_info *req = (netsnmp_request_info *) requests;

    if (req == NULL || req->requestvb == NULL)
    {
        return -1;
    }
    snmp_set_var_typed_value(req->requestvb, ASN_NULL, NULL, 0);
    return 0;
}

/* Rewrite the varbind's OID. A GETNEXT handler must report WHICH OID it is
 * answering with, so the subagent sets the next mapped OID here before filling
 * in the value. */
int
MoxaAgentX_SetRequestOid(void *requests, const oid *o, size_t olen)
{
    netsnmp_request_info *req = (netsnmp_request_info *) requests;

    if (req == NULL || req->requestvb == NULL || o == NULL || olen == 0)
    {
        return -1;
    }
    snmp_set_var_objid(req->requestvb, o, olen);
    return 0;
}

int
MoxaAgentX_GetMode(void *reqinfo)
{
    netsnmp_agent_request_info *ri = (netsnmp_agent_request_info *) reqinfo;
    return ri ? ri->mode : -1;
}

int
MoxaAgentX_GetVarType(void *requests)
{
    netsnmp_request_info *req = (netsnmp_request_info *) requests;
    if (req == NULL || req->requestvb == NULL)
    {
        return -1;
    }
    return req->requestvb->type;
}

int
MoxaAgentX_GetSetString(void *requests, char *buf, size_t buf_max, size_t *out_len)
{
    netsnmp_request_info *req = (netsnmp_request_info *) requests;
    size_t n;

    if (req == NULL || req->requestvb == NULL || buf == NULL || out_len == NULL)
    {
        return -1;
    }
    n = req->requestvb->val_len;
    if (n >= buf_max)   /* need room for the NUL */
    {
        return -1;
    }
    memcpy(buf, req->requestvb->val.string, n);
    buf[n] = '\0';
    *out_len = n;
    return 0;
}

static void *
moxa_agentx_loop(void *arg)
{
    (void) arg;
    while (g_running)
    {
        /* Blocks up to the internal select timeout, then processes AgentX fds. */
        agent_check_and_process(1);
    }
    return NULL;
}

int
MoxaAgentX_RunInThread(void)
{
    g_running = 1;
    return pthread_create(&g_thread, NULL, moxa_agentx_loop, NULL);
}

void
MoxaAgentX_Shutdown(void)
{
    g_running = 0;
    snmp_shutdown("lib_moxa_snmp_agentx");
}
