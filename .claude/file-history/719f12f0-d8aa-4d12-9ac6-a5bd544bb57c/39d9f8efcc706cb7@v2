//! Actix web server initialization, shared state, and route configuration.

use std::sync::{Arc, Mutex};

use actix_cors::Cors;
use actix_web::{middleware::Condition, web, App, HttpServer};

#[cfg(feature = "hello")]
use actix_web::{get, HttpResponse, Responder};

use app_moxa_token_module as moxa_token;
use lib_moxa_rust_debug_log_ng::{lib_moxa_debug_log_ng_syslog, LibMoxaDebugLogNgLogLevel};
use lib_moxa_rust_debug_log_ng::mx_notice;
use lib_moxa_rust_event_action as lib_moxa_event_action;
use lib_moxa_rust_pam as lib_moxa_pam;
use rust_moxa_app_state as app_state;
use rust_moxa_auth_layer as auth_layer;
use rust_moxa_bff as bff;
use rust_moxa_command_layer as command_layer;
use rust_moxa_command_operation as command_operation;
use rust_moxa_common::{api_command_operation, file_layer_process_lock};
use rust_moxa_config_layer as config_layer;
use rust_moxa_file_layer as file_layer;
use rust_moxa_file_operation as file_operation;
use rust_moxa_new_moxa_command_layer as new_moxa_command_layer;
use rust_moxa_new_moxa_command_operation as new_moxa_command_operation;
