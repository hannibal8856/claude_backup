/// Logger implementation initialization  
pub fn init() -> Result<(), SetLoggerError> {
    log::set_logger(&LOGGER).map(|()| log::set_max_level(LevelFilter::Info))
}

/// LibMoxaDebugLogNg_exportFile
pub fn export_file(export_filename: &mut Vec<u8>) -> i32 {
    let mut export_filename = mem::take(export_filename);
    export_filename.push(0);

    #[cfg(not(target_arch = "x86_64"))]
    unsafe {
        ffi::LibMoxaDebugLogNg_exportFile(export_filename.as_ptr())
    }

    #[cfg(target_arch = "x86_64")]
    ffi::LibMoxaDebugLogNg_exportFile(export_filename.as_ptr())
}

/// LibMoxaDebugLogNg_exportRam
pub fn export_ram(export_filename: &mut Vec<u8>) -> i32 {
    let mut export_filename = mem::take(export_filename);
    export_filename.push(0);

    #[cfg(not(target_arch = "x86_64"))]
