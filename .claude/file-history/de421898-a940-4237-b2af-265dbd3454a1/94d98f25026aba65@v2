#ifndef _IES_AUTO_MIBS_FLAGS_net_ifmibdb_c
#define _IES_AUTO_MIBS_FLAGS_net_ifmibdb_c

#if defined(INCLUDE_MOXA_L3)
#include <libmoxa_system/lib_moxa_system_l3_spec_def.h>
#endif

/**
 * @brief function body for set ifmibdb/ifXTable/ifAlias

 * @param[in]    reqinfo     netsnmp register handle
 * @param[in]    request     netsnmp request
 * @param[in]    entry       moxa snmp entry

 * @returns      0 means success, others fail.
 */
/* Handler bodies are in-master only - see IES_AUTO_MIBS_TABLE_ONLY in
 * snmp_tools/inc/ies_auto_mibs_handle.h. The flag setup below stays outside
 * the guard: it is shared with the lookup table. */
#ifndef IES_AUTO_MIBS_TABLE_ONLY

int32_t setEntryValue_ifmibdb_ifXTable_ifAlias( netsnmp_agent_request_info  *reqinfo,
                                                netsnmp_request_info        *request,
                                                struct ies_auto_mibs_entry  *entry   )
{
    int32_t ifIndex               = 0;
    int32_t portChannelTableIndex = 0;
    int  dev_max_port        = gMaxPortInDevice;

    if ( moxaSnmpHandle_UtilSnmpGetOIDIndex(request, entry, &ifIndex) != 0 )
    {
        LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "%% %s@%d can't get ifIndex from oid index\n",
            __func__, __LINE__ );
        return (-1);
    }

#if defined(INCLUDE_MOXA_L3)
    
    if ( ifIndex >= 1 && ifIndex <= dev_max_port ) 
    {
        LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "%% %s@%d can't set ifAlias for ifIndex('%d')\n",
            __func__, __LINE__, ifIndex);
        return (-1);
    }    
    else if( ifIndex >= LIB_SYSTEM_DEF_CFA_MIN_IVR_IF_INDEX && 
                ifIndex <= LIB_SYSTEM_DEF_CFA_MAX_IVR_IF_INDEX ) /* l3ipvlan */
    {
        if ( setEntryValue_mibTableEntry( reqinfo, request, entry,
            "/ipInterface/l3VlanIfTable",
            ifIndex - LIB_SYSTEM_DEF_CFA_MIN_IVR_IF_INDEX,
            "alias",
            MOXA_SNMP_JSON_STRING ) != 0 )
        {
            LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "%% %s@%d : can't set %s\n",
               __func__, __LINE__, "alias");
            return (-1);
        }
    }
    else if( ifIndex >= LIB_SYSTEM_DEF_CFA_MIN_LOOPBACK_IF_INDEX && 
                ifIndex <= LIB_SYSTEM_DEF_CFA_MAX_LOOPBACK_IF_INDEX ) /* l3 loopback interface */
    {
        if ( setEntryValue_mibTableEntry( reqinfo, request, entry,
            "/ipInterface/loopbackIfTable",
            ifIndex - LIB_SYSTEM_DEF_CFA_MIN_LOOPBACK_IF_INDEX,
            "alias",
            MOXA_SNMP_JSON_STRING ) != 0 )
        {
            LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "%% %s@%d : can't set %s\n",
               __func__, __LINE__, "alias");
            return (-1);
        }
    }
    else if (moxaSnmpHandle_UtilLaCheckPortChannel(ifIndex) == LA_PORT_CHANNEL)
    {
        if ( moxaSnmpHandle_UtilLaGetPortChannelIndex( ifIndex, &portChannelTableIndex ) != 0 )
        {
            LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "%% %s@%d can't get portChannelTableIndex from ifIndex('%d')\n",
                __func__, __LINE__, ifIndex );
            return (-1);
        }

        if ( setEntryValue_mibTableEntry( reqinfo, request, entry,
            MXCFG_GRP_mxla_portChannelTable,
            portChannelTableIndex,
            MXCFG_KEY_IfAlias,
            MOXA_SNMP_JSON_STRING ) != 0 )
        {
            LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "%% %s@%d : can't set %s\n",
               __func__, __LINE__, MXCFG_KEY_IfAlias);
            return (-1);
        }
    }
#else
   
    if ( moxaSnmpHandle_UtilLaCheckPortChannel(ifIndex) != LA_PORT_CHANNEL )
    {
        LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "%% %s@%d can't set ifAlias for ifIndex('%d')\n",
            __func__, __LINE__, ifIndex);
        return (-1);
    }

    if ( moxaSnmpHandle_UtilLaGetPortChannelIndex( ifIndex, &portChannelTableIndex ) != 0 )
    {
        LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "%% %s@%d can't get portChannelTableIndex from ifIndex('%d')\n",
            __func__, __LINE__, ifIndex );
        return (-1);
    }

    if ( setEntryValue_mibTableEntry( reqinfo, request, entry,
            MXCFG_GRP_mxla_portChannelTable,
            portChannelTableIndex,
            MXCFG_KEY_IfAlias,
            MOXA_SNMP_JSON_STRING ) != 0 )
    {
        LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "%% %s@%d : can't set %s\n",
            __func__, __LINE__, MXCFG_KEY_IfAlias);
        return (-1);
    }
#endif

    return 0;
}

#endif /* IES_AUTO_MIBS_TABLE_ONLY */


ies_handle_t
ies_auto_mibs_setup_entry_flags_net_ifmibdb
(
    struct ies_auto_mibs_entry *entry
)
{

    
    if ( IES_NOERR == IES_SNMP_COMPARE_URI(entry->uri, "ifmibdb/ifTable/") ) 
    {
        if ( IES_NOERR == IES_SNMP_COMPARE_URI(entry->uri_index, "ifAdminStatus") ) 
        {

            IES_FLAG_BITS_SET(IES_FLAG_SNMP_REPLACE_TRUTH_VALUE, entry->flags);
            IES_FLAG_BITS_SET(IES_FLAG_SNMP_URI_MOD_BY_IDX, entry->flags);

        }
        else
        if ( IES_NOERR == IES_SNMP_COMPARE_URI(entry->uri_index, "ifPhysAddress") ) 
        {
            IES_FLAG_BITS_SET(IES_FLAG_SNMP_REPLACE_BIT_VALUE, entry->flags);
        }
    }
    else
    if ( IES_NOERR == IES_SNMP_COMPARE_URI(entry->uri, "ifmibdb/ifXTable/") ) 
    {
        if ( IES_NOERR == IES_SNMP_COMPARE_URI(entry->uri_index, "ifAlias") ) 
        {
            if ( moxaSnmpHandle_RegEntrySetValue(entry, setEntryValue_ifmibdb_ifXTable_ifAlias) != 0 )
            {
                return IES_ERR;
            }
        }
        else
        if ( IES_NOERR == IES_SNMP_COMPARE_URI(entry->uri_index, "ifLinkUpDownTrapEnable") )
        {
            entry->mode = HANDLER_CAN_RONLY;
        }
    }

    return IES_NOERR;
}



#endif //_IES_AUTO_MIBS_FLAGS_net_ifmibdb_c
