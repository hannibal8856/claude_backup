/**
 * @brief function body for handle active/NotInService in fscfadb/ifMainTable/ifMainRowStatus

 * @param[in]    ifIndex     ifIndex
 * @param[in]    rowStatus   rowStatus command

 * @returns      0 means success, others fail.
 */
/* Handler bodies are in-master only - see IES_AUTO_MIBS_TABLE_ONLY in
 * snmp_tools/inc/ies_auto_mibs_handle.h. The flag setup below stays outside
 * the guard: it is shared with the lookup table. */
#ifndef IES_AUTO_MIBS_TABLE_ONLY

int32_t fscfadb_ifMainTable_ifMainRowStatus_activeAndNotInService( int32_t ifIndex,
                                                                   int32_t rowStatus )
{
    int32_t      ret                      = (-1);
    JSON_Value  *jsonVal                  = NULL;
    JSON_Object *jsonObj                  = NULL;
    JSON_Value  *jsonVal_agent            = NULL;
    JSON_Object *jsonObj_agent            = NULL;
    int32_t      portChannelTableURIIndex = 0;
    char         uriPath[MOXA_SNMP_MAX_URI_LENGTH]  = {0x0};
    int32_t      laGroupSelectionPolicy   = 0;
    int32_t      enable                   = 0;
    int32_t      ifMainType               = 0;

    if ( moxaSnmpHandle_UtilLaGetPortChannelIndex(ifIndex,
                                                  &portChannelTableURIIndex) != 0 )
    {
        LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "%% %s@%d : can't get portChannelTableURIIndex for ifIndex(%d)",
            __func__, __LINE__, ifIndex);
        return (-1);
    }

    snprintf(uriPath, sizeof(uriPath),
        MOXA_SNMP_URI_CONFIG_PATH("/%s/%d/"),
        MXCFG_GRP_mxla_portChannelTable, portChannelTableURIIndex);

    if ( moxaSnmpHandle_UtilCfgGetURIConfig(uriPath, &jsonVal) != 0 )
    {
        json_value_free(jsonVal);
        jsonVal = NULL;
        LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "%% %s@%d : can't get jsonVal From (%s)\n",
            __func__, __LINE__, uriPath);
        return (-1);
    }

    jsonObj = json_value_get_object(jsonVal);
    if ( jsonObj == NULL )
    {
        LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "%% %s@%d : can't init jsonObj from jsonValue\n",
            __func__, __LINE__);
        goto config_end;
    }

    if ( rowStatus == MOXA_SNMP_READ_CREATE_ACTIVE )
    {

        jsonVal_agent = json_value_init_object();

        if (jsonVal_agent == NULL)
        {
            LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "%% %s@%d : can't get jsonVal_agent\n",
                __func__, __LINE__ );
            goto config_end;
        }

        jsonObj_agent = json_value_get_object(jsonVal_agent);
        if ( jsonObj_agent == NULL )
        {
            LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "%% %s@%d : can't get jsonObj_agent\n",
                __func__, __LINE__ );
            goto config_end;
        }

        enable                 = json_object_dotget_boolean(jsonObj, MXCFG_KEY_IfEnable);
        ifMainType             = json_object_dotget_number (jsonObj, MXCFG_KEY_IfMainType);
        laGroupSelectionPolicy = json_object_dotget_number (jsonObj, MXCFG_KEY_laSelectPolicy);

        json_object_dotset_boolean(jsonObj_agent, MXCFG_KEY_IfEntryActive,  MOXA_SNMP_JSON_TRUE);
        json_object_dotset_number (jsonObj_agent, MXCFG_KEY_IfIndex,        ifIndex);
        json_object_dotset_boolean(jsonObj_agent, MXCFG_KEY_IfEnable,       enable);
        json_object_dotset_number (jsonObj_agent, MXCFG_KEY_IfMainType,     ifMainType);
        json_object_dotset_number (jsonObj_agent, MXCFG_KEY_laSelectPolicy, laGroupSelectionPolicy);

        if ( moxaSnmpHandle_UtilCfgDelURIConfig(uriPath) != 0 )
        {
            LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "%% %s@%d : can't del portChannelTableURIIndex(%d)",
                __func__, __LINE__, portChannelTableURIIndex);
            goto config_end;
        }

        snprintf(uriPath, sizeof(uriPath),
            MOXA_SNMP_AGENT_PATH(MXAGENT_GRP_LAportChannelTable));

        if ( moxaSnmpHandle_UtilCfgPostURIConfig(uriPath, jsonVal_agent) != 0 )
        {
            LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "%% %s@%d : can't post agent(%s)",
                __func__, __LINE__, uriPath);
            goto config_end;
        }
    }
    else
    if ( rowStatus == MOXA_SNMP_READ_CREATE_NOT_IN_SERVICE )
    {
        json_object_dotset_boolean(jsonObj, MXCFG_KEY_IfEntryActive, MOXA_SNMP_JSON_FALSE);

        if ( moxaSnmpHandle_UtilCfgPatchURIConfig(uriPath, jsonVal) != 0 )
        {
            LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "%% %s@%d : can't patch config(%s)",
                __func__, __LINE__, uriPath);
            goto config_end;
        }
    }
    else
    {
        LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "%% %s@%d : unsupport rowStatus(%d)",
            __func__, __LINE__, rowStatus);
            goto config_end;
    }

    ret = 0;

config_end:

    if ( jsonVal != NULL )
    {
        json_value_free(jsonVal);
        jsonVal = NULL;
    }

    if ( jsonVal_agent != NULL )
    {
        json_value_free(jsonVal_agent);
        jsonVal_agent = NULL;
    }

    return ret;
}



/**
 * @brief function body for handle destroy in fscfadb/ifMainTable/ifMainRowStatus

 * @param[in]    ifIndex     ifIndex
 * @param[in]    rowStatus   rowStatus command

 * @returns      0 means success, others fail.
 */
int32_t fscfadb_ifMainTable_ifMainRowStatus_destroy( int32_t ifIndex )
{
    int32_t portChannelTableURIIndex = 0;
    int32_t laGroup                  = 0;
    char    uriPath[MOXA_SNMP_MAX_URI_LENGTH]  = {0x0};

    if ( moxaSnmpHandle_UtilLaGetPortChannelIndex(ifIndex,
                                                  &portChannelTableURIIndex) != 0 )
    {
        LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "%% %s@%d : can't get portChannelTableURIIndex for ifIndex(%d)",
            __func__, __LINE__, ifIndex);
        return (-1);
    }

    if ( moxaSnmpHandle_UtilLaFindLaGroup(portChannelTableURIIndex, &laGroup) != LA_SEARCH_HIT )
    {
        LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "%% %s@%d : can't get laGroup for portChannelTableURIIndex(%d)",
            __func__, __LINE__, portChannelTableURIIndex);
        return (-1);
    }

    snprintf(uriPath, sizeof(uriPath),
        MOXA_SNMP_AGENT_PATH(MXAGENT_GRP_LAportChannelTable)"?%s=%d",
        MXAGENT_KEY_laGroup,
        laGroup);

    LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "%s@%d : uriPath('%s')\n",
        __func__, __LINE__, uriPath );

    if ( moxaSnmpHandle_UtilCfgDelURIConfig(uriPath) != 0 )
    {
        LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "%% %s@%d : can't del laGroup(%d) for uriPath(%s)",
            __func__, __LINE__, laGroup, uriPath);
        return (-1);
    }

    return 0;
}


/**
 * @brief function body for handle CreateAndWait in fscfadb/ifMainTable/ifMainRowStatus

 * @param[in]    ifIndex     ifIndex
 * @param[in]    rowStatus   rowStatus command

 * @returns      0 means success, others fail.
 */
int32_t fscfadb_ifMainTable_ifMainRowStatus_createAndWait( int32_t ifIndex )
{
    int32_t       ret                      = (-1);
    JSON_Value   *jsonVal                  = NULL;
    JSON_Object  *jsonObj                  = NULL;
    int32_t       portChannelTableURIIndex = 0;
    int32_t       portChannelTableURICount = 0;
    int32_t       laGroupSelectionPolicy   = 0;
    char          uriPath[MOXA_SNMP_MAX_URI_LENGTH] = {0x0};
    char          ifAlias[32]  = {0x0};
    int32_t       ifMainType   = 0;
    int32_t       maxPortNo    = 0;

    if ( moxaSnmpHandle_UtilLaGetPortChannelIndex(ifIndex,
                                                  &portChannelTableURIIndex) == 0 )
    {
        LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "%% %s@%d : portChannelTableURIIndex(%d) for ifIndex(%d) should not exist\n",
            __func__, __LINE__, portChannelTableURIIndex, ifIndex);
        return (-1);
    }

    snprintf(uriPath, sizeof(uriPath),
        MOXA_SNMP_URI_CONFIG_PATH(MXCFG_GRP_mxla_portChannelTable) );

    if ( moxaSnmpHandle_UtilJsonGetTableCnt(uriPath, &portChannelTableURICount) != 0 )
    {
        LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "%% %s@%d : can't get portChannelTableURICount for uriPath(%s)\n",
            __func__, __LINE__, uriPath);
        return (-1);
    }

    jsonVal = json_value_init_object();

    if ( jsonVal == NULL )
    {
        LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "%% %s@%d : can't init jsonVal\n",
            __func__, __LINE__);
        goto config_end;
    }

    jsonObj = json_value_get_object(jsonVal);
    if ( jsonObj == NULL )
    {
        LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "%% %s@%d : can't get jsonObj for jsonVal\n",
            __func__, __LINE__);
        goto config_end;
    }

    LibSystem_GetMaxPortNumInSystem(&maxPortNo);

    laGroupSelectionPolicy = LA_PORTCHANNELTABLE_DEFAULT_POLICY;
    ifMainType             = LA_PORTCHANNELTABLE_IFMAIN_TYPE;
    snprintf(ifAlias, sizeof(ifAlias), "po%d", ifIndex - maxPortNo);

    json_object_dotset_number (jsonObj, MXCFG_KEY_IfIndex,        ifIndex);
    json_object_dotset_boolean(jsonObj, MXCFG_KEY_IfEnable,       MOXA_SNMP_JSON_FALSE);
    json_object_dotset_number (jsonObj, MXCFG_KEY_laSelectPolicy, laGroupSelectionPolicy);
    json_object_dotset_string (jsonObj, MXCFG_KEY_IfAlias,        ifAlias);
    json_object_dotset_number (jsonObj, MXCFG_KEY_IfMainType,     ifMainType);
    json_object_dotset_boolean(jsonObj, MXCFG_KEY_IfEntryActive,  MOXA_SNMP_JSON_FALSE);

    snprintf(uriPath, sizeof(uriPath),
        MOXA_SNMP_URI_CONFIG_PATH(MXCFG_GRP_mxla_portChannelTable)"/%d/",
        portChannelTableURICount );

    if ( moxaSnmpHandle_UtilCfgPatchURIConfig(uriPath, jsonVal) != 0 )
    {
        LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "%% %s@%d : can't PatchURIConfig\n",
            __func__, __LINE__);
        goto config_end;
    }
    ret = 0;

config_end:

    if ( jsonVal != NULL )
    {
        json_value_free(jsonVal);
        jsonVal = NULL;
    }

    return ret;
}


