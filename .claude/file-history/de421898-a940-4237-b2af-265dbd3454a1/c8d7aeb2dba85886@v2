/**
 * @brief AddPortChannelMembers in fsladb/fsLaPortTable/fsLaPortMode

 * @param[in]    ifIndex     ifIndex    in MIB ifIndex of fsladb/fsLaPortTable
 * @param[in]    laPortMode  laPortMode in MIB value   of fsladb/fsLaPortTable/

 * @returns      0 means success, others fail.
 */
int32_t fsladb_fsLaPortTable_fsLaPortMode_AddPortChannelMembers( int32_t ifIndex,
                                                                 int32_t laPortMode )
{
    int32_t       ret           = (-1);
    JSON_Value   *jsonVal       = NULL;
    JSON_Object  *jsonObj       = NULL;
    JSON_Value   *jsonVal_agent = NULL;
    JSON_Object  *jsonObj_agent = NULL;
    int32_t       dot3adAggPortActorAdminKey = 0;
    int32_t       lacpActivity               = 0;
    char          uriPath[MOXA_SNMP_MAX_URI_LENGTH] = {0x0};

    snprintf(uriPath, sizeof(uriPath),
        MOXA_SNMP_URI_CONFIG_PATH(MXCFG_GRP_mxla_portTable)"/%d",
        MXCFG_INTERNAL_PORT_INDEX(ifIndex));

    if ( moxaSnmpHandle_UtilCfgGetURIConfig(uriPath, &jsonVal) != 0 )
    {
        json_value_free(jsonVal);
        jsonVal = NULL;
        LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "%% %s@%d : can't get jsonVal\n",
            __func__, __LINE__ );
        return (-1);
    }

    jsonObj = json_value_get_object(jsonVal);
    if ( jsonObj == NULL )
    {
        LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "%% %s@%d : can't get jsonObj for jsonVal\n",
            __func__, __LINE__);
        goto config_end;
    }

    jsonVal_agent = json_value_init_object();

    if (jsonVal_agent == NULL)
    {
        LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "%% %s@%d : can't get jsonVal_agent\n",
            __func__, __LINE__ );
        goto config_end;
    }

    jsonObj_agent = json_value_get_object(jsonVal_agent);
    if ( jsonObj_agent == NULL )
    {
        LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "%% %s@%d : can't get jsonObj_agent\n",
            __func__, __LINE__ );
        goto config_end;
    }

    dot3adAggPortActorAdminKey = json_object_dotget_number (jsonObj, MXCFG_KEY_portAdminKey);
    lacpActivity               = json_object_dotget_boolean(jsonObj, MXCFG_KEY_activity);

    json_object_dotset_number (jsonObj_agent, MXCFG_KEY_portAdminKey, dot3adAggPortActorAdminKey);
    json_object_dotset_boolean(jsonObj_agent, MXCFG_KEY_activity,     lacpActivity);
    json_object_dotset_number (jsonObj_agent, MXCFG_KEY_portMode,     laPortMode);

    snprintf(uriPath, sizeof(uriPath),
        MOXA_SNMP_AGENT_PATH(MXAGENT_GRP_MemInSingleChannel)"?%s=%d",
        MXAGENT_KEY_laPorts,
        MXCFG_INTERNAL_PORT_INDEX(ifIndex));

    if ( moxaSnmpHandle_UtilCfgPostURIConfig(uriPath, jsonVal_agent) != 0 )
    {
        LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "%% %s@%d : can't post jsonVal_agent\n",
            __func__, __LINE__ );
        goto config_end;
    }

    ret = 0;

config_end:

    if ( jsonVal != NULL )
    {
        json_value_free(jsonVal);
        jsonVal = NULL;
    }

    if ( jsonVal_agent != NULL )
    {
        json_value_free(jsonVal_agent);
        jsonVal_agent = NULL;
    }

    return ret;
}


/**
 * @brief function body for set fscfadb/ifMainTable/ifMainType

 * @param[in]    reqinfo     netsnmp register handle
 * @param[in]    request     netsnmp request
 * @param[in]    entry       moxa snmp entry

 * @returns      0 means success, others fail.
 */
int32_t setEntryValue_fscfadb_ifMainTable_ifMainType( netsnmp_agent_request_info    *reqinfo,
                                                      netsnmp_request_info          *request,
                                                      struct ies_auto_mibs_entry    *entry   )
{
    int32_t  ifIndex = 0;
    int32_t  portChannelTableURIIndex = 0;

    if ( moxaSnmpHandle_UtilSnmpGetOIDIndex(request, entry, &ifIndex) != 0 )
    {
        LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "%% %s@%d : can't get request OID index\n",
            __func__, __LINE__ );
        return (-1);
    }

    if ( moxaSnmpHandle_UtilLaCheckPortChannel(ifIndex) == LA_NORMAL_PORT )
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "%% %s@%d : only portChannel port is allow to set \n\n",
            __func__, __LINE__);
        return (-1);
    }

    LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "%s@%d : ifIndex(%d)\n",
        __func__, __LINE__, ifIndex);

    if ( moxaSnmpHandle_UtilLaGetPortChannelIndex(ifIndex,
                                                  &portChannelTableURIIndex) != 0 )
    {
        LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "%% %s@%d : can't get portChannelTableURIIndex for ifIndex(%d)",
            __func__, __LINE__, ifIndex);
        return (-1);
    }

    if ( setEntryValue_mibTableEntry( reqinfo, request, entry,
            MXCFG_GRP_mxla_portChannelTable,
            portChannelTableURIIndex,
            MXCFG_KEY_IfMainType,
            MOXA_SNMP_JSON_NUMBER ) != 0 )
    {
        LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "%% %s@%d : can't set %s\n",
            __func__, __LINE__, MXCFG_KEY_IfMainType);
        return (-1);
    }

    return 0;
}


/**
 * @brief function body for set fscfadb/ifMainTable/ifMainRowStatus

 * @param[in]    reqinfo     netsnmp register handle
 * @param[in]    request     netsnmp request
 * @param[in]    entry       moxa snmp entry

 * @returns      0 means success, others fail.
 */
int32_t setEntryValue_fscfadb_ifMainTable_ifMainRowStatus( netsnmp_agent_request_info    *reqinfo,
                                                           netsnmp_request_info          *request,
                                                           struct ies_auto_mibs_entry    *entry   )
{
    int32_t                   ifIndex   = 0;
    int32_t                   rowStatus = 0;
    struct moxaSnmpSetBuffer  setBuf;

    memset(&setBuf, 0, sizeof(setBuf));

    if ( moxaSnmpHandle_UtilSnmpGetOIDIndex(request, entry, &ifIndex) != 0 )
    {
        LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "%% %s@%d : can't get request OID index\n",
            __func__, __LINE__ );
        return (-1);
    }

    if ( moxaSnmpHandle_UtilLaCheckPortChannel(ifIndex) == LA_NORMAL_PORT )
    {
        LibUtil_DbgTrace(kDbgFlgIssUriSNMP, "%% %s@%d : only portChannel port is allow to set \n\n",
            __func__, __LINE__ );
        return (-1);
    }

    if ( moxaSnmpHandle_UtilSnmpGetSetBuffer(reqinfo, request, entry, &setBuf) != 0 )
    {
        LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "%% %s@%d : can't get set buffer\n",
            __func__, __LINE__ );
        return (-1);
    }

    rowStatus = atoi(setBuf.valStrBuf);

    switch(rowStatus)
    {
        case MOXA_SNMP_READ_CREATE_ACTIVE:
        case MOXA_SNMP_READ_CREATE_NOT_IN_SERVICE:

            if ( fscfadb_ifMainTable_ifMainRowStatus_activeAndNotInService(ifIndex, rowStatus) != 0 )
            {
                LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "%% %s@%d : can't handle active or notInService\n",
                    __func__, __LINE__ );
                return (-1);
            }
            break;

        case MOXA_SNMP_READ_CREATE_DESTROY:

            if ( fscfadb_ifMainTable_ifMainRowStatus_destroy( ifIndex ) != 0 )
            {
                LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "%% %s@%d : can't handle destroy\n",
                    __func__, __LINE__ );
                return (-1);
            }
            break;

        case MOXA_SNMP_READ_CREATE_CREATE_AND_WAIT:

            if ( fscfadb_ifMainTable_ifMainRowStatus_createAndWait( ifIndex ) != 0 )
            {
                LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "%% %s@%d : can't handle createAndWait\n",
                    __func__, __LINE__ );
                return (-1);
            }
            break;

        default :
            LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "%% %s@%d : unsupport rowStatus(%d)\n",
            __func__, __LINE__, rowStatus );
            return (-1);
    }

    return 0;
}


/**
 * @brief function body for set fsladb/fsLaPortTable/fsLaPortMode

 * @param[in]    reqinfo     netsnmp register handle
 * @param[in]    request     netsnmp request
 * @param[in]    entry       moxa snmp entry

 * @returns      0 means success, others fail.
 */
int32_t setEntryValue_fsladb_fsLaPortTable_fsLaPortMode( netsnmp_agent_request_info    *reqinfo,
                                                         netsnmp_request_info          *request,
                                                         struct ies_auto_mibs_entry    *entry   )
{
    int32_t                   ret        = (-1);
    int32_t                   ifIndex    = 0;
    struct moxaSnmpSetBuffer  setBuf;
    int32_t                   laPortMode = 0;

    memset(&setBuf, 0, sizeof(setBuf));

    if ( moxaSnmpHandle_UtilSnmpGetOIDIndex(request, entry, &ifIndex) != 0 )
    {
        LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "%% %s@%d : can't get request OID index\n",
            __func__, __LINE__ );
        return (-1);
    }

    LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "%s@%d : ifIndex(%d)\n",
        __func__, __LINE__, ifIndex);

    if ( moxaSnmpHandle_UtilSnmpGetSetBuffer(reqinfo, request, entry, &setBuf) != 0 )
    {
        LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "%% %s@%d : can't get set buffer\n",
            __func__, __LINE__ );
        return (-1);
    }

    laPortMode = atoi(setBuf.valStrBuf);

    switch(laPortMode)
    {
        case LA_PORT_MODE_DISABLE :

            if ( fsladb_fsLaPortTable_fsLaPortMode_RemovePortChannelMembers( ifIndex ) != 0 )
            {
                LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "%% %s@%d : can't RemovePortChannelMembers \n",
                    __func__, __LINE__);
                return (-1);
            }
            break;

        case LA_PORT_MODE_LACP :
        case LA_PORT_MODE_MANUAL :

            if ( fsladb_fsLaPortTable_fsLaPortMode_AddPortChannelMembers( ifIndex, laPortMode ) != 0 )
            {
                LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "%% %s@%d : can't AddPortChannelMembers \n",
                    __func__, __LINE__);
                return (-1);
            }
            break;

        default :
            LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "%% %s@%d : unsupport laPortMode(%d)\n",
                __func__, __LINE__, laPortMode );
            return (-1);
    }

    return 0;
}



/**
 * @brief function body for set fscfadb/fsLaPortChannelTable/laConfigGroupSelectionPolicy

 * @param[in]    reqinfo     netsnmp register handle
 * @param[in]    request     netsnmp request
