            }
        }

    }
    else
    if ( IES_NOERR == IES_SNMP_COMPARE_URI(entry->uri, "fsladb/fsLaPortChannelTable/") ) 
    {
        IES_FLAG_BITS_SET(IES_FLAG_SNMP_INDEX_NOT_START_FROM_1, entry->flags);
        IES_FLAG_BITS_SET(IES_FLAG_SNMP_ISS_REMAP_TBL, entry->flags);
        if ( IES_NOERR == IES_SNMP_COMPARE_NAME(entry->name, "laConfigGroupSelectionPolicy") )
        {

            if ( moxaSnmpHandle_RegEntrySetValue(entry, setEntryValue_fscfadb_fsLaPortChannelTable_laConfigGroupSelectionPolicy) != 0 )
            {
                return IES_ERR;
            }
        }
    }
    else
    if ( IES_NOERR == IES_SNMP_COMPARE_URI(entry->uri, "fsladb/fsLaPortTable/") ) 
    {

        IES_FLAG_BITS_SET(IES_FLAG_SNMP_ISS_REMAP_TBL, entry->flags);
        if ( IES_NOERR == IES_SNMP_COMPARE_URI(entry->uri_index, "fsLaPortMode") ) 
        {
            if ( moxaSnmpHandle_RegEntrySetValue(entry, setEntryValue_fsladb_fsLaPortTable_fsLaPortMode) != 0 )
            {
                return IES_ERR;
            }
        }
        else
        if ( IES_NOERR == IES_SNMP_COMPARE_URI(entry->uri_index, "fsLaPortActorResetAdminState") ) 
        {
            IES_FLAG_BITS_SET(IES_FLAG_SNMP_URI_MOD_ON_SET, entry->flags);
            IES_FLAG_BITS_SET(IES_FLAG_SNMP_LA_REPLACE_BIT, entry->flags);
            IES_FLAG_BITS_SET(IES_FLAG_SNMP_REPLACE_BIT_VALUE, entry->flags);
            snprintf(entry->mod_uri      , IES_MAX_URI,       "laSettings/portTable/");
        }
        else
        if ( IES_NOERR == IES_SNMP_COMPARE_URI(entry->uri_index, "fsLaPortAggregateWaitTime") ) 
        {
            IES_FLAG_BITS_SET(IES_FLAG_SNMP_URI_MOD_ON_SET, entry->flags);
            snprintf(entry->mod_uri      , IES_MAX_URI,       "laSettings/portTable/");
            snprintf(entry->mod_uri_index, IES_MAX_URI_INDEX, "lacpWaitTime");
        }
    }
    return IES_NOERR;
}



