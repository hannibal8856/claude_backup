            if ( moxaSnmpHandle_RegEntrySetValue(entry, setEntryValue_fscfadb_ifMainTable_ifMainType) != 0 )
            {
                return IES_ERR;
            }
        }
        else
        if ( IES_NOERR == IES_SNMP_COMPARE_URI(entry->uri_index, "ifMainRowStatus") ) 
        {
            if ( moxaSnmpHandle_RegEntrySetValue(entry, setEntryValue_fscfadb_ifMainTable_ifMainRowStatus) != 0 )
