        return (-1);
    }

    selPolicy = atoi(setBuf.valStrBuf);

    LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "%s@%d : laConfigGroupSelectionPolicy(%d)\n",
        __func__, __LINE__, selPolicy);

    if ( setEntryValue_mibTableEntry( reqinfo, request, entry,
            MXCFG_GRP_mxla_portChannelTable,
            portChannelTableURIIndex,
            MXCFG_KEY_laSelectPolicy,
            MOXA_SNMP_JSON_NUMBER ) != 0 )
    {
        LibUtil_DbgTrace( kDbgFlgIssUriSNMP, "%% %s@%d : can't set %s\n",
            __func__, __LINE__, MXCFG_KEY_laSelectPolicy);
        return (-1);
    }

    return 0;
}

